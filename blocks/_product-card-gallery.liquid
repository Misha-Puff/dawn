{%- comment -%}
  horizon-blocks Phase 10 — `_product-card-gallery` private block.

  Port of stock Horizon v4.1.1 (68760d9) blocks/_product-card-gallery.liquid;
  schema t: strings hardcoded to Horizon's English. Deviations:
  - Phase 11: stock's badge hardcode (:5-26, ported here as an inline
    hardcode at stock defaults in Phase 10) is REPLACED by a `blocks`
    allowlist + `{% content_for 'blocks' %}` in the children capture — badges
    are now the `_product-badges` gallery-child block (Dawn M&P engine +
    per-block settings; see that file's header). No blank-children fallback
    by design: deleting the Badges block should remove badges, not resurrect
    the stock pair. The .color-custom-badge-sold-out / -sale scopes in
    hz-ui-tokens are consumer-less since this change (kept, stock-parity
    tokens).
  - Phase 13 (quick-add seam closed; round 3 = DAWN-NATIVE, Nathan ruling
    2026-07-07): stock's quick-add render site (:27-29) hosts DAWN's
    quick-add machinery, not the Horizon port — hz-card-quick-add is the
    verbatim extraction of Dawn card-product.liquid:148-243 (see its header
    for the full ruling; the Horizon quick-add subsystem stays in-repo,
    unwired). Deviations vs stock Horizon: (1) the gate reads
    section.settings.quick_add — the per-host setting on hz-product-list /
    hz-product-recommendations (default false = live card parity; other
    hosts have no such setting → nil → no quick-add, zero change; no mobile
    setting — Dawn's trigger is always visible at both breakpoints). (2) The
    render is wrapped in {% unless product.tags contains 'Badge-Coming
    Soon' %} — live-Dawn parity (card-product.liquid:147 suppresses
    quick-add entirely for Coming-Soon products; Phase-10 seam mandated the
    wrap).
{%- endcomment -%}
{% assign product = closest.product %}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
  {% unless product == blank %}
    {% if section.settings.quick_add %}
      {% unless product.tags contains 'Badge-Coming Soon' %}
        {% render 'hz-card-quick-add', product: product, section_id: section.id %}
      {% endunless %}
    {% endif %}
  {% endunless %}
{% endcapture %}

{% render 'card-gallery', children: children %}

{% # Title and price for the zoomed out grid view %}
<div class="product-grid-view-zoom-out--details">
  {% if product == blank %}
    <h3 class="h4">Product title</h3>
  {% else %}
    <h3 class="h4">{{ product.title }}</h3>
  {% endif %}
</div>

{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "Product image",
  "tag": null,
  "blocks": [
    {
      "type": "_product-badges"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays media from parent product"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Auto"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait",
      "label": "Aspect ratio",
      "info": "Adjusted in some layouts"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "placeholder": "Default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Media",
      "category": "Product",
      "blocks": {
        "badges": {
          "type": "_product-badges"
        }
      },
      "block_order": ["badges"]
    }
  ]
}
{% endschema %}
