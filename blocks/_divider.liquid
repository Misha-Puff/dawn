{%- comment -%}
  horizon-blocks Phase 1 — `_divider` primitive (private block).

  Faithful lift of stock Horizon v4.1.1 (68760d9) `blocks/_divider.liquid`, adapted
  for Dawn only by hardcoding English schema strings. Private (`_` prefix), so it's
  reachable only where a parent explicitly allowlists `_divider` — the `group`
  block does. All appearance lives in the rendered `snippets/divider.liquid`.
{%- endcomment -%}

{% render 'divider', id: block.id, settings: block.settings, attributes: true, block: block %}

{% schema %}
{
  "name": "Divider",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "thickness",
      "label": "Thickness",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "Corner radius",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "rounded",
          "label": "Rounded"
        }
      ],
      "default": "square",
      "visible_if": "{{ block.settings.thickness > 1 }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Color",
      "placeholder": "Default"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "Length",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Divider",
      "category": "Layout"
    }
  ]
}
{% endschema %}
