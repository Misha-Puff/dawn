{% comment %}
  horizon-blocks Phase 9: blocks/popup-link.liquid — near-verbatim port of
  Horizon 68760d9 blocks/popup-link.liquid. Public block (no underscore) →
  reachable via @theme everywhere; no allowlist edits needed. Carries its
  own dialog.js module script tag (per-render precedent, verbatim in
  source) + renders snippets/dialog-styles.liquid (the extracted base.css
  dialog/close-button support rules — accordion-styles precedent).

  Dawn deviations (everything else verbatim; source line refs = 68760d9):
  - Schema strings hardcoded English from 68760d9 locales (track
    precedent). The type_preset `info` is REWORDED: Horizon deep-links to
    editable typography theme settings; our presets are hardcoded Horizon
    defaults in hz-type-variables, so the link would be wrong.
  - `icon-close.svg` → `hz-icon-close.svg` (Dawn owns the stock name with
    different art — Phase-4/8 rename-on-ownership precedent);
    icon-external.svg ships verbatim under its own name (unowned).
  - `button` class dropped from BOTH buttons (Phase-8 ratified precedent:
    Dawn's .button is a styled primary; Horizon's .button:not(.button-unstyled)
    guard makes it inert there, so dropping it is behavior-identical).
  - Runtime aria-label hardcoded "Close dialog" (accessibility.close_dialog).
  - Stylesheet deviations are constraint-commented inline (double-selector
    cascade armor, button-unstyled essentials split, .text-left shim,
    re-scoped type presets).

  Kept verbatim (known upstream nits, logged not fixed):
  - aria-labelledby="popup-dialog-heading" static id — duplicate-id risk
    with multiple popups on one page, shipped as-is upstream.
  - dialog-component carries no width styling and custom elements default
    to display:inline (dead width in block-flow hosts) — Horizon relies on
    inline too; eyeball item in the punchlist, no display:block shim.
  - Horizon does not gate the dialog animations behind
    prefers-reduced-motion; matched (see dialog-styles.liquid).
{% endcomment %}

{% assign block_settings = block.settings %}

<script
  src="{{ 'dialog.js' | asset_url }}"
  type="module"
></script>

{% render 'dialog-styles' %}

<dialog-component
  class="popup-link"
  {{ block.shopify_attributes }}
>
  <button
    on:click="/showDialog"
    class="button-unstyled popup-link__button text-left spacing-style {{ block_settings.type_preset }}"
    style="{% render 'spacing-style', settings: block_settings %}"
  >
    {{- block_settings.heading }}
    {{- 'icon-external.svg' | inline_asset_content -}}
  </button>

  <dialog
    ref="dialog"
    class="popup-link__content dialog-modal color-custom-popover{% if block_settings.behavior == 'drawer' %} popup-link__content--drawer dialog-drawer{% endif %}"
    scroll-lock
    aria-labelledby="popup-dialog-heading"
  >
    <h2
      id="popup-dialog-heading"
      class="visually-hidden"
    >
      {{ block_settings.heading }}
    </h2>
    <div class="popup-link__inner">
      {% content_for 'blocks' %}
    </div>
    <button
      ref="closeButton"
      on:click="/closeDialog"
      class="button-unstyled close-button popup-link__close"
      aria-label="Close dialog"
    >
      {{- 'hz-icon-close.svg' | inline_asset_content -}}
    </button>
  </dialog>
</dialog-component>

{% stylesheet %}
  .popup-link__button svg {
    display: inline-block;
    position: relative;
    top: var(--margin-2xs);
  }

  /* Dawn cascade armor: every .popup-link__content* / .popup-link__close
     rule doubles its own class (.text-block--background precedent). In
     Horizon the block CSS loads after base.css and wins these overlaps
     (border, radius, padding, max-w/h, animations, close offsets) at equal
     specificity; Dawn's stylesheet-bundle order is not guaranteed, so the
     doubled selectors must beat the extracted .dialog-modal/.close-button
     family (dialog-styles.liquid) on raw specificity instead. */
  .popup-link__content.popup-link__content {
    box-shadow: var(--shadow-popover);
    border: var(--style-border-popover);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    max-width: var(--normal-content-width);
    max-height: var(--modal-max-height);

    @media screen and (min-width: 750px) {
      padding: var(--padding-5xl);
    }
  }

  .popup-link__content.popup-link__content[open] {
    animation: modalSlideInTop var(--animation-speed) var(--animation-easing) forwards;
  }

  /* :not(--drawer) added on top of the doubling: in drawer mode the stock
     winner for the closing animation is the extracted
     .dialog-drawer[open].dialog-closing (0,3,0) move-and-fade leg beating
     this rule's stock (0,2,0); doubling alone would create a new (0,3,0)
     tie decided by bundle order. Excluding the drawer here keeps both mode
     winners deterministic and stock-faithful. */
  .popup-link__content.popup-link__content.dialog-closing:not(.popup-link__content--drawer) {
    animation: modalSlideOutTop var(--animation-speed) var(--animation-easing) forwards;
  }

  .popup-link__content--drawer.popup-link__content--drawer {
    position: fixed;
    border-radius: 0;
    width: var(--sidebar-width);
    max-width: 95vw;
    height: 100%;
    margin: 0 0 0 auto;
  }

  /* Needed to ensure the drawer is full height */
  .popup-link__content--drawer.popup-link__content--drawer:modal {
    max-height: 100dvh;
  }

  .popup-link__close.popup-link__close {
    top: var(--margin-2xs);
    right: var(--margin-2xs);
    opacity: 0.8;
    animation: none;
  }

  /* Dawn shim: Horizon base.css:1361-1376 .button-unstyled essentials +
     :hover, SPLIT per button because scoping changes specificity: in stock
     the later .close-button rules (0,1,0) out-order button-unstyled's
     display/background/radius, so a single scoped (0,2,0) shim would
     invert those wins on the close button (icon centering, round focus
     outline). Trigger gets the full essentials; the close button gets only
     the props .close-button never contests (border/padding — without
     border: 0 the UA button border shows). --font-paragraph--* tokens
     exist via hz-type-variables (video.liquid pattern, fonts included per
     plan). color: var(--color-foreground) goes IACVT against Dawn's comma
     triplet → inherit outside custom scopes (Phase-1b precedent); inside
     .color-custom-popover it resolves full-color. overflow: hidden stays
     trigger-only: on the close button it would (0,2,0)-tie the iOS < 16.4
     focus-visible workaround in dialog-styles.liquid, and it is inert on a
     fixed 44px flex box anyway. */
  .popup-link__button {
    display: block;
    padding: 0;
    background-color: inherit;
    color: var(--color-foreground);
    border: 0;
    border-radius: 0;
    overflow: hidden;
    box-shadow: none;
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-size: var(--font-paragraph--size);
  }

  .popup-link__button:hover {
    background-color: inherit;
  }

  .popup-link .popup-link__close {
    border: 0;
    padding: 0;
  }

  /* Dawn shim: Horizon base.css:561-564 .text-left utility (Dawn lacks it;
     class appears in this block's markup) */
  .text-left {
    --text-align: left;

    text-align: left;
  }

  /* Dawn shim: Horizon global typography preset classes (base.css:678+)
     re-scoped onto the trigger (blocks/menu.liquid:184-259 precedent;
     without these, Dawn's own .h1-.h6 ramp wins on the trigger) */
  .popup-link__button.paragraph {
    font-family: var(--font-paragraph--family);
    font-style: var(--font-paragraph--style);
    font-weight: var(--font-paragraph--weight);
    font-size: var(--font-paragraph--size);
    line-height: var(--font-paragraph--line-height);
    text-transform: var(--font-paragraph--case);
    -webkit-font-smoothing: antialiased;
    color: var(--color, var(--color-foreground));
  }

  .popup-link__button.h1 {
    font-family: var(--font-h1--family);
    font-style: var(--font-h1--style);
    font-weight: var(--font-h1--weight);
    font-size: var(--font-h1--size);
    line-height: var(--font-h1--line-height);
    letter-spacing: var(--font-h1--letter-spacing);
    text-transform: var(--font-h1--case);
    color: var(--color);
  }

  .popup-link__button.h2 {
    font-family: var(--font-h2--family);
    font-style: var(--font-h2--style);
    font-weight: var(--font-h2--weight);
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    color: var(--color);
  }

  .popup-link__button.h3 {
    font-family: var(--font-h3--family);
    font-style: var(--font-h3--style);
    font-weight: var(--font-h3--weight);
    font-size: var(--font-h3--size);
    line-height: var(--font-h3--line-height);
    letter-spacing: var(--font-h3--letter-spacing);
    text-transform: var(--font-h3--case);
    color: var(--color);
  }

  .popup-link__button.h4 {
    font-family: var(--font-h4--family);
    font-style: var(--font-h4--style);
    font-weight: var(--font-h4--weight);
    font-size: var(--font-h4--size);
    line-height: var(--font-h4--line-height);
    letter-spacing: var(--font-h4--letter-spacing);
    text-transform: var(--font-h4--case);
    color: var(--color);
  }

  .popup-link__button.h5 {
    font-family: var(--font-h5--family);
    font-style: var(--font-h5--style);
    font-weight: var(--font-h5--weight);
    font-size: var(--font-h5--size);
    line-height: var(--font-h5--line-height);
    letter-spacing: var(--font-h5--letter-spacing);
    text-transform: var(--font-h5--case);
    color: var(--color);
  }

  .popup-link__button.h6 {
    font-family: var(--font-h6--family);
    font-style: var(--font-h6--style);
    font-weight: var(--font-h6--weight);
    font-size: var(--font-h6--size);
    line-height: var(--font-h6--line-height);
    letter-spacing: var(--font-h6--letter-spacing);
    text-transform: var(--font-h6--case);
    color: var(--color);
  }
{% endstylesheet %}

