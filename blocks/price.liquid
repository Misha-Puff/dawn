{%- comment -%}
  horizon-blocks Phase 10 — `price` block.

  Port of stock Horizon v4.1.1 (68760d9) blocks/price.liquid; schema t:
  strings hardcoded to Horizon's English. Deviations:
  - render 'price' repointed to the renamed 'hz-price' (Dawn collision
    rename); tax-note buyer strings hardcoded to Horizon's English.
  - Dawn rem-base correction added to the style capture after the frozen
    typography-style render (snippets/text.liquid:79-101 pattern verbatim,
    incl. the Phase-8 non-rem guard): Dawn's root font-size is
    62.5% * body_scale, so the schema's rem font sizes would render ~half
    size without the px re-emit. The schema font_size option VALUES stay in
    stock rem format — typography-style's type classifier parses rem strings
    (never convert them to px).
  - The type_preset `info` key is dropped — it links to per-preset theme
    settings that don't exist in Dawn (presets are hardcoded at stock Horizon
    defaults in snippets/hz-type-variables.liquid; text-block precedent).
  - Custom-preset Font select trimmed 4 -> 2 options (Phase-1b text-block
    precedent: Dawn has 2 real font settings; subheading/accent values in
    hand-written JSON still resolve via hz-type-variables aliases).
  - Per-render module script tag for assets/product-price.js
    (snippets/slideshow.liquid:91 precedent) — stock loads it globally from
    scripts.liquid; nothing imports it (matches stock's importmap).
  <product-price> consumes SlideshowSelectEvent/ProductSelectEvent to
  re-render on variant changes via the section-rendering-product-card
  endpoint.
{%- endcomment -%}
{%- liquid
  assign block_settings = block.settings
  assign product_resource = closest.product
  assign selected_variant = product_resource.selected_or_first_available_variant
-%}

{% liquid
  if block_settings.type_preset == 'rte' or block_settings.type_preset == 'paragraph'
    assign is_rte = true
  endif

  capture text_block_classes
    if block_settings.width == '100%'
      echo 'text-block--align-' | append: block_settings.alignment
      if block_settings.max_width == 'none'
        echo ' text-block--full-width'
      endif
    endif
    if block_settings.type_preset == 'custom'
      echo ' custom-typography'
      if block_settings.font_size != ''
        echo ' custom-font-size'
      endif
      if block_settings.color != ''
        echo ' custom-color'
      endif
    endif
    if block_settings.background
      echo ' text-block--background'
    endif
    if is_rte
      echo ' rte'
    endif
  endcapture
%}

<product-price
  class="text-block {{ text_block_classes }} text-{{ block_settings.alignment }} {{ block_settings.type_preset | default: 'paragraph' }} spacing-style"
  data-block-id="{{ block.id }}"
  data-product-id="{{ product_resource.id }}"
  style="
    {% render 'typography-style', settings: block_settings %}
    {%- liquid
      # Dawn rem-base correction (snippets/text.liquid:79-101 pattern,
      # verbatim incl. the Phase-8 non-rem guard) — re-emit the custom-preset
      # --font-size in px at 16px/rem; a later declaration in the same style
      # attribute wins.
      if block_settings.type_preset == 'custom' and block_settings.font_size != blank and block_settings.font_size contains 'rem'
        assign hz_font_size_rem = block_settings.font_size | split: 'rem' | first | times: 1.0
        assign hz_font_size_px = hz_font_size_rem | times: 16
        if hz_font_size_rem >= 3.0
          assign hz_vw_value = hz_font_size_px | divided_by: 1400.0 | times: 100
          assign hz_min_px = hz_font_size_rem | divided_by: 3.0 | minus: 1 | times: 4 | plus: 48
          echo '--font-size: clamp(' | append: hz_min_px | append: 'px, ' | append: hz_vw_value | append: 'vw, ' | append: hz_font_size_px | append: 'px);'
        else
          echo '--font-size: ' | append: hz_font_size_px | append: 'px;'
        endif
      endif
    -%}
    {% render 'spacing-style', settings: block_settings %}
    {% if block_settings.text_color != blank %}
      --color: {{ block_settings.text_color }};
      --color-rgb: {{ block_settings.text_color.rgb }};
    {% endif %}
    --width: {{ block_settings.width }};
  "
  {{ block.shopify_attributes }}
>
  {% render 'hz-price',
    show_unit_price: true,
    product_resource: product_resource,
    show_sale_price_first: block_settings.show_sale_price_first
  %}

  {% if block_settings.show_tax_info %}
    <div class="tax-note">
      {%- if cart.duties_included and cart.taxes_included -%}
        Duties and taxes included.
      {%- elsif cart.taxes_included -%}
        Taxes included.
      {%- elsif cart.duties_included -%}
        Duties included.
      {%- endif -%}

      {%- if shop.shipping_policy.body != blank -%}
        Shipping calculated at checkout.
      {%- endif -%}
    </div>
  {% endif %}

  {%- if selected_variant != blank and block_settings.show_installments -%}
    <div class="installments">
      {%- assign product_form_installment_id = 'product-form-installment-' | append: block.id -%}
      {%- form 'product', product_resource, id: product_form_installment_id, class: 'payment-terms' -%}
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
        >
        {{ form | payment_terms }}
      {%- endform -%}
    </div>
  {%- endif -%}
</product-price>

<script type="module" src="{{ 'product-price.js' | asset_url }}"></script>

