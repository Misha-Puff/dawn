{%- doc -%}
  Renders an image block.

  @param {string} [loading] - The html loading attribute
  @param {string} [placeholder] - The placeholder image name to use when no image is provided, defaults to 'hero-apparel-2'
  @param {boolean} [decorative_image] - When true, image uses empty alt (decorative) to avoid duplicating adjacent link text for screen readers
{%- enddoc -%}
{%- comment -%}
  horizon-blocks Phase 14 — `_image` private block (collection-links child).

  Port of stock Horizon v4.1.1 (68760d9) blocks/_image.liquid; schema t:
  strings hardcoded to Horizon's English. Deviations:
  - rem→px (Horizon rem = 16px; Dawn rem = 8.5px under 62.5%×body_scale
    root): --image-height-basis 10rem → 160px.

  First emitter of the <image-block> ELEMENT + its element-selector rules.
  Dawn/M&P and the fork's blocks/image.liquid only use the `.image-block`
  CSS CLASS — disjoint selector namespaces; the one shared rule
  (.image-block__placeholder) is byte-identical stock duplication, so the
  theme-wide {% stylesheet %} aggregate stays conflict-free.

  The closest.collection | default: closest.product image sourcing, the
  placeholder names, and the &[ratio=…] variants are kept verbatim.
{%- endcomment -%}

{% assign block_settings = block.settings %}
{% assign image = closest.collection.featured_image | default: closest.product.featured_image %}
{% if decorative_image %}
  {% assign alt = '' %}
{% else %}
  {% assign alt = closest.collection.title | default: closest.product.title %}
{% endif %}

{% liquid
  assign width = '100%'
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560'
%}

{% if image %}
  <image-block
    ratio="{{ block_settings.ratio }}"
    height="{{ block_settings.height }}"
    style="--border-radius: {{ block_settings.border_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {{
      image
      | image_url: width: 2560
      | image_tag: width: width, widths: widths, sizes: sizes, loading: loading, alt: alt
    }}
  </image-block>
{% else %}
  <image-block
    ratio="{{ block_settings.ratio }}"
    height="{{ block_settings.height }}"
    style="--border-radius: {{ block_settings.border_radius }}px;"
    {{ block.shopify_attributes }}
  >
    {{ placeholder | default: 'hero-apparel-2' | placeholder_svg_tag: 'image-block__placeholder' }}
  </image-block>
{% endif %}

{% stylesheet %}
  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  image-block {
    --image-height-basis: 160px; /* 10rem */
    --image-height-small: calc(var(--image-height-basis) * 2);
    --image-height-medium: calc(var(--image-height-basis) * 3);
    --image-height-large: calc(var(--image-height-basis) * 4);

    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: var(--ratio);
    width: 100%;
    max-width: calc(var(--image-height) * var(--ratio));
    height: var(--image-height);
    overflow: hidden;

    @media screen and (min-width: 750px) {
      --image-height-small: calc(var(--image-height-basis) * 2.5);
      --image-height-medium: calc(var(--image-height-basis) * 3.5);
      --image-height-large: calc(var(--image-height-basis) * 4.5);
    }

    @media screen and (max-width: 749px) {
      height: auto;
    }

    &[height='small'] {
      --image-height: var(--image-height-small);
    }

    &[height='medium'] {
      --image-height: var(--image-height-medium);
    }

    &[height='large'] {
      --image-height: var(--image-height-large);
    }

    &[ratio='portrait'] {
      --ratio: 4 / 5;
    }

    &[ratio='square'] {
      --ratio: 1 / 1;

      @media screen and (min-width: 750px) {
        max-width: var(--image-height);
      }
    }

    &[ratio='landscape'] {
      --ratio: 16 / 9;
    }

    img {
      object-fit: cover;
      width: 100%;
      height: auto;
      aspect-ratio: var(--ratio);
      border-radius: var(--border-radius);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays image from parent collection"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "options": [
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
