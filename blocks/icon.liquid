{%- comment -%}
  horizon-blocks Phase 1 — `icon` primitive.

  Ported from stock Horizon v4.1.1 (68760d9) `blocks/icon.liquid`, adapted for Dawn
  only by hardcoding English schema strings (icon-name labels humanized from their
  option values). Renders via icon-or-image -> icon: the full Horizon inline-SVG set
  is ported verbatim in snippets/icon.liquid, keeping every schema icon name valid.
  A merchant image upload overrides the SVG. Known Horizon quirk: caret / bluesky
  are drawn for non-20x20 viewBoxes so they render slightly off (inherited, not new).
{%- endcomment -%}

{% assign block_settings = block.settings %}
{% assign icon_block_class = 'icon-block__media icon-block-' | append: block.id %}

{% if block_settings.icon_color != blank %}
  {% style %}
    .icon-block-{{ block.id }} {
      color: {{ block_settings.icon_color }};
    }
  {% endstyle %}
{% endif %}

{% capture icon %}
  {% render 'icon-or-image',
    icon: block_settings.icon,
    image_upload: block_settings.image_upload,
    width: block_settings.width,
    class_name: icon_block_class,
    attributes: block.shopify_attributes
  %}
{% endcapture %}

{%- if block_settings.link != blank -%}
  <a
    href="{{ block_settings.link }}"
    class="text-inherit"
    {% if block_settings.open_in_new_tab %}
      target="_blank" rel="noopener"
    {% endif %}
  >
    {{ icon }}
  </a>
{%- else -%}
  {{ icon }}
{%- endif -%}

{% stylesheet %}
  .icon-block {
    display: flex;
    flex-shrink: 0;
  }

  .icon-block__media {
    height: auto;
  }

  /* Dawn shim — Horizon defines these utility classes in base.css; Dawn does not.
     Without .icon-default the inline SVG would not honor the icon_color (currentColor). */
  .icon-default {
    fill: currentColor;
  }

  .text-inherit {
    color: inherit;
  }
{% endstylesheet %}

