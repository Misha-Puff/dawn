{%- doc -%}
  Buy-buttons block — the product-form subsystem host: product form (variant
  id + add-to-cart POST), quantity/add-to-cart/accelerated-checkout static
  children, quantity rules, volume pricing, gift-card recipient form, local
  pickup availability + drawer.

  Port of stock Horizon v4.1.1 (68760d9) blocks/buy-buttons.liquid
  (horizon-blocks Phase 13). Deviations:
  - This doc header (stock ships none).
  - Per-render module script tags for hz-product-form.js / theme-drawer.js /
    volume-pricing.js / fly-to-cart.js (deviation from stock's global
    scripts.liquid bundle; slideshow.liquid:91 precedent — browser dedupes).
    component-quantity-selector.js + hz-price-per-item.js ride in via the
    quantity child's quantity-selector snippet; local-pickup.js keeps stock's
    own conditional per-render load (source :257-260, verbatim shape).
    hz-cart-bubble-sync.js is Dawn-glue (serve fix, punchlist §3.4 — see its
    header).
  - hz-product-form.js defines the STOCK-named elements used here
    (product-form-component, add-to-cart-component); only its FILE is renamed
    (Dawn owns assets/product-form.js) — see its deviation header.
  - render 'gift-card-recipient-form' → 'hz-gift-card-recipient-form'
    (snippet renamed; Dawn owns the stock snippet name on its live PDP).
  - Icon repoints: icon-error.svg → hz-icon-error.svg, icon-unavailable.svg →
    hz-icon-unavailable.svg, icon-close.svg → hz-icon-close.svg (Dawn owns
    all three stock names with different artwork); icon-available.svg ships
    stock-named (collision-free).
  - settings.currency_code_enabled_product_pages → Dawn's real
    settings.currency_code_enabled (equivalent-setting mapping precedent;
    Horizon schema default true = M&P live value true).
  - Buyer t: strings hardcoded to Horizon English; interpolated keys inline
    their Liquid values; data-quantity-error-max keeps the literal
    {{ maximum }} placeholder via raw (hz-product-form.js:360 does the
    client-side replace).
  - Schema t: strings hardcoded to Horizon schema-locale English; the
    settings.color_palette.* schema color defaults are static Dawn scheme-1
    values (#ffffff background / #121212 foreground — Phase-10 precedent).
  - The pickup drawer dialog's color-custom-drawer scope is emitted by
    hz-ui-tokens' Phase-13 contrast-override render.
{%- enddoc -%}

<script
  src="{{ 'hz-product-form.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'theme-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'volume-pricing.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'fly-to-cart.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<script
  src="{{ 'hz-cart-bubble-sync.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% render 'theme-drawer-styles' %}
{% liquid
  assign block_settings = block.settings
  assign product = closest.product
  if request.visual_preview_mode and product == blank
    assign product = collections.all.products.first
  endif

  assign variant = closest.product.selected_or_first_available_variant
  assign inventory_quantity = variant.inventory_quantity
  assign inventory_policy = variant.inventory_policy

  if variant.inventory_management == 'shopify'
    assign inventory_managed = true
  endif

  assign can_add_to_cart = false
  assign add_to_cart_text = 'Unavailable'

  if variant
    if variant.quantity_rule.min > variant.inventory_quantity and inventory_managed and inventory_policy == 'deny'
      assign quantity_rule_soldout = true
    endif

    if variant.available
      assign can_add_to_cart = true
      assign add_to_cart_text = 'Add to cart'
    elsif inventory_managed and inventory_quantity <= 0 and inventory_policy == 'deny' or quantity_rule_soldout
      assign can_add_to_cart = false
      assign add_to_cart_text = 'Sold out'
    else
      assign can_add_to_cart = false
      assign add_to_cart_text = 'Unavailable'
    endif
  endif
%}

<span
  class="buy-buttons-block buy-buttons-block--{{ block.id }}"
  {% if block_settings.text_color != blank %}
    style="--color: {{ block_settings.text_color }}; --color-rgb: {{ block_settings.text_color.rgb  }}"
  {% endif %}
  {{ block.shopify_attributes }}
>
  {%- if product != blank -%}
    {%- assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id -%}
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
      data-product-url="{{ product.url }}"
      on:submit="/handleSubmit"
      data-quantity-default="{% if product.selected_or_first_available_variant.quantity_rule.min %}{{ product.selected_or_first_available_variant.quantity_rule.min }}{% else %}1{% endif %}"
      data-quantity-error-max="This item has a maximum of {% raw %}{{ maximum }}{% endraw %}"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', product, id: product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ product.selected_or_first_available_variant.id }}"
        >
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          {%- render 'hz-gift-card-recipient-form', product: product, form: form, section: section, block: block -%}
          <span class="buy-buttons-block__bar">
        {%- endif -%}
        <div
          class="product-form-buttons spacing-style{% if block_settings.stacking %} product-form-buttons--stacked{% endif %}"
          style="{% render 'spacing-style', settings: block_settings %}"
          ref="productFormButtons"
        >
          {%- unless block_settings.gift_card_form and product.gift_card? -%}
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">
                {{- 'hz-icon-error.svg' | inline_asset_content -}}
              </span>
            </span>
          {%- endunless -%}

          {%- liquid
            assign has_quantity_rules = false
            if variant.quantity_rule.min > 1 or variant.quantity_rule.increment > 1 or variant.quantity_rule.max != null
              assign has_quantity_rules = true
            endif
          -%}

          {%- if has_quantity_rules -%}
            {%- assign cart_quantity = cart | item_count_for_variant: variant.id -%}
            <div
              class="quantity-label"
              ref="quantityLabel"
            >
              Quantity
              <span
                class="quantity-label__cart-count{% if cart_quantity == 0 %} hidden{% endif %}"
                ref="quantityLabelCartCount"
                >({{ cart_quantity }}
                in cart)</span
              >
            </div>
          {%- endif -%}

          {% content_for 'block', type: 'quantity', id: 'quantity' %}

          {%- if has_quantity_rules -%}
            <div
              class="quantity-rules"
              ref="quantityRules"
            >
              {%- if variant.quantity_rule.increment > 1 -%}
                <span class="quantity-rules__item">
                  Increments of {{ variant.quantity_rule.increment }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.min > 1 -%}
                <span class="quantity-rules__item">
                  Minimum of {{ variant.quantity_rule.min }}
                </span>
              {%- endif -%}
              {%- if variant.quantity_rule.max != null -%}
                <span class="quantity-rules__item">
                  Maximum of {{ variant.quantity_rule.max }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if product.quantity_price_breaks_configured? and variant.quantity_price_breaks.size > 0 -%}
            {%- liquid
              assign use_currency = settings.currency_code_enabled
            -%}
            <volume-pricing
              class="volume-pricing"
              data-section-id="{{ section.id }}"
              ref="volumePricing"
            >
              <span class="volume-pricing__title">Volume pricing</span>
              <div class="volume-pricing__table">
                <div class="volume-pricing__row volume-pricing__row--even">
                  <span>{{ variant.quantity_rule.min }}+</span>
                  <span>
                    {%- if use_currency -%}
                      {{- variant.price | money_with_currency | strip -}}
                    {%- else -%}
                      {{- variant.price | money | strip -}}
                    {%- endif -%}
                    /{{ 'ea' -}}
                  </span>
                </div>
                {%- for price_break in variant.quantity_price_breaks limit: 2 -%}
                  {%- liquid
                    assign row_index = forloop.index
                    if row_index == 1
                      assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                    else
                      assign row_class = 'volume-pricing__row volume-pricing__row--even'
                    endif
                  -%}
                  <div class="{{ row_class }}">
                    <span>{{ price_break.minimum_quantity }}+</span>
                    <span>
                      {%- if use_currency -%}
                        {{- price_break.price | money_with_currency | strip -}}
                      {%- else -%}
                        {{- price_break.price | money | strip -}}
                      {%- endif -%}
                      /{{ 'ea' -}}
                    </span>
                  </div>
                {%- endfor -%}

                {%- if variant.quantity_price_breaks.size > 2 -%}
                  <div class="volume-pricing__collapsible-wrapper">
                    {%- for price_break in variant.quantity_price_breaks offset: 2 -%}
                      {%- liquid
                        assign collapsed_index = forloop.index
                        assign total_index = collapsed_index | plus: 2
                        assign modulo_result = total_index | modulo: 2
                        if modulo_result == 1
                          assign row_class = 'volume-pricing__row volume-pricing__row--odd'
                        else
                          assign row_class = 'volume-pricing__row volume-pricing__row--even'
                        endif
                      -%}
                      <div class="{{ row_class }}">
                        <span>{{ price_break.minimum_quantity }}+</span>
                        <span>
                          {%- if use_currency -%}
                            {{- price_break.price | money_with_currency | strip -}}
                          {%- else -%}
                            {{- price_break.price | money | strip -}}
                          {%- endif -%}
                          /{{ 'ea' -}}
                        </span>
                      </div>
                    {%- endfor -%}
                  </div>

                  <button
                    type="button"
                    class="volume-pricing__toggle button-unstyled"
                    ref="volumePricingToggle"
                    on:click="/toggleExpanded"
                  >
                    <span class="volume-pricing__toggle-text">
                      <span class="volume-pricing__show-more">+ Show more</span>
                      <span class="volume-pricing__show-less">- Show less</span>
                    </span>
                  </button>
                {%- endif -%}
              </div>
            </volume-pricing>
          {%- endif -%}
          {% content_for 'block',
            type: 'add-to-cart',
            id: 'add-to-cart',
            can_add_to_cart: can_add_to_cart,
            add_to_cart_text: add_to_cart_text
          %}

          {% content_for 'block',
            type: 'accelerated-checkout',
            id: 'accelerated-checkout',
            can_add_to_cart: can_add_to_cart,
            form_obj: form
          %}
        </div>
        {%- if block_settings.gift_card_form and product.gift_card? -%}
          </span>
        {%- endif -%}
      {%- endform -%}
    </product-form-component>
  {%- else -%}
    <div class="product-form-buttons">
      <button
        type="submit"
        name="add"
        class="button"
        disabled
      >
        Sold out
      </button>
    </div>
  {%- endif -%}
</span>

{% if block_settings.show_pickup_availability %}
  <script
    src="{{ 'local-pickup.js' | asset_url }}"
    type="module"
  ></script>

  {%- assign pick_up_availabilities = closest.product.selected_or_first_available_variant.store_availabilities
    | where: 'pick_up_enabled', true
  -%}

  <local-pickup
    class="spacing-style product__pickup-availabilities"
    {% if pick_up_availabilities.size == 0 %}
      hidden
    {% endif %}
    data-section-id="{{ section.id }}"
    data-product-url="{{ closest.product.url }}"
    data-variant-id="{{ closest.product.selected_or_first_available_variant.id }}"
    style="
      {% render 'spacing-style', settings: block_settings %}
      {% if block_settings.text_color != blank %}
        --color: {{ block_settings.text_color }};
        --color-rgb: {{ block_settings.text_color.rgb }}
      {% endif %}
    "
    ref="localPickupButton"
  >
    {% if can_add_to_cart %}
      <div class="pickup-availability__row">
        <div class="pickup-availability__column">
          <span class="svg-wrapper">
            {% if pick_up_availabilities.first.available %}
              {{- 'icon-available.svg' | inline_asset_content -}}
            {% else %}
              {{- 'hz-icon-unavailable.svg' | inline_asset_content -}}
            {% endif %}
          </span>
        </div>
        <div class="pickup-availability__column">
          {% if pick_up_availabilities.first.available %}
            <p class="pickup-location__text-sm">
              Pickup available at <b>{{ pick_up_availabilities.first.location.name }}</b>
            </p>
            <p class="pickup-location__text-xs">
              {{ pick_up_availabilities.first.pick_up_time }}
            </p>
          {% else %}
            <p class="pickup-location__text-sm">
              Pickup currently not available
            </p>
          {% endif %}
          <button
            on:click="#pickup-drawer-{{ block.id }}/toggle"
            class="button-unstyled pickup-location__button"
          >
            View store information
          </button>
        </div>
      </div>
    {% endif %}
  </local-pickup>

  {% if can_add_to_cart %}
    <theme-drawer
      id="pickup-drawer-{{ block.id }}"
      class="pickup-drawer"
      data-skip-node-update
      no-persist
    >
      <dialog
        ref="panel"
        class="theme-drawer__dialog color-custom-drawer"
        aria-labelledby="pickup-dialog-heading-{{ block.id }}"
        data-testid="pickup-location-dialog"
      >
        <h2
          id="pickup-dialog-heading-{{ block.id }}"
          class="visually-hidden"
        >
          View store information
        </h2>
        <div class="theme-drawer__header pickup-availability__header-container">
          <div class="pickup-availability__column">
            <h4 class="pickup-location__h4">{{ closest.product.title }}</h4>
            {% unless closest.product.has_only_default_variant %}
              <p class="pickup-location__text-sm">
                {{ closest.product.selected_or_first_available_variant.title }}
              </p>
            {% endunless %}
          </div>
          <button
            on:click="#pickup-drawer-{{ block.id }}/close"
            class="theme-drawer__close-button"
            type="button"
            aria-label="Close"
          >
            <span class="svg-wrapper">
              {{- 'hz-icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>
        {% for pick_up_availability in pick_up_availabilities %}
          <div class="pickup-location__wrapper">
            <p class="pickup-location__text-bold">{{ pick_up_availability.location.name }}</p>
            <div class="pickup-location__address-wrapper">
              <span class="pickup-location__availability-wrapper">
                {% if pick_up_availability.available %}
                  {{- 'icon-available.svg' | inline_asset_content -}}
                  {% assign pickup_time = pick_up_availability.pick_up_time | downcase %}
                  Pickup available, {{ pickup_time }}
                {% else %}
                  {{- 'hz-icon-unavailable.svg' | inline_asset_content -}}
                  Pickup currently not available
                {% endif %}
              </span>
              <address class="pickup-location__address">
                {{ pick_up_availability.location.address | format_address }}
                {{ pick_up_availability.location.address.phone }}
              </address>
            </div>
          </div>
        {% endfor %}
      </dialog>
    </theme-drawer>
  {% endif %}
{% endif %}

{% render 'buy-buttons-styles' %}

{% schema %}
{
  "name": "Buy buttons",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "stacking",
      "label": "Always stack buttons",
      "default": false
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Local pickup"
    },
    {
      "type": "checkbox",
      "id": "show_pickup_availability",
      "label": "Show pickup availability",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Show nearby pickup locations when online store local pickup is set up. [Learn more](https://help.shopify.com/en/manual/fulfillment/setup/delivery-methods/pickup-in-store)"
    },
    {
      "type": "header",
      "content": "Gift card products"
    },
    {
      "type": "checkbox",
      "id": "gift_card_form",
      "label": "Gift card form",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "Customers can send gift cards to a recipient's email with a personal message. [Learn more](https://help.shopify.com/manual/products/gift-card-products)"
    },
    {
      "type": "select",
      "id": "recipient_button_style",
      "label": "Button style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.gift_card_form }}"
    },
    {
      "type": "color",
      "id": "recipient_button_background",
      "label": "Background",
      "default": "#ffffff",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.recipient_button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "recipient_button_text",
      "label": "Text",
      "default": "#121212",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.recipient_button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "recipient_button_border",
      "label": "Borders",
      "default": "#121212",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.recipient_button_style == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "selected_recipient_button_style",
      "label": "Selected button style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "default",
      "visible_if": "{{ block.settings.gift_card_form }}"
    },
    {
      "type": "color",
      "id": "selected_recipient_button_background",
      "label": "Background",
      "default": "#121212",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.selected_recipient_button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "selected_recipient_button_text",
      "label": "Text",
      "default": "#ffffff",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.selected_recipient_button_style == \"custom\" }}"
    },
    {
      "type": "color",
      "id": "selected_recipient_button_border",
      "label": "Borders",
      "default": "#121212",
      "alpha": true,
      "visible_if": "{{ block.settings.gift_card_form and block.settings.selected_recipient_button_style == \"custom\" }}"
    },
    {
      "type": "select",
      "id": "input_style",
      "label": "Input style",
