{%- comment -%}
  horizon-blocks Phase 10 — `swatches` block.

  Port of stock Horizon v4.1.1 (68760d9) blocks/swatches.liquid;
  schema t: strings hardcoded to Horizon's English. <product-swatches> is an
  undefined styling container in stock too (no JS contract); the rendered
  variant-swatches snippet is the Phase-10 port. The stock path is near-inert
  on M&P data: option_value.swatch is null store-wide (no color-pattern
  metafield mapping), so swatch_count stays 0.

  Phase-11 M&P bridge deviation: when NO option has native swatches and
  sibling_swatches is on, the block falls back to the style_siblings recipe
  (snippets/hz-sibling-swatches.liquid — colorways are separate products on
  M&P; see that file's header). The stock path stays verbatim and wins
  whenever native swatch data ever appears. The alignment/padding settings
  feed both paths (the fallback consumes them as --hz-ss-* vars). NOT in any
  default card preset — live Dawn featured-collection cards show no swatches
  (replace-posture parity); merchants opt in per instance.
{%- endcomment -%}
{%- liquid
  assign block_settings = block.settings
  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size

    if swatch_count > 0
      assign product_has_swatches = true
    endif
  endfor
-%}

{% stylesheet %}
  product-swatches {
    width: 100%;
    display: flex;
    position: relative;
    overflow: hidden;
    gap: 0;
    flex-shrink: 0;
  }
{% endstylesheet %}

{% if product_has_swatches %}
  <product-swatches
    data-product-id="{{ closest.product.id }}"
    data-product-url="{{ closest.product.url }}"
    style="
      --overflow-list-alignment: {{ block_settings.product_swatches_alignment }};
      --overflow-list-alignment-mobile: {{ block_settings.product_swatches_alignment_mobile }};
      --product-swatches-alignment: {% if block_settings.product_swatches_alignment == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-alignment-mobile: {% if block_settings.product_swatches_alignment_mobile == 'flex-start' %}start{% elsif block_settings.product_swatches_alignment_mobile == 'flex-end' %}end{% else %}center{% endif %};
      --product-swatches-padding-block-start: {{ block_settings.product_swatches_padding_top }}px;
      --product-swatches-padding-block-end: {{ block_settings.product_swatches_padding_bottom }}px;
      --product-swatches-padding-inline-start: {{ block_settings.product_swatches_padding_left }}px;
      --product-swatches-padding-inline-end: {{ block_settings.product_swatches_padding_right }}px;
    "
    {{ block.shopify_attributes }}
  >
    {% render 'variant-swatches', product_resource: closest.product %}
  </product-swatches>
{% elsif block_settings.sibling_swatches %}
  {%- capture hz_sibling_wrapper_style -%}
    --hz-ss-justify: {{ block_settings.product_swatches_alignment }};
    --hz-ss-justify-mobile: {{ block_settings.product_swatches_alignment_mobile }};
    --hz-ss-pbs: {{ block_settings.product_swatches_padding_top }}px;
    --hz-ss-pbe: {{ block_settings.product_swatches_padding_bottom }}px;
    --hz-ss-pis: {{ block_settings.product_swatches_padding_left }}px;
    --hz-ss-pie: {{ block_settings.product_swatches_padding_right }}px;
  {%- endcapture -%}
  {% render 'hz-sibling-swatches',
    product: closest.product,
    max: block_settings.max_swatches,
    wrapper_style: hz_sibling_wrapper_style,
    attributes: block.shopify_attributes
  %}
{% endif %}

{% schema %}
{
  "name": "Swatches",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays swatches from parent product"
    },
    {
      "type": "checkbox",
      "id": "sibling_swatches",
      "label": "Sibling colorway swatches",
      "info": "When the product has no native option swatches, shows its style-sibling colorways (product_page.style_siblings)",
      "default": true
    },
    {
      "type": "range",
      "id": "max_swatches",
      "label": "Max sibling swatches",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 3,
      "visible_if": "{{ block.settings.sibling_swatches }}"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "product_swatches_alignment_mobile",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "header",
      "content": "Padding",
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "checkbox",
      "id": "hide_padding",
      "label": "Hide padding",
      "default": false,
      "visible_if": "{{ false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_top",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 4,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_bottom",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_left",
      "label": "Left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    },
    {
      "type": "range",
      "id": "product_swatches_padding_right",
      "label": "Right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0,
      "visible_if": "{{ block.settings.hide_padding == false }}"
    }
  ],
  "presets": [
    {
      "name": "Swatches",
      "category": "Product"
    }
  ]
}
{% endschema %}
