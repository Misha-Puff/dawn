{%- doc -%}
  Renders a collection link block.

  @param {number} index
  @param {boolean} [current]
  @param {boolean} [image_only]
{%- enddoc -%}
{%- comment -%}
  horizon-blocks Phase 14 — `_collection-link` private block (the
  collection-links host's static child; renders the link text via
  _inline-collection-title and the spotlight/reveal image via _image).

  Port of stock Horizon v4.1.1 (68760d9) blocks/_collection-link.liquid;
  schema t: strings hardcoded to Horizon's English. Deviations:
  - rem→px (Horizon rem = 16px): the [reveal] image's
    --image-height-basis 5rem → 80px. font-size: 0.5em (count superscript)
    is element-relative and stays verbatim.

  Kept verbatim + ledgered:
  - STOCK QUIRK: line ~49 reads section.settings.image_height, a setting
    that does not exist on the collection-links section — renders size=""
    on the spotlight image link. Stock behavior, kept.
  - The on:pointerenter/on:focus="/select/{{ index }}" bindings — index
    alignment with refs.images[]/slide positions is load-bearing; the host
    passes a gate-surviving counter as `index`.
  - The collection-links-component / .collection-links__* stylesheet —
    aggregate-audited clean vs Dawn/M&P (element + class families absent).
  Token deps --font-size--4xl/-5xl/-6xl, --disabled-opacity,
  --font-paragraph--weight, --layer-temporary all defined (hz-ui-tokens
  Phase 14 / hz-type-variables).
{%- endcomment -%}

{% unless current %}
  {% assign loading = 'lazy' %}
{% endunless %}

{% liquid
  assign onboarding = false
  if closest.collection == empty
    assign onboarding = true
  endif
%}

{% if block.settings.show_count %}
  {% assign count = closest.collection.all_products_count %}
  {%- capture count -%}
    &nbsp;<sup class="collection-links__count">{{ count }}</sup>
  {%- endcapture -%}

  {% if onboarding %}
    {%- capture count -%}
      &nbsp;<sup class="collection-links__count">5</sup>
    {%- endcapture -%}
  {% endif %}
{% endif %}

{% capture title_block %}
  {% content_for 'block', type: '_inline-collection-title', id: 'title', suffix: count %}
{% endcapture %}

{% capture image_block %}
  {%- liquid
    assign placeholder_variant = index | modulo: 4 | plus: 1
    assign placeholder_name = 'collection-apparel-' | append: placeholder_variant
  -%}
  {% content_for 'block', type: '_image', id: 'image', loading: loading, placeholder: placeholder_name, decorative_image: true %}
{% endcapture %}

{% if image_only %}
  <a
    href="{{ closest.collection.url }}"
    class="collection-links__image"
    size="{{ section.settings.image_height }}"
    tabindex="-1"
    aria-hidden="true"
    {% if onboarding %}
      data-placeholder="true"
    {% endif %}
  >
    {{ image_block }}
  </a>
{% else %}
  <a
    href="{{ closest.collection.url }}"
    class="collection-links__link"
    ref="links[]"
    on:pointerenter="/select/{{ index }}"
    on:focus="/select/{{ index }}"
    {% if section.settings.layout == 'text' %}
      on:pointerleave="/clearSelections"
      on:blur="/clearSelections"
    {% endif %}
    aria-current="{{ current }}"
    {% if onboarding %}
      data-placeholder="true"
    {% endif %}
    {{ block.shopify_attributes }}
  >
    {{ title_block }}

    {% if section.settings.layout == 'text' %}
      <div
        class="collection-links__image"
        ref="images[]"
        hidden
      >
        {{ image_block }}
      </div>
    {% endif %}
  </a>
{% endif %}

{% stylesheet %}
  .collection-links__link {
    --min-font-size: var(--font-size--4xl);
    --max-font-size: var(--font-size--6xl);

    display: flex;
    color: inherit;
    text-decoration: none;
    text-wrap: pretty;
    font-size: clamp(var(--min-font-size), 4.5vw, var(--max-font-size));

    /* When hovering over container, dim non-current links (text layout only) */
    @media (hover: hover) {
      collection-links-component:not([layout='spotlight']) .collection-links__container:hover & {
        opacity: var(--opacity-subdued-text);
      }

      collection-links-component:not([layout='spotlight']) .collection-links__container:hover &[aria-current='true'] {
        opacity: 1;
      }
    }

    [layout='spotlight'] & {
      /* Spotlight layout: dimmed by default */
      opacity: var(--disabled-opacity);

      &[aria-current='true'] {
        opacity: 1;
      }
    }

    .text-block {
      display: inline-block;
    }

    @media screen and (max-width: 749px) {
      --min-font-size: var(--font-size--3xl);
      --max-font-size: var(--font-size--5xl);

      [layout='spotlight'] & {
        white-space: normal;
        scroll-snap-align: start;
        text-wrap: pretty;

        span {
          text-wrap: pretty;
        }
      }
    }
  }

  .collection-links__count {
    font-size: 0.5em;
    opacity: var(--disabled-opacity);
    font-weight: var(--font-paragraph--weight);
  }

  .collection-links__image {
    align-items: center;
    justify-content: center;

    &:not([hidden]) {
      display: flex;
    }

    &[reveal] {
      --offset: 15px;

      position: fixed;
      top: 0;
      left: 0;
      z-index: var(--layer-temporary);
      display: block;
      translate: calc(var(--x) + var(--offset)) calc(var(--y) + var(--offset));
      pointer-events: none;
      width: auto;

      image-block {
        --image-height-basis: 80px; /* 5rem */

        height: var(--image-height);
      }
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays collection from parent section"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show count",
      "default": true
    }
  ]
}
{% endschema %}
