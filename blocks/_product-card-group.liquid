{%- comment -%}
  horizon-blocks Phase 10 — `_product-card-group` private block.

  Port of stock Horizon v4.1.1 (68760d9) blocks/_product-card-group.liquid
  (renders the Phase-1 group snippet — settings/shopify_attributes contract
  verified); schema t: strings hardcoded to Horizon's English. Deviation:
  TRIMMED allowlist entries "review" and "sku" (PDP-phase items not yet
  ported — upload-time validation rejects unknown types); RE-ADD each
  alongside its port.
{%- endcomment -%}
{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% render 'group', children: children, settings: block.settings, shopify_attributes: block.shopify_attributes %}

{% schema %}
{
