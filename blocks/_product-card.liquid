{%- doc -%}
  @param {string} [product_view_context] - Context value passed through to the card snippet.

  horizon-blocks Phase 10 port of stock Horizon v4.1.1 (68760d9)
  blocks/_product-card.liquid; schema t: strings hardcoded to Horizon's
  English. Quick-add seam closed Phase 13. Deviations:
  - Two of the four Phase-10-trimmed style renders (stock :14-17) are
    RESTORED (buy-buttons-styles / gift-card-recipient-form-styles — stock
    position, still the PDP-track vocabulary). quick-add-styles /
    quick-add-modal-styles stay OUT (round 3, Nathan ruling 2026-07-07:
    quick-add on M&P card surfaces is DAWN-NATIVE — see
    snippets/hz-card-quick-add — and Horizon's .quick-add CSS collides with
    Dawn's .quick-add class). RE-ADD only with a Horizon-modal re-wire.
  - "buy-buttons" allowlist entry RESTORED (stock position, between image
    and price). "review" and "sku" stay TRIMMED (PDP items not yet ported —
    upload-time validation rejects unknown types); RE-ADD each alongside
    its port.
  - No quick_add / mobile_quick_add threading into the card snippet (the
    round-2 shape, removed): Dawn's trigger is server-side gated at the
    gallery (blocks/_product-card-gallery reads section.settings.quick_add)
    and always visible at both breakpoints — the snippet's --quick-add-*
    vars went with it.
{%- enddoc -%}

{% liquid
  assign product = closest.product
-%}

{% capture children %}
  {% content_for 'blocks', closest.product: product %}
{% endcapture %}

{% render 'product-card',
  children: children,
  product: product,
  product_view_context: product_view_context
%}
{% render 'buy-buttons-styles' %}
{% render 'gift-card-recipient-form-styles' %}
{% comment %} Stock :16-17 quick-add style renders REMOVED (round 3 — the
  Horizon .quick-add CSS collides with Dawn's .quick-add class; see header).
  RE-ADD only with a Horizon-modal re-wire. {% endcomment %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}

{% schema %}
{
  "name": "Product card",
  "blocks": [
    {
      "type": "_product-card-group"
    },
    {
      "type": "text"
    },
    {
      "type": "image"
    },
    {
      "type": "buy-buttons"
    },
    {
      "type": "price"
    },
    {
      "type": "swatches"
    },
    {
      "type": "_variant-availability"
    },
    {
      "type": "_product-card-gallery"
    },
    {
      "type": "product-title"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays product from parent section"
    },
    {
      "type": "range",
      "id": "product_card_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "Style",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Color",
      "placeholder": "Default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
