{%- comment -%}
  horizon-blocks Phase 12 — `product-recommendations` block.

  Port of stock Horizon v4.1.1 (68760d9) blocks/product-recommendations.liquid;
  schema/preset t: strings hardcoded to Horizon's English. The block TYPE keeps
  the stock name (23 chars — an hz- prefix would break the 25-char serve-time
  block-type cap); only the CUSTOM ELEMENT is renamed. Deviations:
  - The custom element is RENAMED <hz-product-recommendations> (open/close
    tags, stock :36/:179) — Dawn's assets/global.js:1177 owns the stock
    <product-recommendations> tag. Defined by the adapted
    assets/product-recommendations.js (patched copy; its doc-header has the
    full story). The stylesheet's :has(product-recommendations[...]) TAG
    selector is retargeted in lockstep. Class names / ids / hydration keys
    keep stock "product-recommendations" strings — tag-independent.
  - Phase 13 (quick-add seam closed; round 3 = DAWN-NATIVE, Nathan ruling
    2026-07-07): stock's quick-add-styles + quick-add-modal-styles renders
    (:31-32) stay OUT — quick-add on M&P card surfaces is Dawn's own
    machinery (snippets/hz-card-quick-add via _product-card-gallery, gated
    on section.settings.quick_add), and Horizon's .quick-add CSS collides
    with Dawn's .quick-add class. This block's cards render quick-add only
    when the HOST section's quick_add setting is on (the block itself has
    no such setting — a follow-up if ever wanted); the Dawn assets load
    from the gated hosts. RE-ADD the style renders only with a
    Horizon-modal re-wire.
  - LOCKSMITH GATE in the recommendations loop (M&P "Locksmith at call
    sites" contract; hz-product-recommendations/hz-product-list pattern),
    nil-safe for onboarding placeholders; with it the PREFIX-style
    <!--@list/split--> marker restructure (stock's suffix marker lets a
    gated skip leave an empty carousel slide; the marker stays wrapped in
    stock's carousel-only condition) and carousel slide_count switched from
    stock's recommendations.products.size to the POST-gate slides.size.
  - rem→px @16 (Dawn root is 62.5%×body_scale): stock :63
    minmax(9.25rem, 1fr) → minmax(148px, 1fr).
  - The stylesheet gains the recs-specific base.css:3795-3813 extraction
    (same two adaptations as the hz-product-recommendations host: rgb()
    triplet wrap for --color-foreground; --skeleton-opacity 0.025 carried
    as var() fallback) so the block is self-sufficient in any @theme host.
  - The skeleton aria-label hardcodes Horizon's English
    (accessibility.loading_product_recommendations — key absent from Dawn's
    locale files).
  - Preset static-product-card subtree mirrors the Phase-11 M&P tuning
    (badges child under gallery, color_suffix + #000 title, title/price
    custom 0.75rem — hz-product-list preset precedent) so recs cards
    default to the live M&P look; preset frame stays stock.
{%- endcomment -%}
{%- doc -%}
  Renders product recommendations.
  {section.id} - identifies the parent section for the Section Rendering API

  https://shopify.dev/docs/api/section-rendering-api
{%- enddoc -%}

<script
  src="{{ 'product-recommendations.js' | asset_url }}"
  type="module"
></script>

{% liquid
  assign block_settings = block.settings
  case block_settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list--carousel'
  endcase

  if block_settings.background_color != blank
    render 'contrast-override', background_color: block_settings.background_color, section_id: block.id
  endif
%}

{% comment %}
  [data-section-id] {section.id} - used to fetch the product recommendations from the Section Rendering API
{% endcomment %}

{% comment %} Stock :31-32 quick-add style renders REMOVED (round 3 — the
  Horizon .quick-add CSS collides with Dawn's .quick-add class; see header).
  RE-ADD only with a Horizon-modal re-wire. {% endcomment %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
<hz-product-recommendations
  id="product-recommendations-{{ block.id }}"
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ block_settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ closest.product.id }}"
  data-intent="{{ block_settings.recommendation_type }}"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ block.id }}"
  {% if request.visual_preview_mode %}
    data-shopify-editor-preview
  {% endif %}
  data-testid="product-recommendations-block"
  {{ block.shopify_attributes }}
>
  <div
    class="
      {% if block_settings.background_color != blank %}color-custom-{{ block.id }}{% endif %}
      block-resource-list
      spacing-style
      gap-style
    "
    style="
      {%  render 'spacing-style', settings: block_settings %}
      {%  render 'gap-style', value: block_settings.gap %}
      --resource-list-column-gap-desktop: {{ block_settings.columns_gap }}px;
      --resource-list-row-gap-desktop: {{ block_settings.rows_gap }}px;
      --resource-list-columns-mobile: repeat(auto-fill, minmax(148px, 1fr));
      --border-radius: {{ block_settings.border_radius }}px;
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {%- if recommendations.performed or closest.product == blank -%}
      {% liquid
        assign products = recommendations.products

        if closest.product == blank
          # Onboarding mode: Show placeholder products
          for i in (1..block_settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          # No recommendations found, pull from catalog
          if block_settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', closest.product.id
          elsif block_settings.recommendation_type == 'complementary'
            # Do not recommend the All collection as complementary products
            assign products = null
          endif
        else
          assign products = recommendations.products
        endif
      %}
      {% comment %}
        theme-check-disable UniqueStaticBlockId — the repeated
        static-product-card id is stock Horizon's own pattern (one static
        block definition, re-rendered per product). Upload validation
        accepts it; the lint rule doesn't model loops.
      {% endcomment %}
      {% comment %}theme-check-disable UniqueStaticBlockId{% endcomment %}
      {% capture list_items %}
        {% assign hz_rendered_count = 0 %}
        {% for product in products limit: block_settings.max_products %}
          {% comment %}
            Phase-12 LOCKSMITH GATE (leak prevention) — locked products
            must not surface in recommendations for sessions that fail the
            lock. Nil-safe in onboarding mode (blank placeholder product →
            'false'). Gated products still consume loop slots.
          {% endcomment %}
          {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
          {% assign lock_content = lock_content | strip %}
          {% if lock_content == 'true' %}
            {% continue %}
          {% endif %}
          {% comment %}
            Dawn deviation from stock's `unless forloop.last` suffix marker:
            emitted BEFORE every rendered item except the first (still only
            in the carousel modes, as stock), so a gated skip can't leave a
            trailing marker → empty carousel slide.
          {% endcomment %}
          {% if block_settings.layout_type == 'carousel' or block_settings.carousel_on_mobile %}
            {% if hz_rendered_count > 0 %}<!--@list/split-->{% endif %}
          {% endif %}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product
            %}
          </div>
          {% assign hz_rendered_count = hz_rendered_count | plus: 1 %}
        {% endfor %}
      {% endcapture %}
      {% comment %}theme-check-enable UniqueStaticBlockId{% endcomment %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'

        if products != blank and products.size > 0
          assign has_recommendations = 'true'
        else
          assign has_recommendations = 'false'
        endif
      %}

      <div
        class="
          resource-list
          {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
            hidden--mobile
          {% endif %}
          {{ classes }}
        "
        {% if block_settings.layout_type == 'grid' %}
          data-testid="resource-list-grid"
        {% endif %}
        data-has-recommendations="{{ has_recommendations }}"
      >
        {% case block_settings.layout_type %}
          {% when 'grid' %}
            {{ list_items }}
          {% when 'carousel' %}
            {% comment %}
              slide_count deviates from stock's recommendations.products.size:
              the post-gate slides.size keeps carousel controls tracking the
              rendered count (stock would overcount Locksmith-gated items).
            {% endcomment %}
            {% render 'resource-list-carousel',
              ref: 'resourceListCarousel',
              slides: slides,
              slide_count: slides.size,
              settings: block_settings
            %}
        {% endcase %}
      </div>

      {% if block_settings.carousel_on_mobile and block_settings.layout_type != 'carousel' %}
        {% liquid
          assign mobile_carousel_gap = block_settings.columns_gap
        %}
        <div
          class="
            resource-list
            hidden--desktop
            force-full-width
          "
          style="--resource-list-gap: {{ mobile_carousel_gap }}px;"
        >
          {% render 'resource-list-carousel',
            ref: 'resourceListCarouselMobile',
            slides: slides,
            slide_count: slides.size,
            settings: block_settings
          %}
        </div>
      {% endif %}
    {%- else -%}
      <div class="resource-list resource-list--grid">
        {% for i in (1..block_settings.max_products) %}
          <div
            class="resource-list__item product-recommendations__skeleton-item"
            aria-label="Loading product recommendations"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</hz-product-recommendations>

{% stylesheet %}
  .block-resource-list {
    display: flex;
    flex-direction: column;
    row-gap: var(--gap);
    min-width: 0;
    min-height: 0;
    container-type: inline-size;
    container-name: resource-list;
    border-radius: var(--border-radius, 0);
  }

  .product-recommendations-wrapper {
    width: 100%;
  }

  /* TAG selector retargeted to the renamed element (see doc-header). */
  .product-recommendations-wrapper:has(hz-product-recommendations[data-shopify-editor-preview]) {
    width: 100vw;
  }

  /* Horizon base.css:3795-3813 extraction (recs-specific) so the block is
     self-sufficient in any @theme host, verbatim except two documented Dawn
     adaptations: (1) stock's `background-color: var(--color-foreground)`
     expects Horizon's FULL-COLOR var — in this port --color-foreground is a
     Dawn comma triplet, so it's wrapped in rgb(); (2) --skeleton-opacity
     lives in Horizon's theme-styles-variables.liquid:639 (not ported) — its
     value (0.025) is carried as the var() fallback. The hide rule is a TAG
     selector: retargeted to the renamed element. */
  .product-recommendations {
    display: block;
  }

  .product-recommendations__skeleton-item {
    aspect-ratio: 3 / 4;
    background-color: rgb(var(--color-foreground));
    opacity: var(--skeleton-opacity, 0.025);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__skeleton-item:nth-child(2n + 1) {
      display: none;
    }
  }

  hz-product-recommendations:has([data-has-recommendations='false']) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recommended products",
  "class": "product-recommendations-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays recommendations based on parent product"
    },
    {
      "type": "select",
      "id": "recommendation_type",
      "label": "Type",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related"
    },
    {
      "type": "paragraph",
      "content": "Complementary products must be set up using the Search & Discovery app. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery)"
    },
    {
      "type": "header",
      "content": "Cards layout"
    },
    {
      "type": "select",
      "id": "layout_type",
      "label": "Style",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "carousel",
          "label": "Carousel"
        }
      ],
      "default": "grid"
    },
    {
      "type": "checkbox",
      "id": "carousel_on_mobile",
      "label": "Carousel on mobile",
      "default": true,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Product count",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_gap",
      "label": "Horizontal gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' or block.settings.layout_type == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "rows_gap",
      "label": "Vertical gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ block.settings.layout_type == 'grid' }}"
    },
    {
      "type": "header",
      "content": "Carousel navigation",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_style",
      "label": "Icon",
      "options": [
        {
          "value": "arrow",
          "label": "Arrows"
        },
        {
          "value": "chevron",
          "label": "Chevrons"
        },
        {
          "value": "arrows_large",
          "label": "Large arrows"
        },
        {
          "value": "chevron_large",
          "label": "Large chevrons"
        },
        {
          "value": "none",
          "label": "None"
        }
      ],
      "default": "arrow",
      "visible_if": "{{ block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "select",
      "id": "icons_shape",
      "label": "Icon background",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "none",
      "visible_if": "{{ block.settings.icons_style != 'none' and block.settings.layout_type == 'carousel' or block.settings.carousel_on_mobile == true }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "placeholder": "Default"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "Left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "Right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Recommended products",
      "category": "Product",
      "settings": {
        "recommendation_type": "related",
        "border_radius": 0,
        "padding-inline-start": 0,
        "padding-inline-end": 0
      },
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "<h2>You may also like</h2>"
          }
        },
        "static-product-card": {
          "type": "_product-card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product-card-gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {
                "badges": {
                  "type": "_product-badges"
                }
              },
              "block_order": ["badges"]
            },
            "product_title": {
              "type": "product-title",
              "name": "Product title",
              "settings": {
                "color_suffix": true,
                "text_color": "#000000",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "0.75rem",
                "line_height": "loose",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "name": "Price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "custom",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "0.75rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": ["product-card-gallery", "product_title", "price"]
        }
      },
      "block_order": ["heading"]
    }
  ]
}
{% endschema %}
