{%- comment -%}
  horizon-blocks Phase 4 — port of stock Horizon v4.1.1 (68760d9)
  blocks/_accordion-row.liquid. Liquid body verbatim except the two inlined
  icon assets are repointed: Dawn owns the `icon-caret.svg` / `icon-plus.svg`
  FILENAMES with different art (fill-based; Horizon's are stroke-based via
  --icon-stroke-width), so this block inlines `hz-icon-caret.svg` (added in
  Phase 3, byte-identical to Horizon's icon-caret.svg) and `hz-icon-plus.svg`
  (this phase). The `icon-caret` / `icon-plus` CLASS names stay verbatim —
  the parent accordion's caret/plus visibility toggle and the open-state
  animations key off them. Schema verbatim (the 59-icon select resolves
  against the Phase-1 byte-identical snippets/icon.liquid) with t: strings
  hardcoded.
{%- endcomment -%}
{% assign block_settings = block.settings %}

{% capture accordion_row_children %}
  <details
    class="details"
    data-testid="accordion-details"
    {% if block_settings.open_by_default %}
      open
    {% endif %}
    {{ block.shopify_attributes }}
  >
    <summary class="details__header">
      {% render 'icon-or-image',
        icon: block_settings.icon,
        image_upload: block_settings.image_upload,
        width: block_settings.width,
        class_name: 'details__icon'
      %}
      {{ block_settings.heading }}
      <span class="svg-wrapper icon-caret icon-animated">
        {{- 'hz-icon-caret.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper icon-plus">
        {{- 'hz-icon-plus.svg' | inline_asset_content -}}
      </span>
    </summary>

    <div class="details-content">
      {% content_for 'blocks' %}
    </div>
  </details>
{% endcapture %}
{% render 'accordion-custom-component',
  children: accordion_row_children,
  open_by_default_on_desktop: block_settings.open_by_default,
  open_by_default_on_mobile: block_settings.open_by_default
%}

