{% comment %}
  Optional style params (passed by the host section; output is byte-identical
  when bc_custom is falsy):
  - bc_custom: {Boolean} enable the overrides below
  - bc_size: {Number} font size px (0 = keep the 1.3rem default)
  - bc_ls: {Number} letter spacing px (0 = default)
  - bc_color: {Color/String} text color (blank = inherit)
  - bc_margin_top / bc_margin_bottom: {Number} margins px
{% endcomment %}
{%- liquid
  assign bc_size = bc_size | default: 0
  assign bc_ls = bc_ls | default: 0
  assign bc_mt = bc_margin_top | default: 0
  assign bc_mb = bc_margin_bottom | default: 24
-%}
<style>
  .breadcrumbs {
    margin: 0 0 2em;
  }

  .breadcrumbs__list {
    list-style-type: none;
    margin: 0;
    padding: 0;
    font-size: 1.3rem;
    text-transform: uppercase;
  }

  .breadcrumbs__item {
    display: inline-block;
  }

  .breadcrumbs__link {
    color: inherit;
    font-weight: normal;
    text-decoration: none;
  }

  .breadcrumbs__link:hover,
  .breadcrumbs__link:focus {
    text-decoration: underline;
  }

  {%- if bc_custom %}
  .breadcrumbs {
    margin: {{ bc_mt }}px 0 {{ bc_mb }}px;
  }

  .breadcrumbs__list {
    {%- if bc_size > 0 %} font-size: {{ bc_size }}px;{% endif -%}
    {%- if bc_ls > 0 %} letter-spacing: {{ bc_ls }}px;{% endif -%}
    {%- if bc_color != blank %} color: {{ bc_color }};{% endif %}
  }
  {%- endif %}
</style>

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  <nav class="breadcrumbs" role="navigation" aria-label="breadcrumbs">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a class="breadcrumbs__link" href="/">Home</a>
      </li>
      <span>/&nbsp;</span>
      {%- case t -%}
        {%- when 'page' -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ page.url }}" aria-current="page">{{ page.title }}</a>
          </li>
        {%- when 'product' -%}
          {%- if collection.url -%}
            {%- capture collection_title -%}
              {% render 'sanitizer', input: collection.title %}
            {%- endcapture -%}
            <li class="breadcrumbs__item">
              {{ collection_title | link_to: collection.url, class: 'breadcrumbs__link' }}
            </li>
            <span>/&nbsp;</span>
          {%- endif -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ product.url }}" aria-current="page">{{ product.title }}</a>
          </li>
        {%- when 'collection' and collection.handle -%}
          {%- if current_tags -%}
            <li class="breadcrumbs__item">
              {{ collection.title | link_to: collection.url }}
            </li>
            <li class="breadcrumbs__item">
              {%- capture tag_url -%}{{ collection.url }}/{{ current_tags | join: "+"}}{%- endcapture -%}
              <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: ' + ' }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ collection.url }}" aria-current="page">{{ collection.title }}</a>
            </li>
          {%- endif -%}
        {%- when 'blog' -%}
          {%- if current_tags -%}
            <li class="breadcrumbs__item">
              {{ blog.title | link_to: blog.url }}
            </li>
            <li class="breadcrumbs__item">
              {%- capture tag_url -%}{{blog.url}}/tagged/{{ current_tags | join: "+" }}{%- endcapture -%}
              <a class="breadcrumbs__link" href="{{ tag_url }}" aria-current="page">{{ current_tags | join: ' + ' }}</a>
            </li>
          {%- else -%}
            <li class="breadcrumbs__item">
              <a class="breadcrumbs__link" href="{{ blog.url }}" aria-current="page">{{ blog.title }}</a>
            </li>
          {%- endif -%}
        {%- when 'article' -%}
          <li class="breadcrumbs__item">
            {{ blog.title | link_to: blog.url }}
          </li>
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ article.url }}" aria-current="page">{{ article.title }}</a>
          </li>
        {%- else -%}
          <li class="breadcrumbs__item">
            <a class="breadcrumbs__link" href="{{ request.path }}" aria-current="page">{{ page_title }}</a>
          </li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}
