<script>
  window.GORGIASCHAT_DISABLE_AUTO_OPEN = true;

  const initGorgiasChatPromise = window.GorgiasChat
    ? window.GorgiasChat.init()
    : new Promise((resolve) => {
        window.addEventListener('gorgias-widget-loaded', () => {
          resolve();
        });
      });

  initGorgiasChatPromise.then(async () => {
    const sspDict = {
      reasonForgotToUseDiscount: 'I forgot to apply my store credit',
    };

    // Brand-styles the Gorgias chat button: no circle/halo, just the black speech-bubble icon.
    // Gorgias renders the button inside a same-origin iframe (#chat-button) with hashed emotion classes,
    // so we target structure only. Current markup (Gorgias "glass" button, 2026-08):
    //   <button> <div gradient/> <div gradient/> <div blur/> <div><svg/></div> </button>
    // Gorgias destroys and recreates the iframe (e.g. every time the chat window is closed), so the
    // injection must be idempotent and re-run whenever a fresh iframe document shows up.
    const STYLE_ID = 'mp-gorgias-button-style';

    const buttonCss = `
      button {
        background: none !important;
        box-shadow: none !important;
        transition: none !important;
      }

      button:hover,
      button:active {
        transform: none !important;
      }

      /* Gorgias refocuses the button when the chat closes; suppress its white focus ring. */
      button:focus,
      button:focus-visible {
        outline: none !important;
      }

      /* Hide the decorative gradient/blur layers; keep only the icon wrapper. */
      button > div:not(:has(svg)) {
        display: none !important;
      }

      button span {
        display: none !important;
      }

      button path {
        fill: black !important;
      }
    `;

    // Returns true once the current #chat-button document is styled (or was already).
    const styleChatButton = () => {
      const chatButtonDocument = document
        .querySelector('#gorgias-chat-container')
        ?.querySelector('#chat-button')?.contentWindow?.document;

      const chatButtonHead = chatButtonDocument?.querySelector('head');

      if (!chatButtonHead) {
        return false;
      }

      if (chatButtonDocument.getElementById(STYLE_ID)) {
        return true;
      }

      // Wait until Gorgias has mounted its own (emotion) styles and the button.
      if (![...chatButtonHead.children].some((x) => x.getAttribute('data-emotion'))) {
        return false;
      }

      if (!chatButtonDocument.querySelector('button')) {
        return false;
      }

      const buttonStyle = document.createElement('style');
      buttonStyle.id = STYLE_ID;
      buttonStyle.textContent = buttonCss;

      chatButtonHead.appendChild(buttonStyle);

      return true;
    };

    // Poll until styled (bounded), then stop; re-armed whenever the widget's DOM changes.
    let pollTimer = null;

    const armPoll = () => {
      if (pollTimer) {
        return;
      }

      let attempts = 0;

      pollTimer = setInterval(() => {
        attempts += 1;

        if (styleChatButton() || attempts > 200) {
          clearInterval(pollTimer);
          pollTimer = null;
        }
      }, 50);
    };

    armPoll();

    // Gorgias swaps the #chat-button iframe in and out of #gorgias-chat-container; watch for that.
    const container = document.querySelector('#gorgias-chat-container') || document.body;

    new MutationObserver(() => {
      if (!styleChatButton()) {
        armPoll();
      }
    }).observe(container, { childList: true, subtree: true });

    GorgiasChat.updateSSPTexts(sspDict);
  });
</script>
