{% comment %}
  Renders a row of style-sibling color swatches on a product card.

  Swatches are linked (no-JS fallback navigates to the sibling PDP). With JS,
  clicking a swatch previews the sibling IN the card (image, title, price,
  badges, link and size-overlay availability all swap —
  assets/card-sibling-preview.js) Rachel-Comey style; quick-add hides while
  a sibling is previewed so a stale control can never act on the wrong
  product, and the overlay/badges hide only when the sibling has no matching
  payload. Each swatch carries its swap payloads server-rendered (price via
  {% render 'price' %}, badge row, and variant availability, so market /
  currency context is always correct). The current product's color is
  underlined and always renders first, so it can never truncate into the
  "+X" overflow text.

  Accepts:
  - card_product: {Object} the product the card represents (required)
  - section_id: {String} id of the host section (optional, for unique scoping)
  - preview_badge: {String} the card slot's preview label, passed through to
    each sibling's badge payload (optional)
  - hide_sold_out_badge: {Boolean} passed through to badge payloads (optional)

  Usage:
  {% render 'product-sibling-swatches', card_product: card_product, section_id: section_id %}
{% endcomment %}

{%- liquid
  assign siblings = card_product.metafields.product_page.style_siblings.value
  assign max_swatches = 5

  comment
    Count renderable colors beyond the current product. Self is rendered
    separately and skipped in the loop.
  endcomment
  assign other_count = 0
  for sibling in siblings
    if sibling.id == card_product.id
      continue
    endif
    if sibling.tags contains 'preview-product' or sibling.tags contains 'vip-product'
      continue
    endif
    unless sibling.available
      continue
    endunless
    assign other_count = other_count | plus: 1
  endfor
-%}

{%- if other_count > 0 -%}
  {%- liquid
    assign total_swatches = other_count | plus: 1
    assign shown = 1
  -%}
  <sibling-swatches class="card__swatches">
    {%- comment -%} The current product ALWAYS renders first, regardless of its position in its own style_siblings list — if it sat past the swatch cap it would truncate into the "+X" text and the card would have no way back from a sibling preview. {%- endcomment -%}
    {%- liquid
      assign self_cp = card_product.metafields.shopify["color-pattern"].value | first
      assign self_color = card_product.options_by_name.color.values[0] | default: card_product.title
    -%}
    {%- capture payload -%}{% render 'sibling-swatch-payload', payload_product: card_product, section_id: section_id, preview_badge: preview_badge, hide_sold_out_badge: hide_sold_out_badge %}{%- endcapture -%}
    <a
      class="card__swatch card__swatch--current"
      href="{{ card_product.url }}"
      aria-current="true"
      title="{{ self_color | escape }}"
      {% render 'sibling-swatch-attrs', payload_product: card_product, payload_self: true %}
    >
      {% render 'swatch', swatch_image: self_cp.image.value, swatch_color: self_cp.color.value, shape: 'square' %}
      <span class="visually-hidden">{{ self_color | escape }}</span>
      {{ payload }}
    </a>

    {%- for sibling in siblings -%}
      {%- liquid
        if sibling.id == card_product.id
          continue
        endif
        if sibling.tags contains 'preview-product' or sibling.tags contains 'vip-product'
          continue
        endif
        unless sibling.available
          continue
        endunless

        if shown >= max_swatches
          break
        endif

        assign sib_cp = sibling.metafields.shopify["color-pattern"].value | first
        assign sib_color = sibling.options_by_name.color.values[0] | default: sibling.title
        assign shown = shown | plus: 1
      -%}
      {%- capture payload -%}{% render 'sibling-swatch-payload', payload_product: sibling, section_id: section_id, preview_badge: preview_badge, hide_sold_out_badge: hide_sold_out_badge %}{%- endcapture -%}
      <a
        class="card__swatch"
        href="{{ sibling.url }}"
        title="{{ sib_color | escape }}"
        {% render 'sibling-swatch-attrs', payload_product: sibling, payload_self: false %}
      >
        {% render 'swatch', swatch_image: sib_cp.image.value, swatch_color: sib_cp.color.value, shape: 'square' %}
        <span class="visually-hidden">{{ sib_color | escape }}</span>
        {{ payload }}
      </a>
    {%- endfor -%}

    {%- if total_swatches > max_swatches -%}
      <span class="card__swatch-more">+{{ total_swatches | minus: max_swatches }}</span>
    {%- endif -%}
  </sibling-swatches>
{%- endif -%}
