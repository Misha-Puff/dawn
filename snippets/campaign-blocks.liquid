{%- comment -%}
  Renders the campaign-view blocks (campaign_hero / campaign_text /
  campaign_lifestyle / campaign_collage / campaign_strip / campaign_products)
  for a collection grid section. Shared by:
    - sections/main-collection-product-grid.liquid (native collection templates)
    - sections/collection-preview-grid.liquid      (templates/collection.preview.json)

  Render ONCE per campaign view, inside the section's
  `.collection-view--campaign.collection-view--cq` wrapper (the has_campaign
  gate, the Collection/Campaign toggle, the {% style %} block and that wrapper
  stay in each section — their gates legitimately differ). Rendered once, not
  per block, because `campaign_styles_loaded` (card-product `skip_styles`)
  carries across blocks.

  The block SCHEMAS cannot be shared: both sections must keep identical
  campaign_* block definitions — scripts/check-campaign-schema-parity.py
  asserts that in CI.

  Accepts:
  - section              {Object} the calling section (settings/blocks/id)
  - product_view_context {String} passed to card-product (main grid: 'collection'; optional)
  - skip_locked          {Boolean} campaign_lifestyle callouts skip tier-locked
                         products via locksmith-v2-lock-product (preview grid: true; default false)
  - show_preview_badge   {Boolean} campaign_products live-feed cards get the
                         'Early Access' preview_badge (preview grid: true; default false)

  Usage:
  {% render 'campaign-blocks', section: section, product_view_context: 'collection' %}
  {% render 'campaign-blocks', section: section, skip_locked: true, show_preview_badge: true %}
{%- endcomment -%}
{%- assign campaign_styles_loaded = false -%}
{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'campaign_hero' -%}
      {%- capture cb_style -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
      {%- endcapture -%}
      <div
        class="campaign-block campaign-hero{% if block.settings.video_url != blank %} campaign-hero--ambient campaign-block--sized{% endif %}"
        {% if block.settings.video_url != blank %}
          style="--cb-w:calc(100% + 2 * var(--page-width-padding, 50px));--cb-wm:calc(100% + 2 * var(--mobile-page-width-padding, 10px));{{ cb_style }}"
        {% elsif cb_style != blank %}
          style="{{ cb_style }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="campaign-hero__media{% if block.settings.full_screen %} campaign-hero__media--full{% endif %}">
          {%- if block.settings.video_url != blank -%}
            <video
              class="campaign-hero__ambient"
              autoplay
              loop
              muted
              playsinline
              aria-hidden="true"
              {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1500 }}"{% endif %}
            >
              <source src="{{ block.settings.video_url | escape }}">
            </video>
            {%- if block.settings.overlay_eyebrow != blank or block.settings.overlay_image != blank -%}
              <div class="campaign-hero__overlay">
                {%- if block.settings.overlay_eyebrow != blank -%}
                  <p class="campaign-hero__eyebrow">{{ block.settings.overlay_eyebrow | escape }}</p>
                {%- endif -%}
                {%- if block.settings.overlay_image != blank -%}
                  {{
                    block.settings.overlay_image
                    | image_url: width: 2000
                    | image_tag:
                      loading: 'eager',
                      sizes: '100vw',
                      widths: '750, 1100, 1500, 2000',
                      class: 'campaign-hero__overlay-image'
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- elsif block.settings.video != blank -%}
            {%- assign hero_poster = block.settings.video.preview_image | default: block.settings.image -%}
            <video
              class="campaign-hero__video"
              controls
              playsinline
              preload="none"
              {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1500 }}"{% endif %}
            >
              {%- for source in block.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                sizes: '100vw',
                widths: '375, 750, 1100, 1500, 2000',
                class: 'campaign-hero__image'
            }}
          {%- endif -%}
        </div>
        {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
          <div class="campaign-hero__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="campaign-hero__heading inline-richtext {{ block.settings.heading_size }}">
                {{ block.settings.heading }}
              </h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="campaign-hero__text rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a
                class="button"
                {% if block.settings.button_link != blank %}
                  href="{{ block.settings.button_link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- when 'campaign_text' -%}
      {%- capture cb_style -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
        {%- if block.settings.inset_right != blank -%}--ct-inr:{{ block.settings.inset_right }}px;{%- endif -%}
        {%- if block.settings.inset_right_mobile != blank -%}--ct-inrm:{{ block.settings.inset_right_mobile }}px;{%- endif -%}
        {%- if block.settings.heading_px != blank -%}--ct-hfs:{{ block.settings.heading_px }}px;{%- endif -%}
        {%- if block.settings.heading_px_mobile != blank -%}--ct-hfsm:{{ block.settings.heading_px_mobile }}px;{%- endif -%}
        {%- if block.settings.heading_lh != blank -%}--ct-hlh:{{ block.settings.heading_lh }}px;{%- endif -%}
        {%- if block.settings.heading_lh_mobile != blank -%}--ct-hlhm:{{ block.settings.heading_lh_mobile }}px;{%- endif -%}
        {%- if block.settings.heading_weight != blank -%}--ct-hw:{{ block.settings.heading_weight }};{%- endif -%}
        {%- if block.settings.heading_ls != blank -%}--ct-hls:{{ block.settings.heading_ls }}px;{%- endif -%}
        {%- if block.settings.sub_px != blank -%}--ct-sfs:{{ block.settings.sub_px }}px;{%- endif -%}
        {%- if block.settings.sub_px_mobile != blank -%}--ct-sfsm:{{ block.settings.sub_px_mobile }}px;{%- endif -%}
        {%- if block.settings.sub_lh != blank -%}--ct-slh:{{ block.settings.sub_lh }}px;{%- endif -%}
        {%- if block.settings.sub_lh_mobile != blank -%}--ct-slhm:{{ block.settings.sub_lh_mobile }}px;{%- endif -%}
        {%- if block.settings.sub_ls != blank -%}--ct-sls:{{ block.settings.sub_ls }}px;{%- endif -%}
        {%- if block.settings.sub_gap != blank -%}--ct-sgap:{{ block.settings.sub_gap }}px;{%- endif -%}
        {%- if block.settings.sub_gap_mobile != blank -%}--ct-sgapm:{{ block.settings.sub_gap_mobile }}px;{%- endif -%}
        {%- if block.settings.cta_gap != blank -%}--ct-cgap:{{ block.settings.cta_gap }}px;{%- endif -%}
        {%- if block.settings.cta_gap_mobile != blank -%}--ct-cgapm:{{ block.settings.cta_gap_mobile }}px;{%- endif -%}
      {%- endcapture -%}
      <div
        class="campaign-block campaign-text campaign-text--{{ block.settings.align | default: 'center' }}"
        {% if cb_style != blank %}
          style="{{ cb_style }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.heading != blank -%}
          {%- if block.settings.heading_px != blank or block.settings.heading_px_mobile != blank -%}
            <h2 class="campaign-text__heading campaign-text__heading--custom">
              {{ block.settings.heading }}
            </h2>
          {%- else -%}
            <h2 class="campaign-text__heading inline-richtext {{ block.settings.heading_size }}">
              {{ block.settings.heading }}
            </h2>
          {%- endif -%}
        {%- endif -%}
        {%- if block.settings.subheading != blank -%}
          <p class="campaign-text__sub">{{ block.settings.subheading | escape }}</p>
        {%- endif -%}
        {%- if block.settings.text != blank -%}
          <div class="campaign-text__body rte">{{ block.settings.text }}</div>
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <div class="campaign-text__cta-wrap">
            <a
              class="campaign-cta"
              {% if block.settings.cta_link != blank %}
                href="{{ block.settings.cta_link }}"
              {% endif %}
            >
              {{- block.settings.cta_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    {%- when 'campaign_lifestyle' -%}
      {%- capture cb_style -%}
        {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
        {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
      {%- endcapture -%}
      <div
        class="campaign-block campaign-lifestyle{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
        {% if cb_style != blank %}
          style="{{ cb_style }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.video_url != blank -%}
          <div class="campaign-lifestyle__media">
            <video class="campaign-lifestyle__ambient" autoplay loop muted playsinline aria-hidden="true">
              <source src="{{ block.settings.video_url | escape }}">
            </video>
          </div>
        {%- elsif block.settings.image != blank -%}
          <div class="campaign-lifestyle__media">
            {{
              block.settings.image
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                sizes: '100vw',
                widths: '375, 750, 1100, 1500, 2000',
                class: 'campaign-lifestyle__image'
            }}
          </div>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2 class="campaign-lifestyle__heading inline-richtext">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if block.settings.product_list != blank -%}
          <ul class="campaign-lifestyle__callouts list-unstyled" role="list">
            {%- for callout in block.settings.product_list -%}
              {%- if skip_locked -%}
                {%- comment -%}
                  Preview grid only: skip tier-locked products, same guard as
                  campaign_products. The tier lock is discovery-level only (the PDP
                  buy box is gated by the Badge-Coming Soon tag, not by tier), so a
                  callout link would hand an under-tier viewer a live buy box on a
                  product nothing else links.
                {%- endcomment -%}
                {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: callout -%}{%- endcapture -%}
                {%- assign lock_content = lock_content | strip -%}
                {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
              {%- endif -%}
              <li>
                <a class="campaign-lifestyle__callout" href="{{ callout.url }}">
                  <span class="campaign-lifestyle__callout-title">{{ callout.title | escape }}</span>
                  <span class="campaign-lifestyle__callout-price">{{ callout.price | money }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- when 'campaign_collage' -%}
      {%- capture cb_style -%}
        {%- if block.settings.col1_pct != blank -%}--c1-w:{{ block.settings.col1_pct }}cqw;{%- endif -%}
        {%- if block.settings.col2_pct != blank -%}--c2-w:{{ block.settings.col2_pct }}cqw;{%- endif -%}
        {%- if block.settings.col1_pct_mobile != blank -%}--c1-wm:{{ block.settings.col1_pct_mobile }}cqw;{%- endif -%}
        {%- if block.settings.col2_pct_mobile != blank -%}--c2-wm:{{ block.settings.col2_pct_mobile }}cqw;{%- endif -%}
        {%- if block.settings.col1_offset != blank -%}--c1-off:{{ block.settings.col1_offset }}px;{%- endif -%}
        {%- if block.settings.col2_offset != blank -%}--c2-off:{{ block.settings.col2_offset }}px;{%- endif -%}
        {%- if block.settings.col1_offset_mobile != blank -%}--c1-offm:{{ block.settings.col1_offset_mobile }}px;{%- endif -%}
        {%- if block.settings.col2_offset_mobile != blank -%}--c2-offm:{{ block.settings.col2_offset_mobile }}px;{%- endif -%}
        {%- if block.settings.col1_gap != blank -%}--c1-gap:{{ block.settings.col1_gap }}px;{%- endif -%}
        {%- comment -%}
          Blank ratio = the image's own ratio, emitted explicitly so the
          column reserves its height before the lazy image loads (the
          CSS aspect-ratio rule otherwise discards the width/height
          attribute mapping and the column collapses to 0px until load).
        {%- endcomment -%}
        {%- if block.settings.col1_ratio != blank -%}--c1-ar:{{ block.settings.col1_ratio }};{%- elsif block.settings.image_1 != blank -%}--c1-ar:{{ block.settings.image_1.aspect_ratio }};{%- endif -%}
        {%- if block.settings.col2_ratio != blank -%}--c2-ar:{{ block.settings.col2_ratio }};{%- elsif block.settings.image_2 != blank -%}--c2-ar:{{ block.settings.image_2.aspect_ratio }};{%- endif -%}
        {%- if block.settings.inset_x != blank -%}--cg-inx:{{ block.settings.inset_x }}px;{%- endif -%}
        {%- if block.settings.inset_x_mobile != blank -%}--cg-inxm:{{ block.settings.inset_x_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
      {%- endcapture -%}
      <div
        class="campaign-block campaign-block--sized campaign-collage campaign-collage--{{ block.settings.layout }}{% if block.settings.valign == 'bottom' %} campaign-collage--bottom{% endif %}{% if block.settings.first_flush %} campaign-collage--flush-first{% endif %}{% if block.settings.second_flush %} campaign-collage--flush-second{% endif %}"
        style="--cb-w:calc(100% + 2 * var(--page-width-padding, 50px));--cb-wm:calc(100% + 2 * var(--mobile-page-width-padding, 10px));{{ cb_style }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.layout != 'images' -%}
          {%- if block.settings.eyebrow != blank or block.settings.heading != blank -%}
            <div class="campaign-collage__text">
              {%- if block.settings.eyebrow != blank -%}
                <p class="campaign-collage__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="campaign-collage__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endif -%}
        {%- if block.settings.image_1 != blank -%}
          <div class="campaign-collage__col campaign-collage__col--first">
            {{
              block.settings.image_1
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                sizes: '60vw',
                widths: '375, 750, 1100, 1500, 2000',
                class: 'campaign-collage__image'
            }}
          </div>
        {%- endif -%}
        {%- if block.settings.image_2 != blank and block.settings.layout != 'image_text' -%}
          <div class="campaign-collage__col campaign-collage__col--second">
            {{
              block.settings.image_2
              | image_url: width: 2000
              | image_tag:
                loading: 'lazy',
                sizes: '60vw',
                widths: '375, 750, 1100, 1500, 2000',
                class: 'campaign-collage__image'
            }}
          </div>
        {%- endif -%}
      </div>
    {%- when 'campaign_strip' -%}
      {%- capture cb_style -%}
        {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
        {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
        {%- if block.settings.gap != blank -%}--cs-gap:{{ block.settings.gap }}px;{%- endif -%}
        {%- if block.settings.gap_mobile != blank -%}--cs-gapm:{{ block.settings.gap_mobile }}px;{%- endif -%}
        {%- if block.settings.ratio != blank -%}--cs-ar:{{ block.settings.ratio }};{%- endif -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
        --cs-cols:{{ block.settings.columns }};--cs-colsm:{{ block.settings.columns_mobile }};
      {%- endcapture -%}
      <div
        class="campaign-block campaign-strip{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
        style="{{ cb_style }}"
        {{ block.shopify_attributes }}
      >
        <ul class="campaign-strip__row list-unstyled" role="list">
          {%- for slot in (1..6) -%}
            {%- assign img_key = 'image_' | append: slot -%}
            {%- assign link_key = 'link_' | append: slot -%}
            {%- assign strip_image = block.settings[img_key] -%}
            {%- assign strip_link = block.settings[link_key] -%}
            {%- if strip_image == blank -%}{%- continue -%}{%- endif -%}
            <li class="campaign-strip__cell">
              {%- if strip_link != blank -%}
                <a class="campaign-strip__link" href="{{ strip_link }}">
              {%- endif -%}
              {{
                strip_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 17vw, 34vw',
                  widths: '250, 375, 550, 750, 1100',
                  class: 'campaign-strip__image'
              }}
              {%- if strip_link != blank -%}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- when 'campaign_products' -%}
      {%- liquid
        assign cp_products = block.settings.product_list
        assign cp_limit = 12
        if cp_products == blank and block.settings.source_collection != blank
          assign cp_products = block.settings.source_collection.products
          assign cp_limit = block.settings.products_to_show
        endif
      -%}
      {%- capture cb_style -%}
        {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
        {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
        {%- if block.settings.tile_gap != blank -%}--cp-gap:{{ block.settings.tile_gap }}px;{%- endif -%}
        {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
        {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
        {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
        {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
        --cp-cols:{{ block.settings.columns_desktop }};
      {%- endcapture -%}
      <div
        class="campaign-block campaign-products campaign-products--{{ block.settings.display }}{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
        style="{{ cb_style }}"
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.heading != blank -%}
          <h2 class="campaign-products__heading inline-richtext">{{ block.settings.heading }}</h2>
        {%- endif -%}
        {%- if cp_products != blank -%}
          {%- if block.settings.display == 'theme' -%}
            <ul
              class="campaign-products__grid grid product-grid list-unstyled grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ block.settings.columns_desktop }}-col-desktop"
              role="list"
            >
              {%- liquid
                assign cp_shown = 0
              -%}
              {%- for product in cp_products -%}
                {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                {%- assign lock_content = lock_content | strip -%}
                {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                {%- assign cp_shown = cp_shown | plus: 1 -%}
                {%- if show_preview_badge -%}
                  {%- comment -%}
                    Preview grid only: preview products keep their Early Access badge
                    in campaign rows. Tag-gated (like the PDP, unlike the grid loop
                    above) so hand-picked published products get no badge; locked
                    products never reach this point, so no Coming Soon branch is
                    needed. Sold-out stays visible — campaign rows only ever show
                    viewer-shoppable products.
                  {%- endcomment -%}
                  {%- assign preview_badge = '' -%}
                  {%- if product.tags contains 'preview-product' or product.tags contains 'supervip-product' or product.tags contains 'vip-product' -%}
                    {%- unless product.tags contains 'Badge-Early Access' -%}
                      {%- assign preview_badge = 'Early Access' -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endif -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: true,
                    skip_styles: campaign_styles_loaded,
                    quick_add: 'none',
                    section_id: section.id,
                    show_swatches_availability: true,
                    size_overlay: section.settings.show_size_overlay,
                    product_view_context: product_view_context,
                    preview_badge: preview_badge
                  %}
                </li>
                {%- assign campaign_styles_loaded = true -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            <ul class="campaign-products__row list-unstyled" role="list">
              {%- liquid
                assign cp_shown = 0
              -%}
              {%- for product in cp_products -%}
                {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                {%- assign lock_content = lock_content | strip -%}
                {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                {%- assign cp_shown = cp_shown | plus: 1 -%}
                <li class="campaign-products__cell">
                  <a href="{{ product.url }}" class="campaign-products__card">
                    <div class="campaign-products__media">
                      {%- if product.featured_media != blank -%}
                        {{
                          product.featured_media
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            sizes: '(min-width: 750px) 30vw, 34vw',
                            widths: '375, 550, 800',
                            class: 'campaign-products__img'
                        }}
                      {%- endif -%}
                      {%- if block.settings.display == 'cards' and product.media[1] != null -%}
                        {{
                          product.media[1]
                          | image_url: width: 800
                          | image_tag:
                            loading: 'lazy',
                            sizes: '(min-width: 750px) 30vw, 34vw',
                            widths: '375, 550, 800',
                            class: 'campaign-products__img campaign-products__img--hover'
                        }}
                      {%- endif -%}
                    </div>
                    {%- if block.settings.display == 'cards' -%}
                      <div class="campaign-products__meta">
                        <span class="campaign-products__title">{{ product.title | escape }}</span>
                        <span class="campaign-products__price">{{ product.price | money }}</span>
                      </div>
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endif -%}
        {%- if block.settings.cta_label != blank -%}
          <div class="campaign-products__cta-wrap">
            <a
              class="campaign-products__cta"
              {% if block.settings.cta_link != blank %}
                href="{{ block.settings.cta_link }}"
              {% endif %}
            >
              {{- block.settings.cta_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
  {%- endcase -%}
{%- endfor -%}
