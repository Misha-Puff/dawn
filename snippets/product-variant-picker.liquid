{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  - size_chart_block: {Object} optional. The section's size-chart block; supplies the inline Size Guide trigger's modal id, CTA text and editor attributes.
  - size_guide_inline: {Boolean} optional. When true, renders the size-chart trigger right-aligned on the Size option row (the size-chart block suppresses its standalone trigger).
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
<variant-selects
  id="variant-selects-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-title="{{ product.title | escape }}"
  data-product-id="{{ product.id }}"
  data-currency-code="{{ cart.currency.iso_code }}"
  {% # theme-check-disable %}
  data-selected-price-amount="{{ product.selected_or_first_available_variant.price | default: 0 | money_amount | escape }}"
  {% # theme-check-enable %}
  {{ block.shopify_attributes }}
>
  {%- for option in product.options_with_values -%}
    {%- liquid
      assign swatch_count = option.values | map: 'swatch' | compact | size

      if option.name == 'Color'
        assign picker_type = block.settings.color_picker_type
        assign swatch_count = 0
        if product.metafields.shopify["color-pattern"].value != blank
          assign swatch_count = 1
        endif
        assign siblings = product.metafields.product_page.style_siblings.value
        for sibling in siblings
          if sibling.id != product.id and sibling.metafields.shopify["color-pattern"].value != blank
            assign swatch_count = swatch_count | plus: 1
          endif
        endfor
      elsif option.name == 'Size'
        assign picker_type = block.settings.size_picker_type
      else
        assign picker_type = block.settings.picker_type
      endif

      if swatch_count > 0 and block.settings.swatch_shape != 'none'
        if block.settings.color_picker_type == 'dropdown'
          assign picker_type = 'swatch_dropdown'
        else
          assign picker_type = 'swatch'
        endif
      endif

      assign hide_option = false

      for value in option.values
        if value contains 'Dye Lot'
          assign hide_option = true
          break
        endif
      endfor

      assign show_size_guide = false
      if size_guide_inline and option.name == 'Size'
        assign show_size_guide = true
      endif
    -%}

    {%- comment -%} Inline Size Guide trigger, absolutely positioned on the option row (a legend must stay the fieldset's first child and out of its accessible name, so one flex mechanism can't cover all three branches). Empty unless the size-chart block opted in and this is the Size option. {%- endcomment -%}
    {%- capture size_guide_trigger -%}
      {%- if show_size_guide -%}
        <modal-opener
          class="Block-{{ size_chart_block.id }} size-guide-inline product-popup-modal__opener quick-add-hidden"
          data-modal="#PopupModal-{{ size_chart_block.id }}"
          {{ size_chart_block.shopify_attributes }}
        >
          <button
            id="ProductPopup-{{ size_chart_block.id }}"
            class="product-popup-modal__button link"
            type="button"
            aria-haspopup="dialog"
          >
            {{ size_chart_block.settings.cta_text }}
          </button>
        </modal-opener>
      {%- endif -%}
    {%- endcapture -%}

    {%- if picker_type == 'swatch' -%}
      <fieldset class="js product-form__input product-form__input--swatch{% if show_size_guide %} product-form__input--size-guide{% endif %}{% if hide_option %} hidden{% endif %}">
        <legend class="form__label">
          <span data-option-name>{{ option.name }}:</span>
          <span data-selected-value>
            {{- option.selected_value -}}
          </span>
        </legend>
        {{ size_guide_trigger }}
        {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
      </fieldset>
    {%- elsif picker_type == 'button' -%}
      <fieldset class="js product-form__input product-form__input--pill{% if show_size_guide %} product-form__input--size-guide{% endif %}{% if hide_option %} hidden{% endif %}">
        <legend class="form__label"><span data-option-name>{{ option.name }}:</span></legend>
        {{ size_guide_trigger }}
        {% render 'product-variant-options', product: product, option: option, block: block, picker_type: picker_type %}
      </fieldset>
    {%- else -%}
      <div class="product-form__input product-form__input--dropdown{% if show_size_guide %} product-form__input--size-guide{% endif %}{% if hide_option %} hidden{% endif %}">
        <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
          <span data-option-name>{{ option.name }}:</span>
        </label>
        {{ size_guide_trigger }}
        <div class="select">
          {%- if picker_type == 'swatch_dropdown' -%}
            <span
              data-selected-value
              class="dropdown-swatch"
            >
              {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
            </span>
          {%- endif -%}
          <select
            id="Option-{{ section.id }}-{{ forloop.index0 }}"
            class="select__select"
            name="options[{{ option.name | escape }}]"
            form="{{ product_form_id }}"
          >
            {% render 'product-variant-options',
              product: product,
              option: option,
              block: block,
              picker_type: picker_type
            %}
          </select>
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}

  <script type="application/json" data-selected-variant>
    {{ product.selected_or_first_available_variant | json }}
  </script>
</variant-selects>
