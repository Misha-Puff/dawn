{%- liquid
  # Segment = 'guest' | 'member' | the customer's tier handle (vip, super_vip,
  # vic, …) | 'staff'. Tier resolution lives in the vip-tier snippet.
  assign customer_segment = 'guest'
  if customer
    assign customer_segment = 'member'
    capture tier_handle
      render 'vip-tier', field: 'handle'
    endcapture
    assign tier_handle = tier_handle | strip
    if tier_handle != blank
      assign customer_segment = tier_handle
    endif
  endif
-%}
<script type="text/javascript">
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', '75c2w177pq');
  window.clarity('set', 'customer_segment', {{ customer_segment | json }});
</script>
