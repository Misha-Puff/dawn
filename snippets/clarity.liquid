{%- liquid
  assign customer_segment = 'guest'
  if customer
    assign customer_segment = 'member'
    if customer.metafields.clienteling.very_important_customer or customer.metafields.clienteling.super_vip or customer.metafields.clienteling.vip
      assign customer_segment = 'vip'
    endif
    if customer.tags contains 'staff'
      assign customer_segment = 'staff'
    endif
  endif
-%}
<script type="text/javascript">
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', '75c2w177pq');
  window.clarity('set', 'customer_segment', {{ customer_segment | json }});
</script>
