{% if product.metafields.product_page.json_size_chart != blank %}
  {% liquid
    assign additional_size_guide_details = product.metafields.product_page.additional_size_guide_details
    assign size_guide_note = product.metafields.product_page.size_guide_note
    assign size_chart = product.metafields.product_page.json_size_chart.value
    assign sizes = size_chart.sizes | split: ','
    assign measurements = size_chart.measurements
    assign show_legend = false

    if additional_size_guide_details != null
      assign show_legend = true
    endif

    if size_guide_note != null
      assign show_legend = true
    endif

    for measurement in measurements
      if measurement.translation != null
        assign show_legend = true
        break
      endif
    endfor
  %}

  <style>
    .size-chart-container {
      padding-left: 15rem;
      padding-right: 15rem;
    }
    .size-chart-header {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 20px;
      gap: 20px;
    }
    .size-chart-header h2 {
      margin: 0;
      font-family: var(--font-mono-family);
      font-size: 1.3rem;
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: 0.1rem;
      color: rgb(var(--color-foreground));
    }
    .unit-toggle input[type='radio'] {
      position: absolute;
      opacity: 0;
      width: 0;
      height: 0;
    }
    .unit-toggle__label {
      display: inline-flex;
      align-items: center;
      cursor: pointer;
      padding: 5px 10px;
      margin-right: 0;
      color: rgba(var(--color-foreground), 0.75);
      font-family: var(--font-mono-family);
      text-transform: uppercase;
      user-select: none;
    }
    .unit-toggle__label::before {
      content: '';
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 1px solid rgba(var(--color-foreground), 0.75);
      margin-right: 8px;
      box-sizing: border-box;
      vertical-align: middle;
    }
    .unit-toggle input[type='radio']:checked + .unit-toggle__label {
      color: rgb(var(--color-foreground));
    }
    .unit-toggle input[type='radio']:checked + .unit-toggle__label::before {
      background-color: rgb(var(--color-foreground));
      border-color: rgb(var(--color-foreground));
    }
    .unit-toggle {
      margin-bottom: 0;
      padding: 0;
    }
    .size-chart {
      display: flex;
      justify-content: center;
    }
    .size-chart td,
    .size-chart th {
      border: 1px solid rgb(var(--color-foreground)) !important;
      padding: 8px;
    }
    .size-chart table {
      width: fit-content;
      border-collapse: collapse;
      text-align: center;
      box-shadow: none !important;
    }
    .size-chart th {
      background-color: rgba(var(--color-foreground), 0.05);
      white-space: normal;
    }
    .size-chart td:not(:first-child),
    .size-chart th:not(:first-child) {
      width: 1%;
      white-space: nowrap;
    }
    .size-chart .unit-value.unit-in {
      display: none;
    }
    .size-chart-container.show-in .unit-value.unit-in {
      display: inline;
    }
    .size-chart-container.show-in .unit-value.unit-cm {
      display: none;
    }
    .unit-toggle__label,
    .size-chart th {
      font-size: 1rem;
    }
    .size-chart th,
    .size-chart td {
      font-family: var(--font-mono-family);
    }
    .size-chart th {
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.75);
    }
    .size-chart td {
      font-size: 1.2rem;
      color: rgb(var(--color-foreground));
    }

    .size-chart-container .divider-wrapper {
      display: flex;
      justify-content: center;
      margin-top: 18px;
      margin-bottom: 15px;
    }

    .size-chart-container .divider {
      width: 100%;
      border-top: 1px solid rgb(var(--color-foreground));
    }

    .size-chart-legend {
      font-family: var(--font-body-family);
      font-size: 1.1rem;
      color: rgb(var(--color-foreground));
    }

    .size-chart-legend .note {
      font-size: 1.1rem;
    }

    .size-chart-legend .item {
      margin: 0;
      font-size: 1.1rem;
    }

    @media (max-width: 750px) {
      .size-chart-container {
        padding-left: 0;
        padding-right: 0;
      }
      .size-chart td:not(:first-child),
      .size-chart th:not(:first-child) {
        width: 1%;
        white-space: nowrap;
      }
    }
  </style>

  <div class="size-chart-container">
    <div class="size-chart-header">
      <h2>Product Measurements</h2>
      <div class="unit-toggle">
        <input type="radio" id="unit-cm-{{ product.id }}" name="unit-selector-{{ product.id }}" value="cm" checked>
        <label for="unit-cm-{{ product.id }}" class="unit-toggle__label">CM</label>
        <input type="radio" id="unit-in-{{ product.id }}" name="unit-selector-{{ product.id }}" value="in">
        <label for="unit-in-{{ product.id }}" class="unit-toggle__label">IN</label>
      </div>
    </div>
    <div class="size-chart" id="size-chart-{{ product.id }}">
      <table>
        <thead>
          <tr>
            <th>Size</th>
            {% for measurement in measurements %}
              <th>{{ measurement.label }}</th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          {% for size in sizes %}
            {% assign current_index = forloop.index0 %}
            <tr>
              <td>{{ size }}</td>
              {% for measurement in measurements %}
                {% assign cms = measurement.cm | split: ',' %}
                {% assign ins = measurement.in | split: ',' %}
                <td>
                  <span class="unit-value unit-cm">{{ cms[current_index] }} cm</span>
                  <span class="unit-value unit-in">{{ ins[current_index] }} in</span>
                </td>
              {% endfor %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if show_legend %}
      <div class="divider-wrapper">
        <div class="divider">
          <span class="visually-hidden">divider</span>
        </div>
      </div>

      <div class="size-chart-legend">
        {% if size_guide_note != null %}
          {{ size_guide_note }}
        {% endif %}
        {% for measurement in measurements %}
          {% assign translation = measurement.translation %}
          {% assign label = measurement.label %}
          {% if translation != null %}
            <p class="item">{{ label }}: {{ translation }}</p>
          {% endif %}
        {% endfor %}
        {% if additional_size_guide_details != null %}
          {{ additional_size_guide_details }}
        {% endif %}
      </div>
    {% endif %}
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      document.querySelectorAll('.size-chart-container')?.forEach((container) => {
        const updateView = (selectedUnit) => {
          if (selectedUnit === 'in') {
            container.classList.add('show-in');
          } else {
            container.classList.remove('show-in');
          }
        };

        const initialCheckedRadio = container.querySelector('input[name^="unit-selector-"]:checked');

        if (initialCheckedRadio) {
          updateView(initialCheckedRadio.value);
        }

        container.querySelectorAll('input[name^="unit-selector-"]')?.forEach((radio) => {
          radio.addEventListener('change', function () {
            if (this.checked) {
              updateView(this.value);
            }
          });
        });
      });
    });
  </script>
{% elsif product.metafields.product_page.size_chart != blank %}
  <div class="size-chart" id="size-chart{{ product.id }}">
    <div class="size-chart-wrap content container {% if settings.table_styles_enabled %} table is-striped is-bordered {% endif %}">
      <div class="one-whole column">
        <div class="feature_divider"></div>
        {{ product.metafields.product_page.size_chart }}
      </div>
    </div>
  </div>
{% endif %}
