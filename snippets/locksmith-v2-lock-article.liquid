{% liquid
  assign lock_content = 'false'

  # Locks articles tagged with `block-unlogged`
  if article.tags contains 'block-unlogged'
    assign lock_content = 'true'

    if customer
      assign lock_content = 'false'
    endif
  endif

  # Locks articles with an Access Level (`lock.required_priority`; legacy tag
  # `vip` until cutover). Who may see them is decided by the vip-tier resolver.
  capture gated
    render 'vip-tier', for_article: article, field: 'gated'
  endcapture
  assign gated = gated | strip

  if gated == 'true'
    assign lock_content = 'true'

    capture eligible
      render 'vip-tier', for_article: article, field: 'eligible'
    endcapture
    assign eligible = eligible | strip

    if eligible == 'true'
      assign lock_content = 'false'
    endif
  endif

  if request.design_mode
    echo 'false'
  else
    echo lock_content
  endif
%}
