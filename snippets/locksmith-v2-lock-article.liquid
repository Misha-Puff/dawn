{% liquid
  assign lock_content = 'false'

  # Locks articles tagged with `block-unlogged`
  if article.tags contains 'block-unlogged'
    assign lock_content = 'true'

    if customer
      assign lock_content = 'false'
    endif
  endif

  # Locks articles tagged with `vip` — VIP tier and up, via the vip-tier
  # resolver (staff bypass + global access dial live there).
  if article.tags contains 'vip'
    assign lock_content = 'true'

    capture eligible
      render 'vip-tier', required_tier: 'vip', field: 'eligible'
    endcapture
    assign eligible = eligible | strip

    if eligible == 'true'
      assign lock_content = 'false'
    endif
  endif

  if request.design_mode
    echo 'false'
  else
    echo lock_content
  endif
%}
