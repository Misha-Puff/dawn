{%- comment -%}
  horizon-blocks Phase 2+3 — UI-layer tokens (z-index ramp + opacity constants;
  Phase 3 appends icon/slideshow/animation constants + primary-button shims).

  Dawn-side equivalent of the layering + opacity subset of stock Horizon
  v4.1.1 (68760d9) snippets/theme-styles-variables.liquid, values verbatim.
  Dawn has no equivalent tokens; the Phase-2 card slice consumes
  --layer-flat / --layer-raised (card content/link stacking) and
  --opacity-* (contrast-override's muted/subdued text + form tokens,
  overlay fallback color). The FULL ramps are emitted, not just the
  consumed subset, so future slices (sticky headers, drawers, popovers)
  reuse this file instead of growing new partial copies.

  Rendered by sections/hz-blocks-host.liquid next to hz-type-variables —
  same ownership precedent; future hosts render both.

  Emitted via {% style %} (Liquid tag) — exempt from Shopify's CSS
  subsetting, so the tokens survive even when no static CSS references them.
{%- endcomment -%}

{% style %}
  :root {
    /** Z-Index / Layering */
    --layer-section-background: -2;
    --layer-lowest: -1;
    --layer-base: 0;
    --layer-flat: 1;
    --layer-raised: 2;
    --layer-heightened: 4;
    --layer-sticky: 8;
    --layer-window-overlay: 10;
    --layer-header-menu: 12;
    --layer-overlay: 16;
    --layer-menu-drawer: 18;
    --layer-temporary: 20;

    /* Opacity */
    --opacity-5: 0.05;
    --opacity-8: 0.08;
    --opacity-10: 0.1;
    --opacity-15: 0.15;
    --opacity-20: 0.2;
    --opacity-25: 0.25;
    --opacity-30: 0.3;
    --opacity-40: 0.4;
    --opacity-50: 0.5;
    --opacity-60: 0.6;
    --opacity-70: 0.7;
    --opacity-80: 0.8;
    --opacity-85: 0.85;
    --opacity-90: 0.9;
    --opacity-subdued-text: 0.8;
    --opacity-muted-text: 0.6;

    /* --- Phase 3 (carousel slice) --- */
    /* Icons (theme-styles-variables:552 — Horizon icon_stroke setting default) */
    --icon-stroke-width: 1.5px;

    /* Constants (tsv:377-378, 637) */
    --color-white: #ffffff;
    --color-white-rgb: 255 255 255;
    --minimum-touch-target: 44px;

    /* Slideshow sizes (tsv:631-632; Horizon rem = 16px) */
    --slideshow-controls-icon: 32px; /* 2rem */
    --peek-next-slide-size: 48px; /* 3rem */

    /* Padding (tsv:424; 0.7rem) */
    --padding-sm: 11.2px;

    /* Animation (tsv:477, 480) — full ramp per this file's precedent */
    --animation-speed-fast: 0.0625s;
    --animation-speed: 0.125s;
    --animation-speed-medium: 0.15s;
    --animation-speed-slow: 0.2s;
    --animation-easing: ease-in-out;

    /* Primary button colors (Horizon snippets/color-palette.liquid:180-181,
       fed there by theme settings). Dawn mapping shim: deliberate comma-triplet
       composition at the shim boundary — Dawn's --color-button is a comma
       triplet consumed via rgba()/rgb(). Consumed by the circle/square arrow
       shapes; without this they render transparent (IACVT). */
    --color-primary-button-background: rgba(var(--color-button), var(--alpha-button-background));
    --color-primary-button-text: rgb(var(--color-button-text));
  }
{% endstyle %}
