{%- doc -%}
  This snippet is used to render a product card.
  It is used in the product block,featured product block, and the product card block.

  Port of stock Horizon v4.1.1 (68760d9) snippets/price.liquid
  (horizon-blocks Phase 10), renamed hz-price — Dawn/M&P ship a heavily
  customized snippets/price.liquid (collision rename, same family as
  hz-swatch / hz-unit-price / hz-product-media). Deviations:
  - ADAPT (Phase-1b mapping precedent): Horizon's split
    settings.currency_code_enabled_product_pages /
    settings.currency_code_enabled_product_cards collapse onto Dawn's single
    settings.currency_code_enabled — both of stock's branches read the one
    Dawn setting, so cards and pages behave identically (this store: true).
  - content.* | t strings hardcoded to Horizon's English.
  - render 'unit-price' repointed to the renamed 'hz-unit-price'.
  - The appended stylesheet is the price-family extraction from Horizon
    base.css:2309-2375 (invisible-dependency audit, dialog-styles precedent).
    Every non-product-price-prefixed rule is scoped under the product-price
    element (all hz consumers wrap this snippet in <product-price> — the
    price block and section-rendering-product-card): Dawn's
    component-price.css loads GLOBALLY (theme.liquid drawer-cart branch,
    cart_type = drawer on this store) and styles the same bare class names —
    its `.price__sale { display: none }` would permanently hide the hz sale
    price (Horizon's show/hide model is .price__hidden, not Dawn's
    .price--on-sale parent), and its `.price` / `.unit-price` typography
    (font-size 14px / 1.1rem, letter-spacing, margins) would override the
    inherited type-preset sizing. The product-price scope (0,1,1) beats
    Dawn's (0,1,0) regardless of load order; the grouped "Dawn armor"
    declarations neutralize Dawn-only properties back to stock computed
    values — see inline comments.

  @param {product} product_resource - The product to render
  @param {boolean} [show_unit_price] - Whether to show the unit price
  @param {boolean} [show_sale_price_first] - Whether to show the sale price first
{%- enddoc -%}

{%- liquid
  assign show_unit_price = show_unit_price | default: false
  assign show_sale_price_first = show_sale_price_first | default: false
  assign selected_variant = product_resource.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_at_price = selected_variant.compare_at_price

  assign show_compare_price = false
  if compare_at_price > price
    assign show_compare_price = true
  endif

  if product_resource == blank
    assign price = 1999
  endif

  # Check if variant has volume pricing
  assign has_volume_pricing = null
  assign price_min = null
  assign price_max = null

  # For product cards (collection/search pages), calculate min/max across all variants
  # For product pages, only use the selected variant's pricing
  assign is_product_card = false
  if template.name != 'product'
    assign is_product_card = true
  endif

  if is_product_card
    assign price_min = product_resource.price_min
    assign price_max = product_resource.price_max
    assign has_volume_pricing = product_resource.quantity_price_breaks_configured? | default: false
  else
    # Product page: only use selected variant's pricing
    if selected_variant.quantity_price_breaks.size > 0
      assign has_volume_pricing = true
      assign price_min = selected_variant.quantity_price_breaks.last.price
      assign price_max = selected_variant.price
    endif
  endif

  # Determine if currency code should be shown. ADAPT: stock branches on
  # currency_code_enabled_product_pages vs _product_cards (see doc header);
  # Dawn has the single currency_code_enabled for both contexts.
  assign use_currency = false
  if settings.currency_code_enabled
    assign use_currency = true
  endif

  # Format all prices
  if use_currency
    assign price = price | money_with_currency
    assign compare_at_price = compare_at_price | money_with_currency
    assign price_min = price_min | money_with_currency
    assign price_max = price_max | money_with_currency
  else
    assign price = price | money
    assign compare_at_price = compare_at_price | money
    assign price_min = price_min | money
    assign price_max = price_max | money
  endif
-%}

<div ref="priceContainer">
  {% if has_volume_pricing %}
    {% comment %} Volume pricing display {% endcomment %}
    {% if show_compare_price %}
      <span class="price-item__group">
        <span class="visually-hidden">Regular price&nbsp;</span>
        <span class="compare-at-price">{{- compare_at_price -}}</span>
      </span>
    {% endif %}
    <span class="price-item__group">
      <span class="visually-hidden">Price range&nbsp;</span>
      <span class="price">{{ price_min }} - {{ price_max }}</span>
    </span>
  {% else %}
    {% comment %} Standard pricing display {% endcomment %}
    <div
      class="
        price__regular
        {% if show_compare_price %}
          price__hidden
        {% endif %}
      "
    >
      <span class="price">{{ price | default: '&nbsp;' }}</span>
    </div>
    <div
      class="
        price__sale
        {% unless show_compare_price %}
          price__hidden
        {% endunless %}
      "
    >
      {% if show_sale_price_first %}
        <span class="price-item__group">
          <span class="visually-hidden">Sale price&nbsp;</span>
          <span class="price-item--sale price">{{ price | default: '&nbsp;' }}</span>
        </span>
        <span class="price-item__group">
          <span class="visually-hidden">Regular price&nbsp;</span>
          <span class="price-item--regular compare-at-price">{{- compare_at_price -}}</span>
        </span>
      {% else %}
        <span class="price-item__group">
          <span class="visually-hidden">Regular price&nbsp;</span>
          <span class="price-item--regular compare-at-price">{{- compare_at_price -}}</span>
        </span>
        <span class="price-item__group">
          <span class="visually-hidden">Sale price&nbsp;</span>
          <span class="price-item--sale price">{{ price | default: '&nbsp;' }}</span>
        </span>
      {% endif %}
    </div>
  {% endif %}
  {%- if selected_variant.unit_price and show_unit_price %}
    {%- liquid
      if use_currency
        assign unit_price = selected_variant.unit_price | money_with_currency
      else
        assign unit_price = selected_variant.unit_price | money
      endif
    -%}
    {% render 'hz-unit-price', price: unit_price, measurement: selected_variant.unit_price_measurement %}
  {%- endif -%}
</div>
{%- if has_volume_pricing -%}
  <small
    ref="volumePricingNote"
    class="volume-pricing-note"
  >
    Volume pricing available
  </small>
{%- endif -%}

{% stylesheet %}
  /* Horizon base.css:2309-2375 extraction (see doc header). Dawn deviation:
     rules on bare price classes are scoped under the product-price element
     to out-rank Dawn's globally-loaded component-price.css; the two rules
     stock already prefixes with product-price are verbatim. Token deps
     (--color-foreground-rgb via hz-ui-tokens Phase-10 append; --color-rgb is
     the price block's optional text_color; the rest are Phase 1b/2 tokens). */
  product-price .price,
  product-price .compare-at-price,
  product-price .unit-price {
    white-space: nowrap;
  }

  /* Dawn armor (NOT in stock Horizon): component-price.css sets
     font-size/line-height/color on bare .price and Horizon sets none of them
     (type flows from the text-block preset classes) — restore inheritance. */
  product-price .price {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  product-price .unit-price {
    display: block;
    font-size: min(0.85em, var(--font-paragraph--size));
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));

    /* Dawn armor: neutralize component-price.css's Dawn-only declarations
       (letter-spacing / margin-top / line-height) back to stock initials. */
    letter-spacing: normal;
    margin-top: 0;
    line-height: inherit;
  }

  .tax-note.tax-note.tax-note {
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .tax-note:empty {
    display: none;
  }

  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) > *:not(.tax-note) {
    margin-block: 0;
  }

  /* Volume pricing note should match unit-price styling (small, grey text) */
  product-price .volume-pricing-note,
  product-price.text-block:is(.h1, .h2, .h3, .h4, .h5, .h6) .volume-pricing-note {
    display: block;
    font-family: var(--font-body--family);
    font-weight: normal;
    font-size: var(--font-size--xs);
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  product-price .compare-at-price {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
    text-decoration-line: line-through;
    text-decoration-thickness: 1.5px;
    text-decoration-color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-30));
  }

  product-price .price-item__group {
    display: inline-block;
  }

  product-price .price-item--sale {
    white-space: nowrap;
  }

  /* Order matters within this pair: .price__sale first re-asserts visibility
     against Dawn's global `.price__sale { display: none }` (Horizon has no
     such rule — Dawn armor), then .price__hidden (stock Horizon's actual
     show/hide switch) wins the same-specificity tie by coming later, exactly
     stock behavior. */
  product-price .price__sale {
    display: block;
  }

  product-price .price__hidden {
    display: none;
  }

  form.payment-terms {
    padding-top: 0.5em;
    font-size: min(0.85em, var(--font-paragraph--size));
    font-weight: var(--font-paragraph--weight);
    color: var(--color, rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text)));
  }

  .installments:not(:has(shopify-payment-terms)) {
    display: none;
  }
{% endstylesheet %}
