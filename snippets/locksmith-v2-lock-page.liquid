{% liquid
  assign lock_content = 'false'

  # Locks pages with the `lock.password` metafield set
  if page.metafields.lock.password != ''
    assign lock_content = 'true'
    # theme-check-disable ContentForHeaderModification
    assign page_params = content_for_header | split: '"pageurl":"' | last | split: '"' | first | split: '.myshopify.com' | last | split: '?' | last | replace: '\/', '/' | replace: '%20', ' ' | replace: '\u0026', '&' | split: '&'

    for param in page_params
      if param contains 'password='
        assign password = param | split: '=' | last
      endif
    endfor

    if password == page.metafields.lock.password
      assign lock_content = 'false'
    endif
  endif

  # Locks pages with an Access Level (`lock.required_priority`; legacy
  # `lock.vip` until cutover). Who may see them is decided by the vip-tier
  # resolver; an eligible viewer also skips the password.
  capture gated
    render 'vip-tier', for_page: page, field: 'gated'
  endcapture
  assign gated = gated | strip

  if gated == 'true'
    assign lock_content = 'true'

    capture eligible
      render 'vip-tier', for_page: page, field: 'eligible'
    endcapture
    assign eligible = eligible | strip

    if eligible == 'true'
      assign lock_content = 'false'
    endif
  endif

  if request.design_mode
    echo 'false'
  else
    echo lock_content
  endif
%}
