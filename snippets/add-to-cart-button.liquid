{%- doc -%}
  Renders an "Add to cart" button with dynamic text and state. It shows different text based on whether the product can be added to the cart and provides visual feedback when an item is added.

  Port of stock Horizon v4.1.1 (68760d9) snippets/add-to-cart-button.liquid
  (horizon-blocks Phase 13). Deviations:
  - 'actions.add_to_cart' | t hardcoded to Horizon English ("Add to cart") —
    port-wide precedent (Dawn's locale lacks the Horizon keys).
  - settings.add_to_cart_animation hardcoded TRUE (Horizon theme setting Dawn
    lacks; its schema default is true — plan ruling 2026-07-06). Drives the
    checkmark-burst + fly-to-cart paths in hz-product-form.js (fly-to-cart is
    inert-by-design in Dawn — no .header-actions__cart-icon).
  - Icon assets icon-add-to-cart.svg / icon-checkmark-burst.svg are collision
    -free in Dawn and ship under their stock names (byte-verbatim copies).
  - The <add-to-cart-component> element is defined by hz-product-form.js
    (stock tag, renamed file — see its header); the consuming block/snippet
    loads that script per-render.
  - Renders add-to-cart-button-styles (Phase-13 serve fix): the
    checkmark-burst / added-state layer lives in stock base.css:3815-3994,
    unported — extraction snippet, rendered here at the sole markup emitter.
  - `icon` param added (NOT stock — Dawn-visual ruling 2026-07-06): the
    quick-add trigger passes Dawn's own icon-plus.svg to match the live M&P
    card trigger; default stays the stock cart glyph.

  @param {boolean} can_add_to_cart - Whether the product can be added to the cart.
  @param {string} add_to_cart_text - The text to display on the button.
  @param {object} product - The product object to be added to the cart.
  @param {boolean} [icon_only_on_mobile] - If `true`, only the icon is shown on mobile devices.
  @param {string} [class] - Additional CSS classes to apply to the button.
  @param {string} [id] - The ID attribute for the button.
  @param {string} [data_testid] - The data-testid attribute for testing.
  @param {string} [icon] - Icon asset filename for the button glyph (default 'icon-add-to-cart.svg').
{%- enddoc -%}

{%- liquid
  assign default_add_to_cart_text = 'Add to cart'
  assign atc_icon = icon | default: 'icon-add-to-cart.svg'
  assign product_variant_media = product.selected_or_first_available_variant.featured_media.preview_image | image_url: width: 100
  if product.selected_or_first_available_variant.featured_media.preview_image == blank
    assign product_variant_media = product.featured_media.preview_image | image_url: width: 100
  endif
-%}

<add-to-cart-component
  ref="addToCartButtonContainer"
  data-product-variant-media="{{ product_variant_media }}"
  data-add-to-cart-animation="true"
>
  <button
    {% if id != blank %}
      id="{{ id }}"
    {% endif %}
    type="submit"
    name="add"
    ref="addToCartButton"
    on:click="/handleClick"
    class="button {{ class }}"
    {% if data_testid %}
      data-testid="{{ data_testid }}"
    {% endif %}
    {% unless can_add_to_cart %}
      disabled
    {% endunless %}
  >
    <span
      class="add-to-cart-text"
    >
      {% if can_add_to_cart %}
        <span
          aria-hidden="true"
          class="svg-wrapper add-to-cart-icon"
        >
          {{- atc_icon | inline_asset_content -}}
        </span>
      {% endif %}
      <span class="add-to-cart-text__content{% if icon_only_on_mobile %} is-visually-hidden-mobile{% endif %}">
        <span>
          <span>
            {{- add_to_cart_text | default: default_add_to_cart_text -}}
          </span>
        </span>
      </span>
    </span>
    {% comment %} checkmark burst markup {% endcomment %}
    <span class="add-to-cart__added">
      <span class="svg-wrapper add-to-cart__added-icon">
        {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
      </span>
    </span>
  </button>
</add-to-cart-component>

{% render 'add-to-cart-button-styles' %}
