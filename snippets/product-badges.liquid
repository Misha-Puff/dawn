{% comment %}
  Renders a product's badges (preview/Coming Soon, custom Badge- tags, Sold Out, Sale, RWS, Made-to-Order).
  Conditions are product-level. Extracted from price.liquid; when rendered inside a .price wrapper,
  component-price.css gates the Sale/Sold Out badges by the variant-level price--on-sale/price--sold-out classes.

  Accepts:
  - product: {Object} Product Liquid object
  - preview_badge: {String} Optional badge label rendered alongside other badges (e.g. "Coming Soon", "Early Access") (optional)

  Usage:
  {% render 'product-badges', product: product, preview_badge: preview_badge %}
{% endcomment %}
{%- liquid
  assign tags_str = product.tags | join: ','
  assign coming_soon = false

  if tags_str contains 'Badge-Coming Soon'
    assign coming_soon = true
  endif
-%}
{% if preview_badge != blank %}
  <span class="badge price__badge-coming-soon color-{{ settings.coming_soon_badge_color_scheme }}">
    {{ preview_badge }}
  </span>
{% endif %}
{% if tags_str contains 'Badge-' %}
  {% assign custom_tags = '' | split: '😉' %}

  {% for tag in product.tags %}
    {% if tag contains 'Badge-' %}
      {% assign custom_tag = tag | split: 'Badge-' | last | split: '😉' %}
      {% assign custom_tags = custom_tags | concat: custom_tag %}
    {% endif %}
  {% endfor %}

  {%- if custom_tags.size > 0 -%}
    {% for custom_tag in custom_tags %}
      <span class="badge price__badge-coming-soon color-{{ settings.coming_soon_badge_color_scheme }}">
        {{ custom_tag }}
      </span>
    {% endfor %}
  {% endif %}
{% endif %}

{% if product.available == false and coming_soon == false %}
  <span class="badge price__badge-sold-out color-{{ settings.sold_out_badge_color_scheme }}">
    {{ 'products.product.sold_out' | t }}
  </span>
{% elsif product.compare_at_price > product.price %}
  <span class="badge price__badge-sale color-{{ settings.sale_badge_color_scheme }}">
    {{ 'products.product.on_sale' | t }}
  </span>
{% elsif product.tags contains 'RWS' %}
  <span class="badge price__badge-rws color-{{ settings.rws_badge_color_scheme }}">RWS</span>
{% elsif product.tags contains 'made-to-order' %}
  <span class="badge price__badge-mto color-{{ settings.mto_badge_color_scheme }}">Made-to-Order</span>
{% endif %}
