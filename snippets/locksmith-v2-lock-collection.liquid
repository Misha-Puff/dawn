{% liquid
  # Locks collections with `lock.internal_preview` (staff only) or an Access
  # Level (`lock.required_priority`; legacy `lock.super_vip` / `lock.vip` until
  # cutover). Who may see them is decided by the vip-tier resolver, which also
  # admits Preview Guests when the collection sets `lock.preview_guests`.
  # Contract unchanged: echoes 'true' (locked) / 'false' (unlocked).
  assign lock_content = 'false'

  capture eligible
    render 'vip-tier', for_collection: collection, field: 'eligible'
  endcapture
  assign eligible = eligible | strip

  if eligible == 'false'
    assign lock_content = 'true'
  endif

  if request.design_mode
    echo 'false'
  else
    echo lock_content
  endif
%}
