{% liquid
  # Locks collections with `lock.internal_preview` (staff only), `lock.super_vip`
  # or `lock.vip` set. Which tiers may see gated collections right now is decided
  # by the vip-tier resolver (global access dial, else the legacy boolean ladder).
  # Contract unchanged: echoes 'true' (locked) / 'false' (unlocked).
  assign lock_content = 'false'

  capture eligible
    render 'vip-tier', collection: collection, field: 'eligible'
  endcapture
  assign eligible = eligible | strip

  if eligible == 'false'
    assign lock_content = 'true'
  endif

  if request.design_mode
    echo 'false'
  else
    echo lock_content
  endif
%}
