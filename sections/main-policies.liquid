{{ 'section-main-page.css' | asset_url | stylesheet_tag }}
<script src="{{ 'policy-tabs.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding .policy-title {
    text-transform: uppercase;
    text-align: left;
  }

  {%- comment -%}
    Tab row cloned from .collection-tabs / .collection-tabs__tab as shoppers
    actually see it: base assets/template-collection.css values with the
    tabs_* typography override every live collection template applies on
    main-collection-product-grid (Overpass Mono 600 11px, 0.2px spacing,
    #1a1a1a, 40px gap, left-aligned, no rail, 1px underline) baked in.
    Renamed to .policy-tabs to keep the collection stylesheet off this page.
  {%- endcomment -%}
  {%- capture policy_tabs_font -%}{% render 'brand-font', font: 'overpass_mono' %}{%- endcapture -%}
  .policy-tabs {
    display: flex;
    flex-wrap: nowrap;
    gap: 40px;
    margin-bottom: 10px;
    border-bottom: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }

  .policy-tabs::-webkit-scrollbar {
    display: none;
  }

  .policy-tabs__tab:first-child {
    margin-left: 0;
  }

  .policy-tabs__tab:last-child {
    margin-right: auto;
  }

  .policy-tabs__tab {
    padding: 0 0 1px;
    margin-bottom: 0;
    font-family: {{ policy_tabs_font | strip }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.2px;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    color: #1a1a1a;
    border-bottom: 1px solid transparent;
  }

  .policy-tabs__tab[aria-current='page'] {
    border-bottom-color: rgb(var(--color-foreground));
  }

  .policy-block {
    margin-top: 2.4rem;
  }

  .policy-block[hidden] {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Side padding overrides the .page-width side padding (theme --page-width-padding
    vars); the two-class selector outweighs base.css's single .page-width class.
    0 = keep theme default, each breakpoint independent.
  {%- endcomment -%}
  {%- if section.settings.padding_side_mobile > 0 %}
    @media screen and (max-width: 749px) {
      .page-width.section-{{ section.id }}-padding {
        padding-left: {{ section.settings.padding_side_mobile }}px;
        padding-right: {{ section.settings.padding_side_mobile }}px;
      }
    }
  {% endif -%}
  {%- if section.settings.padding_side > 0 %}
    @media screen and (min-width: 750px) {
      .page-width.section-{{ section.id }}-padding {
        padding-left: {{ section.settings.padding_side }}px;
        padding-right: {{ section.settings.padding_side }}px;
      }
    }
  {% endif -%}
{%- endstyle -%}

{%- comment -%}
  Optional page typography, donor: main-policy.liquid (itself from main-page).
  Two groups keyed by prefix (ph_ = page title + policy headings, pb_ = body
  copy); one entry per selector so every rule stays scoped under
  #shopify-section-<id>. ph_ carries no font-size on purpose — the global
  Headings theme settings own the per-level scale.

  Every declaration is emitted !important, and the pb_ group also targets
  span/div: policy bodies authored in the admin policy editor arrive with
  inline styles on those elements (e.g. <div style="text-align: left">,
  pasted-editor spans) which would otherwise beat any stylesheet rule.
  Section settings must always win over that baked-in styling.
{%- endcomment -%}
{%- if section.settings.page_enable_type -%}
  {%- capture page_type_css -%}
    {%- assign page_type_groups = 'ph|.main-page-title;ph|.policy-block__title;ph|.rte h1;ph|.rte h2;ph|.rte h3;pb|.rte;pb|.rte p;pb|.rte li;pb|.rte span;pb|.rte div' | split: ';' -%}
    {%- for grp in page_type_groups -%}
      {%- assign grp_parts = grp | split: '|' -%}
      {%- assign gp = grp_parts[0] -%}
      {%- assign sel = grp_parts[1] -%}
      {%- assign k_font = gp | append: '_custom_font' -%}
      {%- assign k_weight = gp | append: '_font_weight' -%}
      {%- assign k_size = gp | append: '_font_size' -%}
      {%- assign k_case = gp | append: '_text_case' -%}
      {%- assign k_ls = gp | append: '_letter_spacing' -%}
      {%- assign k_color = gp | append: '_color' -%}
      {%- assign k_lh = gp | append: '_line_height' -%}
      {%- assign k_align = gp | append: '_text_align' -%}
      {%- capture grp_brand -%}{% render 'brand-font', font: section.settings[k_font] %}{%- endcapture -%}
      {%- assign grp_brand = grp_brand | strip -%}
      {%- capture grp_decl -%}
        {%- if grp_brand != blank %}font-family: {{ grp_brand }} !important;{% endif -%}
        {%- if section.settings[k_weight] != 'default' and section.settings[k_weight] != blank %} font-weight: {{ section.settings[k_weight] }} !important;{% endif -%}
        {%- if section.settings[k_size] > 0 %} font-size: {{ section.settings[k_size] }}px !important;{% endif -%}
        {%- if section.settings[k_case] != 'default' and section.settings[k_case] != blank %} text-transform: {{ section.settings[k_case] }} !important;{% endif -%}
        {%- if section.settings[k_ls] > 0 %} letter-spacing: {{ section.settings[k_ls] }}px !important;{% endif -%}
        {%- if section.settings[k_color] != blank %} color: {{ section.settings[k_color] }} !important;{% endif -%}
        {%- if section.settings[k_lh] > 0 %} line-height: {{ section.settings[k_lh] }}% !important;{% endif -%}
        {%- if section.settings[k_align] != 'default' and section.settings[k_align] != blank %} text-align: {{ section.settings[k_align] }} !important;{% endif -%}
      {%- endcapture -%}
      {%- assign grp_decl = grp_decl | strip -%}
      {%- if grp_decl != blank -%}
        #shopify-section-{{ section.id }} {{ sel }} { {{ grp_decl }} }
      {%- endif -%}
    {%- endfor -%}
    {%- if section.settings.pb_font_size_mobile > 0 -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .rte p, #shopify-section-{{ section.id }} .rte li, #shopify-section-{{ section.id }} .rte span { font-size: {{ section.settings.pb_font_size_mobile }}px !important; }
      }
    {%- endif -%}
  {%- endcapture -%}
  {%- assign page_type_css = page_type_css | strip -%}
  {%- if page_type_css != blank -%}
    <style>
      {{ page_type_css }}
    </style>
  {%- endif -%}
{%- endif -%}

<div class="page-width{% if section.settings.page_width == 'narrow' %} page-width--narrow{% endif %} section-{{ section.id }}-padding">
  {%- if section.settings.show_title -%}
    {%- assign policies_heading = 'sections.main_policy.policies_label' | t -%}
    <h1 class="main-page-title page-title h1 policy-title">{{ page.title | default: policies_heading | escape }}</h1>
  {%- endif -%}

  {%- comment -%}
    True tabs: exactly one policy panel is visible at a time, switched by
    <policy-tabs>. The section serves two contexts:
    - the consolidated page (page.policies template): tab hrefs are #<slug>
      anchors and clicks keep the URL hash in sync, so
      /pages/policies#<slug> deep links open the right tab;
    - the /policies/* pages themselves (rendered via the theme.liquid
      intercept): tab hrefs are the real sibling policy URLs, the current
      policy's panel is server-rendered active, and clicks rewrite the path
      via replaceState so each policy keeps its canonical URL.
    The tab row is presence-activated like collection-tabs (needs at least
    two policies); the noscript override below restores the stacked
    all-policies view without JS (on /policies/* the tabs then degrade to
    plain links between the real policy pages). Slugs come from each policy
    URL's last segment (/policies/privacy-policy -> privacy-policy).
  {%- endcomment -%}
  {%- liquid
    assign policy_count = 0
    for shop_policy in shop.policies
      if shop_policy.title != blank
        assign policy_count = policy_count | plus: 1
      endif
    endfor

    comment
      Third context: the CCPA opt-out page (/pages/data-sharing-opt-out)
      rides the same theme.liquid intercept so it shares this tab row.
      Policy tabs get real /policies/* hrefs there; no policy panels render,
      so policy-tabs.js sees < 2 panels and leaves every tab a plain link.
    endcomment
    assign is_privacy_choices = false
    if request.page_type == 'page' and page.handle == 'data-sharing-opt-out'
      assign is_privacy_choices = true
    endif

    assign active_slug = ''
    if request.page_type == 'policy'
      assign request_slug = request.path | split: '/' | last
      for shop_policy in shop.policies
        if shop_policy.title == blank
          continue
        endif
        assign policy_slug = shop_policy.url | split: '/' | last
        if policy_slug == request_slug
          assign active_slug = request_slug
        endif
      endfor
    endif
  -%}

  {%- if policy_count > 1 -%}
    <policy-tabs>
      <nav class="policy-tabs" aria-label="{{ 'sections.main_policy.policies_label' | t }}">
        {%- for shop_policy in shop.policies -%}
          {%- if shop_policy.title == blank -%}{%- continue -%}{%- endif -%}
          {%- assign policy_slug = shop_policy.url | split: '/' | last -%}
          {%- if request.page_type == 'policy' or is_privacy_choices -%}
            {%- assign tab_href = shop_policy.url -%}
          {%- else -%}
            {%- assign tab_href = '#' | append: policy_slug -%}
          {%- endif -%}
          <a class="policy-tabs__tab" href="{{ tab_href }}" data-slug="{{ policy_slug }}"{% if policy_slug == active_slug and active_slug != blank %} aria-current="page"{% endif %}>{{ shop_policy.title | escape }}</a>
        {%- endfor -%}
        {%- comment -%}
          Nav-only tab for the CCPA opt-out page. No data-slug on purpose:
          policy-tabs.js only collects a[data-slug], so this stays a plain
          link and the tabs/panels count check is unaffected. Never rendered
          as a panel here — the page body carries the data-sale-opt-out embed
          scripts, which must not load on policy pages.
        {%- endcomment -%}
        <a class="policy-tabs__tab" href="/pages/data-sharing-opt-out"{% if page.handle == 'data-sharing-opt-out' %} aria-current="page"{% endif %}>Your Privacy Choices</a>
      </nav>
    </policy-tabs>
  {%- endif -%}

  {%- if policy_count > 1 -%}
    <noscript>
      <style>
        .policy-block[hidden] {
          display: block;
        }
      </style>
    </noscript>
  {%- endif -%}

  {%- if is_privacy_choices -%}
    {%- comment -%}
      The page body carries Shopify's data-sale-opt-out embed (CDN css/js +
      hCaptcha) — light DOM, same execution as under the main-page render.
      No h2: the H1 above already renders page.title. No id/hidden: the tab
      script never manages this panel.
    {%- endcomment -%}
    <section class="policy-block">
      <div class="rte">{{ page.content }}</div>
    </section>
  {%- else -%}
    {%- assign rendered_panels = 0 -%}
    {%- for shop_policy in shop.policies -%}
      {%- if shop_policy.title == blank -%}{%- continue -%}{%- endif -%}
      {%- assign rendered_panels = rendered_panels | plus: 1 -%}
      {%- assign policy_slug = shop_policy.url | split: '/' | last -%}
      {%- liquid
        assign panel_hidden = false
        if policy_count > 1
          if active_slug != blank
            unless policy_slug == active_slug
              assign panel_hidden = true
            endunless
          elsif rendered_panels > 1
            assign panel_hidden = true
          endif
        endif
      -%}
      <section id="{{ policy_slug }}" class="policy-block"{% if panel_hidden %} hidden{% endif %}>
        <h2 class="policy-block__title policy-title h2">{{ shop_policy.title | escape }}</h2>
        <div class="rte">
          {{ shop_policy.body }}
        </div>
      </section>
    {%- endfor -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main-policies.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "select",
      "id": "page_width",
      "label": "Page Width",
      "default": "full",
      "options": [
        {
          "label": "full",
          "value": "full"
        },
        {
          "label": "narrow",
          "value": "narrow"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_side",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Side padding (desktop)",
      "info": "0 = theme default",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_side_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Side padding (mobile)",
      "info": "Below 750px. 0 = theme default",
      "default": 0
    },
    { "type": "checkbox", "id": "show_title", "default": true, "label": "Show page title" },
    { "type": "header", "content": "Page typography" },
    { "type": "checkbox", "id": "page_enable_type", "default": false, "label": "Enable custom page typography", "info": "Styles the title, policy headings, and body copy. Leave a control at its default to inherit." },
    { "type": "header", "content": "Headings (h1–h3)", "info": "Per-level font sizes stay on the global Headings theme settings." },
    { "type": "select", "id": "ph_custom_font", "options": [ { "value": "default", "label": "None (inherit theme)" }, { "value": "ibm_plex_sans", "label": "IBM Plex Sans" }, { "value": "ibm_plex_mono", "label": "IBM Plex Mono" }, { "value": "inter", "label": "Inter" }, { "value": "geist", "label": "Geist" }, { "value": "geist_mono", "label": "Geist Mono" }, { "value": "overpass", "label": "Overpass" }, { "value": "overpass_mono", "label": "Overpass Mono" }, { "value": "dm_sans", "label": "DM Sans" }, { "value": "dm_mono", "label": "DM Mono" }, { "value": "manrope", "label": "Manrope" }, { "value": "open_sans", "label": "Open Sans" } ], "default": "default", "label": "Brand font", "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "select", "id": "ph_font_weight", "options": [ { "value": "default", "label": "Theme default" }, { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" } ], "default": "default", "label": "Font weight", "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "select", "id": "ph_text_case", "options": [ { "value": "default", "label": "Theme default" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "none", "label": "Normal (remove uppercase)" } ], "default": "default", "label": "Text case", "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "range", "id": "ph_letter_spacing", "min": 0, "max": 4, "step": 0.1, "unit": "px", "label": "Letter spacing", "info": "0 = theme default", "default": 0, "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "header", "content": "Body text" },
    { "type": "select", "id": "pb_custom_font", "options": [ { "value": "default", "label": "None (inherit theme)" }, { "value": "ibm_plex_sans", "label": "IBM Plex Sans" }, { "value": "ibm_plex_mono", "label": "IBM Plex Mono" }, { "value": "inter", "label": "Inter" }, { "value": "geist", "label": "Geist" }, { "value": "geist_mono", "label": "Geist Mono" }, { "value": "overpass", "label": "Overpass" }, { "value": "overpass_mono", "label": "Overpass Mono" }, { "value": "dm_sans", "label": "DM Sans" }, { "value": "dm_mono", "label": "DM Mono" }, { "value": "manrope", "label": "Manrope" }, { "value": "open_sans", "label": "Open Sans" } ], "default": "default", "label": "Brand font", "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "range", "id": "pb_font_size", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Font size", "info": "0 = theme default (12px)", "default": 0, "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "range", "id": "pb_font_size_mobile", "min": 0, "max": 24, "step": 1, "unit": "px", "label": "Font size (mobile)", "info": "Below 750px. 0 = same as larger screens", "default": 0, "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "range", "id": "pb_line_height", "min": 0, "max": 250, "step": 5, "unit": "%", "label": "Line height", "info": "0 = theme default", "default": 0, "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "range", "id": "pb_letter_spacing", "min": 0, "max": 4, "step": 0.1, "unit": "px", "label": "Letter spacing", "info": "0 = theme default", "default": 0, "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "select", "id": "pb_text_align", "options": [ { "value": "default", "label": "Theme default" }, { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ], "default": "default", "label": "Text alignment", "info": "Overrides alignment saved inside the policy content", "visible_if": "{{ section.settings.page_enable_type }}" },
    { "type": "color", "id": "pb_color", "label": "Text color", "info": "Leave blank to inherit", "visible_if": "{{ section.settings.page_enable_type }}" }
  ]
}
{% endschema %}
