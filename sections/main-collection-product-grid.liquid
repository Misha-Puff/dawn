{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_swatches %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{% endif %}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% comment %} Campaign view is offered only when the "Enable campaign view" checkbox is on and the section has at least one campaign block. Image and Shop-the-Look tiles render inside the grid, not the campaign view. {% endcomment %}
{% assign has_campaign = false %}
{% if section.settings.enable_campaign %}
  {% for block in section.blocks %}
    {% unless block.type == 'image' or block.type == 'shop_look_tile' %}
      {% assign has_campaign = true %}
      {% break %}
    {% endunless %}
  {% endfor %}
{% endif %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% render 'card-settings-styles' %}

  @media screen and (max-width: 1099px) {
    .collection {
      padding: 0;
    }
  }

  .editorial #product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  }

  .editorial #product-grid .grid__item {
    width: auto;
    max-width: none;
    display: block;
  }

  @media screen and (max-width: 1099px) {
    .editorial #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  .editorial-content {
    display: flex;
    height: fit-content;
  }

  .editorial-content img {
    width: 100%;
  }

  .editorial-content .editorial-overlay {
    padding: 1.5rem;
  }

  .editorial-content .editorial-overlay.content--top-left {
    position: absolute;
    top: 0;
    left: 0;
  }

  .editorial-content .editorial-overlay.content--top-center {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, 0);
  }

  .editorial-content .editorial-overlay.content--top-right {
    position: absolute;
    top: 0;
    right: 0;
  }

  .editorial-content .editorial-overlay.content--middle-left {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(0, -50%);
  }

  .editorial-content .editorial-overlay.content--middle-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .editorial-content .editorial-overlay.content--middle-right {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translate(0, -50%);
  }

  .editorial-content .editorial-overlay.content--bottom-left {
    position: absolute;
    bottom: 0;
    left: 0;
  }

  .editorial-content .editorial-overlay.content--bottom-center {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 0);
  }

  .editorial-content .editorial-overlay.content--bottom-right {
    position: absolute;
    bottom: 0;
    right: 0;
  }

  {% for block in section.blocks %}
    {%- if block.type == 'image' or block.type == 'shop_look_tile' -%}
    @media screen and (min-width: 1100px) {
      .Block-{{ block.id }} {
        grid-column-start: {{ block.settings.col_start_desktop }};
        grid-column-end: span {{ block.settings.col_span_desktop }};
        grid-row-start: {{ block.settings.row_start_desktop }};
        grid-row-end: span {{ block.settings.row_span_desktop }};
      }
    }

    @media screen and (max-width: 1099px) {
      .Block-{{ block.id }} {
        grid-column-start: {{ block.settings.col_start_mobile }};
        grid-column-end: span {{ block.settings.col_span_mobile }};
        grid-row-start: {{ block.settings.row_start_mobile }};
        grid-row-end: span {{ block.settings.row_span_mobile }};
      }
    }
    {%- endif -%}

    {%- if block.type == 'image' -%}
    .Block-{{ block.id }} .editorial-overlay {
      color: {{ block.settings.text_color }};
      padding: {{ block.settings.text_vertical_padding }}px {{ block.settings.text_horizontal_padding }}px;
      font-size: {{ block.settings.text_size }}px;
    }
    {%- endif -%}
  {% endfor %}

  {% if section.settings.enable_swatches %}
    #variant-selects-{{ section.id }} {
      position: relative;
      z-index: 3;
      margin-top: 0 !important;
    }

    #variant-selects-{{ section.id }} fieldset {
      align-items: center;
    }

    #variant-selects-{{ section.id }} .product-form__input {
      flex: 0 0 100%;
      padding: 0;
      margin: 0 0 1.2rem 0;
      min-width: fit-content;
      border: none;
    }

    #variant-selects-{{ section.id }} .product-form__input .form__label {
      padding-left: 0;
    }

    #variant-selects-{{ section.id }} .product-form__input .select {
      max-width: 100%;
    }

    #variant-selects-{{ section.id }} .product-form__input--swatch .swatch-input__input + .swatch-input__label {
      margin-right: 1rem;
    }
  {% endif %}

  {%- if has_campaign -%}
    .collection-views {
      position: relative;
    }

    #view-collection-{{ section.id }},
    #view-campaign-{{ section.id }} {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .collection-view-tabs {
      display: flex;
      justify-content: {% case section.settings.view_tabs_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      gap: 2.4rem;
      margin-bottom: 2.4rem;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
    }

    .collection-view-tabs__tab {
      padding: 0 0 1.2rem;
      margin-bottom: -0.1rem;
      font-size: 1.3rem;
      letter-spacing: 0.1rem;
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.6);
      border-bottom: 0.2rem solid transparent;
      cursor: pointer;
    }

    /* Base state hides the campaign view; the campaign radio ships :checked
       (see markup), so the :checked rule below reveals it and hides the grid
       on load — Campaign is the default view. Selecting Collection unchecks it
       and restores this base state (grid shown, campaign hidden). */
    .collection-view--campaign {
      display: none;
    }

    #view-collection-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      color: rgb(var(--color-foreground));
      border-bottom-color: rgb(var(--color-foreground));
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--grid {
      display: none;
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--campaign {
      display: block;
    }

    /* Campaign content sits flush under the tab row's hairline; the grid view
       keeps the 2.4rem breathing room below the tabs. */
    #view-campaign-{{ section.id }}:checked ~ .collection-view-tabs {
      margin-bottom: 0;
    }

    #view-collection-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
      outline-offset: 0.3rem;
    }

    /* The Link tab is a real outbound anchor, not a radio state — strip the
       default underline so it matches the label tabs, and give it a hover/focus
       affordance since it never gets the :checked active color. */
    .collection-view-tabs__tab--link {
      text-decoration: none;
    }

    .collection-view-tabs__tab--link:hover,
    .collection-view-tabs__tab--link:focus-visible {
      color: rgb(var(--color-foreground));
    }

    /* Floating escape hatch back to the product grid, revealed only while the
       campaign radio is checked. Must sit as a later sibling of the radios in
       the DOM for the :checked ~ selector to reach it, even though it renders
       fixed to the viewport. Typography defaults mirror .campaign-products__cta
       (template-collection.css) minus the underline; jump_* settings override. */
    {%- liquid
      assign jump_weight = section.settings.jump_font_weight | default: 'default'
      assign jump_fs = section.settings.jump_font_size | default: 0
      assign jump_case = section.settings.jump_text_case | default: 'default'
      assign jump_ls = section.settings.jump_letter_spacing | default: 0
    -%}
    {%- capture jump_brand_stack -%}{% render 'brand-font', font: section.settings.jump_custom_font %}{%- endcapture -%}
    {%- assign jump_brand_stack = jump_brand_stack | strip -%}
    .collection-views__jump {
      display: none;
      position: fixed;
      {% case section.settings.jump_alignment -%}
        {%- when 'left' %} left: 1.6rem;
        {%- when 'right' %} right: 1.6rem;
        {%- else %} left: 50%; transform: translateX(-50%);
      {%- endcase %}
      bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px));
      z-index: 10;
      padding: 1.1rem 2rem;
      {%- if section.settings.jump_pill_enable %}
      background: rgba(255, 255, 255, 0.92);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(26, 26, 26, 0.15);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      {%- else %}
      /* Pill chrome off: match .campaign-products__cta's underlined-text look;
         the padding stays for the tap target. */
      text-decoration: underline;
      text-underline-offset: 3px;
      {%- endif %}
      font-family: {% if jump_brand_stack != blank %}{{ jump_brand_stack }}{% else %}var(--font-mono-family){% endif %};
      font-size: {% if jump_fs > 0 %}{{ jump_fs }}px{% else %}12px{% endif %};
      font-weight: {% if jump_weight != 'default' and jump_weight != blank %}{{ jump_weight }}{% else %}600{% endif %};
      letter-spacing: {% if jump_ls > 0 %}{{ jump_ls }}px{% else %}1px{% endif %};
      text-transform: {% if jump_case != 'default' and jump_case != blank %}{{ jump_case }}{% else %}uppercase{% endif %};
      color: {% if section.settings.jump_color != blank %}{{ section.settings.jump_color }}{% else %}rgb(26, 26, 26){% endif %};
      white-space: nowrap;
      cursor: pointer;
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-views__jump {
      display: block;
    }

    /* Rebuy mounts an EMPTY, transparent, pointer-events:auto 40x40 fixed
       container (#rebuy-bubble-global-alert-modal, z-index 100000) at the
       viewport bottom-center — exactly over this pill's default tap point —
       which silently swallows dead-center clicks. Neutralize it only while
       empty: if Rebuy ever renders a real alert into it, :empty stops
       matching and the container becomes interactive again. */
    #rebuy-bubble-global-alert-modal:empty {
      pointer-events: none;
    }
  {%- endif -%}

  {%- comment -%}
    Lateral collection-tabs settings (tabs_*). Every branch is gated on a
    non-default value so untouched settings emit zero CSS and the stock
    template-collection.css values stay authoritative. The first/last-child
    auto margins there are load-bearing: unlike justify-content, they keep
    tab 1 reachable by horizontal scroll when the row overflows — the left/
    right overrides below only zero out ONE side so overflow stays scrollable.
  {%- endcomment -%}
  {%- if section.settings.tabs_enable_type -%}
    {%- liquid
      assign tabs_font = section.settings.tabs_font
      assign tabs_weight = section.settings.tabs_font_weight | default: 'default'
      assign tabs_fs = section.settings.tabs_font_size | default: 0
      assign tabs_case = section.settings.tabs_text_case | default: 'default'
      assign tabs_ls = section.settings.tabs_letter_spacing | default: 0
    -%}
    {%- capture tabs_brand_stack -%}{% render 'brand-font', font: section.settings.tabs_custom_font %}{%- endcapture -%}
    {%- assign tabs_brand_stack = tabs_brand_stack | strip -%}
    {%- if tabs_font != blank and tabs_brand_stack == blank -%}{{ tabs_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if tabs_font != blank and tabs_brand_stack == blank and tabs_weight != 'default' -%}
      {%- assign tabs_wfont = tabs_font | font_modify: 'weight', tabs_weight -%}
      {%- if tabs_wfont -%}{{ tabs_wfont | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endif -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab {
      {%- if tabs_brand_stack != blank %} font-family: {{ tabs_brand_stack }};{% elsif tabs_font != blank %} font-family: {{ tabs_font.family }}, {{ tabs_font.fallback_families }};{% endif -%}
      {%- if tabs_weight != 'default' and tabs_weight != blank %} font-weight: {{ tabs_weight }};{% endif -%}
      {%- if tabs_fs > 0 %} font-size: {{ tabs_fs }}px;{% endif -%}
      {%- if tabs_case != 'default' and tabs_case != blank %} text-transform: {{ tabs_case }};{% endif -%}
      {%- if tabs_ls > 0 %} letter-spacing: {{ tabs_ls }}px;{% endif -%}
      {%- if section.settings.tabs_color != blank %} color: {{ section.settings.tabs_color }};{% endif -%}
    }
    {%- assign tabs_fs_m = section.settings.tabs_font_size_mobile | default: 0 -%}
    {%- if tabs_fs_m > 0 -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .collection-tabs__tab {
          font-size: {{ tabs_fs_m }}px;
        }
      }
    {%- endif -%}
  {%- endif -%}
  {%- liquid
    assign tabs_gap = section.settings.tabs_gap | default: 0
    assign tabs_mb = section.settings.tabs_margin_bottom | default: 0
    assign tabs_pb = section.settings.tabs_padding_bottom | default: 0
    assign tabs_rail = section.settings.tabs_divider_thickness | default: 0
    assign tabs_underline = section.settings.tabs_underline_thickness | default: 0
  -%}
  {%- if tabs_gap > 0 or tabs_mb > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs {
      {%- if tabs_gap > 0 %} gap: {{ tabs_gap }}px;{% endif -%}
      {%- if tabs_mb > 0 %} margin-bottom: {{ tabs_mb }}px;{% endif -%}
    }
  {%- endif -%}
  {%- assign tabs_gap_m = section.settings.tabs_gap_mobile | default: 0 -%}
  {%- if tabs_gap_m > 0 -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .collection-tabs { gap: {{ tabs_gap_m }}px; }
    }
  {%- endif -%}
  {%- if tabs_pb > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab { padding-bottom: {{ tabs_pb }}px; }
  {%- endif -%}
  {%- if section.settings.tabs_alignment == 'left' -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab:first-child { margin-left: 0; }
  {%- elsif section.settings.tabs_alignment == 'right' -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab:last-child { margin-right: 0; }
  {%- endif -%}
  {%- if section.settings.tabs_divider_enable -%}
    {%- if tabs_rail > 0 or section.settings.tabs_divider_color != blank -%}
      #shopify-section-{{ section.id }} .collection-tabs {
        {%- if tabs_rail > 0 %} border-bottom-width: {{ tabs_rail }}px;{% endif -%}
        {%- if section.settings.tabs_divider_color != blank %} border-bottom-color: {{ section.settings.tabs_divider_color }};{% endif -%}
      }
    {%- endif -%}
    {%- if tabs_rail > 0 -%}
      #shopify-section-{{ section.id }} .collection-tabs__tab { margin-bottom: -{{ tabs_rail }}px; }
    {%- endif -%}
  {%- else -%}
    #shopify-section-{{ section.id }} .collection-tabs { border-bottom: 0; }
    #shopify-section-{{ section.id }} .collection-tabs__tab { margin-bottom: 0; }
  {%- endif -%}
  {%- if tabs_underline > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab { border-bottom-width: {{ tabs_underline }}px; }
  {%- endif -%}
{%- endstyle -%}

{% assign has_filters = false %}

{% for filter in collection.filters %}
  {% if filter.type == 'price_range' %}
    {% if filter.min_value.value or filter.max_value.value %}
      {% assign has_filters = true %}
      {% break %}
    {% endif %}
  {% else %}
    {% if filter.active_values.size > 0 %}
      {% assign has_filters = true %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}

<div class="section-{{ section.id }}-padding card-redesign gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- comment -%}
      Lateral-shopping tabs live OUTSIDE #ProductGridContainer so facet AJAX
      never touches them, and above the Collection / Campaign toggle so they
      persist across both views.
    {%- endcomment -%}
    {% render 'collection-tabs', collection: collection %}
    {%- comment -%}
      Collection / Campaign toggle. The radios and the campaign view live OUTSIDE
      #ProductGridContainer so facet AJAX (which swaps that element's innerHTML)
      never touches the radios' :checked state or the campaign DOM. The radios,
      tabs, grid view and campaign view are all direct siblings, so the toggle is
      CSS-first (#view-*:checked ~ ...); a small progressive script layers on
      ?display= deep links and keeps the URL in sync with the selected view.
    {%- endcomment -%}
    {%- if has_campaign -%}
      <div class="collection-views">
        <input
          type="radio"
          class="collection-views__radio"
          name="collection-view-{{ section.id }}"
          id="view-campaign-{{ section.id }}"
          checked
        >
        <input
          type="radio"
          class="collection-views__radio"
          name="collection-view-{{ section.id }}"
          id="view-collection-{{ section.id }}"
        >
        {%- capture campaign_tab_html -%}
          <label class="collection-view-tabs__tab" for="view-campaign-{{ section.id }}">
            {{ 'sections.collection_template.view_campaign' | t }}
          </label>
        {%- endcapture -%}
        {%- capture collection_tab_html -%}
          <label class="collection-view-tabs__tab" for="view-collection-{{ section.id }}">
            {{ 'sections.collection_template.view_collection' | t }}
          </label>
        {%- endcapture -%}
        <div class="collection-view-tabs page-width">
          {%- if section.settings.view_tabs_order == 'collection_first' -%}
            {{ collection_tab_html }}{{ campaign_tab_html }}
          {%- else -%}
            {{ campaign_tab_html }}{{ collection_tab_html }}
          {%- endif -%}
          {%- if section.settings.link_tab_url != blank -%}
            <a
              class="collection-view-tabs__tab collection-view-tabs__tab--link"
              href="{{ section.settings.link_tab_url }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ section.settings.link_tab_label | default: 'Link' }}
            </a>
          {%- endif -%}
        </div>
        <script>
          // Ambient campaign videos carry the autoplay attribute, but autoplay
          // fires while the campaign view is still display:none and never
          // starts. Progressive nudge: play them when the campaign radio is
          // selected (videos are muted + playsinline; without JS they show
          // their first frame).
          (function () {
            var campaign = document.getElementById('view-campaign-{{ section.id }}');
            var grid = document.getElementById('view-collection-{{ section.id }}');
            if (!campaign || !grid) return;

            // Deep link (?display=collection|campaign): runs during parse,
            // before either view's DOM exists below, so the :checked CSS state
            // is correct before first paint. "view" is Shopify-reserved.
            var v = new URLSearchParams(window.location.search).get('display');
            if (v === 'collection') grid.checked = true;
            else if (v === 'campaign') campaign.checked = true;

            var play = function () {
              if (!campaign.checked) return;
              document
                .querySelectorAll('.campaign-hero__ambient, .campaign-lifestyle__ambient')
                .forEach(function (v) {
                  v.play().catch(function () {});
                });
            };

            // Keep the address bar a shareable deep link. replaceState only (no
            // new history entries); pass history.state through so facets.js
            // popstate payloads ({ searchParams }) are never clobbered.
            var syncURL = function () {
              var url = new URL(window.location.href);
              if (grid.checked) url.searchParams.set('display', 'collection');
              else url.searchParams.delete('display');
              history.replaceState(history.state, '', url);
            };

            document.querySelectorAll('input[name="collection-view-{{ section.id }}"]').forEach(function (r) {
              r.addEventListener('change', play);
              r.addEventListener('change', syncURL);
            });

            // The floating jump link swaps views via native label->radio
            // behavior (which also fires syncURL above); JS only adds the
            // scroll back to top. Bound on the label, not the radios' change,
            // so clicking the top Collection tab doesn't also scroll. The
            // label sits at the END of the wrapper (the :checked ~ CSS needs
            // it after the radios) so it doesn't exist yet while this script
            // parses — defer the lookup; on editor re-renders the DOM is
            // already complete and the fresh node binds immediately.
            var bindJump = function () {
              var jump = document.querySelector('label[for="view-collection-{{ section.id }}"].collection-views__jump');
              if (jump) {
                jump.addEventListener('click', function () {
                  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                  window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
                });
              }
            };
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindJump);
            else bindJump();
            play();
          })();
        </script>
        <div class="collection-view collection-view--grid">
    {%- endif -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      {% comment %}
        collection-tabs.js loads BEFORE facets.js so its popstate listener
        registers first — it reconciles FacetFiltersForm's history state before
        facets' own listener fires on a cross-collection back/forward.
      {% endcomment %}
      <script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}{% if section.blocks.size > 0 %} editorial{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {%- if paginate.current_page == 1 and has_filters == false -%}
                {% for block in section.blocks %}
                  {%- if block.type == 'image' -%}
                  {% if block.settings.image != null %}
                    <li
                      class="editorial-content Block-{{ block.id }} grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% if block.settings.mobile_image != null %} is-hidden-mobile-only{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% if block.settings.link %}
                        <a href="{{ block.settings.link }}">
                      {% endif %}
                      {{ block.settings.image | image_url: width: 5760 | image_tag: width: block.settings.image.width }}
                      {% if block.settings.link %}
                        </a>
                      {% endif %}
                      {% if block.settings.content %}
                        <div class="editorial-overlay content--{{ block.settings.content_position }}">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}

                  {% if block.settings.mobile_image != null %}
                    <li
                      class="editorial-content Block-{{ block.id }} grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% if block.settings.image != null %} is-hidden-desktop-only{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% if block.settings.link %}
                        <a href="{{ block.settings.link }}">
                      {% endif %}
                      {{
                        block.settings.mobile_image
                        | image_url: width: 5760
                        | image_tag: width: block.settings.mobile_image.width
                      }}
                      {% if block.settings.link %}
                        </a>
                      {% endif %}
                      {% if block.settings.content %}
                        <div class="editorial-overlay content--{{ block.settings.content_position }}">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}
                  {%- elsif block.type == 'shop_look_tile' -%}
                    {% render 'shop-the-look-tile', block: block, section: section, animation_order: forloop.index %}
                  {%- endif -%}
                {% endfor %}
              {%- endif -%}

              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                {% assign lock_content = lock_content | strip %}
                {% if lock_content == 'true' %}
                  {% continue %}
                {% endif %}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}

                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    quick_add_mobile_only: section.settings.quick_add_mobile_only,
                    section_id: section.id,
                    show_swatches_availability: true,
                    size_overlay: section.settings.show_size_overlay
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if has_campaign -%}
        </div>
        {%- comment -%} /.collection-view--grid {%- endcomment -%}

        <div
          class="collection-view collection-view--campaign page-width"
          {% if section.settings.campaign_gap != blank %}
            style="--campaign-gap: {{ section.settings.campaign_gap }}px"
          {% endif %}
        >
          {%- assign campaign_styles_loaded = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'campaign_hero' -%}
                {%- capture cb_style -%}
                  {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                  {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                {%- endcapture -%}
                <div
                  class="campaign-block campaign-hero{% if block.settings.video_url != blank %} campaign-hero--ambient campaign-block--sized{% endif %}"
                  {% if block.settings.video_url != blank %}
                    style="--cb-w:100vw;--cb-wm:100vw;{{ cb_style }}"
                  {% elsif cb_style != blank %}
                    style="{{ cb_style }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="campaign-hero__media{% if block.settings.full_screen %} campaign-hero__media--full{% endif %}">
                    {%- if block.settings.video_url != blank -%}
                      <video
                        class="campaign-hero__ambient"
                        autoplay
                        loop
                        muted
                        playsinline
                        aria-hidden="true"
                        {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1500 }}"{% endif %}
                      >
                        <source src="{{ block.settings.video_url | escape }}">
                      </video>
                      {%- if block.settings.overlay_eyebrow != blank or block.settings.overlay_image != blank -%}
                        <div class="campaign-hero__overlay">
                          {%- if block.settings.overlay_eyebrow != blank -%}
                            <p class="campaign-hero__eyebrow">{{ block.settings.overlay_eyebrow | escape }}</p>
                          {%- endif -%}
                          {%- if block.settings.overlay_image != blank -%}
                            {{
                              block.settings.overlay_image
                              | image_url: width: 2000
                              | image_tag:
                                loading: 'eager',
                                sizes: '100vw',
                                widths: '750, 1100, 1500, 2000',
                                class: 'campaign-hero__overlay-image'
                            }}
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    {%- elsif block.settings.video != blank -%}
                      {%- assign hero_poster = block.settings.video.preview_image | default: block.settings.image -%}
                      <video
                        class="campaign-hero__video"
                        controls
                        playsinline
                        preload="none"
                        {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1500 }}"{% endif %}
                      >
                        {%- for source in block.settings.video.sources -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                      </video>
                    {%- elsif block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-hero__image'
                      }}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
                    <div class="campaign-hero__content">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="campaign-hero__heading inline-richtext {{ block.settings.heading_size }}">
                          {{ block.settings.heading }}
                        </h2>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <div class="campaign-hero__text rte">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.button_label != blank -%}
                        <a
                          class="button"
                          {% if block.settings.button_link != blank %}
                            href="{{ block.settings.button_link }}"
                          {% else %}
                            role="link" aria-disabled="true"
                          {% endif %}
                        >
                          {{- block.settings.button_label | escape -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- when 'campaign_text' -%}
                <div class="campaign-block campaign-text" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-text__heading inline-richtext {{ block.settings.heading_size }}">
                      {{ block.settings.heading }}
                    </h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="campaign-text__body rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- when 'campaign_lifestyle' -%}
                {%- capture cb_style -%}
                  {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}vw;{%- endif -%}
                  {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}vw;{%- endif -%}
                  {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                  {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                {%- endcapture -%}
                <div
                  class="campaign-block campaign-lifestyle{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
                  {% if cb_style != blank %}
                    style="{{ cb_style }}"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.video_url != blank -%}
                    <div class="campaign-lifestyle__media">
                      <video class="campaign-lifestyle__ambient" autoplay loop muted playsinline aria-hidden="true">
                        <source src="{{ block.settings.video_url | escape }}">
                      </video>
                    </div>
                  {%- elsif block.settings.image != blank -%}
                    <div class="campaign-lifestyle__media">
                      {{
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-lifestyle__image'
                      }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-lifestyle__heading inline-richtext">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.product_list != blank -%}
                    <ul class="campaign-lifestyle__callouts list-unstyled" role="list">
                      {%- for callout in block.settings.product_list -%}
                        <li>
                          <a class="campaign-lifestyle__callout" href="{{ callout.url }}">
                            <span class="campaign-lifestyle__callout-title">{{ callout.title | escape }}</span>
                            <span class="campaign-lifestyle__callout-price">{{ callout.price | money }}</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- when 'campaign_collage' -%}
                {%- capture cb_style -%}
                  {%- if block.settings.col1_pct != blank -%}--c1-w:{{ block.settings.col1_pct }}vw;{%- endif -%}
                  {%- if block.settings.col2_pct != blank -%}--c2-w:{{ block.settings.col2_pct }}vw;{%- endif -%}
                  {%- if block.settings.col1_pct_mobile != blank -%}--c1-wm:{{ block.settings.col1_pct_mobile }}vw;{%- endif -%}
                  {%- if block.settings.col2_pct_mobile != blank -%}--c2-wm:{{ block.settings.col2_pct_mobile }}vw;{%- endif -%}
                  {%- if block.settings.col1_offset != blank -%}--c1-off:{{ block.settings.col1_offset }}px;{%- endif -%}
                  {%- if block.settings.col2_offset != blank -%}--c2-off:{{ block.settings.col2_offset }}px;{%- endif -%}
                  {%- if block.settings.col1_offset_mobile != blank -%}--c1-offm:{{ block.settings.col1_offset_mobile }}px;{%- endif -%}
                  {%- if block.settings.col2_offset_mobile != blank -%}--c2-offm:{{ block.settings.col2_offset_mobile }}px;{%- endif -%}
                  {%- if block.settings.col1_gap != blank -%}--c1-gap:{{ block.settings.col1_gap }}px;{%- endif -%}
                  {%- if block.settings.col1_ratio != blank -%}--c1-ar:{{ block.settings.col1_ratio }};{%- endif -%}
                  {%- if block.settings.col2_ratio != blank -%}--c2-ar:{{ block.settings.col2_ratio }};{%- endif -%}
                  {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                  {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                {%- endcapture -%}
                <div
                  class="campaign-block campaign-block--sized campaign-collage campaign-collage--{{ block.settings.layout }}{% if block.settings.valign == 'bottom' %} campaign-collage--bottom{% endif %}{% if block.settings.first_flush %} campaign-collage--flush-first{% endif %}{% if block.settings.second_flush %} campaign-collage--flush-second{% endif %}"
                  style="--cb-w:100vw;--cb-wm:100vw;{{ cb_style }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.layout != 'images' -%}
                    {%- if block.settings.eyebrow != blank or block.settings.heading != blank -%}
                      <div class="campaign-collage__text">
                        {%- if block.settings.eyebrow != blank -%}
                          <p class="campaign-collage__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.heading != blank -%}
                          <h2 class="campaign-collage__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.image_1 != blank -%}
                    <div class="campaign-collage__col campaign-collage__col--first">
                      {{
                        block.settings.image_1
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '60vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-collage__image'
                      }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.image_2 != blank and block.settings.layout != 'image_text' -%}
                    <div class="campaign-collage__col campaign-collage__col--second">
                      {{
                        block.settings.image_2
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '60vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-collage__image'
                      }}
                    </div>
                  {%- endif -%}
                </div>
              {%- when 'campaign_products' -%}
                {%- liquid
                  assign cp_products = block.settings.product_list
                  assign cp_limit = 12
                  if cp_products == blank and block.settings.source_collection != blank
                    assign cp_products = block.settings.source_collection.products
                    assign cp_limit = block.settings.products_to_show
                  endif
                -%}
                {%- capture cb_style -%}
                  {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}vw;{%- endif -%}
                  {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}vw;{%- endif -%}
                  {%- if block.settings.tile_gap != blank -%}--cp-gap:{{ block.settings.tile_gap }}px;{%- endif -%}
                  {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                  {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                  {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                  --cp-cols:{{ block.settings.columns_desktop }};
                {%- endcapture -%}
                <div
                  class="campaign-block campaign-products campaign-products--{{ block.settings.display }}{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
                  style="{{ cb_style }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-products__heading inline-richtext">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if cp_products != blank -%}
                    {%- if block.settings.display == 'theme' -%}
                      <ul
                        class="campaign-products__grid grid product-grid list-unstyled grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ block.settings.columns_desktop }}-col-desktop"
                        role="list"
                      >
                        {%- liquid
                          assign cp_shown = 0
                        -%}
                        {%- for product in cp_products -%}
                          {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                          {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                          {%- assign lock_content = lock_content | strip -%}
                          {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                          {%- assign cp_shown = cp_shown | plus: 1 -%}
                          <li class="grid__item">
                            {% render 'card-product',
                              card_product: product,
                              media_aspect_ratio: section.settings.image_ratio,
                              image_shape: section.settings.image_shape,
                              show_secondary_image: section.settings.show_secondary_image,
                              show_vendor: section.settings.show_vendor,
                              show_rating: section.settings.show_rating,
                              lazy_load: true,
                              skip_styles: campaign_styles_loaded,
                              quick_add: 'none',
                              section_id: section.id,
                              show_swatches_availability: true,
                              size_overlay: section.settings.show_size_overlay
                            %}
                          </li>
                          {%- assign campaign_styles_loaded = true -%}
                        {%- endfor -%}
                      </ul>
                    {%- else -%}
                      <ul class="campaign-products__row list-unstyled" role="list">
                        {%- liquid
                          assign cp_shown = 0
                        -%}
                        {%- for product in cp_products -%}
                          {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                          {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                          {%- assign lock_content = lock_content | strip -%}
                          {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                          {%- assign cp_shown = cp_shown | plus: 1 -%}
                          <li class="campaign-products__cell">
                            <a href="{{ product.url }}" class="campaign-products__card">
                              <div class="campaign-products__media">
                                {%- if product.featured_media != blank -%}
                                  {{
                                    product.featured_media
                                    | image_url: width: 800
                                    | image_tag:
                                      loading: 'lazy',
                                      sizes: '(min-width: 750px) 30vw, 34vw',
                                      widths: '375, 550, 800',
                                      class: 'campaign-products__img'
                                  }}
                                {%- endif -%}
                                {%- if block.settings.display == 'cards' and product.media[1] != null -%}
                                  {{
                                    product.media[1]
                                    | image_url: width: 800
                                    | image_tag:
                                      loading: 'lazy',
                                      sizes: '(min-width: 750px) 30vw, 34vw',
                                      widths: '375, 550, 800',
                                      class: 'campaign-products__img campaign-products__img--hover'
                                  }}
                                {%- endif -%}
                              </div>
                              {%- if block.settings.display == 'cards' -%}
                                <div class="campaign-products__meta">
                                  <span class="campaign-products__title">{{ product.title | escape }}</span>
                                  <span class="campaign-products__price">{{ product.price | money }}</span>
                                </div>
                              {%- endif -%}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- endif -%}
                  {%- if block.settings.cta_label != blank -%}
                    <div class="campaign-products__cta-wrap">
                      <a
                        class="campaign-products__cta"
                        {% if block.settings.cta_link != blank %}
                          href="{{ block.settings.cta_link }}"
                        {% endif %}
                      >
                        {{- block.settings.cta_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.jump_link_enable and section.settings.jump_link_label != blank -%}
          <label class="collection-views__jump" for="view-collection-{{ section.id }}">
            {{- section.settings.jump_link_label | escape -}}
          </label>
        {%- endif -%}
      </div>
      {%- comment -%} /.collection-views {%- endcomment -%}
    {%- endif -%}
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

