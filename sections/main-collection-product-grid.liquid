{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_swatches %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{% endif %}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- if section.settings.quick_add == 'bulk' -%}
  <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% comment %} Campaign view is offered only when the section has at least one campaign block. Image and Shop-the-Look tiles render inside the grid, not the campaign view. {% endcomment %}
{% assign has_campaign = false %}
{% for block in section.blocks %}
  {% unless block.type == 'image' or block.type == 'shop_look_tile' %}
    {% assign has_campaign = true %}
    {% break %}
  {% endunless %}
{% endfor %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% render 'card-settings-styles' %}

  @media screen and (max-width: 1099px) {
    .collection {
      padding: 0;
    }
  }

  .editorial #product-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  }

  .editorial #product-grid .grid__item {
    width: auto;
    max-width: none;
    display: block;
  }

  @media screen and (max-width: 1099px) {
    .editorial #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  .editorial-content {
    display: flex;
    height: fit-content;
  }

  .editorial-content img {
    width: 100%;
  }

  .editorial-content .editorial-overlay {
    padding: 1.5rem;
  }

  .editorial-content .editorial-overlay.content--top-left {
    position: absolute;
    top: 0;
    left: 0;
  }

  .editorial-content .editorial-overlay.content--top-center {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, 0);
  }

  .editorial-content .editorial-overlay.content--top-right {
    position: absolute;
    top: 0;
    right: 0;
  }

  .editorial-content .editorial-overlay.content--middle-left {
    position: absolute;
    top: 50%;
    left: 0;
    transform: translate(0, -50%);
  }

  .editorial-content .editorial-overlay.content--middle-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .editorial-content .editorial-overlay.content--middle-right {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translate(0, -50%);
  }

  .editorial-content .editorial-overlay.content--bottom-left {
    position: absolute;
    bottom: 0;
    left: 0;
  }

  .editorial-content .editorial-overlay.content--bottom-center {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 0);
  }

  .editorial-content .editorial-overlay.content--bottom-right {
    position: absolute;
    bottom: 0;
    right: 0;
  }

  {% for block in section.blocks %}
    {%- if block.type == 'image' or block.type == 'shop_look_tile' -%}
    @media screen and (min-width: 1100px) {
      .Block-{{ block.id }} {
        grid-column-start: {{ block.settings.col_start_desktop }};
        grid-column-end: span {{ block.settings.col_span_desktop }};
        grid-row-start: {{ block.settings.row_start_desktop }};
        grid-row-end: span {{ block.settings.row_span_desktop }};
      }
    }

    @media screen and (max-width: 1099px) {
      .Block-{{ block.id }} {
        grid-column-start: {{ block.settings.col_start_mobile }};
        grid-column-end: span {{ block.settings.col_span_mobile }};
        grid-row-start: {{ block.settings.row_start_mobile }};
        grid-row-end: span {{ block.settings.row_span_mobile }};
      }
    }
    {%- endif -%}

    {%- if block.type == 'image' -%}
    .Block-{{ block.id }} .editorial-overlay {
      color: {{ block.settings.text_color }};
      padding: {{ block.settings.text_vertical_padding }}px {{ block.settings.text_horizontal_padding }}px;
      font-size: {{ block.settings.text_size }}px;
    }
    {%- endif -%}
  {% endfor %}

  {% if section.settings.enable_swatches %}
    #variant-selects-{{ section.id }} {
      position: relative;
      z-index: 3;
      margin-top: 0 !important;
    }

    #variant-selects-{{ section.id }} fieldset {
      align-items: center;
    }

    #variant-selects-{{ section.id }} .product-form__input {
      flex: 0 0 100%;
      padding: 0;
      margin: 0 0 1.2rem 0;
      min-width: fit-content;
      border: none;
    }

    #variant-selects-{{ section.id }} .product-form__input .form__label {
      padding-left: 0;
    }

    #variant-selects-{{ section.id }} .product-form__input .select {
      max-width: 100%;
    }

    #variant-selects-{{ section.id }} .product-form__input--swatch .swatch-input__input + .swatch-input__label {
      margin-right: 1rem;
    }
  {% endif %}

  {%- if has_campaign -%}
    .collection-views {
      position: relative;
    }

    #view-collection-{{ section.id }},
    #view-campaign-{{ section.id }} {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .collection-view-tabs {
      display: flex;
      justify-content: {% case section.settings.view_tabs_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      gap: 2.4rem;
      margin-bottom: 2.4rem;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
    }

    .collection-view-tabs__tab {
      padding: 0 0 1.2rem;
      margin-bottom: -0.1rem;
      font-size: 1.3rem;
      letter-spacing: 0.1rem;
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.6);
      border-bottom: 0.2rem solid transparent;
      cursor: pointer;
    }

    /* Default view: campaign hidden, grid shown. */
    .collection-view--campaign {
      display: none;
    }

    #view-collection-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      color: rgb(var(--color-foreground));
      border-bottom-color: rgb(var(--color-foreground));
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--grid {
      display: none;
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--campaign {
      display: block;
    }

    #view-collection-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
      outline-offset: 0.3rem;
    }
  {%- endif -%}

  {%- comment -%}
    Lateral collection-tabs settings (tabs_*). Every branch is gated on a
    non-default value so untouched settings emit zero CSS and the stock
    template-collection.css values stay authoritative. The first/last-child
    auto margins there are load-bearing: unlike justify-content, they keep
    tab 1 reachable by horizontal scroll when the row overflows — the left/
    right overrides below only zero out ONE side so overflow stays scrollable.
  {%- endcomment -%}
  {%- if section.settings.tabs_enable_type -%}
    {%- liquid
      assign tabs_font = section.settings.tabs_font
      assign tabs_weight = section.settings.tabs_font_weight | default: 'default'
      assign tabs_fs = section.settings.tabs_font_size | default: 0
      assign tabs_case = section.settings.tabs_text_case | default: 'default'
      assign tabs_ls = section.settings.tabs_letter_spacing | default: 0
    -%}
    {%- capture tabs_brand_stack -%}{% render 'brand-font', font: section.settings.tabs_custom_font %}{%- endcapture -%}
    {%- assign tabs_brand_stack = tabs_brand_stack | strip -%}
    {%- if tabs_font != blank and tabs_brand_stack == blank -%}{{ tabs_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if tabs_font != blank and tabs_brand_stack == blank and tabs_weight != 'default' -%}
      {%- assign tabs_wfont = tabs_font | font_modify: 'weight', tabs_weight -%}
      {%- if tabs_wfont -%}{{ tabs_wfont | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endif -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab {
      {%- if tabs_brand_stack != blank %} font-family: {{ tabs_brand_stack }};{% elsif tabs_font != blank %} font-family: {{ tabs_font.family }}, {{ tabs_font.fallback_families }};{% endif -%}
      {%- if tabs_weight != 'default' and tabs_weight != blank %} font-weight: {{ tabs_weight }};{% endif -%}
      {%- if tabs_fs > 0 %} font-size: {{ tabs_fs }}px;{% endif -%}
      {%- if tabs_case != 'default' and tabs_case != blank %} text-transform: {{ tabs_case }};{% endif -%}
      {%- if tabs_ls > 0 %} letter-spacing: {{ tabs_ls }}px;{% endif -%}
      {%- if section.settings.tabs_color != blank %} color: {{ section.settings.tabs_color }};{% endif -%}
    }
    {%- assign tabs_fs_m = section.settings.tabs_font_size_mobile | default: 0 -%}
    {%- if tabs_fs_m > 0 -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .collection-tabs__tab {
          font-size: {{ tabs_fs_m }}px;
        }
      }
    {%- endif -%}
  {%- endif -%}
  {%- liquid
    assign tabs_gap = section.settings.tabs_gap | default: 0
    assign tabs_mb = section.settings.tabs_margin_bottom | default: 0
    assign tabs_pb = section.settings.tabs_padding_bottom | default: 0
    assign tabs_rail = section.settings.tabs_divider_thickness | default: 0
    assign tabs_underline = section.settings.tabs_underline_thickness | default: 0
  -%}
  {%- if tabs_gap > 0 or tabs_mb > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs {
      {%- if tabs_gap > 0 %} gap: {{ tabs_gap }}px;{% endif -%}
      {%- if tabs_mb > 0 %} margin-bottom: {{ tabs_mb }}px;{% endif -%}
    }
  {%- endif -%}
  {%- if tabs_pb > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab { padding-bottom: {{ tabs_pb }}px; }
  {%- endif -%}
  {%- if section.settings.tabs_alignment == 'left' -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab:first-child { margin-left: 0; }
  {%- elsif section.settings.tabs_alignment == 'right' -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab:last-child { margin-right: 0; }
  {%- endif -%}
  {%- if section.settings.tabs_divider_enable -%}
    {%- if tabs_rail > 0 or section.settings.tabs_divider_color != blank -%}
      #shopify-section-{{ section.id }} .collection-tabs {
        {%- if tabs_rail > 0 %} border-bottom-width: {{ tabs_rail }}px;{% endif -%}
        {%- if section.settings.tabs_divider_color != blank %} border-bottom-color: {{ section.settings.tabs_divider_color }};{% endif -%}
      }
    {%- endif -%}
    {%- if tabs_rail > 0 -%}
      #shopify-section-{{ section.id }} .collection-tabs__tab { margin-bottom: -{{ tabs_rail }}px; }
    {%- endif -%}
  {%- else -%}
    #shopify-section-{{ section.id }} .collection-tabs { border-bottom: 0; }
    #shopify-section-{{ section.id }} .collection-tabs__tab { margin-bottom: 0; }
  {%- endif -%}
  {%- if tabs_underline > 0 -%}
    #shopify-section-{{ section.id }} .collection-tabs__tab { border-bottom-width: {{ tabs_underline }}px; }
  {%- endif -%}
{%- endstyle -%}

{% assign has_filters = false %}

{% for filter in collection.filters %}
  {% if filter.type == 'price_range' %}
    {% if filter.min_value.value or filter.max_value.value %}
      {% assign has_filters = true %}
      {% break %}
    {% endif %}
  {% else %}
    {% if filter.active_values.size > 0 %}
      {% assign has_filters = true %}
      {% break %}
    {% endif %}
  {% endif %}
{% endfor %}

<div class="section-{{ section.id }}-padding card-redesign gradient color-{{ section.settings.color_scheme }}">
  {%- paginate collection.products by section.settings.products_per_page -%}
    {%- comment -%}
      Lateral-shopping tabs live OUTSIDE #ProductGridContainer so facet AJAX
      never touches them, and above the Collection / Campaign toggle so they
      persist across both views.
    {%- endcomment -%}
    {% render 'collection-tabs', collection: collection %}
    {%- comment -%}
      Collection / Campaign toggle. The radios and the campaign view live OUTSIDE
      #ProductGridContainer so facet AJAX (which swaps that element's innerHTML)
      never touches the radios' :checked state or the campaign DOM. The radios,
      tabs, grid view and campaign view are all direct siblings, so the toggle is
      pure CSS (#view-*:checked ~ ...). No JS.
    {%- endcomment -%}
    {%- if has_campaign -%}
      <div class="collection-views">
        <input
          type="radio"
          class="collection-views__radio"
          name="collection-view-{{ section.id }}"
          id="view-collection-{{ section.id }}"
          checked
        >
        <input
          type="radio"
          class="collection-views__radio"
          name="collection-view-{{ section.id }}"
          id="view-campaign-{{ section.id }}"
        >
        <div class="collection-view-tabs page-width">
          <label class="collection-view-tabs__tab" for="view-collection-{{ section.id }}">
            {{ 'sections.collection_template.view_collection' | t }}
          </label>
          <label class="collection-view-tabs__tab" for="view-campaign-{{ section.id }}">
            {{ 'sections.collection_template.view_campaign' | t }}
          </label>
        </div>
        <div class="collection-view collection-view--grid">
    {%- endif -%}
    {% comment %} Sort is the first tabbable element when filter type is vertical {% endcomment %}
    {%- if section.settings.enable_sorting and section.settings.filter_type == 'vertical' -%}
      <facet-filters-form class="facets facets-vertical-sort page-width small-hide">
        <form class="facets-vertical-form" id="FacetSortForm">
          <div class="facet-filters sorting caption">
            <div class="facet-filters__field">
              <h2 class="facet-filters__label caption-large text-body">
                <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
              </h2>
              <div class="select">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                <select
                  name="sort_by"
                  class="facet-filters__sort select__select caption-large"
                  id="SortBy"
                  aria-describedby="a11y-refresh-page-message"
                >
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value | escape }}"
                      {% if option.value == sort_by %}
                        selected="selected"
                      {% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="svg-wrapper">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </div>
            </div>
          </div>

          <div class="product-count-vertical light" role="status">
            <h2 class="product-count__text text-body">
              <span id="ProductCountDesktop">
                {%- if collection.results_count -%}
                  {{
                    'templates.search.results_with_count'
                    | t: terms: collection.terms, count: collection.results_count
                  }}
                {%- elsif collection.products_count == collection.all_products_count -%}
                  {{ 'products.facets.product_count_simple' | t: count: collection.products_count }}
                {%- else -%}
                  {{
                    'products.facets.product_count'
                    | t: product_count: collection.products_count, count: collection.all_products_count
                  }}
                {%- endif -%}
              </span>
            </h2>
            {%- render 'loading-spinner' -%}
          </div>
        </form>
      </facet-filters-form>
    {%- endif -%}

    <div class="{% if section.settings.filter_type == 'vertical' %} facets-vertical page-width{% endif %}">
      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        <aside
          aria-labelledby="verticalTitle"
          class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
          id="main-collection-filters"
          data-id="{{ section.id }}"
        >
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: section.settings.filter_type,
            paginate: paginate
          %}
        </aside>
      {%- endif -%}

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        id="ProductGridContainer"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        {%- if collection.products.size == 0 -%}
          <div class="collection collection--empty page-width" id="product-grid" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t -}}
                <br>
                {{
                  'sections.collection_template.use_fewer_filters_html'
                  | t: link: collection.url, class: 'underlined-link link'
                }}
              </h2>
            </div>
          </div>
        {%- else -%}
          <div
            class="collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}{% if section.blocks.size > 0 %} editorial{% endif %}"
          >
            <div class="loading-overlay gradient"></div>
            <ul
              id="product-grid"
              data-id="{{ section.id }}"
              class="
                grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
                grid--{{ section.settings.columns_desktop }}-col-desktop
                {% if section.settings.quick_add == 'bulk' %} collection-quick-add-bulk{% endif %}
              "
            >
              {%- if paginate.current_page == 1 and has_filters == false -%}
                {% for block in section.blocks %}
                  {%- if block.type == 'image' -%}
                  {% if block.settings.image != null %}
                    <li
                      class="editorial-content Block-{{ block.id }} grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% if block.settings.mobile_image != null %} is-hidden-mobile-only{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% if block.settings.link %}
                        <a href="{{ block.settings.link }}">
                      {% endif %}
                      {{ block.settings.image | image_url: width: 5760 | image_tag: width: block.settings.image.width }}
                      {% if block.settings.link %}
                        </a>
                      {% endif %}
                      {% if block.settings.content %}
                        <div class="editorial-overlay content--{{ block.settings.content_position }}">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}

                  {% if block.settings.mobile_image != null %}
                    <li
                      class="editorial-content Block-{{ block.id }} grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}{% if block.settings.image != null %} is-hidden-desktop-only{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                        style="--animation-order: {{ forloop.index }};"
                      {% endif %}
                    >
                      {% if block.settings.link %}
                        <a href="{{ block.settings.link }}">
                      {% endif %}
                      {{
                        block.settings.mobile_image
                        | image_url: width: 5760
                        | image_tag: width: block.settings.mobile_image.width
                      }}
                      {% if block.settings.link %}
                        </a>
                      {% endif %}
                      {% if block.settings.content %}
                        <div class="editorial-overlay content--{{ block.settings.content_position }}">
                          {{ block.settings.content }}
                        </div>
                      {% endif %}
                    </li>
                  {% endif %}
                  {%- elsif block.type == 'shop_look_tile' -%}
                    {% render 'shop-the-look-tile', block: block, section: section, animation_order: forloop.index %}
                  {%- endif -%}
                {% endfor %}
              {%- endif -%}

              {% assign skip_card_product_styles = false %}
              {%- for product in collection.products -%}
                {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                {% assign lock_content = lock_content | strip %}
                {% if lock_content == 'true' %}
                  {% continue %}
                {% endif %}
                {% assign lazy_load = false %}
                {%- if forloop.index > 2 -%}
                  {%- assign lazy_load = true -%}
                {%- endif -%}

                <li
                  class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    image_shape: section.settings.image_shape,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: section.settings.show_vendor,
                    show_rating: section.settings.show_rating,
                    lazy_load: lazy_load,
                    skip_styles: skip_card_product_styles,
                    quick_add: section.settings.quick_add,
                    quick_add_mobile_only: section.settings.quick_add_mobile_only,
                    section_id: section.id,
                    show_swatches_availability: true,
                    size_overlay: section.settings.show_size_overlay,
                    hide_color_suffix: true
                  %}
                </li>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              {% render 'pagination', paginate: paginate, anchor: '' %}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if has_campaign -%}
        </div>
        {%- comment -%} /.collection-view--grid {%- endcomment -%}

        <div class="collection-view collection-view--campaign page-width">
          {%- assign campaign_styles_loaded = false -%}
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'campaign_hero' -%}
                <div class="campaign-block campaign-hero" {{ block.shopify_attributes }}>
                  <div class="campaign-hero__media">
                    {%- if block.settings.video != blank -%}
                      {%- assign hero_poster = block.settings.video.preview_image | default: block.settings.image -%}
                      <video
                        class="campaign-hero__video"
                        controls
                        playsinline
                        preload="none"
                        {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1500 }}"{% endif %}
                      >
                        {%- for source in block.settings.video.sources -%}
                          <source src="{{ source.url }}" type="{{ source.mime_type }}">
                        {%- endfor -%}
                      </video>
                    {%- elsif block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-hero__image'
                      }}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
                    <div class="campaign-hero__content">
                      {%- if block.settings.heading != blank -%}
                        <h2 class="campaign-hero__heading inline-richtext {{ block.settings.heading_size }}">
                          {{ block.settings.heading }}
                        </h2>
                      {%- endif -%}
                      {%- if block.settings.text != blank -%}
                        <div class="campaign-hero__text rte">{{ block.settings.text }}</div>
                      {%- endif -%}
                      {%- if block.settings.button_label != blank -%}
                        <a
                          class="button"
                          {% if block.settings.button_link != blank %}
                            href="{{ block.settings.button_link }}"
                          {% else %}
                            role="link" aria-disabled="true"
                          {% endif %}
                        >
                          {{- block.settings.button_label | escape -}}
                        </a>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- when 'campaign_text' -%}
                <div class="campaign-block campaign-text" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-text__heading inline-richtext {{ block.settings.heading_size }}">
                      {{ block.settings.heading }}
                    </h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="campaign-text__body rte">{{ block.settings.text }}</div>
                  {%- endif -%}
                </div>
              {%- when 'campaign_lifestyle' -%}
                <div class="campaign-block campaign-lifestyle" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    <div class="campaign-lifestyle__media">
                      {{
                        block.settings.image
                        | image_url: width: 2000
                        | image_tag:
                          loading: 'lazy',
                          sizes: '100vw',
                          widths: '375, 750, 1100, 1500, 2000',
                          class: 'campaign-lifestyle__image'
                      }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-lifestyle__heading inline-richtext">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.product_list != blank -%}
                    <ul class="campaign-lifestyle__callouts list-unstyled" role="list">
                      {%- for callout in block.settings.product_list -%}
                        <li>
                          <a class="campaign-lifestyle__callout" href="{{ callout.url }}">
                            <span class="campaign-lifestyle__callout-title">{{ callout.title | escape }}</span>
                            <span class="campaign-lifestyle__callout-price">{{ callout.price | money }}</span>
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
              {%- when 'campaign_products' -%}
                <div class="campaign-block campaign-products" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="campaign-products__heading inline-richtext">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.product_list != blank -%}
                    <ul
                      class="campaign-products__grid grid product-grid list-unstyled grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ block.settings.columns_desktop }}-col-desktop"
                      role="list"
                    >
                      {%- for product in block.settings.product_list -%}
                        <li class="grid__item">
                          {% render 'card-product',
                            card_product: product,
                            media_aspect_ratio: section.settings.image_ratio,
                            image_shape: section.settings.image_shape,
                            show_secondary_image: section.settings.show_secondary_image,
                            show_vendor: section.settings.show_vendor,
                            show_rating: section.settings.show_rating,
                            lazy_load: true,
                            skip_styles: campaign_styles_loaded,
                            quick_add: 'none',
                            section_id: section.id,
                            show_swatches_availability: true,
                            size_overlay: section.settings.show_size_overlay,
                            hide_color_suffix: true
                          %}
                        </li>
                        {%- assign campaign_styles_loaded = true -%}
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
      {%- comment -%} /.collection-views {%- endcomment -%}
    {%- endif -%}
  {%- endpaginate -%}
  {% if section.settings.image_shape == 'arch' %}
    {{ 'mask-arch.svg' | inline_asset_content }}
  {%- endif -%}
</div>

