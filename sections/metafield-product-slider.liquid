{% liquid
  if section.settings.collection.products.length > 0
    assign products = section.settings.collection.products
  else
    assign products = section.settings.product_list
  endif

  assign num_products = 0

  for product in products
    if section.settings.hide_sold_out
      assign coming_soon = false

      if product.tags contains 'Badge-Coming Soon'
        assign coming_soon = true
      endif

      unless coming_soon
        if product.available == false
          continue
        endif
      endunless
    endif

    assign num_products = num_products | plus: 1
  endfor
%}

{% unless num_products == 0 %}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}

  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'template-collection.css' | asset_url | stylesheet_tag }}

  {% if section.settings.image_shape == 'blob' %}
    {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- unless section.settings.quick_add == 'none' -%}
    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}

  {%- if section.settings.quick_add == 'standard' -%}
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if section.settings.quick_add == 'bulk' -%}
    <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- style -%}
    @media screen and (max-width: 1080px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        {% if section.settings.mobile_padding_left > 0 %}
          padding-left: {{ section.settings.mobile_padding_left  }}px;
        {% endif %}
        {% if section.settings.mobile_padding_right > 0 %}
          padding-right: {{ section.settings.mobile_padding_right  }}px;
        {% endif %}
      }
    }

    @media screen and (min-width: 1100px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.desktop_padding_top }}px;
        padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        {% if section.settings.desktop_padding_left > 0 %}
          padding-left: {{ section.settings.desktop_padding_left  }}px;
        {% endif %}
        {% if section.settings.desktop_padding_right > 0 %}
          padding-right: {{ section.settings.desktop_padding_right  }}px;
        {% endif %}
      }
    }

    {% if section.settings.enable_custom_spacing %}
      .section-{{ section.id }}-padding .grid {
        column-gap: {{ section.settings.horizontal_spacing_mobile }}px;
        row-gap: {{ section.settings.vertical_spacing_mobile }}px;
      }

      @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding .grid {
          column-gap: {{ section.settings.horizontal_spacing_desktop }}px;
          row-gap: {{ section.settings.vertical_spacing_desktop }}px;
        }

        .section-{{ section.id }}-padding .grid--6-col-desktop .grid__item {
          width: calc(16.66% - {{ section.settings.horizontal_spacing_desktop }}px * 5 / 6) !important;
          max-width: calc(16.66% - {{ section.settings.horizontal_spacing_desktop }}px * 5 / 6) !important;
        }

        .section-{{ section.id }}-padding .grid--5-col-desktop .grid__item {
          width: calc(20% - {{ section.settings.horizontal_spacing_desktop }}px * 4 / 5) !important;
          max-width: calc(20% - {{ section.settings.horizontal_spacing_desktop }}px * 4 / 5) !important;
        }

        .section-{{ section.id }}-padding .grid--4-col-desktop .grid__item {
          width: calc(25% - {{ section.settings.horizontal_spacing_desktop }}px * 3 / 4) !important;
          max-width: calc(25% - {{ section.settings.horizontal_spacing_desktop }}px * 3 / 4) !important;
        }

        .section-{{ section.id }}-padding .grid--3-col-desktop .grid__item {
          width: calc(33.33% - {{ section.settings.horizontal_spacing_desktop }}px * 2 / 3) !important;
          max-width: calc(33.33% - {{ section.settings.horizontal_spacing_desktop }}px * 2 / 3) !important;
        }

        .section-{{ section.id }}-padding .grid--2-col-desktop .grid__item {
          width: calc(50% - {{ section.settings.horizontal_spacing_desktop }}px / 2) !important;
          max-width: calc(50% - {{ section.settings.horizontal_spacing_desktop }}px / 2) !important;
        }
      }

      @media screen and (max-width: 749px){
        .section-{{ section.id }}-padding .grid--2-col-tablet-down .grid__item {
          width: calc(50% - {{ section.settings.horizontal_spacing_mobile }}px / 2);
        }
      }
    {% endif %}

    .section-{{ section.id }} .slider-buttons {
      display: none !important;
    }

    .section-{{ section.id }} .collection__title .title {
      font-size: 15px;
    }

    .section-{{ section.id }} .collection__title.title-wrapper {
      margin-bottom: {{ section.settings.heading_margin }}px !important;
    }

    .section-{{ section.id }} .collection__title .title {
      margin-bottom: 0 !important;
    }

    {%- comment -%}
      Heading-to-cards gap override, gated on enable_custom_spacing. Emitted after
      the heading_margin rule above so it wins at equal specificity. 0-sentinels:
      live instances already run with the gate on, so the defaults emit nothing.
    {%- endcomment -%}
    {%- if section.settings.enable_custom_spacing -%}
      {%- assign hg = section.settings.heading_gap_desktop | default: 0 -%}
      {%- assign hg_m = section.settings.heading_gap_mobile | default: 0 -%}
      {%- if hg > 0 -%}
        .section-{{ section.id }} .collection__title.title-wrapper {
          margin-bottom: {{ hg }}px !important;
        }
      {%- endif -%}
      {%- if hg_m > 0 -%}
        @media screen and (max-width: 749px) {
          .section-{{ section.id }} .collection__title.title-wrapper {
            margin-bottom: {{ hg_m }}px !important;
          }
        }
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      "SHOP {color}" heading typography (per-instance). Emitted after the hardcoded
      15px rule above so a set font-size wins; the (0,3,0) selector out-specifies the
      .uppercase class (0,1,0) so text case "none" can remove the forced uppercase.
      Brand-font stack wins over the font picker; sentinels 0 / 'default' = inherit,
      so with typography disabled nothing is emitted and the current look is unchanged.
    {%- endcomment -%}
    {%- if section.settings.tg_enable_type -%}
      {%- liquid
        assign tg_font = section.settings.tg_font
        assign tg_weight = section.settings.tg_font_weight | default: 'default'
        assign tg_fs = section.settings.tg_font_size | default: 0
        assign tg_lh = section.settings.tg_line_height | default: 0
        assign tg_case = section.settings.tg_text_case | default: 'default'
        assign tg_ls = section.settings.tg_letter_spacing | default: 0
        assign tg_col = section.settings.tg_color
      -%}
      {%- capture tg_brand_stack -%}{% render 'brand-font', font: section.settings.tg_custom_font %}{%- endcapture -%}
      {%- assign tg_brand_stack = tg_brand_stack | strip -%}
      {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
        {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
        {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      .section-{{ section.id }} .collection__title .title {
        {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }}; font-style: normal;{% if tg_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }}; font-style: {{ tg_font.style }};{% if tg_weight == 'default' %} font-weight: {{ tg_font.weight }};{% endif %}{% endif -%}
        {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
        {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
        {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
        {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
        {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- if tg_col != blank %} color: {{ tg_col }};{% endif -%}
      }
      {%- assign tg_fs_m = section.settings.tg_font_size_mobile | default: 0 -%}
      {%- if tg_fs_m > 0 -%}
        @media screen and (max-width: 749px) {
          .section-{{ section.id }} .collection__title .title {
            font-size: {{ tg_fs_m }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}

    {% render 'card-settings-styles' %}
  {%- endstyle -%}

  {%- liquid
    assign products_to_display = num_products

    if num_products > section.settings.products_to_show
      assign products_to_display = section.settings.products_to_show
      assign more_in_collection = true
    endif

    assign columns_mobile_int = section.settings.columns_mobile | plus: 0
    assign show_mobile_slider = false
    if section.settings.swipe_on_mobile and products_to_display > columns_mobile_int
      assign show_mobile_slider = true
    endif

    assign show_desktop_slider = false
    if section.settings.enable_desktop_slider and products_to_display > section.settings.columns_desktop
      assign show_desktop_slider = true
    endif
  -%}

  <div
    class="color-{{ section.settings.color_scheme }} isolate gradient"
  >
    <div
      class="section-{{ section.id }} collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
      id="collection-{{ section.id }}"
      data-id="{{ section.id }}"
    >
      <div class="collection__title title-wrapper title-wrapper--no-top-margin{% if show_desktop_slider %} collection__title--desktop-slider{% endif %} {{ section.settings.heading_alignment }}">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext uppercase {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
      </div>

      <slider-component class="slider-mobile-gutter card-redesign{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if show_desktop_slider %} slider-component-desktop{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <ul
          id="Slider-{{ section.id }}"
          data-id="{{ section.id }}"
          class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down {% if show_mobile_slider or show_desktop_slider %} slider{% if show_desktop_slider %} slider--desktop{% endif %}{% if show_mobile_slider %} slider--tablet grid--peek{% endif %}{% endif %}"
          role="list"
          aria-label="{{ 'general.slider.name' | t }}"
        >
          {% assign skip_card_product_styles = false %}
          {%- for product in products limit: section.settings.products_to_show -%}
            {% liquid
              if section.settings.hide_sold_out
                assign coming_soon = false

                if product.tags contains 'Badge-Coming Soon'
                  assign coming_soon = true
                endif

                unless coming_soon
                  if product.available == false
                    continue
                  endif
                endunless
              endif
            %}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="grid__item{% if show_mobile_slider or show_desktop_slider %} slider__slide{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                skip_styles: skip_card_product_styles,
                section_id: section.id,
                quick_add: section.settings.quick_add,
                quick_add_mobile_only: section.settings.quick_add_mobile_only,
                show_swatches_availability: true,
                size_overlay: section.settings.show_size_overlay,
                hide_color_suffix: true
              %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        </ul>
        {%- if show_mobile_slider or show_desktop_slider -%}
          <div class="slider-buttons">
            <button
              type="button"
              class="slider-button slider-button--prev"
              name="previous"
              aria-label="{{ 'general.slider.previous_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
            <div class="slider-counter caption">
              <span class="slider-counter--current">1</span>
              <span aria-hidden="true"> / </span>
              <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
              <span class="slider-counter--total">{{ products_to_display }}</span>
            </div>
            <button
              type="button"
              class="slider-button slider-button--next"
              name="next"
              aria-label="{{ 'general.slider.next_slide' | t }}"
              aria-controls="Slider-{{ section.id }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>
        {%- endif -%}
      </slider-component>

      {%- if section.settings.show_view_all and more_in_collection -%}
        <div class="center collection__view-all{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <a
            href="{{ section.settings.collection.url }}"
            class="{% if section.settings.view_all_style == 'link' %}link underlined-link{% elsif section.settings.view_all_style == 'solid' %}button{% else %}button button--secondary{% endif %}"
            aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: section.settings.collection.title | escape }}"
          >
            {{ 'sections.featured_collection.view_all' | t }}
          </a>
        </div>
      {%- endif -%}
      {% if section.settings.image_shape == 'arch' %}
        {{ 'mask-arch.svg' | inline_asset_content }}
      {%- endif -%}
    </div>
  </div>
{% endunless %}

{% comment %}
  Editor-only empty state. The Collection / Products settings resolve from product
  metafields (product_page.dynamic_collection / color_siblings / ...), so on preview
  products without data the section renders nothing and merchants can't find or
  configure it in the editor. Everything below is gated on request.design_mode and
  the whitespace controls keep storefront output byte-identical.
{% endcomment %}
{%- if request.design_mode and num_products == 0 -%}
  <div class="color-{{ section.settings.color_scheme }} isolate gradient">
    <div
      class="section-{{ section.id }} collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
      id="collection-{{ section.id }}"
      data-id="{{ section.id }}"
      style="padding: {{ section.settings.desktop_padding_top }}px {{ section.settings.desktop_padding_right }}px {{ section.settings.desktop_padding_bottom }}px {{ section.settings.desktop_padding_left }}px;"
    >
      <div class="collection__title title-wrapper title-wrapper--no-top-margin {{ section.settings.heading_alignment }}">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext uppercase {{ section.settings.heading_size }}">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
      </div>
      <div
        class="metafield-slider-empty-note"
        style="padding: 8px 12px; margin: 0 0 16px; background: #fff8e1; border: 1px dashed #b28704; color: #6b5104; font-size: 12px; font-family: 'Courier New', monospace; letter-spacing: 0.05em;"
      >
        NOTHING TO SHOW ON THIS PREVIEW PRODUCT — this section is driven by product metafields, and
        {%- if section.settings.collection != blank and section.settings.collection.products.length > 0 %}
          all {{ section.settings.collection.products.length }} product(s) in the connected collection &quot;{{ section.settings.collection.title | escape }}&quot; are hidden by &quot;Hide Sold Out Products&quot;.
        {%- elsif section.settings.product_list.count > 0 %}
          all {{ section.settings.product_list.count }} product(s) in the Products list are hidden by &quot;Hide Sold Out Products&quot;.
        {%- elsif section.settings.collection != blank %}
          the connected collection &quot;{{ section.settings.collection.title | escape }}&quot; is empty and the Products list is too.
        {%- else %}
          the Collection source (e.g. product_page.dynamic_collection) and the Products source (e.g. product_page.color_siblings) are both empty on this preview product.
        {%- endif %}
        On the storefront it only appears on products whose metafields are populated. Placeholders below stand in for the product cards.
      </div>
      <div style="display: grid; grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr); gap: 12px;">
        {%- for i in (1..section.settings.columns_desktop) -%}
          <div aria-hidden="true">
            <div style="aspect-ratio: 3 / 4; background: #f0ede8; border: 1px dashed #c9c2b8;"></div>
            <div style="height: 10px; width: 70%; margin-top: 10px; background: #ece8e1;"></div>
            <div style="height: 10px; width: 40%; margin-top: 6px; background: #ece8e1;"></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Metafield Product Slider",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "t:sections.featured-collection.settings.title.default",
      "label": "t:sections.featured-collection.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Heading Alignment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "id": "heading_margin",
      "label": "Heading margin",
      "min": 0,
      "max": 50,
      "type": "range",
      "default": 25,
      "step": 1
    },
    {
      "type": "header",
      "content": "Heading typography"
    },
    {
      "type": "checkbox",
      "id": "tg_enable_type",
      "default": false,
      "label": "Enable typography"
    },
    {
      "type": "font_picker",
      "id": "tg_font",
      "default": "assistant_n4",
      "label": "Font",
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "select",
      "id": "tg_custom_font",
      "options": [
        { "value": "default", "label": "None (use font picker)" },
        { "value": "ibm_plex_sans", "label": "IBM Plex Sans" },
        { "value": "ibm_plex_mono", "label": "IBM Plex Mono" },
        { "value": "inter", "label": "Inter" },
        { "value": "geist", "label": "Geist" },
        { "value": "geist_mono", "label": "Geist Mono" },
        { "value": "overpass", "label": "Overpass" },
        { "value": "overpass_mono", "label": "Overpass Mono" },
        { "value": "dm_sans", "label": "DM Sans" },
        { "value": "dm_mono", "label": "DM Mono" },
        { "value": "manrope", "label": "Manrope" },
        { "value": "open_sans", "label": "Open Sans" }
      ],
      "default": "default",
      "label": "Brand font",
      "info": "Overrides the font picker above when set",
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "select",
      "id": "tg_font_weight",
      "options": [
        { "value": "default", "label": "Theme default" },
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "default",
      "label": "Font weight",
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "range",
      "id": "tg_font_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "info": "0 = theme default (15px)",
      "default": 0,
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "range",
      "id": "tg_line_height",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "info": "0 = theme default",
      "default": 0,
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "select",
      "id": "tg_text_case",
      "options": [
        { "value": "default", "label": "Theme default" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "none", "label": "Normal (remove uppercase)" }
      ],
      "default": "default",
      "label": "Text case",
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "range",
      "id": "tg_letter_spacing",
      "min": 0,
      "max": 4,
      "step": 0.1,
      "unit": "px",
      "label": "Letter spacing",
      "info": "0 = theme default",
      "default": 0,
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    {
      "type": "color",
      "id": "tg_color",
      "label": "Text color",
      "info": "Leave blank for theme default",
      "visible_if": "{{ section.settings.tg_enable_type }}"
    },
    { "type": "range", "id": "tg_font_size_mobile", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Mobile font size", "info": "0 = same as desktop", "default": 0, "visible_if": "{{ section.settings.tg_enable_type }}" },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 50
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide Sold Out Products",
      "default": false
    },
    {
      "type": "range",
