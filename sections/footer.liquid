{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .footer-block__heading{
    text-transform: uppercase;
  }

  .footer-accordion {
    border: 0;
    margin: 0;
  }

  .footer-accordion summary {
    padding: 0;
  }

  .footer-accordion .accordion__title {
    text-transform: uppercase;
  }

  .footer__content-bottom-wrapper {
    justify-content: space-evenly;
  }

  .footer__content-bottom-wrapper {
    text-align: center !important;
  }

  .footer__copyright {
    margin: 0;
    text-align: center !important;
  }

  .localization-form {
    padding: 0 !important;
  }

  .disclosure__button {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 0;
  }

  @media screen and (min-width: 990px) {
    .footer__content-bottom-wrapper .grid__item {
      max-width: fit-content;
    }
  }

  {%- comment -%}
    Redesign controls below are default-inert: 0-sentinel ranges, default selects and
    checkbox gates emit nothing until dialed, so the untouched render stays byte-identical.
  {%- endcomment -%}
  {%- if section.settings.padding_left > 0 or section.settings.padding_right > 0 -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .footer__content-top {
        {%- if section.settings.padding_left > 0 %} padding-left: {{ section.settings.padding_left }}px;{% endif -%}
        {%- if section.settings.padding_right > 0 %} padding-right: {{ section.settings.padding_right }}px;{% endif %}
      }
    }
  {%- endif -%}

  {%- comment -%}
    The wrapper-scoped var override feeds .grid column-gap, the stock 20% block-width
    calc and the span calcs below in one move — they all read the inherited var.
  {%- endcomment -%}
  {%- if section.settings.block_gap > 0 -%}
    #shopify-section-{{ section.id }} .footer__blocks-wrapper {
      --grid-desktop-horizontal-spacing: {{ section.settings.block_gap }}px;
    }
  {%- endif -%}

  {%- if section.settings.blocks_justify != blank and section.settings.blocks_justify != 'space-around' -%}
    #shopify-section-{{ section.id }} .footer__blocks-wrapper {
      justify-content: {{ section.settings.blocks_justify }};
    }
  {%- endif -%}

  {%- liquid
    assign has_span_2 = false
    assign has_span_3 = false
    for block in section.blocks
      if block.settings.block_span == '2'
        assign has_span_2 = true
      elsif block.settings.block_span == '3'
        assign has_span_3 = true
      endif
    endfor
  -%}
  {%- comment -%}
    Span-N = N x 20% minus the same 3/4-gap share the stock single-block rule carries,
    so a fully-spanned row totals exactly 100% (the naive N*(20% - g*3/4) + (N-1)*g
    overflows a full row by g/4 and wraps it — .grid__item has flex-shrink: 0).
  {%- endcomment -%}
  {%- if has_span_2 or has_span_3 -%}
    @media screen and (min-width: 1100px) {
      {%- if has_span_2 %}
      #shopify-section-{{ section.id }} .grid--4-col-desktop .footer-block--span-2 {
        width: calc(40% - var(--grid-desktop-horizontal-spacing) * 3 / 4);
        max-width: calc(40% - var(--grid-desktop-horizontal-spacing) * 3 / 4);
      }
      {%- endif %}
      {%- if has_span_3 %}
      #shopify-section-{{ section.id }} .grid--4-col-desktop .footer-block--span-3 {
        width: calc(60% - var(--grid-desktop-horizontal-spacing) / 2);
        max-width: calc(60% - var(--grid-desktop-horizontal-spacing) / 2);
      }
      {%- endif %}
    }
  {%- endif -%}

  {%- if section.settings.enable_padding_mobile -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .footer {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
      #shopify-section-{{ section.id }} .footer__content-top {
        padding-left: {{ section.settings.padding_left_mobile }}px;
        padding-right: {{ section.settings.padding_right_mobile }}px;
      }
      #shopify-section-{{ section.id }} .footer-block.grid__item {
        margin-top: {{ section.settings.stack_spacing_mobile }}px;
        margin-bottom: {{ section.settings.stack_spacing_mobile }}px;
      }
      #shopify-section-{{ section.id }} .footer-block.grid__item:first-child {
        margin-top: 0;
      }
    }
  {%- endif -%}

  {%- comment -%}
    Bottom-area sliders. The 24px default matches the stock 3rem padding-bottom,
    so the untouched render is unchanged. The gap slider adds sibling margins —
    the bottom wrapper is display: block on mobile (.footer .grid wins), so flex
    row-gap would be inert; at 0 nothing is emitted and the stock line-box
    spacing stands.
  {%- endcomment -%}
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .footer__content-top {
      padding-bottom: {{ section.settings.bottom_spacing_top }}px;
    }
    {%- if section.settings.bottom_gap > 0 %}
    #shopify-section-{{ section.id }} .footer__content-bottom-wrapper.grid > .grid__item + .grid__item {
      margin-top: {{ section.settings.bottom_gap }}px;
    }
    {%- endif %}
  }
{%- endstyle -%}

{%- comment -%}
  Optional footer typography, donor: header.liquid nav_enable_type loop. Two groups
  keyed by prefix (fh_ = block headings, fl_ = menu link items); one entry per
  selector since the heading treatment must also hit the mobile/tablet accordion
  title (visible through 1099px) and the accordion's own link list.
  #shopify-section-<id> gives every rule an ID, so it beats the flat pins in
  section-footer.css and the uppercase pins in the style block above.
{%- endcomment -%}
{%- if section.settings.footer_enable_type -%}
  {%- capture footer_type_css -%}
    {%- assign footer_type_groups = 'fh|.footer-block__heading;fh|.footer-accordion .accordion__title;fl|.footer-block__details-content .list-menu__item;fl|.footer-accordion .accordion__content .list-menu__item' | split: ';' -%}
    {%- for grp in footer_type_groups -%}
      {%- assign grp_parts = grp | split: '|' -%}
      {%- assign gp = grp_parts[0] -%}
      {%- assign sel = grp_parts[1] -%}
      {%- assign k_font = gp | append: '_custom_font' -%}
      {%- assign k_weight = gp | append: '_font_weight' -%}
      {%- assign k_size = gp | append: '_font_size' -%}
      {%- assign k_case = gp | append: '_text_case' -%}
      {%- assign k_ls = gp | append: '_letter_spacing' -%}
      {%- assign k_color = gp | append: '_color' -%}
      {%- assign k_lh = gp | append: '_line_height' -%}
      {%- capture grp_brand -%}{% render 'brand-font', font: section.settings[k_font] %}{%- endcapture -%}
      {%- assign grp_brand = grp_brand | strip -%}
      {%- capture grp_decl -%}
        {%- if grp_brand != blank %}font-family: {{ grp_brand }};{% endif -%}
        {%- if section.settings[k_weight] != 'default' and section.settings[k_weight] != blank %} font-weight: {{ section.settings[k_weight] }};{% endif -%}
        {%- if section.settings[k_size] > 0 %} font-size: {{ section.settings[k_size] }}px;{% endif -%}
        {%- if section.settings[k_case] != 'default' and section.settings[k_case] != blank %} text-transform: {{ section.settings[k_case] }};{% endif -%}
        {%- if section.settings[k_ls] > 0 %} letter-spacing: {{ section.settings[k_ls] }}px;{% endif -%}
        {%- if section.settings[k_color] != blank %} color: {{ section.settings[k_color] }};{% endif -%}
        {%- if section.settings[k_lh] > 0 %} line-height: {{ section.settings[k_lh] }}px;{% endif -%}
      {%- endcapture -%}
      {%- assign grp_decl = grp_decl | strip -%}
      {%- if grp_decl != blank -%}
        #shopify-section-{{ section.id }} {{ sel }} { {{ grp_decl }} }
      {%- endif -%}
    {%- endfor -%}
    #shopify-section-{{ section.id }} { --mp-footer-heading-mb: {{ section.settings.fh_margin_bottom }}px; }
    {%- if section.settings.fh_font_size_mobile > 0 or section.settings.fl_font_size_mobile > 0 -%}
      @media screen and (max-width: 749px) {
        {%- if section.settings.fh_font_size_mobile > 0 -%}
          #shopify-section-{{ section.id }} .footer-block__heading, #shopify-section-{{ section.id }} .footer-accordion .accordion__title { font-size: {{ section.settings.fh_font_size_mobile }}px; }
        {%- endif -%}
        {%- if section.settings.fl_font_size_mobile > 0 -%}
          #shopify-section-{{ section.id }} .footer-block__details-content .list-menu__item, #shopify-section-{{ section.id }} .footer-accordion .accordion__content .list-menu__item { font-size: {{ section.settings.fl_font_size_mobile }}px; }
        {%- endif -%}
      }
    {%- endif -%}
  {%- endcapture -%}
  {%- assign footer_type_css = footer_type_css | strip -%}
  {%- if footer_type_css != blank -%}
    <style>
      {{ footer_type_css }}
    </style>
  {%- endif -%}
{%- endif -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- liquid
    assign has_social_icons = true
    if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
      assign has_social_icons = false
    endif

    if settings.brand_image == blank and settings.brand_headline == blank and settings.brand_description == blank
      assign brand_empty = true
    endif

    if section.blocks.size == 1 and section.blocks[0].type == 'brand_information' and brand_empty and has_social_icons == false and section.settings.enable_follow_on_shop == false
      assign only_empty_brand = true
    endif
  -%}
  {%- if section.blocks.size > 0
    or section.settings.show_social
    and has_social_icons == true
    or section.settings.enable_follow_on_shop
  -%}
    {%- unless only_empty_brand -%}
      <div class="footer__content-top page-width">
        {%- if section.blocks.size > 0 -%}
          {%- liquid
            if section.blocks.size == 9
              assign footer_grid_class = 'grid--3-col-tablet'
            elsif section.blocks.size > 6
              assign footer_grid_class = 'grid--4-col-desktop'
            elsif section.blocks.size > 4
              assign footer_grid_class = 'grid--3-col-tablet'
            endif
          -%}
          <div
            class="footer__blocks-wrapper grid grid--4-col-desktop grid--1-col-tablet-down {{ footer_grid_class }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
            {% endif %}
          >
            {%- for block in section.blocks -%}
              <div
                class="footer-block grid__item{% if block.type == 'link_list' %} footer-block--menu{% endif %}{% if block.settings.block_span != blank and block.settings.block_span != '1' %} footer-block--span-{{ block.settings.block_span }}{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.heading != blank and block.type != 'link_list' -%}
                  <h2 class="footer-block__heading inline-richtext">{{- block.settings.heading -}}</h2>
                {%- endif -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {% render block %}
                  {%- when 'text' -%}
                    <div class="footer-block__details-content rte">
                      {{ block.settings.subtext }}
                    </div>
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <div class="accordion footer-accordion is-hidden-desktop-only" {{ block.shopify_attributes }}>
                        <details id="Details-{{ block.id }}-{{ section.id }}">
                          <summary>
                            <div class="summary__title">
                              <h2 class="h4 accordion__title inline-richtext">{{- block.settings.heading -}}</h2>
                            </div>
                            <span class="svg-wrapper">
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                          </summary>
                          <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section.id }}">
                            {%- for link in block.settings.menu.links -%}
                              <li>
                                <a
                                  href="{{ link.url }}"
                                  class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                                >
                                  {{ link.title | escape }}
                                </a>
                              </li>
                            {%- endfor -%}
                          </div>
                        </details>
                      </div>
                      <h2 class="footer-block__heading inline-richtext is-hidden-mobile-only">
                        {{- block.settings.heading -}}
                      </h2>
                      <ul class="footer-block__details-content list-unstyled is-hidden-mobile-only">
                        {%- for link in block.settings.menu.links -%}
                          <li>
                            <a
                              href="{{ link.url }}"
                              class="link link--text list-menu__item list-menu__item--link{% if link.active %} list-menu__item--active{% endif %}"
                            >
                              {{ link.title | escape }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  {%- when 'brand_information' -%}
                    <div class="footer-block__brand-info">
                      {%- if settings.brand_image != blank -%}
                        {%- assign brand_image_height = settings.brand_image_width
                          | divided_by: settings.brand_image.aspect_ratio
                        -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ settings.brand_image_width }}px);"
                        >
                          {{
                            settings.brand_image
                            | image_url: width: 1100
                            | image_tag:
                              loading: 'lazy',
                              widths: '50, 100, 150, 200, 300, 400, 550, 800, 1100',
                              height: brand_image_height,
                              width: settings.brand_image_width
                          }}
                        </div>
                      {%- endif -%}
                      {%- if settings.brand_headline != blank -%}
                        <h2 class="footer-block__heading rte">{{ settings.brand_headline }}</h2>
                      {%- endif -%}
                      {%- if settings.brand_description != blank -%}
                        <div class="rte">{{ settings.brand_description }}</div>
                      {%- endif -%}
                      {%- if block.settings.show_social and has_social_icons -%}
                        {%- render 'social-icons', class: 'footer__list-social' -%}
                      {%- endif -%}
                    </div>
                  {%- when 'image' -%}
                    <div class="footer-block__details-content footer-block-image {{ block.settings.alignment }}">
                      {%- if block.settings.image != blank -%}
                        {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 5760 -%}
                        <div
                          class="footer-block__image-wrapper"
                          style="max-width: min(100%, {{ block.settings.image_width }}px);"
                        >
                          <img
                            srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                            src="{{ block.settings.image | image_url: width: 760 }}"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}"
                          >
                        </div>
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                      {%- endif -%}
                    </div>
                  {%- when 'newsletter' -%}
                    {% unless template contains 'newsletter-signup' %}
                      <div
                        class="footer-block--newsletter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                        {% if settings.animations_reveal_on_scroll %}
                          data-cascade
                        {% endif %}
                      >
                        <div class="footer-block__newsletter">
                          {%- if block.settings.newsletter_heading != blank -%}
                            <h2 class="footer-block__heading inline-richtext">
                              {{ block.settings.newsletter_heading }}
                            </h2>
                          {%- endif -%}
                          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                            <input type="hidden" name="contact[tags]" value="newsletter">
                            <div class="newsletter-form__field-wrapper">
                              <div class="field">
                                <input
                                  id="NewsletterForm--{{ section.id }}--{{ block.id }}"
                                  type="email"
                                  name="contact[email]"
                                  class="field__input"
                                  value="{{ form.email }}"
                                  aria-required="true"
                                  autocorrect="off"
                                  autocapitalize="off"
                                  autocomplete="email"
                                  {% if form.errors %}
                                    autofocus
                                    aria-invalid="true"
                                    aria-describedby="ContactFooter-error"
                                  {% elsif form.posted_successfully? %}
                                    aria-describedby="ContactFooter-success"
                                  {% endif %}
                                  placeholder="{{ 'newsletter.label' | t }}"
                                  required
                                >
                                <label class="field__label" for="NewsletterForm--{{ section.id }}--{{ block.id }}">
                                  {{ 'newsletter.label' | t }}
                                </label>
                              </div>
                              {%- if form.errors -%}
                                <small class="newsletter-form__message form__message" id="ContactFooter-error">
                                  <span class="svg-wrapper">
                                    {{- 'icon-error.svg' | inline_asset_content -}}
                                  </span>
                                  {{- form.errors.translated_fields.email | capitalize }}
                                  {{ form.errors.messages.email -}}
                                </small>
                              {%- endif -%}
                            </div>
                            <button
                              type="submit"
                              class="button button--secondary"
                              name="commit"
                              id="Subscribe"
                              aria-label="{{ 'newsletter.button_label' | t }}"
                            >
                              Subscribe
                              {% comment %}
                                <span class="svg-wrapper">
                                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                                </span>
                              {% endcomment %}
                            </button>

                            {%- if form.posted_successfully? -%}
                              <h3
                                class="newsletter-form__message newsletter-form__message--success form__message"
                                id="ContactFooter-success"
                                tabindex="-1"
                                autofocus
                              >
                                <span class="svg-wrapper">
                                  {{- 'icon-success.svg' | inline_asset_content -}}
                                </span>
                                {{- 'newsletter.success' | t }}
                              </h3>
                            {%- endif -%}
                          {%- endform -%}
                        </div>

                        {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
                          <div class="footer__follow-on-shop">
                            {{ shop | login_button: action: 'follow' }}
                          </div>
                        {%- endif -%}

                        {%- if section.settings.show_social and has_social_icons -%}
                          {%- render 'social-icons', class: 'footer__list-social' -%}
                        {%- endif -%}
                      </div>
                    {% endunless %}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- endunless -%}
  {%- endif -%}

  <div class="footer__content-bottom">
    <div class="footer__content-bottom-wrapper page-width">
      <div class="footer__column footer__localization isolate">
        {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
          <localization-form>
            {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
              <div>
                <h2 class="caption-large text-body" id="FooterLanguageLabel">
                  {{ 'localization.language_label' | t }}
                </h2>
                {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </div>
      <div class="footer__column footer__column--info">
        {%- if section.settings.payment_enable -%}
          <div class="footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
    <div class="footer__content-bottom-wrapper page-width{% if section.settings.enable_country_selector == false and section.settings.enable_language_selector == false %} footer__content-bottom-wrapper--center{% endif %} grid grid--4-col-desktop grid--1-col-tablet-down">
      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
        <localization-form class="grid__item">
          {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
            <div>
              {%- render 'country-localization', localPosition: 'FooterCountry' -%}
            </div>
          {%- endform -%}
        </localization-form>
      {%- endif -%}
      <div class="footer__copyright caption grid__item">
        <small class="copyright__content"
          >&copy; {{ 'now' | date: '%Y' }}
          {{ shop.name | link_to: routes.root_url -}}
        </small>
        {%- if section.settings.show_policy -%}
          <ul class="policies list-unstyled">
            {%- for policy in shop.policies -%}
              {%- if policy != blank -%}
                <li>
                  <small class="copyright__content"
                    ><a href="{{ policy.url }}">{{ policy.title | escape }}</a></small
                  >
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
      <a href="#" data-acsb-custom-trigger="true" class="link link--text grid__item">Accessibility</a>
      <a href="/pages/data-sale-opt-out" class="link link--text grid__item"
        >Do Not Sell or Share My Personal Information</a
      >
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        },
        { "type": "select", "id": "block_span", "options": [ { "value": "1", "label": "1 column" }, { "value": "2", "label": "2 columns" }, { "value": "3", "label": "3 columns" } ], "default": "1", "label": "Column span", "info": "Desktop only (1100px and up)." }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
