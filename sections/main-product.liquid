        -%}
        {%- capture tgp_brand_stack -%}{% render 'brand-font', font: block.settings.tg_pickup_custom_font %}{%- endcapture -%}
        {%- assign tgp_brand_stack = tgp_brand_stack | strip -%}
        {%- if tgp_font != blank and tgp_brand_stack == blank -%}{{ tgp_font | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if tgp_font != blank and tgp_brand_stack == blank and tgp_weight != 'default' -%}
          {%- assign tgp_wfont = tgp_font | font_modify: 'weight', tgp_weight -%}
