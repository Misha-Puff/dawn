          {%- if tgp_brand_stack != blank %}font-family: {{ tgp_brand_stack }}; font-style: normal;{% if tgp_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tgp_font != blank %}font-family: {{ tgp_font.family }}, {{ tgp_font.fallback_families }}; font-style: {{ tgp_font.style }};{% if tgp_weight == 'default' %} font-weight: {{ tgp_font.weight }};{% endif %}{% endif -%}
          {%- if tgp_weight != 'default' and tgp_weight != blank %} font-weight: {{ tgp_weight }};{% endif -%}
          {%- if tgp_fs > 0 %} font-size: {{ tgp_fs }}px;{% endif -%}
          {%- if tgp_lh > 0 %} line-height: {{ tgp_lh }}%;{% endif -%}
          {%- if tgp_case != 'default' and tgp_case != blank %} text-transform: {{ tgp_case }};{% endif -%}
          {%- if tgp_ls > 0 %} letter-spacing: {{ tgp_ls }}px;{% endif -%}
        {%- endcapture -%}
        {%- assign tgp_typedecl = tgp_typedecl | strip -%}
        {%- assign tgp_fulldecl = tgp_typedecl -%}
        {%- if tgp_col != blank -%}
          {%- assign tgp_fulldecl = tgp_typedecl | append: ' color: ' | append: tgp_col | append: ';' | strip -%}
        {%- endif -%}
        {%- if tgp_fulldecl != blank -%}
          #{{ tg_scope }} .iia-container, #{{ tg_scope }} .iia-container .iia-drawer-link, #{{ tg_scope }} .iia-container .iia-header, #{{ tg_scope }} .product__pickup-availabilities .pickup-availability-preview .caption-large, #{{ tg_scope }} .product__pickup-availabilities .pickup-availability-preview .caption, #{{ tg_scope }} .product__pickup-availabilities .pickup-availability-button { {{ tgp_fulldecl }} }
        {%- endif -%}
        {%- if tgp_col != blank -%}
          {%- comment -%} The location-name span carries color: rgb(var(--color-foreground)) via .color-foreground in base.css and would otherwise win. {%- endcomment -%}
          #{{ tg_scope }} .product__pickup-availabilities .pickup-availability-preview .color-foreground { color: {{ tgp_col }}; }
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'buy_buttons' and block.settings.tg_atc_enable -%}
        {%- comment -%} Add-to-cart submit button label. Buttons don't inherit font — base.css lands font-size/text-transform/color on .button directly — so the full declaration targets the button element: .product-form__submit, which is stable across button--primary/--secondary and the no-JS fallback. ID+class specificity (1,1,0) beats every .button rule (max 0,2,0); no !important (pickup precedent). Background stays with the color scheme; the dynamic-checkout "Buy it now" button is Shopify-rendered and unaffected. buy_buttons has limit 1, so section-id scoping suffices. {%- endcomment -%}
        {%- liquid
          assign tga_font = block.settings.tg_atc_font
          assign tga_weight = block.settings.tg_atc_weight | default: 'default'
          assign tga_fs = block.settings.tg_atc_size | default: 0
          assign tga_lh = block.settings.tg_atc_line_height | default: 0
          assign tga_case = block.settings.tg_atc_case | default: 'default'
          assign tga_ls = block.settings.tg_atc_letter_spacing | default: 0
          assign tga_col = block.settings.tg_atc_color
        -%}
        {%- capture tga_brand_stack -%}{% render 'brand-font', font: block.settings.tg_atc_custom_font %}{%- endcapture -%}
        {%- assign tga_brand_stack = tga_brand_stack | strip -%}
        {%- if tga_font != blank and tga_brand_stack == blank -%}{{ tga_font | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if tga_font != blank and tga_brand_stack == blank and tga_weight != 'default' -%}
          {%- assign tga_wfont = tga_font | font_modify: 'weight', tga_weight -%}
          {%- if tga_wfont -%}{{ tga_wfont | font_face: font_display: 'swap' }}{%- endif -%}
        {%- endif -%}
        {%- capture tga_typedecl -%}
          {%- if tga_brand_stack != blank %}font-family: {{ tga_brand_stack }}; font-style: normal;{% if tga_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tga_font != blank %}font-family: {{ tga_font.family }}, {{ tga_font.fallback_families }}; font-style: {{ tga_font.style }};{% if tga_weight == 'default' %} font-weight: {{ tga_font.weight }};{% endif %}{% endif -%}
          {%- if tga_weight != 'default' and tga_weight != blank %} font-weight: {{ tga_weight }};{% endif -%}
          {%- if tga_fs > 0 %} font-size: {{ tga_fs }}px;{% endif -%}
          {%- if tga_lh > 0 %} line-height: {{ tga_lh }}%;{% endif -%}
          {%- if tga_case != 'default' and tga_case != blank %} text-transform: {{ tga_case }};{% endif -%}
          {%- if tga_ls > 0 %} letter-spacing: {{ tga_ls }}px;{% endif -%}
        {%- endcapture -%}
        {%- assign tga_typedecl = tga_typedecl | strip -%}
        {%- assign tga_fulldecl = tga_typedecl -%}
        {%- if tga_col != blank -%}
          {%- assign tga_fulldecl = tga_typedecl | append: ' color: ' | append: tga_col | append: ';' | strip -%}
        {%- endif -%}
        {%- if tga_fulldecl != blank -%}
          #{{ tg_scope }} .product-form__submit { {{ tga_fulldecl }} }
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'collapsible_tab' and block.settings.tg_body_enable -%}
        {%- comment -%} Accordion body (open-state content). The base tg_ group above styles the heading only; this group lands on the .accordion__content container and inherits into its rte children (nothing inside sets its own font rules). {%- endcomment -%}
        {%- liquid
          assign tgb_font = block.settings.tg_body_font
          assign tgb_weight = block.settings.tg_body_weight | default: 'default'
          assign tgb_fs = block.settings.tg_body_size | default: 0
          assign tgb_lh = block.settings.tg_body_line_height | default: 0
          assign tgb_case = block.settings.tg_body_case | default: 'default'
          assign tgb_ls = block.settings.tg_body_letter_spacing | default: 0
          assign tgb_col = block.settings.tg_body_color
        -%}
        {%- capture tgb_brand_stack -%}{% render 'brand-font', font: block.settings.tg_body_custom_font %}{%- endcapture -%}
        {%- assign tgb_brand_stack = tgb_brand_stack | strip -%}
        {%- if tgb_font != blank and tgb_brand_stack == blank -%}{{ tgb_font | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if tgb_font != blank and tgb_brand_stack == blank and tgb_weight != 'default' -%}
          {%- assign tgb_wfont = tgb_font | font_modify: 'weight', tgb_weight -%}
          {%- if tgb_wfont -%}{{ tgb_wfont | font_face: font_display: 'swap' }}{%- endif -%}
        {%- endif -%}
        {%- capture tgb_fulldecl -%}
          {%- if tgb_brand_stack != blank %}font-family: {{ tgb_brand_stack }}; font-style: normal;{% if tgb_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tgb_font != blank %}font-family: {{ tgb_font.family }}, {{ tgb_font.fallback_families }}; font-style: {{ tgb_font.style }};{% if tgb_weight == 'default' %} font-weight: {{ tgb_font.weight }};{% endif %}{% endif -%}
          {%- if tgb_weight != 'default' and tgb_weight != blank %} font-weight: {{ tgb_weight }};{% endif -%}
          {%- if tgb_fs > 0 %} font-size: {{ tgb_fs }}px;{% endif -%}
          {%- if tgb_lh > 0 %} line-height: {{ tgb_lh }}%;{% endif -%}
          {%- if tgb_case != 'default' and tgb_case != blank %} text-transform: {{ tgb_case }};{% endif -%}
