        -%}
        {%- if tgv_sw_w > 0 or tgv_sw_h > 0 or tgv_sw_r > 0 -%}
          {%- comment -%} Swatch size vars, scoped to this section's info column; component CSS consumes them through var() chains whose fallbacks equal the stock values. {%- endcomment -%}
          #{{ tg_scope }} {
            {%- if tgv_sw_w > 0 %} --swatch-picker-width: {{ tgv_sw_w }}px;{% endif -%}
            {%- if tgv_sw_h > 0 %} --swatch-picker-height: {{ tgv_sw_h }}px;{% endif -%}
            {%- if tgv_sw_r > 0 %} --swatch-picker-radius: {{ tgv_sw_r }}px;{% endif -%}
          }
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'buy_buttons' and block.settings.tg_pickup_enable -%}
        {%- comment -%} Find-in-store / pickup availability text. On this store the visible line ("FIND IN BROOKLYN") is the Inventory Information app block — a .iia-container div filled client-side, sitting inside #ProductInfo — so the rules target its text elements (.iia-drawer-link / .iia-header) alongside Shopify's native <pickup-availability> markup, which currently renders inert (no pickup-enabled locations) but stays covered in case that changes. CSS rules survive both apps' JS re-renders; both store-list drawers append to document.body and keep their own styling. buy_buttons has limit 1, so scoping by the section id alone is stable without the Block-id wrapper (which only exists when padding is enabled). {%- endcomment -%}
        {%- liquid
          assign tgp_font = block.settings.tg_pickup_font
          assign tgp_weight = block.settings.tg_pickup_weight | default: 'default'
          assign tgp_fs = block.settings.tg_pickup_size | default: 0
          assign tgp_lh = block.settings.tg_pickup_line_height | default: 0
          assign tgp_case = block.settings.tg_pickup_case | default: 'default'
          assign tgp_ls = block.settings.tg_pickup_letter_spacing | default: 0
