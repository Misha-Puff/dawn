<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .mending-options {
      margin-bottom: 1.5rem;
      max-width: 44rem;
    }

    .sibling-link {
      display: inline-block;
    }

    {% assign judgeme_badge = product.metafields.judgeme.badge | downcase %}

    {% if judgeme_badge contains 'no reviews' %}
      #judgeme_product_reviews {
        display: none !important;
      }
    {% endif %}

    {% if product.has_only_default_variant %}
      #variant-selects-{{ section.id }} {
        display: none
      }
    {% endif %}

    .divider-wrapper {
      display: flex;
      justify-content: center;
      max-width: 44rem;
    }

    .divider {
      width: 100%;
      border-top: 1px solid rgb(1,1,1,0.25)
    }

    {%- comment -%}
      With the breadcrumb hidden the product grid jams up under the header. Restore
      the vertical breathing room the breadcrumb used to occupy (~1.3rem text line +
      2em margin ≈ 4.8rem) so the media/info block sits where it did before. Both
      columns move down together, so their top alignment is preserved. Only when the
      breadcrumb is off — when it's on, the breadcrumb provides its own spacing.
    {%- endcomment -%}
    {%- unless section.settings.show_breadcrumb -%}
      #MainProduct-{{ section.id }} .product {
        margin-top: 4.8rem;
      }
    {%- endunless -%}

    {%- comment -%}
      Mobile section padding (≤749px). Emitted after both the 0.75× base padding rule
      and the breadcrumb-spacer margin above, so it wins their cascade ties. The top
      axis owns the WHOLE header→media gap: it replaces the scaled section padding AND
      zeroes the 4.8rem spacer (~38px at this store's 80% body scale) — the slider
      value is the entire space above the gallery, not an addition to it.
    {%- endcomment -%}
    {%- liquid
      assign sp_pt_m = section.settings.padding_top_mobile | default: 0
      assign sp_pb_m = section.settings.padding_bottom_mobile | default: 0
    -%}
    {%- if sp_pt_m > 0 or sp_pb_m > 0 -%}
      @media screen and (max-width: 749px) {
        .section-{{ section.id }}-padding {
          {%- if sp_pt_m > 0 %} padding-top: {{ sp_pt_m }}px;{% endif -%}
          {%- if sp_pb_m > 0 %} padding-bottom: {{ sp_pb_m }}px;{% endif -%}
        }
        {%- if sp_pt_m > 0 %}
          #MainProduct-{{ section.id }} .product {
            margin-top: 0;
          }
        {%- endif %}
      }
    {%- endif -%}

    {%- comment -%}
      Product info column overrides. #MainProduct-<id> is the section root, so the
      ID+class specificity (1,1,0) beats the hardcoded .product__info-wrapper padding
      variants and the .product__info-container spacing rules in section-main-product.css.
      Desktop padding is ≥750px-only; spacing applies at all screen sizes and evens
      out the 2.5rem description/buy-area rules. The mobile pass (≤749px) owns small
      screens: its top axis also zeroes the .product grid row-gap (the only mobile
      seam between the media and info wrappers, 18px today from global grid spacing)
      so the slider value IS the gallery→info gap, not an addition to it.
    {%- endcomment -%}
    {%- if section.settings.info_enable_padding -%}
      {%- liquid
        assign info_pl = section.settings.info_padding_left | default: 0
        assign info_pr = section.settings.info_padding_right | default: 0
        assign info_gap = section.settings.info_block_spacing | default: 0
        assign info_pt_m = section.settings.info_padding_top_mobile | default: 0
        assign info_pb_m = section.settings.info_padding_bottom_mobile | default: 0
        assign info_pl_m = section.settings.info_padding_left_mobile | default: 0
        assign info_pr_m = section.settings.info_padding_right_mobile | default: 0
      -%}
      {%- if info_pl > 0 or info_pr > 0 -%}
        @media screen and (min-width: 750px) {
          #MainProduct-{{ section.id }} .product__info-wrapper {
            {%- if info_pl > 0 %} padding-left: {{ info_pl }}px;{% endif -%}
            {%- if info_pr > 0 %} padding-right: {{ info_pr }}px;{% endif -%}
          }
        }
      {%- endif -%}
      {%- if info_pt_m > 0 or info_pb_m > 0 or info_pl_m > 0 or info_pr_m > 0 -%}
        @media screen and (max-width: 749px) {
          #MainProduct-{{ section.id }} .product__info-wrapper {
            {%- if info_pt_m > 0 %} padding-top: {{ info_pt_m }}px;{% endif -%}
            {%- if info_pb_m > 0 %} padding-bottom: {{ info_pb_m }}px;{% endif -%}
            {%- if info_pl_m > 0 %} padding-left: {{ info_pl_m }}px;{% endif -%}
            {%- if info_pr_m > 0 %} padding-right: {{ info_pr_m }}px;{% endif -%}
          }
          {%- if info_pt_m > 0 %}
            #MainProduct-{{ section.id }} .product {
              row-gap: 0;
            }
          {%- endif %}
        }
      {%- endif -%}
      {%- if info_gap > 0 -%}
        #MainProduct-{{ section.id }} .product__info-container > * + * {
          margin: {{ info_gap }}px 0;
        }
        {%- comment -%}
          .product-form sits nested inside the buy-buttons wrapper div with margin: 2.5rem 0;
          its top margin collapses through the wrapper and would floor the gap at 25px.
          Zero only the top — the bottom margin is the internal buttons-to-pickup gap.
        {%- endcomment -%}
        #MainProduct-{{ section.id }} .product__info-container .product-form {
          margin-top: 0;
        }
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      Product media column padding, mirroring the info-column pattern above.
      Same 750px breakpoint — the grid goes 2-column at 750px, not 990px.
    {%- endcomment -%}
    {%- if section.settings.media_enable_padding -%}
      {%- liquid
        assign media_pl = section.settings.media_padding_left | default: 0
        assign media_pr = section.settings.media_padding_right | default: 0
      -%}
      {%- if media_pl > 0 or media_pr > 0 -%}
        @media screen and (min-width: 750px) {
          #MainProduct-{{ section.id }} .product__media-wrapper {
            {%- if media_pl > 0 %} padding-left: {{ media_pl }}px;{% endif -%}
            {%- if media_pr > 0 %} padding-right: {{ media_pr }}px;{% endif -%}
          }
        }
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      Mobile slider controls (prev/next arrows + "1 / 5" counter under the gallery, ≤749px).
      #GalleryViewer is the gallery's <slider-component> (product-media-gallery.liquid) and
      contains only the main media list plus this control row, so these rules can't reach the
      pair-it-with block's .slider-buttons, the thumbnail-rail buttons, or the other
      component-slider.css consumers. ID+class specificity beats .caption (base.css). px units
      throughout — Dawn's rem root is 62.5% × body_scale, so rem values would drift with scale.
    {%- endcomment -%}
    {%- if section.settings.mcc_enable -%}
      {%- liquid
        assign mcc_font = section.settings.mcc_font
        assign mcc_weight = section.settings.mcc_weight | default: 'default'
        assign mcc_fs = section.settings.mcc_size | default: 0
        assign mcc_ls = section.settings.mcc_letter_spacing | default: 0
        assign mcc_h = section.settings.mcc_height | default: 0
        assign mcc_gap = section.settings.mcc_gap | default: 0
        assign mcc_mt = section.settings.mcc_margin_top | default: 0
        assign mcc_mb = section.settings.mcc_margin_bottom | default: 0
      -%}
      {%- capture mcc_brand_stack -%}{% render 'brand-font', font: section.settings.mcc_custom_font %}{%- endcapture -%}
      {%- assign mcc_brand_stack = mcc_brand_stack | strip -%}
      {%- if mcc_font != blank and mcc_brand_stack == blank -%}{{ mcc_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if mcc_font != blank and mcc_brand_stack == blank and mcc_weight != 'default' -%}
        {%- assign mcc_wfont = mcc_font | font_modify: 'weight', mcc_weight -%}
        {%- if mcc_wfont -%}{{ mcc_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      {%- capture mcc_typedecl -%}
        {%- if mcc_brand_stack != blank %}font-family: {{ mcc_brand_stack }}; font-style: normal;{% if mcc_weight == 'default' %} font-weight: 400;{% endif %}{% elsif mcc_font != blank %}font-family: {{ mcc_font.family }}, {{ mcc_font.fallback_families }}; font-style: {{ mcc_font.style }};{% if mcc_weight == 'default' %} font-weight: {{ mcc_font.weight }};{% endif %}{% endif -%}
        {%- if mcc_weight != 'default' and mcc_weight != blank %} font-weight: {{ mcc_weight }};{% endif -%}
        {%- if mcc_fs > 0 %} font-size: {{ mcc_fs }}px;{% endif -%}
        {%- if mcc_ls > 0 %} letter-spacing: {{ mcc_ls }}px;{% endif -%}
      {%- endcapture -%}
      {%- assign mcc_typedecl = mcc_typedecl | strip -%}
      @media screen and (max-width: 749px) {
        {%- if mcc_typedecl != blank %}
          #GalleryViewer-{{ section.id }} .slider-counter { {{ mcc_typedecl }} }
        {%- endif %}
        {%- if mcc_gap > 0 or mcc_mb > 0 %}
          #GalleryViewer-{{ section.id }} .slider-buttons {
            {%- if mcc_gap > 0 %} gap: {{ mcc_gap }}px;{% endif -%}
            {%- if mcc_mb > 0 %} margin-bottom: {{ mcc_mb }}px;{% endif -%}
          }
        {%- endif %}
        {%- comment -%} The prev/next buttons are 44×44 tap targets (component-slider.css) and set the row's intrinsic height — the counter text is only ~10px. "Controls height" shrinks the button height only (width keeps the 44px tap area), so the row model is: space above + controls height + space below. {%- endcomment -%}
        {%- if mcc_h > 0 %}
          #GalleryViewer-{{ section.id }} .slider-button {
            height: {{ mcc_h }}px;
          }
        {%- endif %}
        {%- comment -%} "Space above controls" replaces the media list's own 3rem (~24px) mobile bottom margin (section-main-product.css ≤749px) — that margin IS the whitespace above the controls, so overriding it (not adding a margin-top on the buttons) makes the slider value the whole image→controls gap. {%- endcomment -%}
        {%- if mcc_mt > 0 %}
          #GalleryViewer-{{ section.id }} .product__media-list {
            margin-bottom: {{ mcc_mt }}px;
          }
        {%- endif %}
      }
    {%- endif -%}

    {%- comment -%}
      Stacked-scroll thumbnail rail controls (desktop only). Consumed by the
      .thumbnail-slider--rail rules in section-main-product.css. px→rem ÷10 keeps
      Dawn's 62.5% rem basis, so the defaults (64/16) reproduce 6.4rem/1.6rem exactly.
    {%- endcomment -%}
    #MainProduct-{{ section.id }} {
      --mp-thumb-size: {{ section.settings.thumbnail_size | divided_by: 10.0 }}rem;
      --mp-thumb-gap: {{ section.settings.thumbnail_gap | divided_by: 10.0 }}rem;
    }

    {%- comment -%}
      Name + thumbnails top offset. The info container and the stacked-scroll rail
      are both sticky and rest at the first image's top; margin-top nudges their
      REST position down together (the sticky top stays = --header-height, so they
      still tuck under the header on scroll) while the main image stays put. 0 =
      flush with the image top. Desktop stacked layout (≥1100px).
    {%- endcomment -%}
    {%- assign it_offset = section.settings.info_thumb_top_offset | default: 0 -%}
    {%- if it_offset > 0 -%}
      @media screen and (min-width: 1100px) {
        #MainProduct-{{ section.id }} .product__info-container,
        #MainProduct-{{ section.id }} .thumbnail-slider--rail {
          margin-top: {{ it_offset }}px;
        }
      }
    {%- endif -%}

    {%- comment -%}
      Thumbnail rail max height — lets the thumbnails "end higher up". Overrides the
      default calc(100vh - 153px) cap; the rail keeps overflow-y:auto so extra
      thumbnails scroll. 0 = full height (default). Desktop stacked layout.
    {%- endcomment -%}
    {%- assign rail_mh = section.settings.rail_max_height | default: 0 -%}
    {%- if rail_mh > 0 -%}
      @media screen and (min-width: 1100px) {
        #MainProduct-{{ section.id }} .thumbnail-slider--rail .thumbnail-list {
          max-height: {{ rail_mh }}px;
        }
      }
    {%- endif -%}

    {%- comment -%}
      Description body-copy color. The description block had no color control; this
      is ungated by typography so the default (#1A1A1A) applies as-is and inherits
      to the rendered rich-text paragraphs. ID scope beats .rte.
    {%- endcomment -%}
    {%- assign desc_block = section.blocks | where: 'type', 'description' | first -%}
    {%- if desc_block != blank and desc_block.settings.body_text_color != blank -%}
      #MainProduct-{{ section.id }} .product__description.Block-{{ desc_block.id }} { color: {{ desc_block.settings.body_text_color }}; }
    {%- endif -%}
  {%- endstyle -%}

  {%- comment -%}
    Per-block typography (font family, size, line height) and padding overrides.
    Each content block exposes "Enable typography" / "Enable padding" checkboxes; the
    value controls are revealed in the editor via visible_if and only emit CSS when
    their group is enabled, so the default state changes nothing.
    Scoped to the .Block-<id> class added to each content block's root element below.
    Selectors are prefixed with the section's own id (#ProductInfo-<section.id>, the
    same element as .product__info-container) so the ID specificity beats class-based
    theme rules (heading font, .price sizes, etc.).
    Emitted here (outside .product__info-container) so the <style> element does not
    become a child of the info column and shift the "> * + *" block-spacing selectors.
  {%- endcomment -%}
  {%- style -%}
    {%- assign tg_scope = 'ProductInfo-' | append: section.id -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.tg_enable_type -%}
        {%- liquid
          assign tg_font = block.settings.tg_font
          assign tg_weight = block.settings.tg_font_weight | default: 'default'
          assign tg_fs = block.settings.tg_font_size | default: 0
          assign tg_lh = block.settings.tg_line_height | default: 0
          assign tg_case = block.settings.tg_text_case | default: 'default'
          assign tg_ls = block.settings.tg_letter_spacing | default: 0
          assign tg_col = block.settings.tg_color
        -%}
        {%- capture tg_brand_stack -%}{% render 'brand-font', font: block.settings.tg_custom_font %}{%- endcapture -%}
        {%- assign tg_brand_stack = tg_brand_stack | strip -%}
        {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
          {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
          {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
        {%- endif -%}
        {%- capture tg_typedecl -%}
          {%- if tg_brand_stack != blank %}font-family: {{ tg_brand_stack }};{% elsif tg_font != blank %}font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }};{% endif -%}
          {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
          {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
          {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
          {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- endcapture -%}
        {%- assign tg_typedecl = tg_typedecl | strip -%}
        {%- if tg_typedecl != blank -%}
          {%- case block.type -%}
            {%- when 'title' -%}
              #{{ tg_scope }} .Block-{{ block.id }} h1, #{{ tg_scope }} .Block-{{ block.id }} h2 { {{ tg_typedecl }} }
            {%- when 'price' -%}
              #{{ tg_scope }} .Block-{{ block.id }} .price, #{{ tg_scope }} .Block-{{ block.id }} .price-item { {{ tg_typedecl }} }
            {%- when 'badges' -%}
              #{{ tg_scope }} .Block-{{ block.id }} .badge { {{ tg_typedecl }} }
            {%- when 'pair_it_with' -%}
              {%- comment -%} Heading only — the generic else branch would restyle the product-card text inside the block. {%- endcomment -%}
              #{{ tg_scope }} .Block-{{ block.id }} .pair-it-with__heading { {{ tg_typedecl }} }
            {%- when 'collapsible_tab' -%}
              {%- comment -%} Heading only — the accordion body keeps theme styling. {%- endcomment -%}
              #{{ tg_scope }} .Block-{{ block.id }} .accordion__title { {{ tg_typedecl }} }
            {%- when 'rating' -%}
              #{{ tg_scope }} .Block-{{ block.id }} .rating-text, #{{ tg_scope }} .Block-{{ block.id }} .rating-count { {{ tg_typedecl }} }
            {%- when 'size-chart' -%}
              {%- comment -%} Button elements block font inheritance, so the full declaration (incl. font-style/weight/line-height) lands on the button directly — covers both the standalone and inline Size-row placements (both wrappers carry Block-id) and out-specifies the hardcoded #ProductPopup-<id> font-size. {%- endcomment -%}
              #{{ tg_scope }} .Block-{{ block.id }} .product-popup-modal__button { {{ tg_typedecl }}{% if tg_font != blank %} font-style: {{ tg_font.style }};{% if tg_weight == 'default' %} font-weight: {{ tg_font.weight }};{% endif %}{% endif %}{% if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif %} }
            {%- when 'variant_picker' -%}
              {%- comment -%} Labels, selects and pills carry their own font/color theme rules, so the declaration must land on them directly; the font_picker's style dropdown is honored via font-style/font-weight. Checked pills keep the theme's inverted colors, so the custom color skips them. {%- endcomment -%}
              #{{ tg_scope }} .Block-{{ block.id }}, #{{ tg_scope }} .Block-{{ block.id }} .form__label, #{{ tg_scope }} .Block-{{ block.id }} .select__select, #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill input[type='radio'] + label { {{ tg_typedecl }}{% if tg_brand_stack != blank %} font-style: normal;{% if tg_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tg_font != blank %} font-style: {{ tg_font.style }};{% if tg_weight == 'default' %} font-weight: {{ tg_font.weight }};{% endif %}{% endif %} }
              {%- if tg_col != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }}, #{{ tg_scope }} .Block-{{ block.id }} .select__select, #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill input[type='radio']:not(:checked) + label { color: {{ tg_col }}; }
              {%- endif -%}
            {%- else -%}
              #{{ tg_scope }} .Block-{{ block.id }} { {{ tg_typedecl }} }
          {%- endcase -%}
        {%- endif -%}
        {%- if tg_lh > 0 -%}
          {%- if block.type == 'collapsible_tab' -%}
            {%- comment -%} The wrapper rule never reaches the h2 heading (base.css sets heading line-height), so land it on the title directly. {%- endcomment -%}
            #{{ tg_scope }} .Block-{{ block.id }} .accordion__title { line-height: {{ tg_lh }}%; }
          {%- else -%}
            #{{ tg_scope }} .Block-{{ block.id }} { line-height: {{ tg_lh }}%; }
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
      {%- if block.settings.tg_enable_padding -%}
        {%- liquid
          assign tg_pt = block.settings.tg_padding_top | default: 0
          assign tg_pb = block.settings.tg_padding_bottom | default: 0
        -%}
        {%- if tg_pt > 0 or tg_pb > 0 -%}
          {%- comment -%} Blocks that expose the mobile sliders (schema probe: tg_padding_top_mobile defined → not nil) get the desktop rule scoped ≥750px so the mobile pass below fully owns small screens. Blocks without them keep the legacy all-size rule. Wrapped (snippet) blocks additionally zero the inner root's own margin so padding is the sole spacing and does not stack with theme descendant margins (.product-form / .icon-with-text carry 2.5rem). {%- endcomment -%}
          {%- if block.settings.tg_padding_top_mobile == nil -%}
            #{{ tg_scope }} .Block-{{ block.id }} {
              {%- if tg_pt > 0 %} padding-top: {{ tg_pt }}px;{% endif -%}
              {%- if tg_pb > 0 %} padding-bottom: {{ tg_pb }}px;{% endif -%}
            }
            {%- case block.type -%}
              {%- when 'variant_picker', 'buy_buttons', 'share', 'icon-with-text', 'bis_form' -%}
                #{{ tg_scope }} .Block-{{ block.id }} > * { margin-top: 0; margin-bottom: 0; }
            {%- endcase -%}
          {%- else -%}
            @media screen and (min-width: 750px) {
              #{{ tg_scope }} .Block-{{ block.id }} {
                {%- if tg_pt > 0 %} padding-top: {{ tg_pt }}px;{% endif -%}
                {%- if tg_pb > 0 %} padding-bottom: {{ tg_pb }}px;{% endif -%}
              }
              {%- case block.type -%}
                {%- when 'variant_picker', 'buy_buttons', 'share', 'icon-with-text', 'bis_form' -%}
                  #{{ tg_scope }} .Block-{{ block.id }} > * { margin-top: 0; margin-bottom: 0; }
              {%- endcase -%}
            }
          {%- endif -%}
        {%- endif -%}
        {%- comment -%} Mobile padding pass (≤749px). All four axes. For blocks with the sliders the desktop rule above is ≥750px-scoped, so these values fully own mobile — 0 genuinely means no padding; the > 0 guards only skip no-op declarations. Blocks without the sliders read nil → default 0 → no output (their all-size rule stands). {%- endcomment -%}
        {%- liquid
          assign tg_pt_m = block.settings.tg_padding_top_mobile | default: 0
          assign tg_pb_m = block.settings.tg_padding_bottom_mobile | default: 0
          assign tg_pl_m = block.settings.tg_padding_left_mobile | default: 0
          assign tg_pr_m = block.settings.tg_padding_right_mobile | default: 0
        -%}
        {%- if tg_pt_m > 0 or tg_pb_m > 0 or tg_pl_m > 0 or tg_pr_m > 0 -%}
          @media screen and (max-width: 749px) {
            #{{ tg_scope }} .Block-{{ block.id }} {
              {%- if tg_pt_m > 0 %} padding-top: {{ tg_pt_m }}px;{% endif -%}
              {%- if tg_pb_m > 0 %} padding-bottom: {{ tg_pb_m }}px;{% endif -%}
              {%- if tg_pl_m > 0 %} padding-left: {{ tg_pl_m }}px;{% endif -%}
              {%- if tg_pr_m > 0 %} padding-right: {{ tg_pr_m }}px;{% endif -%}
            }
            {%- comment -%} Same wrapped-block margin armor as the desktop rule, so mobile padding is also the sole spacing. {%- endcomment -%}
            {%- case block.type -%}
              {%- when 'variant_picker', 'buy_buttons', 'share', 'icon-with-text', 'bis_form' -%}
                #{{ tg_scope }} .Block-{{ block.id }} > * { margin-top: 0; margin-bottom: 0; }
            {%- endcase -%}
          }
        {%- endif -%}
      {%- endif -%}
      {%- if block.type == 'variant_picker' -%}
        {%- comment -%} Per-element typography overrides (option name / values / chosen value / swatch message). Settings follow tg_<element>_<suffix> naming so one data-driven loop reads them via bracket access. Rules are emitted after the shared tg_ base rules above, so they win specificity ties deterministically — 'selected' (chosen value) comes after 'value' in the element list, so it also wins the tie on the dropdown's .select__select. {%- endcomment -%}
        {%- assign tgv_elements = 'label,value,selected,message' | split: ',' -%}
        {%- for tgv_el in tgv_elements -%}
          {%- assign tgv_key = 'tg_' | append: tgv_el -%}
          {%- assign tgv_enable_key = tgv_key | append: '_enable' -%}
          {%- unless block.settings[tgv_enable_key] -%}
            {%- continue -%}
          {%- endunless -%}
          {%- liquid
            assign tgv_font_key = tgv_key | append: '_font'
            assign tgv_weight_key = tgv_key | append: '_weight'
            assign tgv_size_key = tgv_key | append: '_size'
            assign tgv_lh_key = tgv_key | append: '_line_height'
            assign tgv_case_key = tgv_key | append: '_case'
            assign tgv_ls_key = tgv_key | append: '_letter_spacing'
            assign tgv_color_key = tgv_key | append: '_color'
            assign tgv_custom_font_key = tgv_key | append: '_custom_font'
            assign tgv_font = block.settings[tgv_font_key]
            assign tgv_custom_font = block.settings[tgv_custom_font_key]
            assign tgv_weight = block.settings[tgv_weight_key] | default: 'default'
            assign tgv_fs = block.settings[tgv_size_key] | default: 0
            assign tgv_lh = block.settings[tgv_lh_key] | default: 0
            assign tgv_case = block.settings[tgv_case_key] | default: 'default'
            assign tgv_ls = block.settings[tgv_ls_key] | default: 0
            assign tgv_col = block.settings[tgv_color_key]
          -%}
          {%- capture tgv_brand_stack -%}{% render 'brand-font', font: tgv_custom_font %}{%- endcapture -%}
          {%- assign tgv_brand_stack = tgv_brand_stack | strip -%}
          {%- if tgv_font != blank and tgv_brand_stack == blank -%}{{ tgv_font | font_face: font_display: 'swap' }}{%- endif -%}
          {%- if tgv_font != blank and tgv_brand_stack == blank and tgv_weight != 'default' -%}
            {%- assign tgv_wfont = tgv_font | font_modify: 'weight', tgv_weight -%}
            {%- if tgv_wfont -%}{{ tgv_wfont | font_face: font_display: 'swap' }}{%- endif -%}
          {%- endif -%}
          {%- capture tgv_typedecl -%}
            {%- if tgv_brand_stack != blank %}font-family: {{ tgv_brand_stack }}; font-style: normal;{% if tgv_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tgv_font != blank %}font-family: {{ tgv_font.family }}, {{ tgv_font.fallback_families }}; font-style: {{ tgv_font.style }};{% if tgv_weight == 'default' %} font-weight: {{ tgv_font.weight }};{% endif %}{% endif -%}
            {%- if tgv_weight != 'default' and tgv_weight != blank %} font-weight: {{ tgv_weight }};{% endif -%}
            {%- if tgv_fs > 0 %} font-size: {{ tgv_fs }}px;{% endif -%}
            {%- if tgv_lh > 0 %} line-height: {{ tgv_lh }}%;{% endif -%}
            {%- if tgv_case != 'default' and tgv_case != blank %} text-transform: {{ tgv_case }};{% endif -%}
            {%- if tgv_ls > 0 %} letter-spacing: {{ tgv_ls }}px;{% endif -%}
          {%- endcapture -%}
          {%- assign tgv_typedecl = tgv_typedecl | strip -%}
          {%- assign tgv_fulldecl = tgv_typedecl -%}
          {%- if tgv_col != blank -%}
            {%- assign tgv_fulldecl = tgv_typedecl | append: ' color: ' | append: tgv_col | append: ';' | strip -%}
          {%- endif -%}
          {%- case tgv_el -%}
            {%- when 'label' -%}
              {%- if tgv_fulldecl != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }} .form__label [data-option-name] { {{ tgv_fulldecl }} }
              {%- endif -%}
            {%- when 'value' -%}
              {%- comment -%} Checked pills keep the theme's inverted colors, so the custom color skips them (same shape as the base group rule above). {%- endcomment -%}
              {%- if tgv_typedecl != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }} .select__select, #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill input[type='radio'] + label { {{ tgv_typedecl }} }
              {%- endif -%}
              {%- if tgv_col != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }} .select__select, #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill input[type='radio']:not(:checked) + label { color: {{ tgv_col }}; }
              {%- endif -%}
            {%- when 'selected' -%}
              {%- if tgv_fulldecl != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }} .form__label [data-selected-value], #{{ tg_scope }} .Block-{{ block.id }} .select__select { {{ tgv_fulldecl }} }
              {%- endif -%}
            {%- when 'message' -%}
              {%- comment -%} The message div carries the Block-id class itself, so this works without the picker wrapper div. {%- endcomment -%}
              {%- if tgv_fulldecl != blank -%}
                #{{ tg_scope }} .Block-{{ block.id }}.custom_message, #{{ tg_scope }} .Block-{{ block.id }}.custom_message p { {{ tgv_fulldecl }} }
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- liquid
          assign tgv_gap_groups = block.settings.tg_gap_option_groups | default: 0
          assign tgv_gap_pills = block.settings.tg_gap_pills | default: 0
          assign tgv_gap_swatches = block.settings.tg_gap_swatches | default: 0
        -%}
        {%- if tgv_gap_groups > 0 -%}
          #{{ tg_scope }} .Block-{{ block.id }} .product-form__input { margin-bottom: {{ tgv_gap_groups }}px; }
        {%- endif -%}
        {%- comment -%} Pills/swatches are inline-blocks in a fieldset (flex gap is unreliable there): gap = right/bottom margins on each chip. The chip top margin gets zeroed, so the label picks up 0.9rem to preserve today's label-to-first-row distance (0.2rem label margin + 0.7rem chip top margin). {%- endcomment -%}
        {%- if tgv_gap_pills > 0 -%}
          #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill input[type='radio'] + label { margin: 0 {{ tgv_gap_pills }}px {{ tgv_gap_pills }}px 0; }
          #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--pill .form__label { margin-bottom: 0.9rem; }
        {%- endif -%}
        {%- if tgv_gap_swatches > 0 -%}
          #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--swatch .swatch-input__input + .swatch-input__label { margin: 0 {{ tgv_gap_swatches }}px {{ tgv_gap_swatches }}px 0; }
          #{{ tg_scope }} .Block-{{ block.id }} .product-form__input--swatch .form__label { margin-bottom: 0.9rem; }
        {%- endif -%}
        {%- liquid
          assign tgv_sw_w = block.settings.swatch_width | default: 0
