{% liquid
  assign careers = shop.metafields.data.careers.value

  assign num_careers = 0
  for career in careers
    assign num_careers = num_careers | plus: 1
  endfor

  echo num_careers
%}

<div class="page-width page-width--narrow section-{{ section.id }}-padding">
  <h1 class="main-page-title page-title h2{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    {{ page.title | escape }}
  </h1>
  <div class="rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {% if num_careers > 0 %}
      {% for career in careers %}
        <div class="career-block">
          <h3>{{ career.title }}</h3>
          <p>{{ career.description }}</p>
          <a href="{{ career.link }}" class="button button--secondary">Apply Now</a>
          <br>
        </div>
      {% endfor %}
    {% else %}
      <p>No careers available at this time.</p>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Careers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom-liquid.settings.custom_liquid.label",
      "info": "t:sections.custom-liquid.settings.custom_liquid.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Careers"
    }
  ]
}
{% endschema %}
