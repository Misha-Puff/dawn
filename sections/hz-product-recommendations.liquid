{% liquid
  case section.settings.layout_type
    when 'grid'
      assign classes = 'resource-list--grid'
    when 'carousel'
      assign classes = 'resource-list__carousel'
  endcase

  capture styles
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--resource-list-row-gap-desktop: ' | append: section.settings.rows_gap | append: 'px;'
    echo '--resource-list-columns: repeat(' | append: section.settings.columns | append: ', 1fr);'
    echo '--resource-list-columns-mobile: repeat(' | append: section.settings.mobile_columns | append: ', 1fr);'
    echo '--resource-list-column-gap-desktop: ' | append: section.settings.columns_gap | append: 'px;'
    echo '--column-count: ' | append: section.settings.columns | append: ';'
    echo '--column-count-mobile: ' | append: section.settings.mobile_columns | append: ';'
  endcapture
%}

{% comment %} Stock :27-28 quick-add style renders REMOVED (round 3 — the
  Horizon .quick-add CSS collides with Dawn's .quick-add class; see header).
  RE-ADD only with a Horizon-modal re-wire. {% endcomment %}
{% render 'variant-picker-styles' %}
{% render 'product-badges-styles' %}
{% render 'resource-list-styles' %}
<hz-product-recommendations
  id="product-recommendations-{{ section.id }}"
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.max_products }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ section.settings.product.id | default: product.id }}"
  data-intent="{{ section.settings.recommendation_type }}"
  data-testid="product-recommendations-section"
  data-recommendations-performed="{{ recommendations.performed }}"
  data-hydration-key="product-recommendations-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  {% liquid
    if section.settings.background_color != blank
      render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
    endif
  %}

  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      section--{{ section.settings.section_width }}
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      section-resource-list
      spacing-style
      gap-style
    "
    style="
      {%  render 'spacing-style', settings: section.settings %}
      {%  render 'gap-style', value: section.settings.gap %}
      {{ styles }}
    "
  >
    <div class="section-resource-list__content">
      {% content_for 'blocks' %}
    </div>

    {%- if recommendations.performed or section.settings.product == blank -%}
      {% liquid
        if section.settings.product == blank
          assign products = null
          # Onboarding mode: Show placeholder products
          for i in (1..section.settings.max_products)
            assign products = products | append: ', '
            assign products = products | split: ','
          endfor
        elsif recommendations.performed and recommendations.products_count == 0
          # No recommendations found, pull from catalog
          if section.settings.recommendation_type == 'related'
            assign products = collections.all.products | reject: 'id', section.settings.product.id
          elsif section.settings.recommendation_type == 'complementary'
            # Do not recommend the All collection as complementary products
            assign products = null
          endif

        else
          assign products = recommendations.products
        endif
      %}
      {% comment %}
        theme-check-disable UniqueStaticBlockId — the repeated
        static-product-card id is stock Horizon's own pattern (one static
        block definition, re-rendered per product). Upload validation
        accepts it; the lint rule doesn't model loops.
      {% endcomment %}
      {% comment %}theme-check-disable UniqueStaticBlockId{% endcomment %}
      {% capture list_items %}
        {% assign hz_rendered_count = 0 %}
        {% for product in products limit: section.settings.max_products %}
          {% comment %}
            Phase-12 LOCKSMITH GATE (leak prevention) — the
            hz-product-list:107-119 pattern: locked products must not
            surface in recommendations for sessions that fail the lock.
            Nil-safe in onboarding mode (blank placeholder product →
            'false'). Gated products still consume loop slots, matching
            the native grid's behavior.
          {% endcomment %}
          {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
          {% assign lock_content = lock_content | strip %}
          {% if lock_content == 'true' %}
            {% continue %}
          {% endif %}
          {% comment %}
            Dawn deviation from stock's `unless forloop.last` suffix marker
            (hz-product-list precedent): the split marker is emitted BEFORE
            every rendered item except the first, so a gated (skipped)
            product can't leave a trailing marker — a trailing marker would
            split into an empty chunk and render as an empty carousel slide.
          {% endcomment %}
          {% if hz_rendered_count > 0 %}<!--@list/split-->{% endif %}
          <div class="resource-list__item">
            {% content_for 'block',
              type: '_product-card',
              id: 'static-product-card',
              closest.product: product,
              product_view_context: 'recommendation'
            %}
          </div>
          {% assign hz_rendered_count = hz_rendered_count | plus: 1 %}
        {% endfor %}
      {% endcapture %}
      {% comment %}theme-check-enable UniqueStaticBlockId{% endcomment %}

      {% liquid
        # Create an array from the list items to be used in the carousel
        assign slide_content = list_items | strip
        assign slides = slide_content | split: '<!--@list/split-->'

        if products != blank and products.size > 0
          assign has_recommendations = 'true'
        else
          assign has_recommendations = 'false'
        endif
      %}

      <div
        class="
          resource-list
          {% if section.settings.layout_type == 'carousel' %}
            force-full-width
          {% endif %}
          {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
            hidden--mobile
          {% endif %}
          {{ classes }}
        "
        {% if section.settings.layout_type == 'grid' %}
          data-testid="resource-list-grid"
        {% endif %}
        data-has-recommendations="{{ has_recommendations }}"
      >
        {% case section.settings.layout_type %}
          {% when 'grid' %}
            {{ list_items }}
          {% when 'carousel' %}
            {% comment %}
              slide_count deviates from stock's recommendations.products.size:
              the post-gate slides.size keeps carousel controls tracking the
              rendered count (stock would overcount Locksmith-gated items).
            {% endcomment %}
            {% render 'resource-list-carousel',
              ref: 'resourceListCarousel',
              slides: slides,
              slide_count: slides.size,
              settings: section.settings
            %}
        {% endcase %}
      </div>

      {% if section.settings.carousel_on_mobile and section.settings.layout_type != 'carousel' %}
        {% liquid
          assign mobile_carousel_gap = section.settings.columns_gap
        %}
        <div
          class="
            resource-list
            hidden--desktop
            force-full-width
          "
          style="
            --resource-list-gap: {{ mobile_carousel_gap }}px;
            --column-count: {{ section.settings.columns }};
          "
        >
          {% render 'resource-list-carousel',
            ref: 'resourceListCarouselMobile',
            slides: slides,
            slide_count: slides.size,
            settings: section.settings
          %}
        </div>
      {% endif %}
    {%- else -%}
      <div
        class="resource-list resource-list--grid"
      >
        {% for i in (1..section.settings.columns) %}
          <div
            class="product-recommendations__skeleton-item"
            aria-label="Loading product recommendations"
          ></div>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
</hz-product-recommendations>

{% stylesheet %}
  /* Dawn adaptation of Horizon base.css .section grid (68760d9
     base.css:333-419), scoped to .section-resource-list — copied from the
     hz-product-list host (each standalone host carries its own copy; same
     store-specific reduction: .page-width max-width is disabled, so
     --util-page-margin-offset === the page padding; gutters follow Dawn's
     1100px page-padding breakpoint). */
  .section-resource-list {
    --util-page-margin-offset: var(--page-width-padding);
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns:
      minmax(var(--util-page-margin-offset), 1fr)
      minmax(0, calc(100% - var(--util-page-margin-offset) * 2))
      minmax(var(--util-page-margin-offset), 1fr);
  }

  @media screen and (max-width: 1099px) {
    .section-resource-list {
      --util-page-margin-offset: var(--mobile-page-width-padding);
    }
  }

  .section-resource-list > * {
    grid-column: 2;
  }

  .section-resource-list.section--full-width > * {
    grid-column: 1 / -1;
  }

  /* Horizon base.css:418 leg, re-scoped from `.section >` to this host's
     section class: carousel layouts break out to the full page width. */
  .section-resource-list > .force-full-width {
    grid-column: 1 / -1;
  }

  /* Horizon base.css:3605-3633 extraction (subset, verbatim): the section's
     row gap, the content/header empty-state collapse. */
  .section-resource-list {
    row-gap: var(--gap);
  }

  .section-resource-list__content {
    display: flex;
    flex-direction: column;
    align-items: var(--horizontal-alignment);
    gap: var(--gap);
    width: 100%;
  }

  .section-resource-list__content:empty {
    display: none;
  }

  /* Horizon base.css:3795-3813 extraction (recs-specific), verbatim except
     two documented Dawn adaptations: (1) stock's `background-color:
     var(--color-foreground)` expects Horizon's FULL-COLOR var — in this
     port --color-foreground is a Dawn comma triplet, so it's wrapped in
     rgb() (hz-ui-tokens --color-border precedent); (2) --skeleton-opacity
     lives in Horizon's theme-styles-variables.liquid:639 (not ported) —
     its value (0.025) is carried as the var() fallback. The final rule is
     a TAG selector: retargeted to the renamed element (tag selectors move
     in lockstep with the rename; see doc-header). */
  .product-recommendations {
    display: block;
  }

  .product-recommendations__skeleton-item {
    aspect-ratio: 3 / 4;
    background-color: rgb(var(--color-foreground));
    opacity: var(--skeleton-opacity, 0.025);
    border-radius: 4px;
  }

  @media screen and (max-width: 749px) {
    .product-recommendations__skeleton-item:nth-child(2n + 1) {
      display: none;
    }
  }

  hz-product-recommendations:has([data-has-recommendations='false']) {
    display: none;
  }
{% endstylesheet %}

