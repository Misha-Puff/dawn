{% liquid
  if section.blocks.size > 0
    assign use_blocks = true
  else
    assign use_blocks = false
    if section.settings.data_source == 'shop'
      assign outfits = shop.metafields[section.settings.shop_metafield_namespace][section.settings.shop_metafield_key].value
    else
      assign outfits = product.metafields.product_page.shop_the_look_outfits.value
    endif
  endif

  assign num_outfits = 0

  if use_blocks
    for block in section.blocks
      assign outfit = block.settings.outfit
      if outfit.lead_image.value == blank
        continue
      endif
      if section.settings.enforce_product_minimum
        assign num_products = 0
        for product in outfit.products
          assign num_products = num_products | plus: 1
        endfor
        if num_products >= 4
          assign num_outfits = num_outfits | plus: 1
        endif
      else
        assign num_outfits = num_outfits | plus: 1
      endif
    endfor
  else
    for outfit in outfits
      if outfit.lead_image.value == blank
        continue
      endif
      if section.settings.enforce_product_minimum
        assign num_products = 0
        for product in outfit.products
          assign num_products = num_products | plus: 1
        endfor

        if num_products >= 4
          assign num_outfits = num_outfits | plus: 1
        endif
      else
        assign num_outfits = num_outfits | plus: 1
      endif
    endfor
  endif
%}

{% unless num_outfits == 0 %}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}

  {%- unless section.settings.quick_add == 'none' -%}
    {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  {%- endunless -%}

  {%- if section.settings.quick_add == 'standard' -%}
    <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if section.settings.quick_add == 'bulk' -%}
    <script src="{{ 'quick-add-bulk.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'quick-order-list.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <style>
    @media screen and (max-width: 1100px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.mobile_padding_top }}px;
        padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
        {% if section.settings.mobile_padding_left > 0 %}
          padding-left: {{ section.settings.mobile_padding_left  }}px;
        {% endif %}
        {% if section.settings.mobile_padding_right > 0 %}
          padding-right: {{ section.settings.mobile_padding_right  }}px;
        {% endif %}
      }
    }

    @media screen and (min-width: 1100px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.desktop_padding_top }}px;
        padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
        {% if section.settings.desktop_padding_left > 0 %}
          padding-left: {{ section.settings.desktop_padding_left  }}px;
        {% endif %}
        {% if section.settings.desktop_padding_right > 0 %}
          padding-right: {{ section.settings.desktop_padding_right  }}px;
        {% endif %}
      }
    }

    .carousel-container {
      position: relative;
      width: 100%;
    }

    .carousel {
      position: relative;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      -ms-overflow-style: none;
      scrollbar-width: none;
    }

    .carousel-title {
      margin-left: {{ section.settings.desktop_slide_margin }}px;
      margin-bottom: {{ section.settings.title_margin_bottom }}px;
      font-size: {{ section.settings.title_font_size }}px;
    }

    .carousel::-webkit-scrollbar {
      display: none;
    }

    .carousel-slide {
      width: {{ section.settings.desktop_slide_width }}%;
      position: relative;
      flex-shrink: 0;
      margin: 0 {{ section.settings.desktop_slide_margin }}px;
      overflow: hidden;
      scroll-snap-align: center;
    }

    .slide-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.desktop_grid_gap }}px;
    }

    .main-box,
    .sub-box {
      overflow: hidden;
      position: relative;
    }

    .sub-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: {{ section.settings.desktop_grid_gap }}px;
    }

    .main-box img,
    .sub-box img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .mobile-look-title {
      margin: 0;
      font-size: 12px;
    }

    .desktop-look-title {
      margin-top: 0;
      font-size: 12px;
    }

    .carousel--stacked {
      flex-wrap: wrap;
      overflow-x: visible;
      scroll-snap-type: none;
      scroll-behavior: auto;
    }

    .carousel--stacked .carousel-slide {
      width: 100%;
      margin: 0 {{ section.settings.desktop_slide_margin }}px {{ section.settings.desktop_slide_margin }}px;
    }

    @media (max-width: 1099px) {
      .carousel-title {
        margin-left: {{ section.settings.mobile_slide_margin }}px;
      }

      .carousel-slide {
        width: {{ section.settings.mobile_slide_width }}%;
        margin: 0 {{ section.settings.mobile_slide_margin }}px;
      }

      .slide-grid {
        grid-template-columns: 1fr;
        gap: {{ section.settings.mobile_grid_gap }}px;
      }

      .sub-grid {
        gap: {{ section.settings.mobile_grid_gap }}px;
      }
    }
  </style>
  {%- comment -%}
    Card-settings parity note: tiles render hide_content, so title/price/swatch/
    overlay markup never exists here — the spacing/typography/overlay/swatch packs
    would be dead settings and are deliberately omitted. Only the Swym heart
    (app-injected onto the media) can emit from the shared snippet.
  {%- endcomment -%}
  {%- style -%}
    {% render 'card-settings-styles' %}
  {%- endstyle -%}
  <div class="section-{{ section.id }}-padding">
    {% if section.settings.title_text != blank %}
      <h1 class="carousel-title">{{ section.settings.title_text }}</h1>
    {% endif %}
    <div class="carousel-container card-redesign">
      <div class="carousel{% if section.settings.layout == 'stacked' %} carousel--stacked{% endif %}">
        {% assign look_number = 0 %}
        {% if use_blocks %}
          {% for block in section.blocks %}
            {% liquid
              assign outfit = block.settings.outfit
              assign lead_image = outfit.lead_image.value
              if lead_image == blank
                continue
              endif
              assign lead_image_link = outfit.lead_image_link
              assign products = outfit.products.value
              assign flats = outfit.flats.value

              if section.settings.enforce_product_minimum
                assign num_products = 0
                for product in outfit.products
                  assign num_products = num_products | plus: 1
                endfor
                if num_products < 4
                  continue
                endif
              endif

              assign look_number = look_number | plus: 1
            %}

            <div class="carousel-slide" {{ block.shopify_attributes }}>
              <p class="is-hidden-mobile-only desktop-look-title">LOOK #{{ look_number }}</p>
              <div class="slide-grid">
                <div class="main-box">
                  {% if lead_image_link %}<a href="{{ lead_image_link }}">{% endif %}
                  <img
                    srcset="
                      {%- if lead_image.width >= 550 -%}{{ lead_image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if lead_image.width >= 1100 -%}{{ lead_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if lead_image.width >= 1445 -%}{{ lead_image | image_url: width: 1445 }} 1445w,{%- endif -%}
                      {%- if lead_image.width >= 1680 -%}{{ lead_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                      {%- if lead_image.width >= 2048 -%}{{ lead_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                      {%- if lead_image.width >= 2200 -%}{{ lead_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                      {%- if lead_image.width >= 2890 -%}{{ lead_image | image_url: width: 2890 }} 2890w,{%- endif -%}
                      {%- if lead_image.width >= 4096 -%}{{ lead_image | image_url: width: 4096 }} 4096w,{%- endif -%}
                      {{ lead_image | image_url }} {{ lead_image.width }}w
                    "
                    sizes="(min-width: 750px) calc(100vw - 22rem), 1100px"
                    src="{{ lead_image | image_url: width: 1445 }}"
                    alt="{{ lead_image.alt | escape }}"
                    loading="lazy"
                    width="1100"
                    height="{{ 1100 | divided_by: lead_image.aspect_ratio | ceil }}"
                  >
                  {% if lead_image_link %}</a>{% endif %}
                </div>
                <p class="is-hidden-desktop-only mobile-look-title">LOOK #{{ look_number }}</p>
                <div class="sub-grid">
                  {% for product in products limit: 4 %}
                    {% assign skip_card_product_styles = false %}
                    {% assign outer = forloop.index0 %}
                    {% for flat in flats %}
                      {% assign inner = forloop.index0 %}
                      {% if outer == inner %}
                        <div class="sub-box">
                          {% render 'card-product',
                            card_product: product,
                            media_aspect_ratio: 'adapt',
                            image_shape: 'default',
                            show_secondary_image: false,
                            show_vendor: false,
                            show_rating: false,
                            skip_styles: skip_card_product_styles,
                            section_id: section.id,
                            quick_add: section.settings.quick_add,
                            quick_add_mobile_only: section.settings.quick_add_mobile_only,
                            custom_media: flat,
                            hide_content: true,
                            hide_color_suffix: true
                          %}
                          {% assign skip_card_product_styles = true %}
                        </div>
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          {% for outfit in outfits %}
            {% liquid
              assign lead_image = outfit.lead_image.value
              if lead_image == blank
                continue
              endif
              assign lead_image_link = outfit.lead_image_link
              assign products = outfit.products.value
              assign flats = outfit.flats.value

              if section.settings.enforce_product_minimum
                assign num_products = 0

                for product in outfit.products
                  assign num_products = num_products | plus: 1
                endfor

                if num_products < 4
                  continue
                endif
              endif

              assign look_number = look_number | plus: 1
            %}

            <div class="carousel-slide">
              <p class="is-hidden-mobile-only desktop-look-title">LOOK #{{ look_number }}</p>
              <div class="slide-grid">
                <div class="main-box">
                  {% if lead_image_link %}<a href="{{ lead_image_link }}">{% endif %}
                  <img
                    srcset="
                      {%- if lead_image.width >= 550 -%}{{ lead_image | image_url: width: 550 }} 550w,{%- endif -%}
                      {%- if lead_image.width >= 1100 -%}{{ lead_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                      {%- if lead_image.width >= 1445 -%}{{ lead_image | image_url: width: 1445 }} 1445w,{%- endif -%}
                      {%- if lead_image.width >= 1680 -%}{{ lead_image | image_url: width: 1680 }} 1680w,{%- endif -%}
                      {%- if lead_image.width >= 2048 -%}{{ lead_image | image_url: width: 2048 }} 2048w,{%- endif -%}
                      {%- if lead_image.width >= 2200 -%}{{ lead_image | image_url: width: 2200 }} 2200w,{%- endif -%}
                      {%- if lead_image.width >= 2890 -%}{{ lead_image | image_url: width: 2890 }} 2890w,{%- endif -%}
                      {%- if lead_image.width >= 4096 -%}{{ lead_image | image_url: width: 4096 }} 4096w,{%- endif -%}
                      {{ lead_image | image_url }} {{ lead_image.width }}w
                    "
                    sizes="(min-width: 750px) calc(100vw - 22rem), 1100px"
                    src="{{ lead_image | image_url: width: 1445 }}"
                    alt="{{ lead_image.alt | escape }}"
                    loading="lazy"
                    width="1100"
                    height="{{ 1100 | divided_by: lead_image.aspect_ratio | ceil }}"
                  >
                  {% if lead_image_link %}</a>{% endif %}
                </div>
                <p class="is-hidden-desktop-only mobile-look-title">LOOK #{{ look_number }}</p>
                <div class="sub-grid">
                  {% for product in products limit: 4 %}
                    {% assign skip_card_product_styles = false %}
                    {% assign outer = forloop.index0 %}
                    {% for flat in flats %}
                      {% assign inner = forloop.index0 %}
                      {% if outer == inner %}
                        <div class="sub-box">
                          {% render 'card-product',
                            card_product: product,
                            media_aspect_ratio: 'adapt',
                            image_shape: 'default',
                            show_secondary_image: false,
                            show_vendor: false,
                            show_rating: false,
                            skip_styles: skip_card_product_styles,
                            section_id: section.id,
                            quick_add: section.settings.quick_add,
                            quick_add_mobile_only: section.settings.quick_add_mobile_only,
                            custom_media: flat,
                            hide_content: true,
                            hide_color_suffix: true
                          %}
                          {% assign skip_card_product_styles = true %}
                        </div>
                        {% break %}
                      {% endif %}
                    {% endfor %}
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Shop the Look Outfits",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Data Source"
    },
    {
      "type": "select",
      "id": "data_source",
      "label": "Source",
      "options": [
        { "value": "product", "label": "Product (current page)" },
        { "value": "shop", "label": "Shop metafield" }
      ],
      "default": "product"
    },
    {
      "type": "text",
      "id": "shop_metafield_namespace",
      "label": "Shop Metafield Namespace",
      "info": "Only used when Source = Shop metafield"
    },
    {
      "type": "text",
      "id": "shop_metafield_key",
      "label": "Shop Metafield Key",
      "info": "Only used when Source = Shop metafield"
    },
    {
      "type": "text",
      "id": "title_text",
      "label": "Title",
      "default": "How to Wear"
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Title Margin Bottom",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 16,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 24
    },
    {
      "type": "checkbox",
      "id": "enforce_product_minimum",
      "label": "Enforce product minimum",
      "info": "If enabled, this will only display outfits with atleast 4 products",
      "default": false
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "standard",
      "label": "t:sections.main-collection-product-grid.settings.quick_add.label",
      "options": [
        {
          "value": "none",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_1"
        },
        {
          "value": "standard",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_2"
        },
        {
          "value": "bulk",
          "label": "t:sections.main-collection-product-grid.settings.quick_add.options.option_3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "quick_add_mobile_only",
      "default": true,
      "label": "Quick add on mobile only",
      "info": "Hide the quick-add button on desktop (sizes show on hover instead)",
      "visible_if": "{{ section.settings.quick_add != 'none' }}"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "scrolling", "label": "Scrolling" },
        { "value": "stacked", "label": "Stacked" }
      ],
      "default": "scrolling"
    },
    {
      "type": "range",
      "id": "desktop_slide_width",
      "min": 50,
      "max": 100,
      "step": 2,
      "label": "Desktop Slide width (%)",
      "default": 90
    },
    {
      "type": "range",
      "id": "desktop_slide_margin",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Desktop Slide margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "desktop_grid_gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Desktop Grid Gap",
      "default": 8
    },
    {
      "type": "range",
      "id": "mobile_slide_width",
      "min": 50,
      "max": 100,
      "step": 2,
      "label": "Mobile Slide width (%)",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_slide_margin",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Mobile Slide margin",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Mobile Grid Gap",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Bottom Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Desktop Right Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Top Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Bottom Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Mobile Right Padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Wishlist heart"
    },
    {
      "type": "checkbox",
      "id": "heart_custom",
      "default": false,
      "label": "Custom heart size & position",
      "info": "Off = the Wishlist Plus app embed controls the heart"
    },
    {
      "type": "range",
      "id": "heart_size",
      "min": 6,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Heart size",
      "default": 13,
      "visible_if": "{{ section.settings.heart_custom }}"
    },
    {
      "type": "range",
      "id": "heart_top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heart top padding",
      "default": 8,
      "visible_if": "{{ section.settings.heart_custom }}"
    },
    {
      "type": "range",
      "id": "heart_right",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Heart right padding",
      "default": 8,
      "visible_if": "{{ section.settings.heart_custom }}"
    }
  ],
  "blocks": [
    {
      "type": "outfit",
      "name": "Outfit",
      "settings": [
        {
          "type": "metaobject",
          "id": "outfit",
          "label": "Outfit",
          "metaobject_type": "shop_the_look_outfit"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the Look Outfits"
    }
  ]
}
{% endschema %}
