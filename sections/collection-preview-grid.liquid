{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_swatches %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% liquid
  # Explicit lock.shoppable = false forces read-only cards for everyone; unset keeps per-product tiers
  assign force_readonly = false
  if collection.metafields.lock.shoppable.value == false and request.design_mode == false
    assign force_readonly = true
  endif

  # Campaign view is VIP-only on this section: full Locksmith ladder (same
  # conditional as locksmith-v2-lock-product); the editor always shows it.
  # Read-only collections (force_readonly) never expose the campaign — its
  # shoppable product blocks would leak past the lock.
  assign show_campaign_views = false
  if request.design_mode
    assign show_campaign_views = true
  elsif customer
    if customer.tags contains 'staff' or customer.metafields.clienteling.very_important_customer or customer.metafields.clienteling.super_vip or customer.metafields.clienteling.vip
      assign show_campaign_views = true
    endif
  endif

  assign has_campaign = false
  if show_campaign_views and section.settings.enable_campaign and force_readonly == false and section.blocks.size > 0
    assign has_campaign = true
  endif
%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% render 'card-settings-styles' %}

  {%- if has_campaign -%}
    .collection-views {
      position: relative;
    }

    #view-collection-{{ section.id }},
    #view-campaign-{{ section.id }} {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      border: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .collection-view-tabs {
      display: flex;
      justify-content: {% case section.settings.view_tabs_alignment %}{% when 'left' %}flex-start{% when 'right' %}flex-end{% else %}center{% endcase %};
      gap: 2.4rem;
      margin-bottom: 2.4rem;
      border-bottom: 0.1rem solid rgba(var(--color-foreground), 0.15);
    }

    .collection-view-tabs__tab {
      padding: 0 0 1.2rem;
      margin-bottom: -0.1rem;
      font-size: 1.3rem;
      letter-spacing: 0.1rem;
      text-transform: uppercase;
      color: rgba(var(--color-foreground), 0.6);
      border-bottom: 0.2rem solid transparent;
      cursor: pointer;
    }

    /* Base state hides the campaign view; the campaign radio ships :checked
       (see markup), so the :checked rule below reveals it and hides the grid
       on load — Campaign is the default view. Selecting Collection unchecks it
       and restores this base state (grid shown, campaign hidden). */
    .collection-view--campaign {
      display: none;
    }

    #view-collection-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:checked ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      color: rgb(var(--color-foreground));
      border-bottom-color: rgb(var(--color-foreground));
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--grid {
      display: none;
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-view--campaign {
      display: block;
    }

    /* Campaign content sits flush under the tab row's hairline; the grid view
       keeps the 2.4rem breathing room below the tabs. */
    #view-campaign-{{ section.id }}:checked ~ .collection-view-tabs {
      margin-bottom: 0;
    }

    #view-collection-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-collection-{{ section.id }}"],
    #view-campaign-{{ section.id }}:focus-visible ~ .collection-view-tabs label[for="view-campaign-{{ section.id }}"] {
      outline: 0.2rem solid rgba(var(--color-foreground), 0.5);
      outline-offset: 0.3rem;
    }

    /* The Link tab is a real outbound anchor, not a radio state — strip the
       default underline so it matches the label tabs, and give it a hover/focus
       affordance since it never gets the :checked active color. */
    .collection-view-tabs__tab--link {
      text-decoration: none;
    }

    .collection-view-tabs__tab--link:hover,
    .collection-view-tabs__tab--link:focus-visible {
      color: rgb(var(--color-foreground));
    }

    /* Floating escape hatch back to the product grid, revealed only while the
       campaign radio is checked. Must sit as a later sibling of the radios in
       the DOM for the :checked ~ selector to reach it, even though it renders
       fixed to the viewport. Typography defaults mirror .campaign-products__cta
       (template-collection.css) minus the underline; jump_* settings override. */
    {%- liquid
      assign jump_weight = section.settings.jump_font_weight | default: 'default'
      assign jump_fs = section.settings.jump_font_size | default: 0
      assign jump_case = section.settings.jump_text_case | default: 'default'
      assign jump_ls = section.settings.jump_letter_spacing | default: 0
    -%}
    {%- capture jump_brand_stack -%}{% render 'brand-font', font: section.settings.jump_custom_font %}{%- endcapture -%}
    {%- assign jump_brand_stack = jump_brand_stack | strip -%}
    .collection-views__jump {
      display: none;
      position: fixed;
      {% case section.settings.jump_alignment -%}
        {%- when 'left' %} left: 1.6rem;
        {%- when 'right' %} right: 1.6rem;
        {%- else %} left: 50%; transform: translateX(-50%);
      {%- endcase %}
      bottom: calc(1.6rem + env(safe-area-inset-bottom, 0px));
      z-index: 10;
      padding: 1.1rem 2rem;
      {%- if section.settings.jump_pill_enable %}
      background: rgba(255, 255, 255, 0.92);
      -webkit-backdrop-filter: blur(6px);
      backdrop-filter: blur(6px);
      border: 1px solid rgba(26, 26, 26, 0.15);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      {%- else %}
      /* Pill chrome off: match .campaign-products__cta's underlined-text look;
         the padding stays for the tap target. */
      text-decoration: underline;
      text-underline-offset: 3px;
      {%- endif %}
      font-family: {% if jump_brand_stack != blank %}{{ jump_brand_stack }}{% else %}var(--font-mono-family){% endif %};
      font-size: {% if jump_fs > 0 %}{{ jump_fs }}px{% else %}12px{% endif %};
      font-weight: {% if jump_weight != 'default' and jump_weight != blank %}{{ jump_weight }}{% else %}600{% endif %};
      letter-spacing: {% if jump_ls > 0 %}{{ jump_ls }}px{% else %}1px{% endif %};
      text-transform: {% if jump_case != 'default' and jump_case != blank %}{{ jump_case }}{% else %}uppercase{% endif %};
      color: {% if section.settings.jump_color != blank %}{{ section.settings.jump_color }}{% else %}rgb(26, 26, 26){% endif %};
      white-space: nowrap;
      cursor: pointer;
    }

    #view-campaign-{{ section.id }}:checked ~ .collection-views__jump {
      display: block;
    }

    /* Rebuy mounts an EMPTY, transparent, pointer-events:auto 40x40 fixed
       container (#rebuy-bubble-global-alert-modal, z-index 100000) at the
       viewport bottom-center — exactly over this pill's default tap point —
       which silently swallows dead-center clicks. Neutralize it only while
       empty: if Rebuy ever renders a real alert into it, :empty stops
       matching and the container becomes interactive again. */
    #rebuy-bubble-global-alert-modal:empty {
      pointer-events: none;
    }
  {%- endif -%}
{%- endstyle -%}

{% liquid
  assign preview = collection.metafields.lock.unlisted_collection.value
  assign current_page_num = current_page | default: 1
  assign prev_page_num = current_page_num | minus: 1
  assign next_page_num = current_page_num | plus: 1

  assign current_group = nil
  assign has_prev = false
  assign has_next = false
  assign has_prev_ellipsis = false
  assign has_next_ellipsis = false
  assign prev_prev_page_num = current_page_num | minus: 2
  assign next_next_page_num = current_page_num | plus: 2

  for group in preview.groups.value
    if forloop.index == current_page_num
      assign current_group = group
    endif
    if forloop.index == prev_page_num
      assign has_prev = true
    endif
    if forloop.index == next_page_num
      assign has_next = true
    endif
    if forloop.index == prev_prev_page_num
      assign has_prev_ellipsis = true
    endif
    if forloop.index == next_next_page_num
      assign has_next_ellipsis = true
    endif
  endfor

  assign has_products = false
  if current_group != blank and current_group.products.value != blank
    assign has_products = true
  endif
%}

<div class="section-{{ section.id }}-padding card-redesign gradient color-{{ section.settings.color_scheme }}">
  {%- if has_products == false and current_page_num > 1 -%}
    <script>window.location.replace('{{ collection.url }}');</script>
  {%- endif -%}

  {%- comment -%}
    Collection / Campaign toggle (VIP-gated on this section — see has_campaign
    above). The radios, tabs, grid view and campaign view are all direct
    siblings, so the toggle is CSS-first (#view-*:checked ~ ...); a small
    progressive script layers on ?display= deep links and keeps the URL in
    sync with the selected view.
  {%- endcomment -%}
  {%- if has_campaign -%}
    <div class="collection-views">
      <input
        type="radio"
        class="collection-views__radio"
        name="collection-view-{{ section.id }}"
        id="view-campaign-{{ section.id }}"
        {% if section.settings.view_tabs_order != 'collection_first' %}checked{% endif %}
      >
      <input
        type="radio"
        class="collection-views__radio"
        name="collection-view-{{ section.id }}"
        id="view-collection-{{ section.id }}"
        {% if section.settings.view_tabs_order == 'collection_first' %}checked{% endif %}
      >
      {%- capture campaign_tab_html -%}
        <label class="collection-view-tabs__tab" for="view-campaign-{{ section.id }}">
          {{ 'sections.collection_template.view_campaign' | t }}
        </label>
      {%- endcapture -%}
      {%- capture collection_tab_html -%}
        <label class="collection-view-tabs__tab" for="view-collection-{{ section.id }}">
          {{ 'sections.collection_template.view_collection' | t }}
        </label>
      {%- endcapture -%}
      <div class="collection-view-tabs page-width">
        {%- if section.settings.view_tabs_order == 'collection_first' -%}
          {{ collection_tab_html }}{{ campaign_tab_html }}
        {%- else -%}
          {{ campaign_tab_html }}{{ collection_tab_html }}
        {%- endif -%}
        {%- if section.settings.link_tab_url != blank -%}
          <a
            class="collection-view-tabs__tab collection-view-tabs__tab--link"
            href="{{ section.settings.link_tab_url }}"
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ section.settings.link_tab_label | default: 'Link' }}
          </a>
        {%- endif -%}
      </div>
      <script>
        // Ambient campaign videos carry the autoplay attribute, but autoplay
        // fires while the campaign view is still display:none and never
        // starts. Progressive nudge: play them when the campaign radio is
        // selected (videos are muted + playsinline; without JS they show
        // their first frame).
        (function () {
          var campaign = document.getElementById('view-campaign-{{ section.id }}');
          var grid = document.getElementById('view-collection-{{ section.id }}');
          if (!campaign || !grid) return;

          // Deep link (?display=collection|campaign): runs during parse,
          // before either view's DOM exists below, so the :checked CSS state
          // is correct before first paint. "view" is Shopify-reserved.
          var v = new URLSearchParams(window.location.search).get('display');
          if (v === 'collection') grid.checked = true;
          else if (v === 'campaign') campaign.checked = true;

          var play = function () {
            if (!campaign.checked) return;
            document
              .querySelectorAll('.campaign-hero__ambient, .campaign-lifestyle__ambient')
              .forEach(function (v) {
                v.play().catch(function () {});
              });
          };

          // Keep the address bar a shareable deep link: the default (first)
          // tab's view keeps a clean URL, the other carries ?display=.
          // replaceState only (no new history entries); pass history.state
          // through so popstate payloads are never clobbered.
          var defaultView = {% if section.settings.view_tabs_order == 'collection_first' %}'collection'{% else %}'campaign'{% endif %};
          var syncURL = function () {
            var url = new URL(window.location.href);
            var current = grid.checked ? 'collection' : 'campaign';
            if (current === defaultView) url.searchParams.delete('display');
            else url.searchParams.set('display', current);
            history.replaceState(history.state, '', url);
          };

          // This section's pagination links are hand-rolled bare ?page=N
          // anchors (no facets.js AJAX), so a page change is a full
          // navigation that would drop the selected view. Carry the current
          // ?display= state onto every pagination link; re-run on each
          // toggle (registered after syncURL, so the address bar is already
          // updated when it reads it).
          var syncPagination = function () {
            var display = new URLSearchParams(window.location.search).get('display');
            document.querySelectorAll('.pagination a[href]').forEach(function (a) {
              var url = new URL(a.href, window.location.origin);
              if (display) url.searchParams.set('display', display);
              else url.searchParams.delete('display');
              a.href = url;
            });
          };

          document.querySelectorAll('input[name="collection-view-{{ section.id }}"]').forEach(function (r) {
            r.addEventListener('change', play);
            r.addEventListener('change', syncURL);
            r.addEventListener('change', syncPagination);
          });

          // The floating jump link swaps views via native label->radio
          // behavior (which also fires syncURL above); JS only adds the
          // scroll back to top. Bound on the label, not the radios' change,
          // so clicking the top Collection tab doesn't also scroll. The
          // label sits at the END of the wrapper (the :checked ~ CSS needs
          // it after the radios) so it doesn't exist yet while this script
          // parses — defer the lookup; on editor re-renders the DOM is
          // already complete and the fresh node binds immediately. Same
          // deferral for the pagination sync — those links render below too.
          var bindJump = function () {
            var jump = document.querySelector('label[for="view-collection-{{ section.id }}"].collection-views__jump');
            if (jump) {
              jump.addEventListener('click', function () {
                var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
              });
            }
            syncPagination();
          };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bindJump);
          else bindJump();
          play();
        })();
      </script>
      <div class="collection-view collection-view--grid">
  {%- endif -%}

  {%- unless has_products -%}
    <div class="collection collection--empty page-width" data-id="{{ section.id }}">
      <div class="title-wrapper center">
        <h2 class="title title--primary">
          {{ 'sections.collection_template.empty' | t -}}
        </h2>
      </div>
    </div>
  {%- else -%}
    <div class="collection page-width">
      <div class="loading-overlay gradient"></div>

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <ul
          data-id="{{ section.id }}"
          class="
            grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
            grid--{{ section.settings.columns_desktop }}-col-desktop
          "
        >
          {% assign skip_card_product_styles = false %}
          {% assign rendered = 0 %}

          {%- for product in current_group.products.value -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
            {%- assign lock_content = lock_content | strip -%}
            {%- if force_readonly -%}{%- assign lock_content = 'true' -%}{%- endif -%}
            {%- assign preview_badge = '' -%}
            {%- if lock_content == 'true' -%}
              {%- unless product.tags contains 'Badge-Coming Soon' -%}
                {%- assign preview_badge = 'Coming Soon' -%}
              {%- endunless -%}
            {%- else -%}
              {%- unless product.tags contains 'Badge-Early Access' -%}
                {%- assign preview_badge = 'Early Access' -%}
              {%- endunless -%}
            {%- endif -%}
            {%- assign lazy_load = false -%}
            {%- if rendered > 2 -%}{%- assign lazy_load = true -%}{%- endif -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ rendered }};"
              {% endif %}
            >
              {% if lock_content == 'true' %}
                {% render 'card-product-readonly',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  lazy_load: lazy_load,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  size_overlay: section.settings.show_size_overlay,
                  preview_badge: preview_badge,
                  hide_sold_out_badge: true
                %}
              {% else %}
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  lazy_load: lazy_load,
                  skip_styles: skip_card_product_styles,
                  quick_add: section.settings.quick_add,
                  quick_add_mobile_only: section.settings.quick_add_mobile_only,
                  section_id: section.id,
                  show_swatches_availability: true,
                  size_overlay: section.settings.show_size_overlay,
                  preview_badge: preview_badge
                %}
              {% endif %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        </ul>

        {%- if has_prev or has_next -%}
          {{ 'component-pagination.css' | asset_url | stylesheet_tag }}
          {%- assign prev_page = prev_page_num -%}
          {%- assign next_page = next_page_num -%}

          <div class="pagination-wrapper">
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul class="pagination__list list-unstyled" role="list">
                {%- if has_prev -%}
                  <li>
                    <a
                      href="{{ collection.url }}{% if prev_page > 1 %}?page={{ prev_page }}{% endif %}"
                      class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce"
                      aria-label="{{ 'general.pagination.previous' | t }}"
                    >
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}

                {%- if has_prev_ellipsis -%}
                  <li><span class="pagination__item">&hellip;</span></li>
                {%- endif -%}

                {%- if has_prev -%}
                  <li>
                    <a
                      href="{{ collection.url }}{% if prev_page > 1 %}?page={{ prev_page }}{% endif %}"
                      class="pagination__item link"
                      aria-label="{{ 'general.pagination.page' | t: number: prev_page }}"
                    >
                      {{- prev_page -}}
                    </a>
                  </li>
                {%- endif -%}

                <li>
                  <a
                    role="link"
                    aria-disabled="true"
                    class="pagination__item pagination__item--current light"
                    aria-current="page"
                    aria-label="{{ 'general.pagination.page' | t: number: current_page_num }}"
                  >
                    {{- current_page_num -}}
                  </a>
                </li>

                {%- if has_next -%}
                  <li>
                    <a
                      href="{{ collection.url }}?page={{ next_page }}"
                      class="pagination__item link"
                      aria-label="{{ 'general.pagination.page' | t: number: next_page }}"
                    >
                      {{- next_page -}}
                    </a>
                  </li>
                {%- endif -%}

                {%- if has_next_ellipsis -%}
                  <li><span class="pagination__item">&hellip;</span></li>
                {%- endif -%}

                {%- if has_next -%}
                  <li>
                    <a
                      href="{{ collection.url }}?page={{ next_page }}"
                      class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce"
                      aria-label="{{ 'general.pagination.next' | t }}"
                    >
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}

  {%- if has_campaign -%}
      </div>
      {%- comment -%} /.collection-view--grid {%- endcomment -%}

      {%- comment -%}
        collection-view--cq makes this view a size container: every campaign
        width/column setting is emitted in cqw (1% of the page-width content
        box), so Gempages proportions survive the viewport scrollbar exactly.
        Deviation from the main grid, which emits vw.
      {%- endcomment -%}
      <div
        class="collection-view collection-view--campaign collection-view--cq page-width"
        {% if section.settings.campaign_gap != blank %}
          style="--campaign-gap: {{ section.settings.campaign_gap }}px"
        {% endif %}
      >
        {%- assign campaign_styles_loaded = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'campaign_hero' -%}
              {%- capture cb_style -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
              {%- endcapture -%}
              <div
                class="campaign-block campaign-hero{% if block.settings.video_url != blank %} campaign-hero--ambient campaign-block--sized{% endif %}"
                {% if block.settings.video_url != blank %}
                  style="--cb-w:calc(100% + 2 * var(--page-width-padding, 50px));--cb-wm:calc(100% + 2 * var(--mobile-page-width-padding, 10px));{{ cb_style }}"
                {% elsif cb_style != blank %}
                  style="{{ cb_style }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                <div class="campaign-hero__media{% if block.settings.full_screen %} campaign-hero__media--full{% endif %}">
                  {%- if block.settings.video_url != blank -%}
                    <video
                      class="campaign-hero__ambient"
                      autoplay
                      loop
                      muted
                      playsinline
                      aria-hidden="true"
                      {% if block.settings.image != blank %}poster="{{ block.settings.image | image_url: width: 1500 }}"{% endif %}
                    >
                      <source src="{{ block.settings.video_url | escape }}">
                    </video>
                    {%- if block.settings.overlay_eyebrow != blank or block.settings.overlay_image != blank -%}
                      <div class="campaign-hero__overlay">
                        {%- if block.settings.overlay_eyebrow != blank -%}
                          <p class="campaign-hero__eyebrow">{{ block.settings.overlay_eyebrow | escape }}</p>
                        {%- endif -%}
                        {%- if block.settings.overlay_image != blank -%}
                          {{
                            block.settings.overlay_image
                            | image_url: width: 2000
                            | image_tag:
                              loading: 'eager',
                              sizes: '100vw',
                              widths: '750, 1100, 1500, 2000',
                              class: 'campaign-hero__overlay-image'
                          }}
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- elsif block.settings.video != blank -%}
                    {%- assign hero_poster = block.settings.video.preview_image | default: block.settings.image -%}
                    <video
                      class="campaign-hero__video"
                      controls
                      playsinline
                      preload="none"
                      {% if hero_poster != blank %}poster="{{ hero_poster | image_url: width: 1500 }}"{% endif %}
                    >
                      {%- for source in block.settings.video.sources -%}
                        <source src="{{ source.url }}" type="{{ source.mime_type }}">
                      {%- endfor -%}
                    </video>
                  {%- elsif block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        sizes: '100vw',
                        widths: '375, 750, 1100, 1500, 2000',
                        class: 'campaign-hero__image'
                    }}
                  {%- endif -%}
                </div>
                {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
                  <div class="campaign-hero__content">
                    {%- if block.settings.heading != blank -%}
                      <h2 class="campaign-hero__heading inline-richtext {{ block.settings.heading_size }}">
                        {{ block.settings.heading }}
                      </h2>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="campaign-hero__text rte">{{ block.settings.text }}</div>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        class="button"
                        {% if block.settings.button_link != blank %}
                          href="{{ block.settings.button_link }}"
                        {% else %}
                          role="link" aria-disabled="true"
                        {% endif %}
                      >
                        {{- block.settings.button_label | escape -}}
                      </a>
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            {%- when 'campaign_text' -%}
              {%- capture cb_style -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                {%- if block.settings.inset_right != blank -%}--ct-inr:{{ block.settings.inset_right }}px;{%- endif -%}
                {%- if block.settings.inset_right_mobile != blank -%}--ct-inrm:{{ block.settings.inset_right_mobile }}px;{%- endif -%}
                {%- if block.settings.heading_px != blank -%}--ct-hfs:{{ block.settings.heading_px }}px;{%- endif -%}
                {%- if block.settings.heading_px_mobile != blank -%}--ct-hfsm:{{ block.settings.heading_px_mobile }}px;{%- endif -%}
                {%- if block.settings.heading_lh != blank -%}--ct-hlh:{{ block.settings.heading_lh }}px;{%- endif -%}
                {%- if block.settings.heading_lh_mobile != blank -%}--ct-hlhm:{{ block.settings.heading_lh_mobile }}px;{%- endif -%}
                {%- if block.settings.heading_weight != blank -%}--ct-hw:{{ block.settings.heading_weight }};{%- endif -%}
                {%- if block.settings.heading_ls != blank -%}--ct-hls:{{ block.settings.heading_ls }}px;{%- endif -%}
                {%- if block.settings.sub_px != blank -%}--ct-sfs:{{ block.settings.sub_px }}px;{%- endif -%}
                {%- if block.settings.sub_px_mobile != blank -%}--ct-sfsm:{{ block.settings.sub_px_mobile }}px;{%- endif -%}
                {%- if block.settings.sub_lh != blank -%}--ct-slh:{{ block.settings.sub_lh }}px;{%- endif -%}
                {%- if block.settings.sub_lh_mobile != blank -%}--ct-slhm:{{ block.settings.sub_lh_mobile }}px;{%- endif -%}
                {%- if block.settings.sub_ls != blank -%}--ct-sls:{{ block.settings.sub_ls }}px;{%- endif -%}
                {%- if block.settings.sub_gap != blank -%}--ct-sgap:{{ block.settings.sub_gap }}px;{%- endif -%}
                {%- if block.settings.sub_gap_mobile != blank -%}--ct-sgapm:{{ block.settings.sub_gap_mobile }}px;{%- endif -%}
                {%- if block.settings.cta_gap != blank -%}--ct-cgap:{{ block.settings.cta_gap }}px;{%- endif -%}
                {%- if block.settings.cta_gap_mobile != blank -%}--ct-cgapm:{{ block.settings.cta_gap_mobile }}px;{%- endif -%}
              {%- endcapture -%}
              <div
                class="campaign-block campaign-text campaign-text--{{ block.settings.align | default: 'center' }}"
                {% if cb_style != blank %}
                  style="{{ cb_style }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  {%- if block.settings.heading_px != blank or block.settings.heading_px_mobile != blank -%}
                    <h2 class="campaign-text__heading campaign-text__heading--custom">
                      {{ block.settings.heading }}
                    </h2>
                  {%- else -%}
                    <h2 class="campaign-text__heading inline-richtext {{ block.settings.heading_size }}">
                      {{ block.settings.heading }}
                    </h2>
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.subheading != blank -%}
                  <p class="campaign-text__sub">{{ block.settings.subheading | escape }}</p>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="campaign-text__body rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <div class="campaign-text__cta-wrap">
                    <a
                      class="campaign-cta"
                      {% if block.settings.cta_link != blank %}
                        href="{{ block.settings.cta_link }}"
                      {% endif %}
                    >
                      {{- block.settings.cta_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
            {%- when 'campaign_lifestyle' -%}
              {%- capture cb_style -%}
                {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
                {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
              {%- endcapture -%}
              <div
                class="campaign-block campaign-lifestyle{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
                {% if cb_style != blank %}
                  style="{{ cb_style }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.video_url != blank -%}
                  <div class="campaign-lifestyle__media">
                    <video class="campaign-lifestyle__ambient" autoplay loop muted playsinline aria-hidden="true">
                      <source src="{{ block.settings.video_url | escape }}">
                    </video>
                  </div>
                {%- elsif block.settings.image != blank -%}
                  <div class="campaign-lifestyle__media">
                    {{
                      block.settings.image
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        sizes: '100vw',
                        widths: '375, 750, 1100, 1500, 2000',
                        class: 'campaign-lifestyle__image'
                    }}
                  </div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="campaign-lifestyle__heading inline-richtext">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.product_list != blank -%}
                  {%- comment -%}
                    Deviation from the main grid: skip tier-locked products, same
                    guard as campaign_products. The tier lock is discovery-level
                    only (the PDP buy box is gated by the Badge-Coming Soon tag,
                    not by tier), so a callout link would hand an under-tier
                    viewer a live buy box on a product nothing else links.
                  {%- endcomment -%}
                  <ul class="campaign-lifestyle__callouts list-unstyled" role="list">
                    {%- for callout in block.settings.product_list -%}
                      {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: callout -%}{%- endcapture -%}
                      {%- assign lock_content = lock_content | strip -%}
                      {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                      <li>
                        <a class="campaign-lifestyle__callout" href="{{ callout.url }}">
                          <span class="campaign-lifestyle__callout-title">{{ callout.title | escape }}</span>
                          <span class="campaign-lifestyle__callout-price">{{ callout.price | money }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {%- when 'campaign_collage' -%}
              {%- capture cb_style -%}
                {%- if block.settings.col1_pct != blank -%}--c1-w:{{ block.settings.col1_pct }}cqw;{%- endif -%}
                {%- if block.settings.col2_pct != blank -%}--c2-w:{{ block.settings.col2_pct }}cqw;{%- endif -%}
                {%- if block.settings.col1_pct_mobile != blank -%}--c1-wm:{{ block.settings.col1_pct_mobile }}cqw;{%- endif -%}
                {%- if block.settings.col2_pct_mobile != blank -%}--c2-wm:{{ block.settings.col2_pct_mobile }}cqw;{%- endif -%}
                {%- if block.settings.col1_offset != blank -%}--c1-off:{{ block.settings.col1_offset }}px;{%- endif -%}
                {%- if block.settings.col2_offset != blank -%}--c2-off:{{ block.settings.col2_offset }}px;{%- endif -%}
                {%- if block.settings.col1_offset_mobile != blank -%}--c1-offm:{{ block.settings.col1_offset_mobile }}px;{%- endif -%}
                {%- if block.settings.col2_offset_mobile != blank -%}--c2-offm:{{ block.settings.col2_offset_mobile }}px;{%- endif -%}
                {%- if block.settings.col1_gap != blank -%}--c1-gap:{{ block.settings.col1_gap }}px;{%- endif -%}
                {%- comment -%}
                  Blank ratio = the image's own ratio, emitted explicitly so the
                  column reserves its height before the lazy image loads (the
                  CSS aspect-ratio rule otherwise discards the width/height
                  attribute mapping and the column collapses to 0px until load).
                {%- endcomment -%}
                {%- if block.settings.col1_ratio != blank -%}--c1-ar:{{ block.settings.col1_ratio }};{%- elsif block.settings.image_1 != blank -%}--c1-ar:{{ block.settings.image_1.aspect_ratio }};{%- endif -%}
                {%- if block.settings.col2_ratio != blank -%}--c2-ar:{{ block.settings.col2_ratio }};{%- elsif block.settings.image_2 != blank -%}--c2-ar:{{ block.settings.image_2.aspect_ratio }};{%- endif -%}
                {%- if block.settings.inset_x != blank -%}--cg-inx:{{ block.settings.inset_x }}px;{%- endif -%}
                {%- if block.settings.inset_x_mobile != blank -%}--cg-inxm:{{ block.settings.inset_x_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
              {%- endcapture -%}
              <div
                class="campaign-block campaign-block--sized campaign-collage campaign-collage--{{ block.settings.layout }}{% if block.settings.valign == 'bottom' %} campaign-collage--bottom{% endif %}{% if block.settings.first_flush %} campaign-collage--flush-first{% endif %}{% if block.settings.second_flush %} campaign-collage--flush-second{% endif %}"
                style="--cb-w:calc(100% + 2 * var(--page-width-padding, 50px));--cb-wm:calc(100% + 2 * var(--mobile-page-width-padding, 10px));{{ cb_style }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.layout != 'images' -%}
                  {%- if block.settings.eyebrow != blank or block.settings.heading != blank -%}
                    <div class="campaign-collage__text">
                      {%- if block.settings.eyebrow != blank -%}
                        <p class="campaign-collage__eyebrow">{{ block.settings.eyebrow | escape }}</p>
                      {%- endif -%}
                      {%- if block.settings.heading != blank -%}
                        <h2 class="campaign-collage__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.image_1 != blank -%}
                  <div class="campaign-collage__col campaign-collage__col--first">
                    {{
                      block.settings.image_1
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        sizes: '60vw',
                        widths: '375, 750, 1100, 1500, 2000',
                        class: 'campaign-collage__image'
                    }}
                  </div>
                {%- endif -%}
                {%- if block.settings.image_2 != blank and block.settings.layout != 'image_text' -%}
                  <div class="campaign-collage__col campaign-collage__col--second">
                    {{
                      block.settings.image_2
                      | image_url: width: 2000
                      | image_tag:
                        loading: 'lazy',
                        sizes: '60vw',
                        widths: '375, 750, 1100, 1500, 2000',
                        class: 'campaign-collage__image'
                    }}
                  </div>
                {%- endif -%}
              </div>
            {%- when 'campaign_strip' -%}
              {%- capture cb_style -%}
                {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
                {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
                {%- if block.settings.gap != blank -%}--cs-gap:{{ block.settings.gap }}px;{%- endif -%}
                {%- if block.settings.gap_mobile != blank -%}--cs-gapm:{{ block.settings.gap_mobile }}px;{%- endif -%}
                {%- if block.settings.ratio != blank -%}--cs-ar:{{ block.settings.ratio }};{%- endif -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                --cs-cols:{{ block.settings.columns }};--cs-colsm:{{ block.settings.columns_mobile }};
              {%- endcapture -%}
              <div
                class="campaign-block campaign-strip{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
                style="{{ cb_style }}"
                {{ block.shopify_attributes }}
              >
                <ul class="campaign-strip__row list-unstyled" role="list">
                  {%- for slot in (1..6) -%}
                    {%- assign img_key = 'image_' | append: slot -%}
                    {%- assign link_key = 'link_' | append: slot -%}
                    {%- assign strip_image = block.settings[img_key] -%}
                    {%- assign strip_link = block.settings[link_key] -%}
                    {%- if strip_image == blank -%}{%- continue -%}{%- endif -%}
                    <li class="campaign-strip__cell">
                      {%- if strip_link != blank -%}
                        <a class="campaign-strip__link" href="{{ strip_link }}">
                      {%- endif -%}
                      {{
                        strip_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          sizes: '(min-width: 750px) 17vw, 34vw',
                          widths: '250, 375, 550, 750, 1100',
                          class: 'campaign-strip__image'
                      }}
                      {%- if strip_link != blank -%}
                        </a>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- when 'campaign_products' -%}
              {%- liquid
                assign cp_products = block.settings.product_list
                assign cp_limit = 12
                if cp_products == blank and block.settings.source_collection != blank
                  assign cp_products = block.settings.source_collection.products
                  assign cp_limit = block.settings.products_to_show
                endif
              -%}
              {%- capture cb_style -%}
                {%- if block.settings.width_pct != blank -%}--cb-w:{{ block.settings.width_pct }}cqw;{%- endif -%}
                {%- if block.settings.width_pct_mobile != blank -%}--cb-wm:{{ block.settings.width_pct_mobile }}cqw;{%- endif -%}
                {%- if block.settings.tile_gap != blank -%}--cp-gap:{{ block.settings.tile_gap }}px;{%- endif -%}
                {%- if block.settings.pad_top != blank -%}--cb-pt:{{ block.settings.pad_top }}px;{%- endif -%}
                {%- if block.settings.pad_bottom != blank -%}--cb-pb:{{ block.settings.pad_bottom }}px;{%- endif -%}
                {%- if block.settings.pad_top_mobile != blank -%}--cb-ptm:{{ block.settings.pad_top_mobile }}px;{%- endif -%}
                {%- if block.settings.pad_bottom_mobile != blank -%}--cb-pbm:{{ block.settings.pad_bottom_mobile }}px;{%- endif -%}
                --cp-cols:{{ block.settings.columns_desktop }};
              {%- endcapture -%}
              <div
                class="campaign-block campaign-products campaign-products--{{ block.settings.display }}{% if block.settings.width_pct != blank or block.settings.width_pct_mobile != blank %} campaign-block--sized{% endif %}"
                style="{{ cb_style }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.heading != blank -%}
                  <h2 class="campaign-products__heading inline-richtext">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if cp_products != blank -%}
                  {%- if block.settings.display == 'theme' -%}
                    <ul
                      class="campaign-products__grid grid product-grid list-unstyled grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ block.settings.columns_desktop }}-col-desktop"
                      role="list"
                    >
                      {%- liquid
                        assign cp_shown = 0
                      -%}
                      {%- for product in cp_products -%}
                        {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                        {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                        {%- assign lock_content = lock_content | strip -%}
                        {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                        {%- assign cp_shown = cp_shown | plus: 1 -%}
                        {%- comment -%}
                          Deviation from the main grid: preview products keep their
                          Early Access badge in campaign rows. Tag-gated (like the
                          PDP, unlike the grid loop above) so hand-picked published
                          products get no badge; locked products never reach this
                          point, so no Coming Soon branch is needed. Sold-out stays
                          visible — campaign rows only ever show viewer-shoppable
                          products.
                        {%- endcomment -%}
                        {%- assign preview_badge = '' -%}
                        {%- if product.tags contains 'preview-product' or product.tags contains 'supervip-product' or product.tags contains 'vip-product' -%}
                          {%- unless product.tags contains 'Badge-Early Access' -%}
                            {%- assign preview_badge = 'Early Access' -%}
                          {%- endunless -%}
                        {%- endif -%}
                        <li class="grid__item">
                          {% render 'card-product',
                            card_product: product,
                            media_aspect_ratio: section.settings.image_ratio,
                            image_shape: section.settings.image_shape,
                            show_secondary_image: section.settings.show_secondary_image,
                            show_vendor: section.settings.show_vendor,
                            show_rating: section.settings.show_rating,
                            lazy_load: true,
                            skip_styles: campaign_styles_loaded,
                            quick_add: 'none',
                            section_id: section.id,
                            show_swatches_availability: true,
                            size_overlay: section.settings.show_size_overlay,
                            preview_badge: preview_badge
                          %}
                        </li>
                        {%- assign campaign_styles_loaded = true -%}
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    <ul class="campaign-products__row list-unstyled" role="list">
                      {%- liquid
                        assign cp_shown = 0
                      -%}
                      {%- for product in cp_products -%}
                        {%- if cp_shown >= cp_limit -%}{%- break -%}{%- endif -%}
                        {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
                        {%- assign lock_content = lock_content | strip -%}
                        {%- if lock_content == 'true' -%}{%- continue -%}{%- endif -%}
                        {%- assign cp_shown = cp_shown | plus: 1 -%}
                        <li class="campaign-products__cell">
                          <a href="{{ product.url }}" class="campaign-products__card">
                            <div class="campaign-products__media">
                              {%- if product.featured_media != blank -%}
                                {{
                                  product.featured_media
                                  | image_url: width: 800
                                  | image_tag:
                                    loading: 'lazy',
                                    sizes: '(min-width: 750px) 30vw, 34vw',
                                    widths: '375, 550, 800',
                                    class: 'campaign-products__img'
                                }}
                              {%- endif -%}
                              {%- if block.settings.display == 'cards' and product.media[1] != null -%}
                                {{
                                  product.media[1]
                                  | image_url: width: 800
                                  | image_tag:
                                    loading: 'lazy',
                                    sizes: '(min-width: 750px) 30vw, 34vw',
                                    widths: '375, 550, 800',
                                    class: 'campaign-products__img campaign-products__img--hover'
                                }}
                              {%- endif -%}
                            </div>
                            {%- if block.settings.display == 'cards' -%}
                              <div class="campaign-products__meta">
                                <span class="campaign-products__title">{{ product.title | escape }}</span>
                                <span class="campaign-products__price">{{ product.price | money }}</span>
                              </div>
                            {%- endif -%}
                          </a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                {%- endif -%}
                {%- if block.settings.cta_label != blank -%}
                  <div class="campaign-products__cta-wrap">
                    <a
                      class="campaign-products__cta"
                      {% if block.settings.cta_link != blank %}
                        href="{{ block.settings.cta_link }}"
                      {% endif %}
                    >
                      {{- block.settings.cta_label | escape -}}
                    </a>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.jump_link_enable and section.settings.jump_link_label != blank -%}
        <label class="collection-views__jump" for="view-collection-{{ section.id }}">
          {{- section.settings.jump_link_label | escape -}}
        </label>
      {%- endif -%}
    </div>
    {%- comment -%} /.collection-views {%- endcomment -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Preview product grid",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
