{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{% if section.settings.enable_swatches %}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
{% endif %}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

{%- if section.settings.quick_add == 'standard' -%}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% render 'card-settings-styles' %}
{%- endstyle -%}

{% liquid
  assign preview = collection.metafields.lock.unlisted_collection.value
  assign current_page_num = current_page | default: 1
  assign prev_page_num = current_page_num | minus: 1
  assign next_page_num = current_page_num | plus: 1

  assign current_group = nil
  assign has_prev = false
  assign has_next = false
  assign has_prev_ellipsis = false
  assign has_next_ellipsis = false
  assign prev_prev_page_num = current_page_num | minus: 2
  assign next_next_page_num = current_page_num | plus: 2

  for group in preview.groups.value
    if forloop.index == current_page_num
      assign current_group = group
    endif
    if forloop.index == prev_page_num
      assign has_prev = true
    endif
    if forloop.index == next_page_num
      assign has_next = true
    endif
    if forloop.index == prev_prev_page_num
      assign has_prev_ellipsis = true
    endif
    if forloop.index == next_next_page_num
      assign has_next_ellipsis = true
    endif
  endfor

  assign has_products = false
  if current_group != blank and current_group.products.value != blank
    assign has_products = true
  endif

  # Explicit lock.shoppable = false forces read-only cards for everyone; unset keeps per-product tiers
  assign force_readonly = false
  if collection.metafields.lock.shoppable.value == false and request.design_mode == false
    assign force_readonly = true
  endif
%}

<div class="section-{{ section.id }}-padding card-redesign gradient color-{{ section.settings.color_scheme }}">
  {%- if has_products == false and current_page_num > 1 -%}
    <script>window.location.replace('{{ collection.url }}');</script>
  {%- endif -%}

  {%- unless has_products -%}
    <div class="collection collection--empty page-width" data-id="{{ section.id }}">
      <div class="title-wrapper center">
        <h2 class="title title--primary">
          {{ 'sections.collection_template.empty' | t -}}
        </h2>
      </div>
    </div>
  {%- else -%}
    <div class="collection page-width">
      <div class="loading-overlay gradient"></div>

      <div
        class="product-grid-container{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        {% if settings.animations_reveal_on_scroll %}
          data-cascade
        {% endif %}
      >
        <ul
          data-id="{{ section.id }}"
          class="
            grid product-grid grid--{{ section.settings.columns_mobile }}-col-tablet-down
            grid--{{ section.settings.columns_desktop }}-col-desktop
          "
        >
          {% assign skip_card_product_styles = false %}
          {% assign rendered = 0 %}

          {%- for product in current_group.products.value -%}
            {%- assign rendered = rendered | plus: 1 -%}
            {%- capture lock_content -%}{%- render 'locksmith-v2-lock-product' product: product -%}{%- endcapture -%}
            {%- assign lock_content = lock_content | strip -%}
            {%- if force_readonly -%}{%- assign lock_content = 'true' -%}{%- endif -%}
            {%- assign preview_badge = '' -%}
            {%- if lock_content == 'true' -%}
              {%- unless product.tags contains 'Badge-Coming Soon' -%}
                {%- assign preview_badge = 'Coming Soon' -%}
              {%- endunless -%}
            {%- else -%}
              {%- unless product.tags contains 'Badge-Early Access' -%}
                {%- assign preview_badge = 'Early Access' -%}
              {%- endunless -%}
            {%- endif -%}
            {%- assign lazy_load = false -%}
            {%- if rendered > 2 -%}{%- assign lazy_load = true -%}{%- endif -%}
            <li
              class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ rendered }};"
              {% endif %}
            >
              {% if lock_content == 'true' %}
                {% render 'card-product-readonly',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  lazy_load: lazy_load,
                  skip_styles: skip_card_product_styles,
                  section_id: section.id,
                  preview_badge: preview_badge,
                  hide_sold_out_badge: true
                %}
              {% else %}
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  image_shape: section.settings.image_shape,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  lazy_load: lazy_load,
                  skip_styles: skip_card_product_styles,
                  quick_add: section.settings.quick_add,
                  quick_add_mobile_only: section.settings.quick_add_mobile_only,
                  section_id: section.id,
                  show_swatches_availability: true,
                  size_overlay: section.settings.show_size_overlay,
                  preview_badge: preview_badge,
                  hide_sold_out_badge: true
                %}
              {% endif %}
            </li>
            {%- assign skip_card_product_styles = true -%}
          {%- endfor -%}
        </ul>

        {%- if has_prev or has_next -%}
          {{ 'component-pagination.css' | asset_url | stylesheet_tag }}
          {%- assign prev_page = prev_page_num -%}
          {%- assign next_page = next_page_num -%}

          <div class="pagination-wrapper">
            <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              <ul class="pagination__list list-unstyled" role="list">
                {%- if has_prev -%}
                  <li>
                    <a
                      href="{{ collection.url }}{% if prev_page > 1 %}?page={{ prev_page }}{% endif %}"
                      class="pagination__item pagination__item--next pagination__item-arrow link motion-reduce"
                      aria-label="{{ 'general.pagination.previous' | t }}"
                    >
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}

                {%- if has_prev_ellipsis -%}
                  <li><span class="pagination__item">&hellip;</span></li>
                {%- endif -%}

                {%- if has_prev -%}
                  <li>
                    <a
                      href="{{ collection.url }}{% if prev_page > 1 %}?page={{ prev_page }}{% endif %}"
                      class="pagination__item link"
                      aria-label="{{ 'general.pagination.page' | t: number: prev_page }}"
                    >
                      {{- prev_page -}}
                    </a>
                  </li>
                {%- endif -%}

                <li>
                  <a
                    role="link"
                    aria-disabled="true"
                    class="pagination__item pagination__item--current light"
                    aria-current="page"
                    aria-label="{{ 'general.pagination.page' | t: number: current_page_num }}"
                  >
                    {{- current_page_num -}}
                  </a>
                </li>

                {%- if has_next -%}
                  <li>
                    <a
                      href="{{ collection.url }}?page={{ next_page }}"
                      class="pagination__item link"
                      aria-label="{{ 'general.pagination.page' | t: number: next_page }}"
                    >
                      {{- next_page -}}
                    </a>
                  </li>
                {%- endif -%}

                {%- if has_next_ellipsis -%}
                  <li><span class="pagination__item">&hellip;</span></li>
                {%- endif -%}

                {%- if has_next -%}
                  <li>
                    <a
                      href="{{ collection.url }}?page={{ next_page }}"
                      class="pagination__item pagination__item--prev pagination__item-arrow link motion-reduce"
                      aria-label="{{ 'general.pagination.next' | t }}"
                    >
                      <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            </nav>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endunless -%}
</div>

{% schema %}
{
  "name": "Preview product grid",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-product-grid.settings.header__3.content"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__3.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.main-collection-product-grid.settings.image_ratio.label"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "t:sections.all.image_shape.options__1.label"
        },
        {
          "value": "arch",
          "label": "t:sections.all.image_shape.options__2.label"
        },
        {
          "value": "blob",
          "label": "t:sections.all.image_shape.options__3.label"
        },
        {
          "value": "chevronleft",
          "label": "t:sections.all.image_shape.options__4.label"
        },
        {
          "value": "chevronright",
          "label": "t:sections.all.image_shape.options__5.label"
        },
        {
          "value": "diamond",
          "label": "t:sections.all.image_shape.options__6.label"
        },
        {
          "value": "parallelogram",
          "label": "t:sections.all.image_shape.options__7.label"
        },
        {
          "value": "round",
          "label": "t:sections.all.image_shape.options__8.label"
        }
      ],
      "default": "default",
      "label": "t:sections.all.image_shape.label"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_secondary_image.label"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_vendor.label"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "t:sections.main-collection-product-grid.settings.show_rating.label",
      "info": "t:sections.main-collection-product-grid.settings.show_rating.info"
    },
    {
      "type": "checkbox",
      "id": "show_size_overlay",
      "default": false,
      "label": "Show size availability on hover (desktop)"
    },
    {
      "type": "color",
      "id": "size_overlay_bg_color",
      "label": "Size overlay background color",
      "info": "Leave blank to follow the card color scheme background.",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Size overlay background opacity",
      "info": "Theme default: 60%.",
      "default": 60,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "select",
      "id": "size_overlay_position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom (theme default)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        }
      ],
      "default": "bottom",
      "label": "Size overlay position",
      "info": "Top and bottom slide in on hover; center fades in.",
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_padding_top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Size overlay padding top",
      "info": "Theme default: 8px.",
      "default": 6,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_padding_bottom",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Size overlay padding bottom",
      "info": "Theme default: 16px.",
      "default": 6,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "checkbox",
      "id": "enable_swatches",
      "default": false,
      "label": "Enable Product Swatches",
      "info": "Off by default: sibling swatches can reveal unreleased colorways on preview grids."
    },
    {
      "type": "range",
      "id": "swatch_card_width",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Swatch width",
      "info": "0 = theme default (20px)",
      "default": 20,
      "visible_if": "{{ section.settings.enable_swatches }}"
    },
    {
      "type": "range",
      "id": "swatch_card_height",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Swatch height",
      "info": "0 = theme default (square)",
      "default": 12,
      "visible_if": "{{ section.settings.enable_swatches }}"
    },
    {
      "type": "range",
      "id": "swatch_card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Swatch corner radius",
      "info": "0 = square corners (theme default)",
      "default": 0,
      "visible_if": "{{ section.settings.enable_swatches }}"
    },
    {
      "type": "header",
      "content": "Card spacing"
    },
    {
      "type": "checkbox",
      "id": "card_spacing_enable",
      "default": true,
      "label": "Customize card spacing",
      "info": "Defaults below match the theme's stock spacing."
    },
    {
      "type": "range",
      "id": "card_info_padding_top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space above title row",
      "default": 8,
      "visible_if": "{{ section.settings.card_spacing_enable }}"
    },
    {
      "type": "range",
      "id": "card_title_price_gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Title to price gap",
      "info": "Vertical gap when the price wraps below the title (mobile).",
      "default": 2,
      "visible_if": "{{ section.settings.card_spacing_enable }}"
    },
    {
      "type": "range",
      "id": "card_swatch_space",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space above swatches",
      "default": 6,
      "visible_if": "{{ section.settings.card_spacing_enable }}"
    },
    {
      "type": "range",
      "id": "card_swatch_gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Gap between swatches",
      "default": 6,
      "visible_if": "{{ section.settings.card_spacing_enable }}"
    },
    {
      "type": "range",
      "id": "card_badge_space",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space above badges",
      "default": 8,
