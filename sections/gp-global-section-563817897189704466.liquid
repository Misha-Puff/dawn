{% liquid
    assign content = collection.metafields.seo.description
    assign content_size = content | size
    assign max_chars = 20
%}
<p>Content: |{{ content}}|</p>
{% unless content_size == 0 %}
    <div class="isolate page-width">
        <div class="rich-text content-container gradient section-collapsible-seo">
            <div class="rich-text__wrapper page-width">
                <div class="rich-text__blocks">
                    <div
                        class="rich-text__text rte scroll-trigger animate--slide-in small"
                        data-cascade
                        style="--animation-order: 0;"
                    >
                        {% if content_size > max_chars %}
                            <span class="truncated-content-wrapper">
                                <span class="truncated-content"></span>
                                <button class="link" onclick="toggleContent()">Read more</button>
                            </span>
                            <span class="full-content-wrapper hidden">
                                <span class="full-content">{{ content }}</span>
                                <button class="link" onclick="toggleContent()">Read less</button>
                            </span>
                        {% else %}
                            <span>{{ content }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script>
        const fullContent = document.querySelector('.section-collapsible-seo .full-content-wrapper');
        const truncatedContent = document.querySelector('.section-collapsible-seo .truncated-content-wrapper');
        
        function toggleContent() {
          fullContent.classList.toggle('hidden');
          truncatedContent.classList.toggle('hidden');
        }
        
        function truncateHTML(length) {
            let visibleTextLength = 0;
            let truncatedHTML = '';
            
            function traverseNodes(node) {
                if (visibleTextLength >= length) {
                    return;
                }
                
                if (node.nodeType === Node.TEXT_NODE) {
                    const remainingLength = length - visibleTextLength;
                    const text = node.nodeValue;
                    
                    if (text.length <= remainingLength) {
                        truncatedHTML += text;
                        visibleTextLength += text.length;
                    } else {
                        truncatedHTML += text.substring(0, remainingLength);
                        visibleTextLength = length;
                    }
                    
                    if(visibleTextLength == length) {
                        truncatedHTML += '...';
                    }
                } else if (node.nodeType === Node.ELEMENT_NODE) {
                    truncatedHTML += (node.outerHTML.match(/^<[^>]+>/) || [''])[0];
                
                    for (const childNode of node.childNodes) {
                        traverseNodes(childNode);
                        
                        if (visibleTextLength >= length) {
                            break;
                        }
                    }
                
                    if (visibleTextLength <= length) {
                        truncatedHTML += (node.outerHTML.match(/^<[^>]+>/) || [''])[0];
                    }
                }
            }
        
            traverseNodes(fullContent);
            
            console.log(fullContent)
            truncatedContent.innerHTML = truncatedHTML;
        }
        
        truncateHTML({{ max_chars }});
    </script>
{% endunless %}</div></div>
  
