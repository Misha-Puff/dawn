{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-padding .rich-text__blocks {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  .section-{{ section.id }}-padding .rich-text__text {
    line-height: {{ section.settings.line_height }}px;
  }
{%- endstyle -%}

{% liquid
  assign full_text_content = section.settings.text | strip_html
  assign word_count = full_text_content | strip_html | split: ' ' | size
  if word_count > 32
    assign truncated_text_content = full_text_content | strip_html | truncatewords: 32
  endif
%}

{% unless full_text_content == blank %}
  <script>
    function toggleContent() {
      console.log('HERE');
      const fullContent = document.querySelector('.section-{{ section.id }}-padding .full-content');
      const truncatedContent = document.querySelector('.section-{{ section.id }}-padding .truncated-content');

      fullContent.classList.toggle('hidden');
      truncatedContent.classList.toggle('hidden');
    }
  </script>
  <div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
    <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
      <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
        <div class="rich-text__blocks {{ section.settings.content_alignment }}">
          <div
            class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} small"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: 0;"
            {% endif %}
          >
            <p class="truncated-content">
              {{ truncated_text_content }}
              <button class="link" onclick="toggleContent()">Read more</button>
            </p>
            <p class="full-content hidden">
              {{ full_text_content }}
              <button class="link" onclick="toggleContent()">Read less</button>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endunless %}

{% schema %}
{
  "name": "Collapsible Rich Text",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "default": "t:sections.rich-text.blocks.text.settings.text.default",
      "label": "t:sections.rich-text.blocks.text.settings.text.label"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Line Height",
      "default": 24
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Right Padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collapsible Rich Text"
    }
  ]
}
{% endschema %}
