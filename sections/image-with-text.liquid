{{ 'component-image-with-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% if template contains 'product' and section.settings.show_section_tag != '' %}
    {% unless product.tags contains section.settings.show_section_tag %}
      .section-{{ section.id }}-padding {
        display: none;
      }
    {% endunless %}
  {% endif %}

  .image-with-text__text {
    font-size: 14px;
  }

  {%- comment -%}
    Layout / sizing / mobile overrides. All settings use the 0 = theme default sentinel
    (mobile section padding uses an enable checkbox instead, so an explicit 0 is honest).
  {%- endcomment -%}
  {%- liquid
    assign iwt_img_w = section.settings.image_width_custom | default: 0
    assign iwt_col_gap = section.settings.column_gap | default: 0
    assign iwt_media_h = section.settings.custom_height | default: 0
    assign iwt_img_r = section.settings.image_radius | default: 0
    assign iwt_content_max = section.settings.content_max_width | default: 0
    assign iwt_content_px = section.settings.content_padding_x | default: 0
    assign iwt_content_py = section.settings.content_padding_y | default: 0
  -%}
  {%- if section.settings.enable_mobile_padding -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }
  {%- endif -%}
  {%- if iwt_col_gap > 0 -%}
    #shopify-section-{{ section.id }} .image-with-text__grid {
      gap: {{ iwt_col_gap }}px;
    }
  {%- endif -%}
  {%- if iwt_img_w > 0 -%}
    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .image-with-text__grid > .image-with-text__media-item {
        width: calc({{ iwt_img_w }}% - {{ iwt_col_gap | divided_by: 2.0 }}px);
      }
      #shopify-section-{{ section.id }} .image-with-text__grid > .image-with-text__text-item {
        width: calc({{ 100 | minus: iwt_img_w }}% - {{ iwt_col_gap | divided_by: 2.0 }}px);
      }
    }
  {%- endif -%}
  {%- if iwt_media_h > 0 -%}
    @media screen and (min-width: 750px) {
      {%- comment -%} !important beats the Adapt option's inline padding-bottom sizing hack; mobile keeps the stock behavior. {%- endcomment -%}
      #shopify-section-{{ section.id }} .image-with-text__media {
        height: {{ iwt_media_h }}px !important;
        padding-bottom: 0 !important;
      }
    }
  {%- endif -%}
  {%- if iwt_img_r > 0 -%}
    #shopify-section-{{ section.id }} .image-with-text__media {
      border-radius: {{ iwt_img_r }}px;
      overflow: hidden;
    }
  {%- endif -%}
  {%- if iwt_content_max > 0 -%}
    #ImageWithText--{{ section.id }} {
      max-width: {{ iwt_content_max }}px;
    }
  {%- endif -%}
  {%- if iwt_content_px > 0 or iwt_content_py > 0 -%}
    #ImageWithText--{{ section.id }} {
      {%- if iwt_content_py > 0 %} padding-top: {{ iwt_content_py }}px; padding-bottom: {{ iwt_content_py }}px;{% endif -%}
      {%- if iwt_content_px > 0 %} padding-left: {{ iwt_content_px }}px; padding-right: {{ iwt_content_px }}px;{% endif -%}
    }
  {%- endif -%}
{%- endstyle -%}

{%- comment -%}
  Per-block typography & padding overrides. Scoped to the .Block-<id> class added to
  each block root, prefixed with this section's content id (#ImageWithText--<section.id>)
  so the ID specificity beats the heading-size / text-style theme classes. Only emits
  CSS when a block's Enable typography / Enable padding checkbox is on.
{%- endcomment -%}
{%- style -%}
  {%- assign tg_scope = 'ImageWithText--' | append: section.id -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tg_enable_type -%}
      {%- liquid
        assign tg_font = block.settings.tg_font
        assign tg_weight = block.settings.tg_font_weight | default: 'default'
        assign tg_fs = block.settings.tg_font_size | default: 0
        assign tg_lh = block.settings.tg_line_height | default: 0
        assign tg_case = block.settings.tg_text_case | default: 'default'
        assign tg_ls = block.settings.tg_letter_spacing | default: 0
      -%}
      {%- capture tg_brand_stack -%}{% render 'brand-font', font: block.settings.tg_custom_font %}{%- endcapture -%}
      {%- assign tg_brand_stack = tg_brand_stack | strip -%}
      {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
        {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
        {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      #{{ tg_scope }} .Block-{{ block.id }} {
        {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }};{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }};{% endif -%}
        {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
        {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
        {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
        {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
        {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- if block.settings.tg_color != blank %} color: {{ block.settings.tg_color }};{% endif -%}
      }
      {%- assign tg_fs_m = block.settings.tg_font_size_mobile | default: 0 -%}
      {%- if tg_fs_m > 0 -%}
        @media screen and (max-width: 749px) {
          #{{ tg_scope }} .Block-{{ block.id }} {
            font-size: {{ tg_fs_m }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}
    {%- if block.settings.tg_enable_padding -%}
      {%- liquid
        assign tg_pt = block.settings.tg_padding_top | default: 0
        assign tg_pb = block.settings.tg_padding_bottom | default: 0
        assign tg_pt_m = block.settings.tg_padding_top_mobile | default: 0
        assign tg_pb_m = block.settings.tg_padding_bottom_mobile | default: 0
      -%}
      {%- if tg_pt > 0 or tg_pb > 0 -%}
        #{{ tg_scope }} .Block-{{ block.id }} {
          {%- if tg_pt > 0 %} padding-top: {{ tg_pt }}px;{% endif -%}
          {%- if tg_pb > 0 %} padding-bottom: {{ tg_pb }}px;{% endif -%}
        }
      {%- endif -%}
      {%- if tg_pt_m > 0 or tg_pb_m > 0 -%}
        @media screen and (max-width: 749px) {
          #{{ tg_scope }} .Block-{{ block.id }} {
            {%- if tg_pt_m > 0 %} padding-top: {{ tg_pt_m }}px;{% endif -%}
            {%- if tg_pb_m > 0 %} padding-bottom: {{ tg_pb_m }}px;{% endif -%}
          }
        }
      {%- endif -%}
    {%- endif -%}
    {%- if block.type == 'button' -%}
      {%- liquid
        assign btn_r = block.settings.button_radius | default: 0
        assign btn_full = block.settings.button_full_width | default: false
      -%}
      {%- if btn_full or btn_r > 0 -%}
        #{{ tg_scope }} .Block-{{ block.id }} {
          {%- if btn_full %} width: 100%;{% endif -%}
          {%- if btn_r > 0 %} border-radius: {{ btn_r }}px; --buttons-radius: {{ btn_r }}px;{% endif -%}
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 1
    assign fetch_priority = 'high'
  endif
  if section.settings.color_scheme == section.settings.section_color_scheme and section.settings.content_layout == 'no-overlap'
    assign remove_color_classes = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient color-{{ section.settings.section_color_scheme }}">
  <div class="page-width">
    <div class="image-with-text image-with-text--{{ section.settings.content_layout }} isolate{% if settings.text_boxes_border_thickness > 0 and settings.text_boxes_border_opacity > 0 and settings.media_border_thickness > 0 and settings.media_border_opacity > 0 %} collapse-borders{% endif %}{% unless section.settings.color_scheme == section.settings.section_color_scheme and settings.media_border_thickness > 0 and settings.text_boxes_shadow_opacity == 0 and settings.text_boxes_border_thickness == 0 or settings.text_boxes_border_opacity == 0 %} collapse-corners{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="image-with-text__grid grid grid--gapless grid--1-col grid--{% if section.settings.desktop_image_width == 'medium' %}2-col-tablet{% else %}3-col-tablet{% endif %}{% if section.settings.layout == 'text_first' %} image-with-text__grid--reverse{% endif %}">
        <div class="image-with-text__media-item image-with-text__media-item--{{ section.settings.desktop_image_width }} image-with-text__media-item--{{ section.settings.desktop_content_position }} grid__item">
          <div
            class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %} {% if section.settings.mobile_image != blank %}is-hidden-mobile-only{% endif %}"
            {% if section.settings.height == 'adapt' and section.settings.image != blank %}
              style="padding-bottom: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;"
            {% endif %}
          >
            {%- if section.settings.image != blank -%}
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
                {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          {%- if section.settings.mobile_image != blank -%}
            <div
              class="image-with-text__media image-with-text__media--{{ section.settings.height }} global-media-settings{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}{% if section.settings.mobile_image != blank %} media{% else %} image-with-text__media--placeholder placeholder{% endif %}{% if section.settings.image_behavior != 'none' %} animate--{{ section.settings.image_behavior }}{% endif %} is-hidden-desktop-only"
              {% if section.settings.height == 'adapt' and section.settings.mobile_image != blank %}
                style="padding-bottom: {{ 1 | divided_by: section.settings.mobile_image.aspect_ratio | times: 100 }}%;"
              {% endif %}
            >
              {%- if section.settings.image_behavior == 'ambient' or section.settings.image_behavior == 'zoom-in' -%}
                {%- assign widths = '198, 432, 642, 900, 1284, 1800' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 1.6667 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 1.667), calc((100vw - 50px) / 1.667)
                {%- endcapture -%}
              {%- else -%}
                {%- assign widths = '165, 360, 535, 750, 1070, 1500' -%}
                {%- capture sizes -%}
                  (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px,
                  (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)
                {%- endcapture -%}
              {%- endif -%}
              {{
                section.settings.mobile_image
                | image_url: width: 1500
                | image_tag: sizes: sizes, widths: widths, fetchpriority: fetch_priority
              }}
            </div>
          {% endif %}
        </div>
        <div class="image-with-text__text-item grid__item">
          <div
            id="ImageWithText--{{ section.id }}"
            class="image-with-text__content image-with-text__content--{{ section.settings.desktop_content_position }} image-with-text__content--desktop-{{ section.settings.desktop_content_alignment }} image-with-text__content--mobile-{{ section.settings.mobile_content_alignment }} image-with-text__content--{{ section.settings.height }} content-container{% unless remove_color_classes %} gradient color-{{ section.settings.color_scheme }}{% else %} background-transparent{% endunless %}"
          >
            {%- for block in section.blocks -%}
              {% case block.type %}
                {%- when 'heading' -%}
                  <h2
                    class="image-with-text__heading Block-{{ block.id }} inline-richtext {{ block.settings.heading_size }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.heading }}
                  </h2>
                {%- when 'caption' -%}
                  <p
                    class="image-with-text__text Block-{{ block.id }} image-with-text__text--caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} {{ block.settings.text_style }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.caption | escape }}
                  </p>
                {%- when 'text' -%}
                  <div class="image-with-text__text Block-{{ block.id }} rte {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                    {{ block.settings.text }}
                  </div>
                {%- when 'button' -%}
                  {%- if block.settings.button_label != blank -%}
                    <a
                      {% if block.settings.button_link == blank %}
                        role="link" aria-disabled="true"
                      {% else %}
                        href="{{ block.settings.button_link }}"
                      {% endif %}
                      class="button Block-{{ block.id }}{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image-with-text.name",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image-with-text.settings.image.label"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image",
      "info": "Replaces the image above on screens under 750px"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image-with-text.settings.height.options__1.label"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__4.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "range",
      "id": "custom_height",
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px",
      "label": "Custom image height (desktop)",
      "info": "0 = use the Height option above. Overrides it, including Adapt; mobile keeps the Height option.",
      "default": 0
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "info": "0 = theme default",
      "default": 0
    },
    {
      "type": "select",
      "id": "desktop_image_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.desktop_image_width.options__3.label"
        }
      ],
      "default": "medium",
      "label": "t:sections.image-with-text.settings.desktop_image_width.label"
    },
    {
      "type": "range",
      "id": "image_width_custom",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Custom image width (desktop)",
      "info": "0 = use the Desktop image width option above",
      "default": 0
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Gap between image and text",
      "info": "0 = theme default (columns touch)",
      "default": 0
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "image_first",
          "label": "t:sections.image-with-text.settings.layout.options__1.label"
        },
        {
          "value": "text_first",
          "label": "t:sections.image-with-text.settings.layout.options__2.label"
        }
      ],
      "default": "image_first",
      "label": "t:sections.image-with-text.settings.layout.label"
    },
    {
      "type": "select",
      "id": "image_behavior",
      "options": [
        {
          "value": "none",
          "label": "t:sections.all.animation.image_behavior.options__1.label"
        },
        {
          "value": "ambient",
          "label": "t:sections.all.animation.image_behavior.options__2.label"
        },
        {
          "value": "zoom-in",
          "label": "t:sections.all.animation.image_behavior.options__4.label"
        }
      ],
      "default": "none",
      "label": "t:sections.all.animation.image_behavior.label"
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header.content"
    },
    {
      "type": "select",
      "id": "content_layout",
      "options": [
        {
          "value": "no-overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__1.label"
        },
        {
          "value": "overlap",
          "label": "t:sections.image-with-text.settings.content_layout.options__2.label"
        }
      ],
      "default": "no-overlap",
      "label": "t:sections.image-with-text.settings.content_layout.label"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "top",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "middle",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "bottom",
          "label": "t:sections.image-with-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "top",
      "label": "t:sections.image-with-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.desktop_content_alignment.label"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.image-with-text.settings.mobile_content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "label": "t:sections.image-with-text.settings.mobile_content_alignment.label"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "min": 0,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Content max width",
      "info": "0 = full column width",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_padding_x",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content horizontal padding",
      "info": "0 = theme default",
      "default": 0
    },
    {
      "type": "range",
      "id": "content_padding_y",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Content vertical padding",
      "info": "0 = theme default",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.image-with-text.settings.header_colors.content"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.multirow.settings.container_color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
