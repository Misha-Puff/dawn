{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-padding .rich-text__blocks {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }
  }

  {%- comment -%}
    Custom mobile section padding — emitted after the base rule so it wins the
    same-specificity tie and replaces the stock 75%-of-desktop scaling.
  {%- endcomment -%}
  {%- comment -%}
    With the checkbox on, all four mobile sliders are ABSOLUTE values: top/bottom
    replace the stock 75%-of-desktop scaling, and left/right replace the page-width
    gutter + the wrapper's stock mobile width shave (0 = edge to edge). The
    #shopify-section id scope outranks section-rich-text.css's
    .rich-text:not(.rich-text--full-width) .rich-text__wrapper width rule and
    base.css's ≤1099px .page-width gutter.
  {%- endcomment -%}
  {%- if section.settings.enable_mobile_padding -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .isolate {
        padding-left: 0;
        padding-right: 0;
      }

      #shopify-section-{{ section.id }} .rich-text__wrapper {
        width: 100%;
        padding-left: {{ section.settings.padding_left_mobile | default: 0 }}px;
        padding-right: {{ section.settings.padding_right_mobile | default: 0 }}px;
      }
    }
  {%- endif -%}

  {%- comment -%}
    Per-block typography overrides, ported from image-with-text. Scoped to the
    .Block-<id> class added to each block root, prefixed with the section wrapper id
    (#shopify-section-<section.id>) so the ID specificity beats the heading-size /
    text-style theme classes and the text block's legacy line-height slider. Only
    emits CSS when a block's Enable typography checkbox is on.
  {%- endcomment -%}
  {%- assign tg_scope = 'shopify-section-' | append: section.id -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tg_enable_type -%}
      {%- liquid
        assign tg_font = block.settings.tg_font
        assign tg_weight = block.settings.tg_font_weight | default: 'default'
        assign tg_fs = block.settings.tg_font_size | default: 0
        assign tg_lh = block.settings.tg_line_height | default: 0
        assign tg_case = block.settings.tg_text_case | default: 'default'
        assign tg_ls = block.settings.tg_letter_spacing | default: 0
      -%}
      {%- capture tg_brand_stack -%}{% render 'brand-font', font: block.settings.tg_custom_font %}{%- endcapture -%}
      {%- assign tg_brand_stack = tg_brand_stack | strip -%}
      {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
        {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
        {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      #{{ tg_scope }} .Block-{{ block.id }} {
        {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }};{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }};{% endif -%}
        {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
        {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
        {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
        {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
        {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- if block.settings.tg_color != blank %} color: {{ block.settings.tg_color }};{% endif -%}
      }
      {%- assign tg_fs_m = block.settings.tg_font_size_mobile | default: 0 -%}
      {%- if tg_fs_m > 0 -%}
        @media screen and (max-width: 749px) {
          #{{ tg_scope }} .Block-{{ block.id }} {
            font-size: {{ tg_fs_m }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <h2
                class="rich-text__heading rte inline-richtext {{ block.settings.heading_size }} Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </h2>
            {%- when 'caption' -%}
              <p
                class="rich-text__caption {{ block.settings.text_style }} {{ block.settings.text_style }}--{{ block.settings.text_size }} Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.caption | escape }}
              </p>
            {%- when 'text' -%}
              {% style %}
                .block-{{ block.id }} {
                  line-height: {{ block.settings.line_height }}px;
                }
              {% endstyle %}
              <div
                class="rich-text__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} small block-{{ block.id }} Block-{{ block.id }}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              {% liquid
                assign num_buttons = 0

                if block.settings.button_label
                  assign num_buttons = num_buttons | plus: 1
                endif

                if block.settings.button_label2
                  assign num_buttons = num_buttons | plus: 1
                endif

                if block.settings.button_label3
                  assign num_buttons = num_buttons | plus: 1
                endif
              %}
              <div
                class="rich-text__buttons{% if num_buttons > 1 %} rich-text__buttons--multiple{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_2 != blank -%}
                  <a
                    {% if block.settings.button_link_2 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_2 }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary_2 %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label_2 | escape -}}
                  </a>
                {%- endif -%}
                {%- if block.settings.button_label_3 != blank -%}
                  <a
                    {% if block.settings.button_link_3 == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link_3 }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary_3 %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label_3 | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.desktop_content_position.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.desktop_content_position.label"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich-text.settings.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich-text.settings.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich-text.settings.content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.rich-text.settings.content_alignment.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.rich-text.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Left Padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Right Padding",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_padding",
      "default": false,
      "label": "Custom mobile section padding",
      "info": "Off = mobile uses 75% of the desktop vertical padding and the standard side gutters. On = the four sliders below are the exact mobile padding."
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile padding top",
      "default": 28,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile padding bottom",
      "default": 28,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile padding left",
      "info": "Exact side inset on mobile — replaces the standard gutter. 0 = edge to edge.",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Mobile padding right",
      "info": "Exact side inset on mobile — replaces the standard gutter. 0 = edge to edge.",
      "default": 0,
      "visible_if": "{{ section.settings.enable_mobile_padding }}"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.rich-text.blocks.heading.settings.heading.default",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "header",
          "content": "Typography"
        },
        {
          "type": "checkbox",
          "id": "tg_enable_type",
          "default": false,
          "label": "Enable typography"
        },
        {
          "type": "font_picker",
          "id": "tg_font",
          "default": "assistant_n4",
          "label": "Font",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_custom_font",
          "options": [
            { "value": "default", "label": "None (use font picker)" },
            { "value": "ibm_plex_sans", "label": "IBM Plex Sans" },
            { "value": "ibm_plex_mono", "label": "IBM Plex Mono" },
            { "value": "inter", "label": "Inter" },
            { "value": "geist", "label": "Geist" },
            { "value": "geist_mono", "label": "Geist Mono" },
            { "value": "overpass", "label": "Overpass" },
            { "value": "overpass_mono", "label": "Overpass Mono" },
            { "value": "dm_sans", "label": "DM Sans" },
            { "value": "dm_mono", "label": "DM Mono" },
            { "value": "manrope", "label": "Manrope" },
            { "value": "open_sans", "label": "Open Sans" }
          ],
          "default": "default",
          "label": "Brand font",
          "info": "Overrides the font picker above when set",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_font_weight",
          "options": [
            { "value": "default", "label": "Theme default" },
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "default",
          "label": "Font weight",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_font_size",
          "min": 0,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_line_height",
          "min": 0,
          "max": 250,
          "step": 5,
          "unit": "%",
          "label": "Line height",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_text_case",
          "options": [
            { "value": "default", "label": "Theme default" },
            { "value": "uppercase", "label": "Uppercase" },
            { "value": "capitalize", "label": "Capitalize" },
            { "value": "lowercase", "label": "Lowercase" },
            { "value": "none", "label": "Normal (remove uppercase)" }
          ],
          "default": "default",
          "label": "Text case",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_letter_spacing",
          "min": 0,
          "max": 4,
          "step": 0.1,
          "unit": "px",
          "label": "Letter spacing",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "color",
          "id": "tg_color",
          "label": "Text color",
          "info": "Leave blank to inherit",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_font_size_mobile",
          "min": 0,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Mobile font size",
          "info": "0 = same as desktop",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        }
      ]
    },
    {
      "type": "caption",
      "name": "t:sections.rich-text.blocks.caption.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "caption",
          "default": "t:sections.rich-text.blocks.caption.settings.text.default",
          "label": "t:sections.rich-text.blocks.caption.settings.text.label"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            {
              "value": "subtitle",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__1.label"
            },
            {
              "value": "caption-with-letter-spacing",
              "label": "t:sections.rich-text.blocks.caption.settings.text_style.options__2.label"
            }
          ],
          "default": "caption-with-letter-spacing",
          "label": "t:sections.rich-text.blocks.caption.settings.text_style.label"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "small",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__1.label"
            },
            {
              "value": "medium",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__2.label"
            },
            {
              "value": "large",
              "label": "t:sections.rich-text.blocks.caption.settings.caption_size.options__3.label"
            }
          ],
          "default": "medium",
          "label": "t:sections.rich-text.blocks.caption.settings.caption_size.label"
        },
        {
          "type": "header",
          "content": "Typography"
