{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    .section-{{ section.id }}-padding .rich-text__blocks {
      padding-left: {{ section.settings.padding_left }}px;
      padding-right: {{ section.settings.padding_right }}px;
    }

    {%- if section.settings.content_max_width > 0 %}
      #shopify-section-{{ section.id }} .store-info__blocks {
        max-width: {{ section.settings.content_max_width }}px;
      }
    {%- endif %}
  }

  {%- comment -%}
    With the checkbox on, all four mobile sliders are ABSOLUTE values: top/bottom
    replace the stock 75%-of-desktop scaling, and left/right replace the page-width
    gutter + the wrapper's stock mobile width shave (0 = edge to edge). Same model
    as rich-text.
  {%- endcomment -%}
  {%- if section.settings.enable_mobile_padding -%}
    @media screen and (max-width: 749px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }

      #shopify-section-{{ section.id }} .isolate {
        padding-left: 0;
        padding-right: 0;
      }

      #shopify-section-{{ section.id }} .rich-text__wrapper {
        width: 100%;
        padding-left: {{ section.settings.padding_left_mobile | default: 0 }}px;
        padding-right: {{ section.settings.padding_right_mobile | default: 0 }}px;
      }
    }
  {%- endif -%}

  .store-info__label {
    margin: 0;
  }

  .store-info__address {
    font-style: normal;
  }

  .store-info__hours > *,
  .store-info__contact > * {
    margin-top: 0;
    margin-bottom: 0;
  }

  .store-info__hours > * + *,
  .store-info__contact > * + * {
    margin-top: 0.8rem;
  }

  .store-info__map-embed {
    display: block;
    width: 100%;
    border: 0;
  }

  {%- comment -%}
    Per-block typography overrides, same model as rich-text/image-with-text. Scoped
    to the .Block-<id> class on each block root, prefixed with the section wrapper id
    so the ID specificity beats the heading-size / text-style theme classes. Only
    emits CSS when a block's Enable typography checkbox is on.
  {%- endcomment -%}
  {%- assign tg_scope = 'shopify-section-' | append: section.id -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tg_enable_type -%}
      {%- liquid
        assign tg_font = block.settings.tg_font
        assign tg_weight = block.settings.tg_font_weight | default: 'default'
        assign tg_fs = block.settings.tg_font_size | default: 0
        assign tg_lh = block.settings.tg_line_height | default: 0
        assign tg_case = block.settings.tg_text_case | default: 'default'
        assign tg_ls = block.settings.tg_letter_spacing | default: 0
      -%}
      {%- capture tg_brand_stack -%}{% render 'brand-font', font: block.settings.tg_custom_font %}{%- endcapture -%}
      {%- assign tg_brand_stack = tg_brand_stack | strip -%}
      {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
        {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
        {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      #{{ tg_scope }} .Block-{{ block.id }} {
        {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }};{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }};{% endif -%}
        {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
        {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
        {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
        {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
        {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- if block.settings.tg_color != blank %} color: {{ block.settings.tg_color }};{% endif -%}
      }
      {%- assign tg_fs_m = block.settings.tg_font_size_mobile | default: 0 -%}
      {%- if tg_fs_m > 0 -%}
        @media screen and (max-width: 749px) {
          #{{ tg_scope }} .Block-{{ block.id }} {
            font-size: {{ tg_fs_m }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="isolate{% unless section.settings.full_width %} page-width{% endunless %}">
  <div class="store-info rich-text content-container color-{{ section.settings.color_scheme }} gradient{% if section.settings.full_width %} rich-text--full-width content-container--full-width{% endif %} section-{{ section.id }}-padding">
    <div class="rich-text__wrapper rich-text__wrapper--{{ section.settings.desktop_content_position }}{% if section.settings.full_width %} page-width{% endif %}">
      <div class="rich-text__blocks store-info__blocks {{ section.settings.content_alignment }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              {%- assign heading_tag = block.settings.heading_tag | default: 'h1' -%}
              <{{ heading_tag }}
                class="store-info__heading rte inline-richtext {{ block.settings.heading_size }} Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.heading }}
              </{{ heading_tag }}>
            {%- when 'text' -%}
              {% style %}
                .block-{{ block.id }} {
                  line-height: {{ block.settings.line_height }}px;
                }
              {% endstyle %}
              <div
                class="store-info__text rte block-{{ block.id }} Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {{ block.settings.text }}
              </div>
            {%- when 'hours' -%}
              <div
                class="store-info__hours Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.label != blank -%}
                  <h2 class="store-info__label h4">{{ block.settings.label | escape }}</h2>
                {%- endif -%}
                {%- if block.settings.hours != blank -%}
                  <div class="store-info__hours-rows rte">{{ block.settings.hours }}</div>
                {%- endif -%}
                {%- if block.settings.note != blank -%}
                  <div class="store-info__hours-note rte">{{ block.settings.note }}</div>
                {%- endif -%}
              </div>
            {%- when 'contact' -%}
              <div
                class="store-info__contact Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.address != blank -%}
                  <address class="store-info__address rte">{{ block.settings.address }}</address>
                {%- endif -%}
                {%- if block.settings.phone != blank -%}
                  {%- assign phone_href = block.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' | remove: '.' -%}
                  <p class="store-info__phone">
                    <a href="tel:{{ phone_href }}" class="link">{{ block.settings.phone | escape }}</a>
                  </p>
                {%- endif -%}
                {%- if block.settings.email != blank -%}
                  <p class="store-info__email">
                    {%- if block.settings.email_prefix != blank -%}{{ block.settings.email_prefix | escape }} {% endif -%}
                    <a href="mailto:{{ block.settings.email | escape }}" class="link">{{ block.settings.email | escape }}</a>.
                  </p>
                {%- endif -%}
                {%- if block.settings.directions_label != blank and block.settings.address != blank -%}
                  {%- assign maps_query = block.settings.address | replace: '<br/>', ' ' | replace: '<br>', ' ' | strip_html | strip_newlines | url_encode -%}
                  <p class="store-info__directions">
                    <a href="https://www.google.com/maps/search/?api=1&query={{ maps_query }}" class="link" target="_blank" rel="noopener">{{ block.settings.directions_label | escape }}</a>
                  </p>
                {%- endif -%}
              </div>
            {%- when 'map' -%}
              <div class="store-info__map Block-{{ block.id }}" {{ block.shopify_attributes }}>
                {%- if block.settings.map_embed_url != blank -%}
                  <iframe
                    src="{{ block.settings.map_embed_url | escape }}"
                    class="store-info__map-embed"
                    height="400"
                    loading="lazy"
                    title="Map"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                  ></iframe>
                {%- elsif block.settings.map_image != blank -%}
                  {%- if block.settings.map_link != blank -%}
                    <a href="{{ block.settings.map_link }}">
                  {%- endif -%}
                  {{
                    block.settings.map_image
                    | image_url: width: 1500
                    | image_tag: loading: 'lazy', widths: '375, 750, 1100, 1500', sizes: '100vw', class: 'store-info__map-image'
                  }}
                  {%- if block.settings.map_link != blank -%}
                    </a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- when 'button' -%}
              <div
                class="rich-text__buttons Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {%- if block.settings.button_label != blank -%}
                  <a
                    {% if block.settings.button_link == blank %}
                      role="link" aria-disabled="true"
                    {% else %}
                      href="{{ block.settings.button_link }}"
                    {% endif %}
                    class="button{% if block.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
                  >
                    {{- block.settings.button_label | escape -}}
                  </a>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Store info",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "select", "id": "desktop_content_position", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left", "label": "Desktop content position" },
    { "type": "select", "id": "content_alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left", "label": "Content alignment" },
    { "type": "range", "id": "content_max_width", "min": 0, "max": 1200, "step": 20, "unit": "px", "label": "Content max width", "info": "0 = theme default", "default": 0 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "full_width", "default": true, "label": "Make section full width" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 40 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 52 },
    { "type": "range", "id": "padding_left", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Left Padding", "default": 0 },
    { "type": "range", "id": "padding_right", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Right Padding", "default": 0 },
    { "type": "checkbox", "id": "enable_mobile_padding", "default": false, "label": "Custom mobile section padding", "info": "Off = mobile uses 75% of the desktop vertical padding and the standard side gutters. On = the four sliders below are the exact mobile padding." },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Mobile padding top", "default": 28, "visible_if": "{{ section.settings.enable_mobile_padding }}" },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Mobile padding bottom", "default": 28, "visible_if": "{{ section.settings.enable_mobile_padding }}" },
    { "type": "range", "id": "padding_left_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Mobile padding left", "info": "Exact side inset on mobile — replaces the standard gutter. 0 = edge to edge.", "default": 0, "visible_if": "{{ section.settings.enable_mobile_padding }}" },
    { "type": "range", "id": "padding_right_mobile", "min": 0, "max": 100, "step": 2, "unit": "px", "label": "Mobile padding right", "info": "Exact side inset on mobile — replaces the standard gutter. 0 = edge to edge.", "default": 0, "visible_if": "{{ section.settings.enable_mobile_padding }}" }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "Heading",
      "limit": 3,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "default": "Store name", "label": "Heading" },
        { "type": "select", "id": "heading_tag", "options": [{ "value": "h1", "label": "h1" }, { "value": "h2", "label": "h2" }, { "value": "h3", "label": "h3" }], "default": "h1", "label": "Heading tag", "info": "Use h1 when the page has no other h1 (SEO)" },
        { "type": "select", "id": "heading_size", "options": [{ "value": "h2", "label": "Small" }, { "value": "h1", "label": "Medium" }, { "value": "h0", "label": "Large" }, { "value": "hxl", "label": "Extra large" }, { "value": "hxxl", "label": "XX large" }], "default": "h1", "label": "Heading size" },
        { "type": "header", "content": "Typography" },
        { "type": "checkbox", "id": "tg_enable_type", "default": false, "label": "Enable typography" },
        { "type": "font_picker", "id": "tg_font", "default": "assistant_n4", "label": "Font", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_custom_font", "options": [{ "value": "default", "label": "None (use font picker)" }, { "value": "ibm_plex_sans", "label": "IBM Plex Sans" }, { "value": "ibm_plex_mono", "label": "IBM Plex Mono" }, { "value": "inter", "label": "Inter" }, { "value": "geist", "label": "Geist" }, { "value": "geist_mono", "label": "Geist Mono" }, { "value": "overpass", "label": "Overpass" }, { "value": "overpass_mono", "label": "Overpass Mono" }, { "value": "dm_sans", "label": "DM Sans" }, { "value": "dm_mono", "label": "DM Mono" }, { "value": "manrope", "label": "Manrope" }, { "value": "open_sans", "label": "Open Sans" }], "default": "default", "label": "Brand font", "info": "Overrides the font picker above when set", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_font_weight", "options": [{ "value": "default", "label": "Theme default" }, { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "default", "label": "Font weight", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_font_size", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Font size", "info": "0 = theme default", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_line_height", "min": 0, "max": 250, "step": 5, "unit": "%", "label": "Line height", "info": "0 = theme default", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_text_case", "options": [{ "value": "default", "label": "Theme default" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "none", "label": "Normal (remove uppercase)" }], "default": "default", "label": "Text case", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_letter_spacing", "min": 0, "max": 4, "step": 0.1, "unit": "px", "label": "Letter spacing", "info": "0 = theme default", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "color", "id": "tg_color", "label": "Text color", "info": "Leave blank to inherit", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_font_size_mobile", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Mobile font size", "info": "0 = same as desktop", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "limit": 6,
      "settings": [
        { "type": "richtext", "id": "text", "default": "<p>Share information about your store with your customers.</p>", "label": "Text" },
        { "type": "range", "id": "line_height", "min": 20, "max": 40, "step": 1, "unit": "px", "label": "Line Height", "default": 24 },
        { "type": "header", "content": "Typography" },
        { "type": "checkbox", "id": "tg_enable_type", "default": false, "label": "Enable typography" },
        { "type": "font_picker", "id": "tg_font", "default": "assistant_n4", "label": "Font", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_custom_font", "options": [{ "value": "default", "label": "None (use font picker)" }, { "value": "ibm_plex_sans", "label": "IBM Plex Sans" }, { "value": "ibm_plex_mono", "label": "IBM Plex Mono" }, { "value": "inter", "label": "Inter" }, { "value": "geist", "label": "Geist" }, { "value": "geist_mono", "label": "Geist Mono" }, { "value": "overpass", "label": "Overpass" }, { "value": "overpass_mono", "label": "Overpass Mono" }, { "value": "dm_sans", "label": "DM Sans" }, { "value": "dm_mono", "label": "DM Mono" }, { "value": "manrope", "label": "Manrope" }, { "value": "open_sans", "label": "Open Sans" }], "default": "default", "label": "Brand font", "info": "Overrides the font picker above when set", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_font_weight", "options": [{ "value": "default", "label": "Theme default" }, { "value": "300", "label": "Light" }, { "value": "400", "label": "Regular" }, { "value": "500", "label": "Medium" }, { "value": "600", "label": "Semibold" }, { "value": "700", "label": "Bold" }], "default": "default", "label": "Font weight", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_font_size", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Font size", "info": "0 = theme default", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_line_height", "min": 0, "max": 250, "step": 5, "unit": "%", "label": "Line height", "info": "0 = theme default. Overrides the px slider above when set", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "select", "id": "tg_text_case", "options": [{ "value": "default", "label": "Theme default" }, { "value": "uppercase", "label": "Uppercase" }, { "value": "capitalize", "label": "Capitalize" }, { "value": "lowercase", "label": "Lowercase" }, { "value": "none", "label": "Normal (remove uppercase)" }], "default": "default", "label": "Text case", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_letter_spacing", "min": 0, "max": 4, "step": 0.1, "unit": "px", "label": "Letter spacing", "info": "0 = theme default", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "color", "id": "tg_color", "label": "Text color", "info": "Leave blank to inherit", "visible_if": "{{ block.settings.tg_enable_type }}" },
        { "type": "range", "id": "tg_font_size_mobile", "min": 0, "max": 72, "step": 1, "unit": "px", "label": "Mobile font size", "info": "0 = same as desktop", "default": 0, "visible_if": "{{ block.settings.tg_enable_type }}" }
      ]
    },
    {
      "type": "hours",
      "name": "Hours",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "info": "Optional, e.g. \"Regular store hours\". Renders uppercase.", "default": "Store hours" },
        { "type": "richtext", "id": "hours", "label": "Hours", "default": "<p>Monday through Saturday 11am-6pm<br/>Sunday 11am-5pm</p>" },
        { "type": "richtext", "id": "note", "label": "Note", "info": "Optional caveats shown under the hours" },
        { "type": "header", "content": "Typography" },
        { "type": "checkbox", "id": "tg_enable_type", "default": false, "label": "Enable typography" },
        { "type": "font_picker", "id": "tg_font", "default": "assistant_n4", "label": "Font", "visible_if": "{{ block.settings.tg_enable_type }}" },
