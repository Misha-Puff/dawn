{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }

  {%- comment -%}
    Title / description typography (tg_ pattern, donor rich-text/buttons) and
    opt-in section padding. The #shopify-section id scope outranks
    template-collection.css's .collection-hero__title (1.3rem uppercase) and
    component-collection-hero.css. Zero CSS when the checkboxes are off.
  {%- endcomment -%}
  {%- if section.settings.tt_enable_type -%}
    {%- liquid
      assign tt_font = section.settings.tt_font
      assign tt_weight = section.settings.tt_font_weight | default: 'default'
      assign tt_fs = section.settings.tt_font_size | default: 0
      assign tt_case = section.settings.tt_text_case | default: 'default'
      assign tt_ls = section.settings.tt_letter_spacing | default: 0
    -%}
    {%- capture tt_brand_stack -%}{% render 'brand-font', font: section.settings.tt_custom_font %}{%- endcapture -%}
    {%- assign tt_brand_stack = tt_brand_stack | strip -%}
    {%- if tt_font != blank and tt_brand_stack == blank -%}{{ tt_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if tt_font != blank and tt_brand_stack == blank and tt_weight != 'default' -%}
      {%- assign tt_wfont = tt_font | font_modify: 'weight', tt_weight -%}
      {%- if tt_wfont -%}{{ tt_wfont | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endif -%}
    #shopify-section-{{ section.id }} .collection-hero__title {
      {%- if tt_brand_stack != blank %} font-family: {{ tt_brand_stack }};{% elsif tt_font != blank %} font-family: {{ tt_font.family }}, {{ tt_font.fallback_families }};{% endif -%}
      {%- if tt_weight != 'default' and tt_weight != blank %} font-weight: {{ tt_weight }};{% endif -%}
      {%- if tt_fs > 0 %} font-size: {{ tt_fs }}px;{% endif -%}
      {%- if tt_case != 'default' and tt_case != blank %} text-transform: {{ tt_case }};{% endif -%}
      {%- if tt_ls > 0 %} letter-spacing: {{ tt_ls }}px;{% endif -%}
      {%- if section.settings.tt_color != blank %} color: {{ section.settings.tt_color }};{% endif -%}
    }
    {%- assign tt_fs_m = section.settings.tt_font_size_mobile | default: 0 -%}
    {%- if tt_fs_m > 0 -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .collection-hero__title {
          font-size: {{ tt_fs_m }}px;
        }
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.td_enable_type -%}
    {%- liquid
      assign td_font = section.settings.td_font
      assign td_weight = section.settings.td_font_weight | default: 'default'
      assign td_fs = section.settings.td_font_size | default: 0
      assign td_case = section.settings.td_text_case | default: 'default'
      assign td_ls = section.settings.td_letter_spacing | default: 0
    -%}
    {%- capture td_brand_stack -%}{% render 'brand-font', font: section.settings.td_custom_font %}{%- endcapture -%}
    {%- assign td_brand_stack = td_brand_stack | strip -%}
    {%- if td_font != blank and td_brand_stack == blank -%}{{ td_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if td_font != blank and td_brand_stack == blank and td_weight != 'default' -%}
      {%- assign td_wfont = td_font | font_modify: 'weight', td_weight -%}
      {%- if td_wfont -%}{{ td_wfont | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endif -%}
    #shopify-section-{{ section.id }} .collection-hero__description {
      {%- if td_brand_stack != blank %} font-family: {{ td_brand_stack }};{% elsif td_font != blank %} font-family: {{ td_font.family }}, {{ td_font.fallback_families }};{% endif -%}
      {%- if td_weight != 'default' and td_weight != blank %} font-weight: {{ td_weight }};{% endif -%}
      {%- if td_fs > 0 %} font-size: {{ td_fs }}px;{% endif -%}
      {%- if td_case != 'default' and td_case != blank %} text-transform: {{ td_case }};{% endif -%}
      {%- if td_ls > 0 %} letter-spacing: {{ td_ls }}px;{% endif -%}
      {%- if section.settings.td_color != blank %} color: {{ section.settings.td_color }};{% endif -%}
    }
    {%- assign td_fs_m = section.settings.td_font_size_mobile | default: 0 -%}
    {%- if td_fs_m > 0 -%}
      @media screen and (max-width: 749px) {
        #shopify-section-{{ section.id }} .collection-hero__description {
          font-size: {{ td_fs_m }}px;
        }
      }
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.pad_enable -%}
    @media screen and (max-width: 749px) {
      #shopify-section-{{ section.id }} .collection-hero {
        padding-top: {{ section.settings.padding_top_mobile }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
      }
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }} .collection-hero {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection.image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {% render 'sanitizer', input: collection.title %}
      </h1>

      {%- if section.settings.show_collection_description -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="collection-hero__image-container media gradient">
        <img
          srcset="
            {%- if collection.image.width >= 165 -%}{{ collection.image | image_url: width: 165 }} 165w,{%- endif -%}
            {%- if collection.image.width >= 360 -%}{{ collection.image | image_url: width: 360 }} 360w,{%- endif -%}
            {%- if collection.image.width >= 535 -%}{{ collection.image | image_url: width: 535 }} 535w,{%- endif -%}
            {%- if collection.image.width >= 750 -%}{{ collection.image | image_url: width: 750 }} 750w,{%- endif -%}
            {%- if collection.image.width >= 1070 -%}{{ collection.image | image_url: width: 1070 }} 1070w,{%- endif -%}
            {%- if collection.image.width >= 1500 -%}{{ collection.image | image_url: width: 1500 }} 1500w,{%- endif -%}
            {{ collection.image | image_url }} {{ collection.image.width }}w
          "
          src="{{ collection.image | image_url: width: 750 }}"
          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
          alt="{{ collection.image.alt | escape }}"
          width="{{ collection.image.width }}"
          height="{{ collection.image.height }}"
        >
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
