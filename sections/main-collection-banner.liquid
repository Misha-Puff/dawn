    {
      "type": "select",
      "id": "tt_custom_font",
      "options": [
        {
          "value": "default",
          "label": "None (use font picker)"
        },
        {
          "value": "ibm_plex_sans",
          "label": "IBM Plex Sans"
        },
        {
          "value": "ibm_plex_mono",
          "label": "IBM Plex Mono"
        },
        {
          "value": "inter",
          "label": "Inter"
        },
        {
          "value": "geist",
          "label": "Geist"
        },
        {
          "value": "geist_mono",
          "label": "Geist Mono"
        },
        {
          "value": "overpass",
          "label": "Overpass"
        },
        {
          "value": "overpass_mono",
          "label": "Overpass Mono"
        },
        {
          "value": "dm_sans",
          "label": "DM Sans"
        },
        {
          "value": "dm_mono",
          "label": "DM Mono"
        },
        {
          "value": "manrope",
          "label": "Manrope"
        },
        {
          "value": "open_sans",
          "label": "Open Sans"
        }
      ],
      "default": "default",
      "label": "Brand font",
      "info": "Overrides the font picker above when set",
      "visible_if": "{{ section.settings.tt_enable_type }}"
    },
    {
      "type": "select",
      "id": "tt_font_weight",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "300",
          "label": "Light"
        },
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "default",
      "label": "Font weight",
      "visible_if": "{{ section.settings.tt_enable_type }}"
    },
    {
      "type": "range",
      "id": "tt_font_size",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "info": "0 = theme default",
      "default": 0,
      "visible_if": "{{ section.settings.tt_enable_type }}"
    },
    {
      "type": "range",
      "id": "tt_font_size_mobile",
      "min": 0,
      "max": 72,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "info": "0 = same as desktop",
      "default": 0,
      "visible_if": "{{ section.settings.tt_enable_type }}"
    },
    {
      "type": "select",
      "id": "tt_text_case",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        },
        {
          "value": "lowercase",
