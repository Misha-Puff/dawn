    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Title typography"
    },
    {
      "type": "checkbox",
      "id": "tt_enable_type",
