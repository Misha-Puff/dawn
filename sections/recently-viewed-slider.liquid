{%- style -%}
  @media screen and (max-width: 1080px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
      {% if section.settings.mobile_padding_left > 0 %}
        padding-left: {{ section.settings.mobile_padding_left  }}px;
      {% endif %}
      {% if section.settings.mobile_padding_right > 0 %}
        padding-right: {{ section.settings.mobile_padding_right  }}px;
      {% endif %}
    }
  }

  @media screen and (min-width: 1100px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.desktop_padding_top }}px;
      padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
      {% if section.settings.desktop_padding_left > 0 %}
        padding-left: {{ section.settings.desktop_padding_left  }}px;
      {% endif %}
      {% if section.settings.desktop_padding_right > 0 %}
        padding-right: {{ section.settings.desktop_padding_right  }}px;
      {% endif %}
    }
  }

  {% if section.settings.enable_custom_spacing %}
    .section-{{ section.id }}-padding .grid {
      column-gap: {{ section.settings.horizontal_spacing_mobile }}px;
      row-gap: {{ section.settings.vertical_spacing_mobile }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding .grid {
        column-gap: {{ section.settings.horizontal_spacing_desktop }}px;
        row-gap: {{ section.settings.vertical_spacing_desktop }}px;
      }

      .section-{{ section.id }}-padding .grid--6-col-desktop .grid__item {
        width: calc(16.66% - {{ section.settings.horizontal_spacing_desktop }}px * 5 / 6) !important;
        max-width: calc(16.66% - {{ section.settings.horizontal_spacing_desktop }}px * 5 / 6) !important;
      }

      .section-{{ section.id }}-padding .grid--5-col-desktop .grid__item {
        width: calc(20% - {{ section.settings.horizontal_spacing_desktop }}px * 4 / 5) !important;
        max-width: calc(20% - {{ section.settings.horizontal_spacing_desktop }}px * 4 / 5) !important;
      }

      .section-{{ section.id }}-padding .grid--4-col-desktop .grid__item {
        width: calc(25% - {{ section.settings.horizontal_spacing_desktop }}px * 3 / 4) !important;
        max-width: calc(25% - {{ section.settings.horizontal_spacing_desktop }}px * 3 / 4) !important;
      }

      .section-{{ section.id }}-padding .grid--3-col-desktop .grid__item {
        width: calc(33.33% - {{ section.settings.horizontal_spacing_desktop }}px * 2 / 3) !important;
        max-width: calc(33.33% - {{ section.settings.horizontal_spacing_desktop }}px * 2 / 3) !important;
      }

      .section-{{ section.id }}-padding .grid--2-col-desktop .grid__item {
        width: calc(50% - {{ section.settings.horizontal_spacing_desktop }}px / 2) !important;
        max-width: calc(50% - {{ section.settings.horizontal_spacing_desktop }}px / 2) !important;
      }
    }

    @media screen and (max-width: 749px){
      .section-{{ section.id }}-padding .grid--2-col-tablet-down .grid__item {
        width: calc(50% - {{ section.settings.horizontal_spacing_mobile }}px / 2);
      }
    }
  {% endif %}

  .section-{{ section.id }} .slider-buttons {
    display: none !important;
  }

  .section-{{ section.id }} .collection__title .title {
    font-size: 15px;
  }

  .section-{{ section.id }} .collection__title.title-wrapper {
    margin-bottom: {{ section.settings.heading_margin }}px !important;
  }

  .section-{{ section.id }} .collection__title .title {
    margin-bottom: 0 !important;
  }

  {%- comment -%}
    Heading typography (per-instance), cloned from metafield-product-slider. Emitted
    after the hardcoded 15px rule above so a set font-size wins; the (0,3,0) selector
    out-specifies the .uppercase class (0,1,0) so text case "none" can remove the
    forced uppercase. Brand-font stack wins over the font picker; sentinels 0 /
    'default' = inherit, so with typography disabled nothing is emitted and the
    current look is unchanged.
  {%- endcomment -%}
  {%- if section.settings.tg_enable_type -%}
    {%- liquid
      assign tg_font = section.settings.tg_font
      assign tg_weight = section.settings.tg_font_weight | default: 'default'
      assign tg_fs = section.settings.tg_font_size | default: 0
      assign tg_lh = section.settings.tg_line_height | default: 0
      assign tg_case = section.settings.tg_text_case | default: 'default'
      assign tg_ls = section.settings.tg_letter_spacing | default: 0
      assign tg_col = section.settings.tg_color
    -%}
    {%- capture tg_brand_stack -%}{% render 'brand-font', font: section.settings.tg_custom_font %}{%- endcapture -%}
    {%- assign tg_brand_stack = tg_brand_stack | strip -%}
    {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
      {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
      {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
    {%- endif -%}
    .section-{{ section.id }} .collection__title .title {
      {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }}; font-style: normal;{% if tg_weight == 'default' %} font-weight: 400;{% endif %}{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }}; font-style: {{ tg_font.style }};{% if tg_weight == 'default' %} font-weight: {{ tg_font.weight }};{% endif %}{% endif -%}
      {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
      {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
      {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
      {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
      {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
      {%- if tg_col != blank %} color: {{ tg_col }};{% endif -%}
    }
    {%- assign tg_fs_m = section.settings.tg_font_size_mobile | default: 0 -%}
    {%- if tg_fs_m > 0 -%}
      @media screen and (max-width: 749px) {
        .section-{{ section.id }} .collection__title .title {
          font-size: {{ tg_fs_m }}px;
        }
      }
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} Cards are fetched live via sections/recently-viewed-cards.liquid; the shared snippet only styles them. {%- endcomment -%}
  {% render 'card-settings-styles' %}

  {%- comment -%}
    The SRA fragment emits BOTH the swatch row and the colorway line
    (force_color_line); this setting decides which one shows — mutually
    exclusive, matching the setting-level rule in card-product.liquid.
  {%- endcomment -%}
  {%- if section.settings.show_card_swatches -%}
    #shopify-section-{{ section.id }} .card__color-line {
      display: none;
    }
  {%- else -%}
    #shopify-section-{{ section.id }} .card__swatches {
      display: none;
    }
  {%- endif -%}

  {%- comment -%}
    The SRA fragment (recently-viewed-cards) always emits rating markup — it cannot
    read this section's settings — so unchecking hides it here, scoped to this
    section's cards only.
  {%- endcomment -%}
  {%- unless section.settings.show_rating -%}
    #shopify-section-{{ section.id }} .rating,
    #shopify-section-{{ section.id }} .rating-text,
    #shopify-section-{{ section.id }} .rating-count {
      display: none;
    }
  {%- endunless -%}

  {%- unless section.settings.show_size_overlay -%}
    #shopify-section-{{ section.id }} .popup-overlay {
      display: none;
    }
  {%- endunless -%}
{%- endstyle -%}

<div
  class="color-{{ section.settings.color_scheme }} isolate gradient"
>
  <div
    class="section-{{ section.id }} collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    <div class="collection__title title-wrapper title-wrapper--no-top-margin collection__title--desktop-slider {{ section.settings.heading_alignment }}">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext uppercase {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
    </div>

    <recently-viewed-products
      data-search-url="{{ routes.search_url }}"
      data-section-id="{{ section.id }}"
      data-products-to-show="{{ section.settings.products_to_show }}"
      data-current-product-id="{{ product.id }}"
    >
      <slider-component class="slider-mobile-gutter card-redesign slider-component-desktop{% if section.settings.full_width %} slider-component-full-width{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <ul
        id="Slider-{{ section.id }}"
        data-id="{{ section.id }}"
        class="grid product-grid contains-card contains-card--product{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down slider slider--desktop slider--tablet grid--peek"
        role="list"
        aria-label="{{ 'general.slider.name' | t }}"
      ></ul>
      <div class="slider-buttons">
        <button
          type="button"
          class="slider-button slider-button--prev"
          name="previous"
          aria-label="{{ 'general.slider.previous_slide' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>
        <div class="slider-counter caption">
          <span class="slider-counter--current">1</span>
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
          <span class="slider-counter--total"></span>
        </div>
        <button
          type="button"
          class="slider-button slider-button--next"
          name="next"
          aria-label="{{ 'general.slider.next_slide' | t }}"
          aria-controls="Slider-{{ section.id }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    </slider-component>
    </recently-viewed-products>
  </div>
</div>

{% schema %}
{
  "name": "Recently Viewed Products",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "paragraph",
      "content": "Cards are fetched live from the store when the slider comes into view, so prices, badges, and availability are always current. These settings hide or style card details in this slider only."
    },
    {
      "type": "checkbox",
      "id": "show_card_swatches",
      "default": true,
      "label": "Show color swatches",
      "info": "When off, the colorway name shows as text instead."
    },
    { "type": "checkbox", "id": "show_rating", "default": true, "label": "Show product rating", "info": "Stars read the reviews.rating metafield. Unchecking hides them on this slider's cards only." },
    {
      "type": "range",
      "id": "swatch_card_width",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Swatch width",
      "info": "0 = theme default (20px)",
      "default": 20
    },
    {
      "type": "range",
      "id": "swatch_card_height",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Swatch height",
      "info": "0 = theme default (square)",
      "default": 12
    },
    {
      "type": "range",
      "id": "swatch_card_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Swatch corner radius",
      "info": "0 = square corners (theme default)",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_size_overlay",
      "default": true,
      "label": "Show size availability on hover (desktop)",
      "info": "Unchecking hides the overlay on this slider's cards; the settings below style it."
    },
    {
      "type": "color",
      "id": "size_overlay_bg_color",
      "label": "Size overlay background color",
      "info": "Leave blank to follow the card color scheme background.",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Size overlay background opacity",
      "info": "Theme default: 60%.",
      "default": 60,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "select",
      "id": "size_overlay_position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom (theme default)"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        }
      ],
      "default": "bottom",
      "label": "Size overlay position",
      "info": "Top and bottom slide in on hover; center fades in.",
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_padding_top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Size overlay padding top",
      "info": "Theme default: 8px.",
      "default": 6,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "range",
      "id": "size_overlay_padding_bottom",
      "min": 0,
      "max": 48,
      "step": 1,
      "unit": "px",
      "label": "Size overlay padding bottom",
      "info": "Theme default: 16px.",
      "default": 6,
      "visible_if": "{{ section.settings.show_size_overlay }}"
    },
    {
      "type": "header",
      "content": "Card spacing"
    },
    {
      "type": "checkbox",
      "id": "card_spacing_enable",
      "default": true,
      "label": "Customize card spacing",
      "info": "Defaults below match the theme's stock spacing."
    },
    {
      "type": "range",
      "id": "card_info_padding_top",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space above title row",
      "default": 8,
      "visible_if": "{{ section.settings.card_spacing_enable }}"
    },
    {
      "type": "range",
      "id": "card_title_price_gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Title to price gap",
      "info": "Vertical gap when the price wraps below the title (mobile).",
