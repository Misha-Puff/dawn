{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'newsletter-section.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- comment -%}
    Per-block typography overrides, ported from rich-text. Scoped to the
    .Block-<id> class on the heading block, prefixed with the section wrapper id
    (#shopify-section-<section.id>) so the ID specificity beats the heading-size
    theme classes. Only emits CSS when a block's Enable typography checkbox is on.
  {%- endcomment -%}
  {%- assign tg_scope = 'shopify-section-' | append: section.id -%}
  {%- for block in section.blocks -%}
    {%- if block.settings.tg_enable_type -%}
      {%- liquid
        assign tg_font = block.settings.tg_font
        assign tg_weight = block.settings.tg_font_weight | default: 'default'
        assign tg_fs = block.settings.tg_font_size | default: 0
        assign tg_lh = block.settings.tg_line_height | default: 0
        assign tg_case = block.settings.tg_text_case | default: 'default'
        assign tg_ls = block.settings.tg_letter_spacing | default: 0
      -%}
      {%- capture tg_brand_stack -%}{% render 'brand-font', font: block.settings.tg_custom_font %}{%- endcapture -%}
      {%- assign tg_brand_stack = tg_brand_stack | strip -%}
      {%- if tg_font != blank and tg_brand_stack == blank -%}{{ tg_font | font_face: font_display: 'swap' }}{%- endif -%}
      {%- if tg_font != blank and tg_brand_stack == blank and tg_weight != 'default' -%}
        {%- assign tg_wfont = tg_font | font_modify: 'weight', tg_weight -%}
        {%- if tg_wfont -%}{{ tg_wfont | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      #{{ tg_scope }} .Block-{{ block.id }} {
        {%- if tg_brand_stack != blank %} font-family: {{ tg_brand_stack }};{% elsif tg_font != blank %} font-family: {{ tg_font.family }}, {{ tg_font.fallback_families }};{% endif -%}
        {%- if tg_weight != 'default' and tg_weight != blank %} font-weight: {{ tg_weight }};{% endif -%}
        {%- if tg_fs > 0 %} font-size: {{ tg_fs }}px;{% endif -%}
        {%- if tg_lh > 0 %} line-height: {{ tg_lh }}%;{% endif -%}
        {%- if tg_case != 'default' and tg_case != blank %} text-transform: {{ tg_case }};{% endif -%}
        {%- if tg_ls > 0 %} letter-spacing: {{ tg_ls }}px;{% endif -%}
        {%- if block.settings.tg_color != blank %} color: {{ block.settings.tg_color }};{% endif -%}
      }
      {%- assign tg_fs_m = block.settings.tg_font_size_mobile | default: 0 -%}
      {%- if tg_fs_m > 0 -%}
        @media screen and (max-width: 749px) {
          #{{ tg_scope }} .Block-{{ block.id }} {
            font-size: {{ tg_fs_m }}px;
          }
        }
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endstyle -%}

<div class="newsletter center {% if section.settings.full_width == false %}newsletter--narrow page-width{% endif %}">
  <div class="newsletter__wrapper color-{{ section.settings.color_scheme }} gradient content-container isolate{% if section.settings.full_width %} content-container--full-width{% endif %} section-{{ section.id }}-padding">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
        {%- when 'heading' -%}
          <h2
            class="inline-richtext {{ block.settings.heading_size }} Block-{{ block.id }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.heading }}
          </h2>
        {%- when 'paragraph' -%}
          <div
            class="newsletter__subheading rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {{ block.settings.text }}
          </div>
        {%- when 'email_form' -%}
          <div {{ block.shopify_attributes }}>
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div
                class="newsletter-form__field-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                <div class="field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="Newsletter-error--{{ section.id }}"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="Newsletter-success--{{ section.id }}"
                    {% endif %}
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                  <label class="field__label" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                </div>
                <button
                  type="submit"
                  class="button button--secondary"
                  name="commit"
                  id="Subscribe"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  Subscribe
                  {% comment %}
                    <span class="svg-wrapper">
                      {{- 'icon-arrow.svg' | inline_asset_content -}}
                    </span>
                  {% endcomment %}
                </button>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="Newsletter-success--{{ section.id }}"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {% endform %}
          </div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.newsletter.settings.paragraph.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "t:sections.newsletter.settings.full_width.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.newsletter.blocks.heading.name",
      "limit": 1,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.newsletter.blocks.heading.settings.heading.default",
          "label": "t:sections.newsletter.blocks.heading.settings.heading.label"
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__1.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__2.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__3.label"
            },
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__4.label"
            },
            {
              "value": "hxxl",
              "label": "t:sections.all.heading_size.options__5.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        },
        {
          "type": "header",
          "content": "Typography"
        },
        {
          "type": "checkbox",
          "id": "tg_enable_type",
          "default": false,
          "label": "Enable typography"
        },
        {
          "type": "font_picker",
          "id": "tg_font",
          "default": "assistant_n4",
          "label": "Font",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_custom_font",
          "options": [
            { "value": "default", "label": "None (use font picker)" },
            { "value": "ibm_plex_sans", "label": "IBM Plex Sans" },
            { "value": "ibm_plex_mono", "label": "IBM Plex Mono" },
            { "value": "inter", "label": "Inter" },
            { "value": "geist", "label": "Geist" },
            { "value": "geist_mono", "label": "Geist Mono" },
            { "value": "overpass", "label": "Overpass" },
            { "value": "overpass_mono", "label": "Overpass Mono" },
            { "value": "dm_sans", "label": "DM Sans" },
            { "value": "dm_mono", "label": "DM Mono" },
            { "value": "manrope", "label": "Manrope" },
            { "value": "open_sans", "label": "Open Sans" }
          ],
          "default": "default",
          "label": "Brand font",
          "info": "Overrides the font picker above when set",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_font_weight",
          "options": [
            { "value": "default", "label": "Theme default" },
            { "value": "300", "label": "Light" },
            { "value": "400", "label": "Regular" },
            { "value": "500", "label": "Medium" },
            { "value": "600", "label": "Semibold" },
            { "value": "700", "label": "Bold" }
          ],
          "default": "default",
          "label": "Font weight",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_font_size",
          "min": 0,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Font size",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_line_height",
          "min": 0,
          "max": 250,
          "step": 5,
          "unit": "%",
          "label": "Line height",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "select",
          "id": "tg_text_case",
          "options": [
            { "value": "default", "label": "Theme default" },
            { "value": "uppercase", "label": "Uppercase" },
            { "value": "capitalize", "label": "Capitalize" },
            { "value": "lowercase", "label": "Lowercase" },
            { "value": "none", "label": "Normal (remove uppercase)" }
          ],
          "default": "default",
          "label": "Text case",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_letter_spacing",
          "min": 0,
          "max": 4,
          "step": 0.1,
          "unit": "px",
          "label": "Letter spacing",
          "info": "0 = theme default",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "color",
          "id": "tg_color",
          "label": "Text color",
          "info": "Leave blank to inherit",
          "visible_if": "{{ block.settings.tg_enable_type }}"
        },
        {
          "type": "range",
          "id": "tg_font_size_mobile",
          "min": 0,
          "max": 72,
          "step": 1,
          "unit": "px",
          "label": "Mobile font size",
          "info": "0 = same as desktop",
          "default": 0,
          "visible_if": "{{ block.settings.tg_enable_type }}"
        }
      ]
    },
    {
      "type": "paragraph",
      "name": "t:sections.newsletter.blocks.paragraph.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "t:sections.newsletter.blocks.paragraph.settings.paragraph.default",
          "label": "t:sections.newsletter.blocks.paragraph.settings.paragraph.label"
        }
      ]
    },
    {
      "type": "email_form",
      "name": "t:sections.newsletter.blocks.email_form.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "email_form"
        }
      ]
    }
  ]
}
{% endschema %}
