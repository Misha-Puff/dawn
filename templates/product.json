        "padding_bottom": 24,
        "show_section_tag": "denim"
      }
    },
    "image_with_text_Yfnzea": {
      "type": "image-with-text",
      "blocks": {
        "text_Eqkbw6": {
          "type": "text",
          "settings": {
            "text": "<p><strong>INFINITE VARIATIONS — THE MAGIC OF HAND-DYE</strong></p><p>Our hand-dyed Superwash Merino wool is sustainably and ethically crafted by skilled artisans in Peru using premium natural fibers and low-impact dyes. This yarn is truly special, with each strand unique due to the hand-dye process, introducing subtle nuances to every garment. The hand-dyed variation and natural patterns the yarn creates when knit mean no two garments are the same, and that’s exactly why we love it. With this process, we embrace unpredictability and celebrate the presence of the hand.</p><p>For those reasons, we can’t guarantee that the Space Dye garment you receive will have a pattern close to those pictured, but it will truly be a one-of-a-kind heirloom.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "text_Eqkbw6"
      ],
      "settings": {
