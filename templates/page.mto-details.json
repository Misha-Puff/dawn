          "type": "text",
          "settings": {
            "text": "<p><strong>ON ADDRESS CHANGES</strong><br/><br/>While address changes are generally not permitted, you may update your shipping address before your order is scheduled to ship. Use the unique link in your order confirmation email and follow the instructions <a href=\"https://help.misha-and-puff.com/en-US#article-62381\" target=\"_blank\" title=\"https://help.misha-and-puff.com/en-US#article-62381\">here</a>. If you encounter any issues, please submit a <a href=\"https://shop.misha-and-puff.com/pages/contact-form\" target=\"_blank\" title=\"https://shop.misha-and-puff.com/pages/contact-form\">support ticket</a>.</p><p><em>Note:</em><em><strong> </strong></em><em>Changes to the destination country are not supported. Shipping charges and taxes will remain unchanged, as all shipping fees are non-refundable.</em></p>",
            "line_height": 22
          }
