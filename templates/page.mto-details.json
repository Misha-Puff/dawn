        "text_HKRrd4": {
          "type": "text",
          "settings": {
            "text": "<p><strong>YOUR MADE-TO-ORDER GUIDE</strong><br/><br/>Made-to-Order styles are available for a limited time and may have capacity limits due to their handcrafted nature. When a style reaches capacity, it will appear as “Unavailable.”</p><p>All Made-to-Order purchases are final sale — no cancellations or returns, even in the event of delays.</p><p>The estimated ship date is summer 2026. While we strive to meet this timeline, it may shift as production evolves. We’ll share updates along the way.</p><p>You may update your shipping address until your order begins processing, using the link in your confirmation email.</p><p>You can check the status of the MTO <a href=\"/pages/mto-status\" target=\"_blank\" title=\"Made to Order Status\">here</a>. For further assistance, visit our <a href=\"https://help.misha-and-puff.com/en-US#category-14398\" target=\"_blank\" title=\"https://help.misha-and-puff.com/en-US#category-14398\">Support Portal</a> or explore FAQs <a href=\"https://help.misha-and-puff.com/en-US\" target=\"_blank\" title=\"https://help.misha-and-puff.com/en-US\">here</a>.</p>",
            "line_height": 22
          }
        },
