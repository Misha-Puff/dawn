        "crafting_text": {
          "type": "text",
          "settings": {
            "text": "<p>We source recycled paper options from local vendors for our print and packaging needs and we are constantly exploring new ways to be creative with a minimal footprint.</p><p><a href=\"/pages/sourcing\">Read next</a> &gt; <a href=\"/pages/sourcing\">Sourcing</a></p>"
          }
        }
